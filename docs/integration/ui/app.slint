export { HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitTextField, KitSelect, KitThemes, FieldAccess, ValidationPresentation, OptionRow, SelectState, SelectionRef, Ownership } from "@kit";

export enum ExampleLanguage { english, french }
export { OptionRow, SelectState, SelectionRef, Ownership, FieldAccess, ValidationPresentation }
export component App inherits Window {
    in property <ExampleLanguage> language: ExampleLanguage.english;
    private property <bool> french: root.language == ExampleLanguage.french;
    title: root.french ? "Exemple Slint Kit typé" : "Typed Slint Kit example";
    preferred-width: 560px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: KitThemes.light.canvas;
    in property <[OptionRow]> options;
    in property <Ownership> selection-ownership: Ownership.local;
    in-out property <SelectionRef> workspace-selected;
    out property <SelectState> select-state: workspace.state;
    in property <string> selected-label;
    in property <string> draft;
    in property <string> error;
    in property <string> accepted-label;
    in property <FieldAccess> field-access;
    in property <ValidationPresentation> validation;
    callback workspace-chosen(OptionRow);
    callback name-edited(string);
    callback name-commit();
    callback name-blur();
    callback name-cancel();
    public function focus-name() { name.take-focus(); }
    VerticalLayout {
        padding: 32px;
        spacing: 20px;
        alignment: start;
        Text { text: root.french ? "Paramètres du projet" : "Project settings"; color: KitThemes.light.text-primary; font-size: 24px; font-weight: 600; }
        name := KitTextField {
            label: root.french ? "Nom du projet" : "Project name";
            text: root.draft;
            error: root.error;
            validation: root.validation;
            access: root.field-access;
            edited(text) => { root.name-edited(text); }
            commit-requested(text) => { root.name-commit(); }
            cancelled => { root.name-cancel(); }
            focus-observed(focused) => { if (!focused) { root.name-blur(); } }
        }
        Text { text: root.french ? "Espace de travail" : "Workspace"; color: KitThemes.light.text-primary; font-size: 14px; }
        workspace := KitSelect {
            options: root.options;
            ownership: root.selection-ownership;
            selected <=> root.workspace-selected;
            placeholder: root.selected-label;
            chosen(row) => { root.workspace-chosen(row); }
            tab-navigation(reverse) => { root.focus-name(); return accept; }
        }
        KitButton { text: root.french ? "Accepter le nom" : "Accept name"; activated => { root.name-commit(); } }
        Text { text: (root.french ? "Nom accepté : " : "Accepted: ") + root.accepted-label; color: KitThemes.light.text-secondary; wrap: word-wrap; }
    }
}
