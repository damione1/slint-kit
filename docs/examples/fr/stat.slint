import { InterFont } from "@kit/fonts/inter.slint";
import { KitStat, KitProgress, KitCard, KitTheme, KitThemes, KitBadge, Tone } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Stat";
    preferred-width: 660px; preferred-height: 480px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;

    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Votre espace, en chiffres"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Un aperçu de l’activité du mois."; color: root.theme.text-secondary; wrap: word-wrap; }
        HorizontalLayout { spacing: 16px;
            KitCard { theme: root.theme;
                KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: "PROJETS"; tone: Tone.accent; }
                KitStat { theme: root.theme; leading-icon: root.theme.icons.article; label: "Projets actifs"; value: "24"; description: "4 ajoutés ce mois-ci"; }
                KitProgress { theme: root.theme; value: 0.72; }
            }
            KitCard { theme: root.theme;
                KitBadge { theme: root.theme; text: "ÉQUIPE"; tone: Tone.success; }
                KitStat { theme: root.theme; label: "Tâches terminées"; value: "148"; description: "32 de plus que le mois dernier"; }
                KitProgress { theme: root.theme; value: 0.88; }
            }
        }
        KitCard { theme: root.theme;
            HorizontalLayout { spacing: 20px;
                KitStat { theme: root.theme; label: "Stockage utilisé"; value: "6,2 Go"; description: "Sur les 10 Go de votre espace"; }
                KitBadge { theme: root.theme; text: "62 % utilisés"; tone: Tone.warning; }
            }
        }
    }
}
