// Conservez le retour intrinsèque des chips ; les éditeurs natifs survivent aux changements de modèle.
import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldError, ValidationTiming, KitTagInput, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    default-font-family: InterFont.family;
    title: "KitTagInput — exemple";
    preferred-width: 420px;
    preferred-height: 220px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Saisie d’étiquettes"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        field := KitTagInput { required: true; validation-timing: ValidationTiming.on-blur; theme: root.theme; label: "Étiquettes du projet"; chips: [{ token: 11, label: "Design", removable: true }, { token: 23, label: "Recherche", removable: true }]; text: ""; create-requested(value) => { root.status = "Créer une étiquette : " + value; } }
        if field.error-visible: KitFieldError { theme: root.theme; text: field.validation-message; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
