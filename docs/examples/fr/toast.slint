import { AlertSeverity, KitTheme, KitThemes, KitToast } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitToast — exemple";
    preferred-width: 480px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Notification transitoire"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitToast { theme: root.theme; entry: { token: 11, title: "Projet archivé", message: "Vos notes sont enregistrées en toute sécurité.", action-label: "Annuler", severity: AlertSeverity.success, dismissible: true }; action(token) => { root.status = "Annulation demandée"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
