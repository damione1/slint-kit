// Cette vue statique émet des jetons visuels ; durée et observation des fermetures restent en Rust.
// Conservez le ToastId de ToastBinding::push, puis utilisez toasts.dismiss_id(id).
// toasts.update(id, replacement_view, lifetime) conserve l’action typée et les sources de pause.
// on_closed reçoit (ToastId, clone de l’action, ToastCloseReason) après publication modèle/minuteur.
// Le guide des contrôleurs fournit un observateur typé copiable ; aucune prop Slint de motif de fermeture.
import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { AlertSeverity, KitTheme, KitThemes, KitToast } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitToast — exemple";
    preferred-width: 480px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Notification transitoire"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitToast { theme: root.theme; entry: { token: 11, title: "Projet archivé", dismiss-label: "Fermer Projet archivé", message: "Vos notes sont enregistrées en toute sécurité.", action-label: "Annuler", severity: AlertSeverity.success, dismissible: true }; action(token) => { root.status = "Annulation demandée"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
