import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCard, KitBadge, Tone, KitTabs, KitProgress, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    in-out property <string> status;
    default-font-family: InterFont.family;
    title: "KitTabs example";
    preferred-width: 520px;
    preferred-height: 490px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> interactive: true;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Overview", description: "", disabled: false }, { token: 25, generation: 1, label: "Activity", description: "", disabled: false }, { token: 39, generation: 1, label: "Settings", description: "", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Espace du studio"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        control := KitTabs { interactive: root.interactive;
            theme: root.theme; options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Choisi : " + row.label; }
        }
        KitCard { theme: root.theme;
            KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: control.selected.token == 11 ? "APERÇU DU PROJET" : control.selected.token == 25 ? "DERNIÈRES NOUVELLES" : "PRÉFÉRENCES"; tone: Tone.accent; }
            Text { text: control.selected.token == 11 ? "Une vision plus claire de la suite" : control.selected.token == 25 ? "Le projet avance" : "Un espace à votre image"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { text: control.selected.token == 11 ? "La collection d’automne prend forme. La recherche est terminée, les prototypes sont prêts et l’équipe prépare sa prochaine revue." : control.selected.token == 25 ? "Today · Elliot shared the updated prototypes.\nYesterday · Darlene completed the accessibility review.\nMonday · Angela added three research notes." : "Notifications · Email and desktop enabled\nVisibility · Shared with your team\nLanguage · English"; color: root.theme.text-secondary; wrap: word-wrap; }
            Text { text: control.selected.token == 11 ? "8 tâches terminées    ·    3 collaborateurs" : control.selected.token == 25 ? "Les changements sont enregistrés dans votre espace." : "Vos choix restent associés à cet espace."; color: root.theme.accent; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
        }
        result := Text { text: "Selected: " + control.selected-label; color: root.theme.text-secondary; }
    }

}
