import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCard, KitBadge, Tone, KitTabs, KitProgress, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitTabs example";
    preferred-width: 520px;
    preferred-height: 490px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <[OptionRow]> rows: [{ token: 11, generation: 1, label: "Overview", description: "", disabled: false }, { token: 25, generation: 1, label: "Activity", description: "", disabled: false }, { token: 39, generation: 1, label: "Settings", description: "", disabled: false }];
    in property <SelectState> select-state: { open: false, generation: 1, active-index: 0, active: { present: true, token: 11 }, selected: { present: true, token: 11 }, selection-availability: SelectionAvailability.available };
    in property <string> selected-label: "Overview";
    in-out property <string> query;
    callback select-open();
    callback select-navigate(NavigationStep);
    callback select-activate(int, int);
    callback select-dismiss(CloseReason);
    callback select-query(string);
    callback select-typeahead(string);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Espace du studio"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        control := KitTabs {
            theme: root.theme; rows: root.rows; state: root.select-state;
            navigate(step) => { root.select-navigate(step); }
            activate(token, generation) => { root.select-activate(token, generation); }
            dismiss(reason) => { root.select-dismiss(reason); }
            typeahead(text) => { root.select-typeahead(text); }
        }
        KitCard { theme: root.theme;
            KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: root.selected-label == "Overview" ? "APERÇU DU PROJET" : root.selected-label == "Activity" ? "DERNIÈRES NOUVELLES" : "PRÉFÉRENCES"; tone: Tone.accent; }
            Text { text: root.selected-label == "Overview" ? "Une vision plus claire de la suite" : root.selected-label == "Activity" ? "Le projet avance" : "Un espace à votre image"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { text: root.selected-label == "Overview" ? "La collection d’automne prend forme. La recherche est terminée, les prototypes sont prêts et l’équipe prépare sa prochaine revue." : root.selected-label == "Activity" ? "Today · Elliot shared the updated prototypes.\nYesterday · Darlene completed the accessibility review.\nMonday · Angela added three research notes." : "Notifications · Email and desktop enabled\nVisibility · Shared with your team\nLanguage · English"; color: root.theme.text-secondary; wrap: word-wrap; }
            Text { text: root.selected-label == "Overview" ? "8 tâches terminées    ·    3 collaborateurs" : root.selected-label == "Activity" ? "Les changements sont enregistrés dans votre espace." : "Vos choix restent associés à cet espace."; color: root.theme.accent; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
        }
        result := Text { text: "Selected: " + root.selected-label; color: root.theme.text-secondary; }
    }

}
