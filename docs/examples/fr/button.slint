import { InterFont } from "@kit/fonts/inter.slint";
import { LucideIcons } from "@kit/icons/lucide/all.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitTheme, KitThemes, ButtonIntent, ChoiceFlow } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitButton — exemple";
    preferred-width: 360px;
    preferred-height: 280px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Bouton"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        // Les réserves latérales égales centrent le libellé avec une seule icône.
        KitButton { intent: ButtonIntent.success; leading-icon: LucideIcons.check(); theme: root.theme; text: "Enregistrer les modifications"; busy-label: "Enregistrement…"; activated => { root.status = "Action demandée"; } }
        KitButton { theme: root.theme; intent: ButtonIntent.link; text: "En savoir plus"; activated => { root.status = "Aide demandée"; } }
        KitButton { theme: root.theme; text: "Inverser la disposition"; activated => { root.theme.direction = root.theme.direction == ChoiceFlow.left-to-right ? ChoiceFlow.right-to-left : ChoiceFlow.left-to-right; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
