import { KitTheme, KitThemeContext, KitThemes, KitMetrics, TypographyRole, KitMultiSelect, OptionRow, SelectionRef } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component Example inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Canaux de notification"; preferred-width: 560px; preferred-height: 440px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{token: 1, generation: 1, label: "Email"}, {token: 2, generation: 1, label: "Push"}, {token: 3, generation: 1, label: "SMS"}, {token: 4, generation: 1, label: "Bureau"}, {token: 5, generation: 1, label: "Boîte de réception"}, {token: 6, generation: 1, label: "Résumé hebdomadaire"}, {token: 7, generation: 1, label: "Webhook"}, {token: 8, generation: 1, label: "Calendrier"}];
    in-out property <[SelectionRef]> selected: [{present: true, token: 1}, {present: true, token: 2}];
    callback membership-changed(OptionRow, bool);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Restez au courant"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Choisissez vos canaux de notification. Chaque sélection conserve son identité lorsque la liste visible change."; color: root.theme.text-secondary; wrap: word-wrap; }
        KitMultiSelect { theme: root.theme; options: root.options; selected <=> root.selected; selection-changed(row, added) => { root.membership-changed(row, added); } }
        Text { text: root.selected.length + " canaux sélectionnés"; color: root.theme.text-secondary; }
    }
}
