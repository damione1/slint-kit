// Les parties invalides portent leur erreur ; les contraintes de paire restent distinctes du fuseau.
import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

import { KitZonedDateTimeField, ZonedDateTimeCommit, ZonedOccurrenceSelection, KitStack, KitButton } from "@kit";
export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return control.report-validity(); }
    public function focus-invalid() -> bool { return control.focus-if-invalid(); }

    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    preferred-width: 600px; preferred-height: 460px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Date et heure avec fuseau";
    callback chosen(ZonedDateTimeCommit);
    // État d’acceptation lisible par l’hôte ; resolution décrit toujours une heure ambiguë.
    // Modifier le brouillon ou rappeler resolve() efface cette sélection.
    out property <ZonedOccurrenceSelection> occurrence-selection: control.occurrence-selection;
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        control := KitZonedDateTimeField { label: "Rendez-vous"; date-label: "Date du rendez-vous"; time-label: "Heure du rendez-vous"; zone-label: "Fuseau horaire"; earlier-label: "Première occurrence"; later-label: "Seconde occurrence"; date-text: "2026-11-01"; time-text: "01:30"; zone-text: "America/Toronto"; required: true; earlier-accepted-message: "Première occurrence acceptée."; later-accepted-message: "Seconde occurrence acceptée."; chosen(value) => { root.chosen(value); } }
        KitButton { text: "Résoudre l’heure"; activated => { control.resolve(); } }
    }
}
