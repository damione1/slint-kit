import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSelectTrigger, KitGlyphs, KitOption, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes, KitSurface, KitCardHeader, KitIcon } from "@kit";
export component Example inherits Window {
    in-out property <string> status;
    default-font-family: InterFont.family;
    title: "KitSelectTrigger example";
    preferred-width: 520px;
    preferred-height: 520px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <length> row-height: max(54px, 38px * root.theme.text-scale);
    in property <[OptionRow]> options: [{ token:11,generation:1,label:"Overview",description:"Your project at a glance",disabled:false }, { token:23,generation:1,label:"Activity",description:"Recent changes and updates",disabled:false }, { token:38,generation:1,label:"Settings",description:"Team and project preferences",disabled:false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        KitCardHeader { theme: root.theme; title: "Choisissez votre destination"; description: "Une sélection claire, des options descriptives et une navigation clavier familière."; }
        trigger := KitSelectTrigger {
            theme: root.theme; options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Choisi : " + row.label; } accessible-name: "Choose destination";
            tab-navigation(reverse) => { return reject; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: trigger.selected-label; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Rectangle { width: 20px * root.theme.text-scale; horizontal-stretch: 0;
                    KitIcon { theme: root.theme; glyph: trigger.state.open ? root.theme.icons.chevron-up : root.theme.icons.chevron-down; ink: root.theme.text-secondary; y: (parent.height - self.height) / 2; }
                }
            }
        }
        if trigger.state.open: KitSurface { theme: root.theme;
            for row in trigger.rows: KitOption {
                theme: root.theme; option-data: row; height: root.row-height; activate(token, generation) => { trigger.choose-option(token, generation); }
                selected: trigger.state.selected.present && trigger.state.selected.token == row.token;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle { width: 20px * root.theme.text-scale; horizontal-stretch: 0;
                        KitIcon { theme: root.theme; glyph: root.theme.icons.article; ink: row.disabled ? root.theme.disabled-text : root.theme.accent; y: (parent.height - self.height) / 2; }
                    }
                    VerticalLayout { alignment: center; spacing: 3px;
                        Text { text: row.label; color: row.disabled ? root.theme.disabled-text : root.theme.text-primary; font-size: 14px * root.theme.text-scale; font-weight: 500; overflow: elide; }
                        if row.description != "": Text { text: row.description; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; overflow: elide; }
                    }
                    Rectangle { width: 20px * root.theme.text-scale; horizontal-stretch: 0;
                        if trigger.state.selected.present && trigger.state.selected.token == row.token: KitIcon { theme: root.theme; glyph: root.theme.icons.check; ink: root.theme.accent; y: (parent.height - self.height) / 2; }
                    }
                }
            }
        }
        result := Text { text: "Selected: " + trigger.selected-label; color: root.theme.text-primary; }
    }

}
