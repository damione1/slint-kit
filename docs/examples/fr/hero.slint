import { InterFont } from "@kit/fonts/inter.slint";
import { KitButton, KitHero, KitTheme, KitThemes, KitBadge, Tone, ButtonIntent, LayoutSpace } from "@kit/kit.slint";
export enum DemoAction { create-workspace }
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Hero";
    preferred-width: 640px; preferred-height: 530px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    in property <string> status: "Votre nouvel espace vous attend."; callback action-requested(DemoAction);
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: "VOTRE PROCHAINE IDÉE COMMENCE ICI"; tone: Tone.accent; }
        KitHero { theme: root.theme; inset: LayoutSpace.section;
            title: "Faites place à\nvos belles idées.";
            description: "Réunissez vos notes, vos projets et votre équipe. Un espace serein pour transformer une inspiration en réalisation.";
            FlexboxLayout { spacing: 12px; flex-wrap: wrap; alignment: start;
                KitButton { theme: root.theme; intent: ButtonIntent.primary; leading-icon: root.theme.icons.plus; text: "Créer un espace"; activated => { root.action-requested(DemoAction.create-workspace); } }
                KitBadge { theme: root.theme; text: "Un nouveau départ, en quelques secondes"; tone: Tone.success; }
            }
        }
        HorizontalLayout { spacing: 20px;
            Text { text: "01  Rassemblez vos idées"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            Text { text: "02  Préparez un plan"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            Text { text: "03  Construisez ensemble"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
        }
        Text { text: root.status; color: root.theme.text-secondary; wrap: word-wrap; }
    }
}
