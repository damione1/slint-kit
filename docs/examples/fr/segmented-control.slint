import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSegmentedControl, KitTheme, KitThemes, ChoiceDirection } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitSegmentedControl — exemple";
    preferred-width: 420px;
    preferred-height: 420px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Choix segmenté"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitSegmentedControl { theme: root.theme; options: [{ token: 11, label: "Courriel", disabled: false , generation: 1 , description: "" }, { token: 23, label: "Notification push", disabled: false , generation: 1 , description: "" }, { token: 38, label: "SMS", disabled: true , generation: 1 , description: "" }]; selected: { present: true, token: 11 };  chosen(row) => { root.status = "Choisi : " + row.label; } }
        KitSegmentedControl { theme: root.theme; width: 200px * root.theme.text-scale; direction: ChoiceDirection.vertical; label: "Densité des lignes"; options: [{ token: 41, label: "Compacte", disabled: false , generation: 1 , description: "" }, { token: 42, label: "Confortable", disabled: false , generation: 1 , description: "" }, { token: 43, label: "Aérée", disabled: false , generation: 1 , description: "" }];  chosen(row) => { root.status = "Choisi : " + row.label; } }
        KitSegmentedControl { theme: root.theme; columns: 2; label: "Quatre choix"; options: [{ token: 51, label: "Un", generation: 1 , description: "" }, { token: 52, label: "Deux", generation: 1 , description: "" }, { token: 53, label: "Trois", generation: 1 , description: "" }, { token: 54, label: "Quatre", generation: 1 , description: "" }]; icons: [{ token: 51, glyph: root.theme.icons.check }];  chosen(row) => { root.status = "Choisi : " + row.label; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
