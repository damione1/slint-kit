// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitNumberStepper, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitNumberStepper — exemple";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Champ numérique à incréments"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitNumberStepper { decrement-label: "Diminuer la valeur"; increment-label: "Augmenter la valeur"; theme: root.theme; label: "Invités"; text: "3"; step-requested(direction) => { root.status = "Incrément demandé ; valider dans Rust"; }; edited(value) => { root.status = "Brouillon : " + value; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
