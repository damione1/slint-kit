import { KitTabs, KitTabPanel, KitStack, KitFieldDescription, LayoutSpace, OptionRow, SelectionRef, KitTheme, KitThemes } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component Example inherits Window {
    preferred-width: 620px; preferred-height: 360px;
    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    private property <SelectionRef> overview: {present: true, token: 11};
    private property <SelectionRef> settings: {present: true, token: 37};
    in-out property <SelectionRef> selected: root.overview;
    KitStack {
        theme: root.theme; inset: LayoutSpace.roomy;
        tabs := KitTabs {
            theme: root.theme; selected <=> root.selected;
            typeahead-enabled: false;
            options: [
                {token: root.overview.token, generation: 1, label: "Aperçu"},
                {token: root.settings.token, generation: 1, label: "Réglages"},
            ];
        }
        KitStack { theme: root.theme; gap: LayoutSpace.none;
            KitTabPanel {
                theme: root.theme; state: tabs.state; tab: root.overview;
                accessible-name: "Aperçu"; tab-stop: true; inset: LayoutSpace.compact;
                KitFieldDescription { theme: root.theme; text: "Le panneau reste associé à sa clé, même si les onglets sont réordonnés."; }
            }
            KitTabPanel {
                theme: root.theme; state: tabs.state; tab: root.settings;
                accessible-name: "Réglages"; tab-stop: true; inset: LayoutSpace.compact;
                KitFieldDescription { theme: root.theme; text: "Les éditeurs peuvent rester montés : la sélection change seulement le panneau visible."; }
            }
        }
    }
}
