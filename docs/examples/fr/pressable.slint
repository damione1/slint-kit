import { KitPressable, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitPressable — exemple";
    preferred-width: 360px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Primitive d’action"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitPressable { theme: root.theme; accessible-name: "Ajouter à la collection"; activated => { root.status = "Ajouté à la collection"; } Text { text: "Ajouter à la collection"; color: root.theme.text-primary; horizontal-alignment: center; vertical-alignment: center; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
