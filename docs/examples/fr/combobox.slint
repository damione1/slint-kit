import { KitKeyResult } from "@kit";
import { KitMetrics, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
import { KitCombobox, KitTheme, KitThemes, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, SearchPresentation } from "@kit";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability }

// Développer ouvre seulement ; l’activation ordinaire bascule. Un hôte contrôlé acquitte l’état demandé.
export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return workspace.report-validity(); }
    public function focus-invalid() -> bool { return workspace.focus-if-invalid(); }

    in-out property <string> status;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint combobox";
    preferred-width: 480px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Personnel", description: "Notes et brouillons privés", disabled: false }, { token: 25, generation: 1, label: "Partagé", description: "Documents d’équipe", disabled: false }, { token: 39, generation: 1, label: "Archives", description: "Projets terminés", disabled: false }, { token: 53, generation: 1, label: "Studio de design", description: "Systèmes UI et jetons", disabled: false }, { token: 67, generation: 1, label: "Ingénierie", description: "Architecture et versions", disabled: false }, { token: 81, generation: 1, label: "Marketing", description: "Campagnes et lancements", disabled: false }, { token: 95, generation: 1, label: "Labo de recherche", description: "Études utilisateurs", disabled: false }, { token: 109, generation: 1, label: "Communauté", description: "Discussions publiques", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Trouvez votre espace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Saisissez dans le champ en ligne pour filtrer les espaces, ou parcourez-les avec les flèches."; color: root.theme.text-secondary; wrap: word-wrap; }
        workspace := KitCombobox { theme: root.theme;
            label: "Espace de travail";
            placeholder: "Rechercher un espace…";
            clearable: true;
            options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Choisi : " + row.label; }

            query <=> root.query;
            search-state: SearchPresentation.ready;
            tab-navigation(reverse) => { return KitKeyResult.reject; }
        }
        selected-label-view := Text { text: "Espace accepté : " + workspace.selected-label; color: root.theme.text-primary; }
    }
}
