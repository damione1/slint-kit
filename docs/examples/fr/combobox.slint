import { KitMetrics, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
import { KitCombobox, KitTheme, KitThemes, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, SearchPresentation } from "@kit";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability }

export component Example inherits Window {
    in-out property <string> status;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint combobox";
    preferred-width: 480px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Personnel", description: "", disabled: false }, { token: 25, generation: 1, label: "Partagé", description: "", disabled: false }, { token: 39, generation: 1, label: "Archives", description: "", disabled: false }, { token: 53, generation: 1, label: "Studio de design", description: "", disabled: false }, { token: 67, generation: 1, label: "Ingénierie", description: "", disabled: false }, { token: 81, generation: 1, label: "Marketing", description: "", disabled: false }, { token: 95, generation: 1, label: "Labo de recherche", description: "", disabled: false }, { token: 109, generation: 1, label: "Communauté", description: "", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Trouvez votre espace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Recherchez parmi huit espaces ou parcourez-les avec les flèches."; color: root.theme.text-secondary; wrap: word-wrap; }
        workspace := KitCombobox { theme: root.theme;
            label: "Espace de travail";
            options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Choisi : " + row.label; }

            query <=> root.query;
            search-state: SearchPresentation.ready;
            tab-navigation(reverse) => { return reject; }
        }
        selected-label-view := Text { text: "Espace accepté : " + workspace.selected-label; color: root.theme.text-primary; }
    }
}
