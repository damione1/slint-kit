import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSlider, KitTheme, KitThemes, ChoiceDirection, SliderPresentation, FieldAccess } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitSlider — exemple";
    preferred-width: 420px;
    preferred-height: 540px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Curseur"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Volume · 65 %"; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; } KitSlider { theme: root.theme; label: "Volume"; position: 0.65; value-label: "65 %"; position-requested(value) => { root.status = "Position demandée"; } }
        Text { text: "Exposition · 40 %"; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; } KitSlider { theme: root.theme; presentation: SliderPresentation.filled; label: "Exposition"; position: 0.4; value-label: "40 %"; position-requested(value) => { root.status = "Exposition demandée"; } }
        HorizontalLayout { alignment: start; spacing: 24px;
            KitSlider { theme: root.theme; direction: ChoiceDirection.vertical; presentation: SliderPresentation.filled; height: 160px; label: "Gain"; position: 0.7; value-label: "70 %"; position-requested(value) => { root.status = "Gain demandé"; } }
            KitSlider { theme: root.theme; direction: ChoiceDirection.vertical; height: 160px; label: "Balance"; position: 0.5; value-label: "Centrée"; position-requested(value) => { root.status = "Balance demandée"; } }
        }
        KitSlider { theme: root.theme; label: "Échelle personnalisée indisponible"; presentation: SliderPresentation.filled; access: FieldAccess.disabled; position: 0.5; track-brush: root.theme.canvas; fill-brush: root.theme.text-secondary; handle-brush: root.theme.surface; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
