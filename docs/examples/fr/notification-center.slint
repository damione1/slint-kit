import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitNotificationCenter, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitNotificationCenter — exemple";
    preferred-width: 620px;
    preferred-height: 540px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Centre de notifications"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitNotificationCenter { dismiss-label: "Fermer"; empty-description: "Vous êtes à jour."; empty-label: "Aucune notification"; mark-read-label: "Marquer comme lu"; open-label: "Ouvrir l’aperçu"; read-label: "Lu"; theme: root.theme; height: 400px * root.theme.text-scale; rows: [{ item: { token: 11, generation: 1, label: "Darlene a partagé un document", description: "Les notes de recherche sont prêtes pour révision.", disabled: false }, read: false }, { item: { token: 23, generation: 1, label: "Votre exportation est prête", description: "Téléchargez la dernière archive du projet.", disabled: false }, read: true }, { item: { token: 38, generation: 1, label: "Angela a rejoint l’espace de travail", description: "Votre invitation a été acceptée.", disabled: false }, read: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
