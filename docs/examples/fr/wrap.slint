// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitTheme, KitThemes, KitWrap } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitWrap — exemple";
    preferred-width: 420px;
    preferred-height: 220px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Disposition avec retour à la ligne"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitWrap { KitButton { theme: root.theme; text: "Vue d’ensemble"; activated => { root.status = "Action demandée"; } }KitButton { theme: root.theme; text: "Activité"; activated => { root.status = "Action demandée"; } }KitButton { theme: root.theme; text: "Réglages"; activated => { root.status = "Action demandée"; } }KitButton { theme: root.theme; text: "Membres"; activated => { root.status = "Action demandée"; } }KitButton { theme: root.theme; text: "Réglages du projet"; activated => { root.status = "Action demandée"; } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
