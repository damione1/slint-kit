import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldError, ValidationTiming, KitSwitch, KitTheme, KitThemes, FieldAccess } from "@kit";

export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    default-font-family: InterFont.family;
    title: "KitSwitch — exemple";
    preferred-width: 360px;
    preferred-height: 220px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Interrupteur"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        field := KitSwitch { required: true; validation-timing: ValidationTiming.on-blur; theme: root.theme; label: "Notifications sur le bureau"; checked: true; toggled(value) => { root.status = value ? "Activation demandée" : "Désactivation demandée"; } }
        if field.error-visible: KitFieldError { theme: root.theme; text: field.validation-message; }
        KitSwitch { theme: root.theme; label: "Réglage géré"; checked: true; access: FieldAccess.read-only; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
