import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { AvatarShape, AvatarInteraction, KitAvatar, KitSurface, KitBadge, Tone, KitTheme, KitThemes } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Équipe et profils"; preferred-width: 580px; preferred-height: 380px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> status: "Sélectionnez le portrait d’Alex pour ouvrir son profil.";
    in-out property <string> demo-status;
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Un visage familier pour chaque profil"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        KitSurface { theme: root.theme;
            HorizontalLayout { spacing: 16px;
                KitAvatar { theme: root.theme; size: 72px; source: @image-url("../../quickstart/avatar/ui/assets/profile-portrait.jpg"); accessible-name: "Open Alex Morgan’s profile"; interaction: AvatarInteraction.action; activated => { root.demo-status = "Profile requested"; } }
                VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 6px;
                    Text { text: "Alex Morgan"; color: root.theme.text-primary; font-size: 18px * root.theme.text-scale; font-weight: 600; }
                    Text { text: "Designer produit · Montréal"; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                    KitBadge { theme: root.theme; tone: Tone.success; leading-icon: root.theme.icons.check; text: "Disponible pour collaborer"; }
                }
            }
        }
        HorizontalLayout { alignment: start; spacing: 16px;
            KitAvatar { theme: root.theme; initials: "AM"; accessible-name: "Alex Morgan initials"; size: 56px; }
            KitAvatar { theme: root.theme; initials: "JS"; accessible-name: "Jamie Smith initials"; shape: AvatarShape.rounded; size: 56px; }
            KitAvatar { theme: root.theme; source: @image-url("../../quickstart/avatar/ui/assets/profile-portrait.jpg"); accessible-name: "Alex Morgan portrait"; shape: AvatarShape.rounded; size: 56px; }
            KitAvatar { theme: root.theme; initials: "RK"; accessible-name: "Riley Kim initials"; shape: AvatarShape.square; size: 56px; }
        }
        Text { text: root.demo-status != "" ? root.demo-status : root.status; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; accessible-live-region: polite; }
    }
}
