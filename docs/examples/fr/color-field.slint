// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitColorField, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitColorField — exemple";
    preferred-width: 420px;
    preferred-height: 210px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Champ de couleur"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitColorField { theme: root.theme; label: "Couleur d’accent"; swatch: #6366f1; accepted-color: { red: 99, green: 102, blue: 241, alpha: 255 }; text: "#6366F1"; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
