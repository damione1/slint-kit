import { ColumnSourceMode, ColumnVisibility, KitKeyResult } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { CheckState, ColumnCeiling, ColumnSizing, DataAlignment, DataSortDirection, FieldAccess, HtmlInputKind, TableEditBlurPolicy, TableUnchangedEditPolicy, TableHeaderFocus, KitDataTable, KitTheme, KitThemes, NavigationStep, TableCellKind, Tone } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitDataTable example";
    preferred-width: 620px;
    preferred-height: 520px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    private property <int> active-row: 0;
    // Sortir entièrement la ligne éditée du viewport annule le brouillon sans confirmation.
    // Sauvegardez scroll-x/scroll-y puis restaurez avec set-scroll(x,y) ; scroll-to-index déplace le viewport sans sélectionner de ligne.
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Data Table"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitDataTable { edit-blur-policy: TableEditBlurPolicy.commit-or-drop; unchanged-edit-policy: TableUnchangedEditPolicy.skip; edit-started(row, column, generation) => { root.status = "Édition du responsable"; } edit-ended(row, column, generation, outcome, message) => { root.status = message != "" ? message : "Édition terminée"; } header-focus: TableHeaderFocus.roving; header-label: "En-têtes"; sort-requested(token) => { root.status = "Trier la colonne " + token; } key-event(event) => {return KitKeyResult.reject;} active-index: root.active-row; cursor-requested(row, column) => { root.active-row = row; } navigate(step) => { if (step == NavigationStep.first) { root.active-row = 0; } else if (step == NavigationStep.last) { root.active-row = self.rows.length - 1; } else if (step == NavigationStep.next || step == NavigationStep.page-next) { root.active-row = min(self.rows.length - 1, root.active-row + (step == NavigationStep.page-next ? self.page-rows : 1)); } else if (step == NavigationStep.previous || step == NavigationStep.page-previous) { root.active-row = max(0, root.active-row - (step == NavigationStep.page-previous ? self.page-rows : 1)); } } theme: root.theme; height: 370px; generation: 1; label: "Projets"; editable-label: "modifiable"; read-only-label: "lecture seule"; sort-ascending-label: "croissant"; sort-descending-label: "décroissant"; unnamed-row-label: "Ligne"; resize-label: "largeur"; columns: [{ token: 11, source: { mode: ColumnSourceMode.data-index, index: 0 }, visibility: ColumnVisibility.visible, label: "Project", sortable: true, sort: DataSortDirection.ascending, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fill, minimum: 200px, resizable: true } }, { token: 23, source: { mode: ColumnSourceMode.data-index, index: 1 }, visibility: ColumnVisibility.visible, label: "Status", sortable: true, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fixed, basis: 140px, minimum: 96px, ceiling: ColumnCeiling.bounded, maximum: 240px, resizable: true } }, { token: 38, source: { mode: ColumnSourceMode.data-index, index: 2 }, visibility: ColumnVisibility.visible, label: "Owner", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fixed, basis: 120px } }, { token: 47, source: { mode: ColumnSourceMode.data-index, index: 3 }, visibility: ColumnVisibility.visible, label: "Fait", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.center, width: { sizing: ColumnSizing.fixed, basis: 80px } }]; rows: [{ token: 101, content: [{ kind: TableCellKind.text, text: "Field notes" }, { kind: TableCellKind.badge, text: "In progress", tone: Tone.information }, { kind: TableCellKind.field, text: "Elliot", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Non fait", check: CheckState.unchecked }], selected: true, disabled: false }, { token: 205, content: [{ kind: TableCellKind.text, text: "Design system" }, { kind: TableCellKind.badge, text: "Review", tone: Tone.warning }, { kind: TableCellKind.field, text: "Darlene", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Partiellement fait", check: CheckState.mixed }], selected: false, disabled: false }, { token: 309, content: [{ kind: TableCellKind.text, text: "Launch plan" }, { kind: TableCellKind.badge, text: "Brouillon", tone: Tone.neutral }, { kind: TableCellKind.field, text: "Angela", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Non fait", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 413, content: [{ kind: TableCellKind.text, text: "Accessibility pass" }, { kind: TableCellKind.badge, text: "In progress", tone: Tone.information }, { kind: TableCellKind.field, text: "Noah", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Non fait", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 527, content: [{ kind: TableCellKind.text, text: "Research notes" }, { kind: TableCellKind.badge, text: "Prêt", tone: Tone.success }, { kind: TableCellKind.field, text: "Maya", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Fait", check: CheckState.checked }], selected: false, disabled: false }, { token: 641, content: [{ kind: TableCellKind.text, text: "Release checklist" }, { kind: TableCellKind.badge, text: "Brouillon", tone: Tone.neutral }, { kind: TableCellKind.field, text: "Theo", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Non fait", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 755, content: [{ kind: TableCellKind.text, text: "Onboarding" }, { kind: TableCellKind.badge, text: "Review", tone: Tone.warning }, { kind: TableCellKind.field, text: "Ines", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Partiellement fait", check: CheckState.mixed }], selected: false, disabled: false }, { token: 869, content: [{ kind: TableCellKind.text, text: "Project archive" }, { kind: TableCellKind.badge, text: "Terminé", tone: Tone.accent }, { kind: TableCellKind.field, text: "Leon", access: FieldAccess.editable, constrained: true, constraints: { kind: HtmlInputKind.text, required: true, min-length: -1, max-length: 40 } }, { kind: TableCellKind.check, text: "Fait", check: CheckState.checked }], selected: false, disabled: false }]; retry-requested => { root.status = "Nouvelle tentative demandée"; } activate(token, generation) => { root.status = "Project token " + token; } cell-committed(proposal) => { root.status = "Responsable de la ligne " + proposal.row + " validé : " + proposal.commit.value.text; } autosize-requested(token) => { root.status = "Ajuster la colonne " + token; } reorder-requested(source, target) => { root.status = "Déplacer la colonne " + source + " vers la colonne " + target; } resize-requested(token, width) => { root.status = "Colonne " + token + " redimensionnée à " + Math.round(width / 1px) + " px"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
