import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitRadioGroup, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitRadioGroup — exemple";
    preferred-width: 420px;
    preferred-height: 250px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Groupe de boutons radio"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitRadioGroup { width: 372px; theme: root.theme; options: [{ token: 11, label: "Courriel", disabled: false , generation: 1 , description: "" }, { token: 23, label: "Notification push", disabled: false , generation: 1 , description: "" }, { token: 38, label: "SMS", disabled: true , generation: 1 , description: "" }]; selected: { present: true, token: 11 };  chosen(row) => { root.status = "Choisi : " + row.label; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
