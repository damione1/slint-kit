import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitRating, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitRating — exemple";
    preferred-width: 560px;
    preferred-height: 170px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Notation"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitRating { theme: root.theme; label: "Votre note"; generation: 1; active-token: 4; scores: [{ token: 1, label: "1 étoile", selected: false, disabled: false }, { token: 2, label: "2 étoiles", selected: false, disabled: false }, { token: 3, label: "3 étoiles", selected: false, disabled: false }, { token: 4, label: "4 étoiles", selected: true, disabled: false }, { token: 5, label: "5 étoiles", selected: false, disabled: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
