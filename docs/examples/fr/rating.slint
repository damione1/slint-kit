import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

// SPDX-License-Identifier: GPL-3.0-or-later

import { KitFieldDescription, KitRating, KitStack, KitThemeContext, RatingView } from "@kit";
    // Les portées natives persistantes conservent le clavier quand le modèle d’options change.
export component Example inherits Window {
    default-font-family: InterFont.family;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Note"; preferred-width: 560px; preferred-height: 360px;
    background: KitThemeContext.current.canvas;
    in-out property <RatingView> rating-value: {present: true, step: 4, scale: 5};
    callback feedback-changed(RatingView);
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        KitRating { label: "Votre note"; scale: 5; value <=> root.rating-value; chosen(value) => { root.feedback-changed(value); } }
        KitFieldDescription { theme: root.theme; text: root.rating-value.present ? "Note : " + root.rating-value.step + " / " + root.rating-value.scale : "Aucune note"; } }
}
