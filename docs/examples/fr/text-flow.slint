import { InterFont } from "@kit-fonts/inter.slint";
import { KitTextFlow, KitStack, KitText, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    default-font-family: InterFont.family;
    in-out property <KitTheme> theme: KitThemes.light;
    preferred-width: 480px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in-out property <string> selection;
    KitStack {
        theme: root.theme; inset: regular;
        KitText { theme: root.theme; role: title; text: "Échantillons"; }
        KitTextFlow {
            theme: root.theme;
            fragments: [
                {item: {token: 17, generation: 1, label: "Érable"}, suffix: ", "},
                {item: {token: 4, generation: 1, label: "et", disabled: true}, suffix: " "},
                {item: {token: 31, generation: 1, label: "Hêtre"}, suffix: "."}
            ];
            activated(anchor) => { root.selection = anchor.token == 17 ? "Érable" : "Hêtre"; }
        }
        KitText { theme: root.theme; text: root.selection; }
    }
}
