import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCard, KitBadge, Tone, KitBreadcrumbs, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    in-out property <string> status;
    default-font-family: InterFont.family;
    title: "KitBreadcrumbs example";
    preferred-width: 520px;
    preferred-height: 310px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> interactive: true;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Overview", description: "", disabled: false }, { token: 25, generation: 1, label: "Activity", description: "", disabled: false }, { token: 39, generation: 1, label: "Settings", description: "", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        control := KitBreadcrumbs { interactive: root.interactive; theme: root.theme; options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Choisi : " + row.label; }  }
        KitCard { theme: root.theme;
            KitBadge { theme: root.theme; text: "ESPACE PROJET"; tone: Tone.accent; }
            Text { text: "Chaque chose à sa place"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { text: "Suivez le chemin pour retrouver une section parente sans perdre vos repères."; color: root.theme.text-secondary; wrap: word-wrap; }
        }
        result := Text { text: "Selected: " + control.selected-label; color: root.theme.text-secondary; }
    }

}
