import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldError, ValidationTiming, ChoiceRow, KitSelect, KitTheme, KitThemes, SelectionAvailability } from "@kit";

// Développer ouvre seulement ; l’activation ordinaire bascule. Un hôte contrôlé acquitte l’état demandé.
    // L’édition garde le focus natif ; les positions ne créent pas de relation active-descendant.
export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    default-font-family: InterFont.family;
    title: "KitSelect — exemple";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    // Marqueurs lisibles par l’hôte, liés aux jetons ; en contrôle, ils attendent selected acquitté.
    out property <[ChoiceRow]> projected-choice-rows: field.choice-rows;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Sélecteur"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        // Active explicitement la recherche native ; le nouveau défaut est searchable:false.
        // Appelez slint_kit::install une fois par fenêtre pour saisie native et sélection.
        field := KitSelect { searchable: true; focus-search-on-open: true; search-label: "Rechercher une vue"; empty-label: "Aucune vue correspondante"; required: true; validation-timing: ValidationTiming.on-blur; unavailable-label: "L’option sélectionnée est indisponible"; theme: root.theme; label: "Vue de l’espace"; placeholder: "Choisir une vue"; options: [{ token: 11, generation: 1, label: "Vue d’ensemble", description: "Résumé du projet", disabled: false }, { token: 23, generation: 1, label: "Activité", description: "Modifications récentes", disabled: false }, { token: 38, generation: 1, label: "Réglages", description: "Préférences du projet", disabled: false }]; selected: { present: true, token: 11 };  chosen(row) => { root.status = "Choisi : " + row.label; } }
        if field.error-visible: KitFieldError { theme: root.theme; text: field.validation-message; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
