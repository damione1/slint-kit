import { InterFont } from "@kit/fonts/inter.slint";
import { KitOtpField, FieldDecoration, KitTheme, KitThemes, FieldAccess, ValidationTiming, OtpAlphabet } from "@kit";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitOtpField";
    preferred-width: 480px; preferred-height: 570px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> code-complete;
    VerticalLayout {
        padding: 24px; spacing: 24px; alignment: start;
        KitOtpField {
            theme: root.theme; label: "Code vide, six emplacements";
            group-size: 3; slots: 6;
            completed(code) => { root.code-complete = true; }
            edited(code) => { root.code-complete = false; }
            description: root.code-complete ? "Code complet saisi" : "Six chiffres bruts ; copiez sans espace ni tiret.";
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Lettres et chiffres";
            slots: 6; alphabet: OtpAlphabet.ascii-alphanumeric; text: "ABC123";
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Code masqué (lecture seule)";
            slots: 6; text: "731952"; input-type: InputType.password; access: FieldAccess.read-only;
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Cellules natives groupées";
            slots: 7; pattern: "[A-Z]{2}[0-9]{5}"; text: "FG76657";
            group-size: 2;
            validation-timing: ValidationTiming.on-submit;
        }
    }
}
