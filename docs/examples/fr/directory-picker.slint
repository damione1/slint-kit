import { KitStrings } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
// Configurez titre, dossier initial et filtres fichier avec binding.set_request dans l’hôte Rust.
import { KitDirectoryPicker, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    // Signalez les erreurs, puis demandez séparément le focus sur un contrôle invalide.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    init => {
        KitStrings.file-choose-one = "Choisir un fichier…";
        KitStrings.file-choose-many = "Choisir des fichiers…";
        KitStrings.folder-choose = "Choisir un dossier…";
        KitStrings.folder-clear = "Effacer le dossier";
        KitStrings.file-remove = "Supprimer";
        KitStrings.file-list = "Fichiers sélectionnés";
        KitStrings.step-current = "étape actuelle";
        KitStrings.step-complete = "terminé";
        KitStrings.step-error = "erreur";
        KitStrings.step-pending = "en attente";
    }

    default-font-family: InterFont.family;
    title: "KitDirectoryPicker — exemple";
    preferred-width: 520px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Sélecteur de dossier"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        field := KitDirectoryPicker { theme: root.theme; label: "Dossier d’exportation"; selected-name: "Documents/Project exports"; browse-requested => { root.status = "Demande de dossier à l’hôte"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
