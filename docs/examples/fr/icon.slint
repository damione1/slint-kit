import { IconKind, KitIcon, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitIcon — exemple";
    preferred-width: 360px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Icône"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        HorizontalLayout { alignment: start; spacing: 24px; KitIcon { kind: IconKind.check; ink: root.theme.accent; } KitIcon { kind: IconKind.search; ink: root.theme.text-primary; } KitIcon { kind: IconKind.warning; ink: root.theme.warning; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
