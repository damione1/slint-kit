import { KitStrings } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSteps, KitTheme, KitThemes, StepState } from "@kit";

export component Example inherits Window {
    init => {
        KitStrings.steps-label = "Étapes";
        KitStrings.file-choose-one = "Choisir un fichier…";
        KitStrings.file-choose-many = "Choisir des fichiers…";
        KitStrings.folder-choose = "Choisir un dossier…";
        KitStrings.folder-clear = "Effacer le dossier";
        KitStrings.file-remove = "Supprimer";
        KitStrings.file-list = "Fichiers sélectionnés";
        KitStrings.step-current = "étape actuelle";
        KitStrings.step-complete = "terminé";
        KitStrings.step-error = "erreur";
        KitStrings.step-pending = "en attente";
    }

    default-font-family: InterFont.family;
    title: "KitSteps — exemple";
    preferred-width: 520px;
    preferred-height: 540px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Étapes"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitSteps { theme: root.theme; interactive: true; entries: [
            { token: 11, generation: 1, label: "Compte", description: "Identifiants et sécurité", state: StepState.complete, enabled: true },
            { token: 23, generation: 1, label: "Espace de travail", description: "Détails du projet", state: StepState.current, enabled: true },
            { token: 38, generation: 1, label: "Inviter l’équipe", description: "Disponible après la configuration", state: StepState.pending, enabled: false },
        ]; step-activated(token, generation) => { root.status = "Étape demandée : " + token; } }
        KitSteps { theme: root.theme; orientation: Orientation.horizontal; entries: [{ token: 11, label: "Compte", state: StepState.complete }, { token: 23, label: "Espace de travail", state: StepState.current }, { token: 38, label: "Inviter l’équipe", state: StepState.pending }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
