// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitCard, KitCardBody, KitCardFooter, KitCardHeader, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitCard — exemple";
    preferred-width: 480px;
    preferred-height: 300px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Carte"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitCard { theme: root.theme; KitCardHeader { theme: root.theme; title: "Notes de terrain"; description: "L’espace de recherche partagé de votre équipe."; } KitCardBody { Text { text: "Gardez les observations et les décisions au même endroit."; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; } } KitCardFooter { KitButton { theme: root.theme; text: "Ouvrir le projet"; activated => { root.status = "Action demandée"; } } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
