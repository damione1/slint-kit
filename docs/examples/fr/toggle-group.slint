import { KitTheme, KitThemeContext, KitThemes, KitMetrics, TypographyRole, KitToggleGroup, OptionRow, SelectionRef } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component Example inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Canaux de notification"; preferred-width: 560px; preferred-height: 440px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{token: 1, generation: 1, label: "Courriel"}, {token: 2, generation: 1, label: "Notification push"}, {token: 3, generation: 1, label: "SMS", disabled: true}];
    in-out property <[SelectionRef]> selected: [{present: true, token: 1}];
    callback membership-changed(OptionRow, bool);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Restez au courant"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Choisissez vos canaux de notification. Le courriel est sélectionné au départ ; les SMS sont indisponibles."; color: root.theme.text-secondary; wrap: word-wrap; }
        KitToggleGroup { theme: root.theme; options: root.options; selected <=> root.selected; selection-changed(row, added) => { root.membership-changed(row, added); } }
        Text { text: "Canaux sélectionnés : " + root.selected.length; color: root.theme.text-secondary; }
    }
}
