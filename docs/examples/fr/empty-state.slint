import { KitButton, KitEmptyState, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitEmptyState — exemple";
    preferred-width: 480px;
    preferred-height: 310px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "État vide"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitEmptyState { theme: root.theme; title: "Aucun projet pour le moment"; description: "Créez un projet pour commencer à rassembler vos idées."; KitButton { theme: root.theme; text: "Créer un projet"; activated => { root.status = "Action demandée"; } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
