import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

import { KitDateTimeField, LocalDateTimeView, KitStack, KitButton } from "@kit";
export component Example inherits Window {
    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    preferred-width: 600px; preferred-height: 460px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Date et heure locales";
    callback chosen(LocalDateTimeView);
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        control := KitDateTimeField { label: "Rendez-vous"; date-label: "Date du rendez-vous"; time-label: "Heure du rendez-vous"; date-description: "Date civile, sans fuseau horaire"; time-description: "Heure locale au format 24 heures"; date-text: "2026-10-17"; time-text: "09:30"; required: true; chosen(value) => { root.chosen(value); } }
        KitButton { text: "Appliquer"; activated => { control.commit(); } }
    }
}
