import { InterFont } from "@kit-fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { ButtonIntent, KitDialog, KitTextField, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitDialog — exemple";
    preferred-width: 560px;
    preferred-height: 420px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    KitDialog { close-label: "Fermer la boîte de dialogue"; theme: root.theme; width: parent.width; height: parent.height; title: "Archiver le projet"; description: "Vous pourrez le restaurer plus tard depuis les archives."; state: { open: true, topmost: true, busy: false }; actions: [{ token: 1, text: "Annuler", intent: ButtonIntent.secondary, disabled: false }, { token: 2, text: "Archiver le projet", intent: ButtonIntent.primary, disabled: false }]; action-activated(token) => { root.status = "Action demandée"; } KitTextField { character-count-label: "caractères"; checking-label: "Vérification…"; clear-label: "Effacer la recherche"; hide-label: "Masquer le mot de passe"; reveal-label: "Afficher le mot de passe"; theme: root.theme; label: "Nom du projet"; text: "Notes de terrain"; } if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; vertical-stretch: 0; } }
}
