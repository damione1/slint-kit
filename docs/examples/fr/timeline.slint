import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
// Display projections are fixtures. Validate accepted domain values in Rust.
import { KitTheme, KitThemes, KitTimeline, Tone } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitTimeline — exemple";
    preferred-width: 600px;
    preferred-height: 600px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Chronologie"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitTimeline { theme: root.theme; entries: [{ tone: Tone.accent, glyph: root.theme.icons.article, title: "Projet créé", description: "Elliot a ouvert l’espace de travail.", metadata: "09:00" }, { tone: Tone.success, glyph: root.theme.icons.check, title: "Recherche partagée", description: "Darlene a ajouté les notes d’entretien.", metadata: "09:30" }, { tone: Tone.warning, glyph: root.theme.icons.warning, title: "Prêt pour révision", description: "L’équipe peut laisser des commentaires.", metadata: "10:15" }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
