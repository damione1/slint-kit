import { InterFont } from "@kit-fonts/inter.slint";
import { KitCard, KitKeycap, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Touche";
    preferred-width: 480px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;

    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Les raccourcis, en touches"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Une touche nomme l’accord à côté de l’action qu’il déclenche."; color: root.theme.text-secondary; wrap: word-wrap; }
        KitCard { theme: root.theme;
            HorizontalLayout { spacing: 8px; alignment: start; KitKeycap { theme: root.theme; text: "⌘ K"; } Text { text: "Ouvrir la palette de commandes"; color: root.theme.text-primary; vertical-alignment: center; } }
            HorizontalLayout { spacing: 8px; alignment: start; KitKeycap { theme: root.theme; text: "⌥ Espace"; } KitKeycap { theme: root.theme; text: "Échap"; } Text { text: "Démarrer la dictée, puis annuler"; color: root.theme.text-primary; vertical-alignment: center; } }
            HorizontalLayout { spacing: 8px; alignment: start; KitKeycap { theme: root.theme; text: "⇧ ⌘ P"; } Text { text: "Changer de projet"; color: root.theme.text-primary; vertical-alignment: center; } }
        }
    }
}
