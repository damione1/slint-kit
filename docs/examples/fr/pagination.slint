import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitPagination, PaginationDisplay, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitPagination — exemple";
    preferred-width: 760px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> interactive: true;
    in-out property <string> status;
    // L’hôte peut lire la position localisée ; une surcharge doit suivre la page/diapositive courante.
    out property <string> current-position: control.position-label;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Pagination"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        control := KitPagination { accessible-name: "Pagination"; interactive: root.interactive; next-label: "Suivant"; previous-label: "Précédent"; first-label: "Première"; last-label: "Dernière"; page-label-template: "Page {page}"; theme: root.theme; page-index: 2; page-count: 12; display: PaginationDisplay.numbered; show-first-last: true; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
