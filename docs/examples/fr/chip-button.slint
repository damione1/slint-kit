import { InterFont } from "@kit/fonts/inter.slint";
import { LucideIcons } from "@kit/icons/lucide/all.slint";
import { KitChipButton, KitTheme, KitThemes, KitMetrics, Tone, TypographyRole } from "@kit/kit.slint";
// A closed set the code owns: one variant per filter.
enum OrderFilter { all, awaiting-shipment, in-transit, delayed, returned }
export component Example inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Bouton pastille";
    preferred-width: 560px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    in-out property <OrderFilter> active: OrderFilter.awaiting-shipment;
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Filtrer la file"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Chaque pastille affiche une partie des commandes. La pastille sélectionnée prend la tonalité de son statut."; color: root.theme.text-secondary; wrap: word-wrap; }
        FlexboxLayout { spacing: root.theme.spacing.unit * 2; flex-wrap: wrap; alignment: start;
            KitChipButton { theme: root.theme; label: "Toutes les commandes"; glyph: LucideIcons.inbox(); tone: Tone.accent; selected: root.active == OrderFilter.all; activated => { root.active = OrderFilter.all; } }
            KitChipButton { theme: root.theme; label: "À expédier"; glyph: LucideIcons.package(); tone: Tone.information; selected: root.active == OrderFilter.awaiting-shipment; activated => { root.active = OrderFilter.awaiting-shipment; } }
            KitChipButton { theme: root.theme; label: "En transit"; glyph: LucideIcons.truck(); tone: Tone.success; selected: root.active == OrderFilter.in-transit; activated => { root.active = OrderFilter.in-transit; } }
            KitChipButton { theme: root.theme; label: "En retard"; glyph: LucideIcons.clock(); tone: Tone.warning; selected: root.active == OrderFilter.delayed; activated => { root.active = OrderFilter.delayed; } }
            KitChipButton { theme: root.theme; label: "Retournées"; tone: Tone.danger; selected: root.active == OrderFilter.returned; activated => { root.active = OrderFilter.returned; } }
        }
    }
}
