import { InterFont } from "@kit/fonts/inter.slint";
// Public label overrides localize this fixture; toolkit/host defaults keep their language.
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitTheme, KitThemes, KitVirtualTextView } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitVirtualTextView — exemple";
    preferred-width: 620px;
    preferred-height: 360px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Vue de texte virtualisée"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitVirtualTextView { label: "Document texte"; theme: root.theme; height: 230px; generation: 1; lines: [{ token: 101, number: 1, text: "# Notes de terrain", selected: false }, { token: 205, number: 2, text: "Un espace partagé pour les observations.", selected: true }, { token: 309, number: 3, text: "Préservez les identités lorsque les lignes changent de position.", selected: false }, { token: 413, number: 4, text: "Utilisez l’édition native pour les lignes sélectionnées.", selected: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
