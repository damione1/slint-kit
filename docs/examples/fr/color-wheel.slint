import { KitColorWheel, KitTheme, KitThemeContext, KitThemes, SrgbColorView } from "@kit";
export component Example inherits Window {
    in-out property <KitTheme> theme: KitThemes.light;
    changed theme => { KitThemeContext.current = root.theme; }
    preferred-width: 300px * root.theme.text-scale; preferred-height: 340px * root.theme.text-scale;
    max-width: 100000px; max-height: 100000px;
    private property <SrgbColorView> draft: {red:124,green:108,blue:240,alpha:255};
    VerticalLayout {
        KitColorWheel { theme: root.theme; label: "Couleur d’accent"; unknown-label: "Couleur inconnue"; value-format: "Teinte {hue}°, saturation {saturation} %"; value: root.draft; chosen(value) => { root.draft = value; } }
    }
}
