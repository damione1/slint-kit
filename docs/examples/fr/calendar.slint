import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole, KitStack } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

import { KitCalendar, CivilDateView, WeekStart, CalendarOutsideDays, CalendarWeekRows } from "@kit";
export component Example inherits Window {
    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    preferred-width: 600px; preferred-height: 460px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Calendrier";
    callback chosen(CivilDateView);
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        KitCalendar {
            // Suit le sens de la fenêtre ; un flow explicite peut remplacer celui du thème.
            flow: root.theme.direction;
            today: {year: 2026, month: 10, day: 19};
            configuration-message: "Vérifiez les dates et les bornes du calendrier.";
            // Les noms restent lundi en premier même si la semaine commence dimanche.
            week-start: WeekStart.sunday;
            // Défaut corrigé : jours adjacents atténués, avec six semaines conservées.
            outside-days: CalendarOutsideDays.dim;
            week-rows: CalendarWeekRows.fixed;
            // Les noms de formatage sont distincts des initiales visibles weekdays.
            month-short-names: ["Janv.", "Févr.", "Mars", "Avr.", "Mai", "Juin", "Juil.", "Août", "Sept.", "Oct.", "Nov.", "Déc."];
            weekday-names: ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"];
            weekday-short-names: ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."];
            accessible-date-pattern: "%A %-d %B %Y"; title-pattern: "%B %Y";
            today-label: "Aujourd’hui"; range-start-label: "Début de période";
            range-end-label: "Fin de période"; in-range-label: "Dans la période sélectionnée";
            month-names: ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
            weekdays: ["L", "M", "M", "J", "V", "S", "D"];
            previous-month-label: "Mois précédent"; next-month-label: "Mois suivant";
            selected: {year: 2026, month: 10, day: 19};
            min: "2026-10-01"; max: "2027-12-31";
            unavailable-weekdays: [WeekStart.saturday, WeekStart.sunday];
            unavailable-ranges: [{start: {year: 2026, month: 10, day: 13}, end: {year: 2026, month: 10, day: 15}}];
            chosen(date) => { root.chosen(date); }
        }
    }
}
