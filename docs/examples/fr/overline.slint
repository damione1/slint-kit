import { InterFont } from "@kit-fonts/inter.slint";
import { KitCard, KitOverline, KitText, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Surtitre";
    preferred-width: 480px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;

    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Réglages, groupés par libellé"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Un surtitre nomme un groupe de lignes ; le libellé garde sa casse naturelle."; color: root.theme.text-secondary; wrap: word-wrap; }
        KitCard { theme: root.theme;
            VerticalLayout { spacing: 4px; KitOverline { theme: root.theme; label: "Calendriers"; } KitText { theme: root.theme; text: "Tous les calendriers sont inclus ; décochez ceux à masquer."; } }
            VerticalLayout { spacing: 4px; KitOverline { theme: root.theme; label: "Notifications"; } KitText { theme: root.theme; text: "Choisissez les alertes que vous recevez."; } }
        }
    }
}
