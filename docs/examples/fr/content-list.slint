import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { NavigationStep, KitContentList, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitContentList example";
    preferred-width: 620px;
    preferred-height: 580px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    in-out property <int> active-row: 0;
    // Sauvegardez scroll-x/scroll-y puis restaurez avec set-scroll(x,y) ; scroll-to-index déplace le viewport sans sélectionner de ligne.
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Content List"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitContentList { active-index: root.active-row; navigate(step) => { if (step == NavigationStep.first) { root.active-row = 0; } else if (step == NavigationStep.last) { root.active-row = self.items.length - 1; } else if (step == NavigationStep.next || step == NavigationStep.page-next) { root.active-row = min(self.items.length - 1, root.active-row + (step == NavigationStep.page-next ? self.page-rows : 1)); } else if (step == NavigationStep.previous || step == NavigationStep.page-previous) { root.active-row = max(0, root.active-row - (step == NavigationStep.page-previous ? self.page-rows : 1)); } }  theme: root.theme; height: 420px * root.theme.text-scale; generation: 1; items: [{ token: 101, title: "A guide to native design", excerpt: "Build interfaces that feel at home on the desktop.", metadata: "Design · 5 min read", link-label: "Read article", selected: false, disabled: false }, { token: 205, title: "Keep domain values exact", excerpt: "Use validated values and stable application identity.", metadata: "Engineering · 8 min read", link-label: "Read article", selected: false, disabled: false }, { token: 309, title: "Accessible controls", excerpt: "Preserve keyboard navigation and clear focus states.", metadata: "Accessibility · 6 min read", link-label: "Read article", selected: false, disabled: false }, { token: 413, title: "Make the theme your own", excerpt: "Bring your brand to surfaces and typography.", metadata: "Design · 6 min read", link-label: "Read article", selected: false, disabled: false }, { token: 527, title: "Build a better form", excerpt: "Help every user finish with clear labels and recovery paths.", metadata: "Engineering · 8 min read", link-label: "Read article", selected: false, disabled: false }, { token: 641, title: "From prototype to desktop", excerpt: "Package your native app for the people who use it.", metadata: "Getting started · 5 min read", link-label: "Read article", selected: false, disabled: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
