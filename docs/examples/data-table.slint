import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { CheckState, ColumnCeiling, ColumnSizing, DataAlignment, DataSortDirection, KitDataTable, KitTheme, KitThemes, TableCellKind, Tone } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitDataTable example";
    preferred-width: 620px;
    preferred-height: 520px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Data Table"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitDataTable { theme: root.theme; height: 370px; generation: 1; label: "Projects"; sort-ascending-label: "ascending"; sort-descending-label: "descending"; resize-label: "width"; columns: [{ token: 11, label: "Project", sortable: true, sort: DataSortDirection.ascending, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fill, minimum: 200px, resizable: true } }, { token: 23, label: "Status", sortable: true, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fixed, basis: 140px, minimum: 96px, ceiling: ColumnCeiling.bounded, maximum: 240px, resizable: true } }, { token: 38, label: "Owner", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading, width: { sizing: ColumnSizing.fixed, basis: 120px } }, { token: 47, label: "Done", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.center, width: { sizing: ColumnSizing.fixed, basis: 80px } }]; rows: [{ token: 101, content: [{ kind: TableCellKind.text, text: "Field notes" }, { kind: TableCellKind.badge, text: "In progress", tone: Tone.information }, { kind: TableCellKind.text, text: "Elliot" }, { kind: TableCellKind.check, text: "Not done", check: CheckState.unchecked }], selected: true, disabled: false }, { token: 205, content: [{ kind: TableCellKind.text, text: "Design system" }, { kind: TableCellKind.badge, text: "Review", tone: Tone.warning }, { kind: TableCellKind.text, text: "Darlene" }, { kind: TableCellKind.check, text: "Partly done", check: CheckState.mixed }], selected: false, disabled: false }, { token: 309, content: [{ kind: TableCellKind.text, text: "Launch plan" }, { kind: TableCellKind.badge, text: "Draft", tone: Tone.neutral }, { kind: TableCellKind.text, text: "Angela" }, { kind: TableCellKind.check, text: "Not done", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 413, content: [{ kind: TableCellKind.text, text: "Accessibility pass" }, { kind: TableCellKind.badge, text: "In progress", tone: Tone.information }, { kind: TableCellKind.text, text: "Noah" }, { kind: TableCellKind.check, text: "Not done", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 527, content: [{ kind: TableCellKind.text, text: "Research notes" }, { kind: TableCellKind.badge, text: "Ready", tone: Tone.success }, { kind: TableCellKind.text, text: "Maya" }, { kind: TableCellKind.check, text: "Done", check: CheckState.checked }], selected: false, disabled: false }, { token: 641, content: [{ kind: TableCellKind.text, text: "Release checklist" }, { kind: TableCellKind.badge, text: "Draft", tone: Tone.neutral }, { kind: TableCellKind.text, text: "Theo" }, { kind: TableCellKind.check, text: "Not done", check: CheckState.unchecked }], selected: false, disabled: false }, { token: 755, content: [{ kind: TableCellKind.text, text: "Onboarding" }, { kind: TableCellKind.badge, text: "Review", tone: Tone.warning }, { kind: TableCellKind.text, text: "Ines" }, { kind: TableCellKind.check, text: "Partly done", check: CheckState.mixed }], selected: false, disabled: false }, { token: 869, content: [{ kind: TableCellKind.text, text: "Project archive" }, { kind: TableCellKind.badge, text: "Complete", tone: Tone.accent }, { kind: TableCellKind.text, text: "Leon" }, { kind: TableCellKind.check, text: "Done", check: CheckState.checked }], selected: false, disabled: false }]; activate(token, generation) => { root.status = "Project token " + token; } resize-requested(token, width) => { root.status = "Column " + token + " resized to " + Math.round(width / 1px) + " px"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
