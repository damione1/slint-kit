import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { DataAlignment, DataSortDirection, KitDataTable, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitDataTable example";
    preferred-width: 620px;
    preferred-height: 520px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Data Table"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitDataTable { theme: root.theme; height: 370px; generation: 1; columns: [{ token: 11, label: "Project", sortable: true, sort: DataSortDirection.ascending, alignment: DataAlignment.leading }, { token: 23, label: "Status", sortable: true, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading }, { token: 38, label: "Owner", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading }]; rows: [{ token: 101, cells: ["Field notes", "In progress", "Elliot"], selected: true, disabled: false }, { token: 205, cells: ["Design system", "Review", "Darlene"], selected: false, disabled: false }, { token: 309, cells: ["Launch plan", "Draft", "Angela"], selected: false, disabled: false }, { token: 413, cells: ["Accessibility pass", "In progress", "Noah"], selected: false, disabled: false }, { token: 527, cells: ["Research notes", "Ready", "Maya"], selected: false, disabled: false }, { token: 641, cells: ["Release checklist", "Draft", "Theo"], selected: false, disabled: false }, { token: 755, cells: ["Onboarding", "Review", "Ines"], selected: false, disabled: false }, { token: 869, cells: ["Project archive", "Complete", "Leon"], selected: false, disabled: false }]; activate(token, generation) => { root.status = "Project token " + token; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
