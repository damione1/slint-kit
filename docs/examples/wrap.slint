import { KitButton, KitTheme, KitThemes, KitWrap } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitWrap example";
    preferred-width: 420px;
    preferred-height: 220px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Wrap"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitWrap { KitButton { theme: root.theme; text: "Overview"; activated => { root.status = "Action requested"; } }KitButton { theme: root.theme; text: "Activity"; activated => { root.status = "Action requested"; } }KitButton { theme: root.theme; text: "Settings"; activated => { root.status = "Action requested"; } }KitButton { theme: root.theme; text: "Members"; activated => { root.status = "Action requested"; } }KitButton { theme: root.theme; text: "Project settings"; activated => { root.status = "Action requested"; } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
