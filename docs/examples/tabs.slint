import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCard, KitBadge, Tone, KitTabs, KitProgress, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    in-out property <string> status;
    default-font-family: InterFont.family;
    title: "KitTabs example";
    preferred-width: 520px;
    preferred-height: 490px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> interactive: true;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Overview", description: "", disabled: false }, { token: 25, generation: 1, label: "Activity", description: "", disabled: false }, { token: 39, generation: 1, label: "Settings", description: "", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Studio workspace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        control := KitTabs { interactive: root.interactive;
            theme: root.theme; options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Chosen: " + row.label; }
        }
        KitCard { theme: root.theme;
            KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: control.selected.token == 11 ? "PROJECT SNAPSHOT" : control.selected.token == 25 ? "LATEST UPDATES" : "PREFERENCES"; tone: Tone.accent; }
            Text { text: control.selected.token == 11 ? "A clearer view of what’s next" : control.selected.token == 25 ? "Good work is happening" : "A workspace that fits you"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { text: control.selected.token == 11 ? "The autumn collection is taking shape. Research is complete, prototypes are ready, and the team is preparing its next design review." : control.selected.token == 25 ? "Today · Elliot shared the updated prototypes.\nYesterday · Darlene completed the accessibility review.\nMonday · Angela added three research notes." : "Notifications · Email and desktop enabled\nVisibility · Shared with your team\nLanguage · English"; color: root.theme.text-secondary; wrap: word-wrap; }
            Text { text: control.selected.token == 11 ? "8 tasks completed    ·    3 people collaborating" : control.selected.token == 25 ? "All changes are saved in your workspace." : "Your choices stay with this workspace."; color: root.theme.accent; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            if control.selected.token == 11: KitProgress { theme: root.theme; label: "Milestone progress"; value: 0.65; }
        }
        result := Text { text: "Selected: " + control.selected-label; color: root.theme.text-secondary; }
    }

}
