import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCarousel, KitBadge, Tone, KitProgress, KitTheme, KitThemes, SelectionAvailability } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitCarousel example";
    preferred-width: 600px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> interactive: true;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Carousel"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitCarousel { interactive: root.interactive; theme: root.theme; options: [{ token: 11, generation: 1, label: "Alpine morning", description: "A quiet trail, an open sky, and a little room to think.", disabled: false }, { token: 23, generation: 1, label: "Desert light", description: "Find fresh perspective in the warm light of the desert.", disabled: false }, { token: 38, generation: 1, label: "Coastal calm", description: "Slow down by the water and make space for your next idea.", disabled: false }]; selected: { present: true, token: 11 };  chosen(row) => { root.status = "Chosen: " + row.label; } Rectangle { height: 170px; background: root.theme.accent; border-radius: root.theme.shape.radius-container; Text { text: "A little room to breathe."; color: root.theme.on-accent; font-size: 26px * root.theme.text-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
