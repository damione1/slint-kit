import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitButtonGroup, KitTheme, KitThemes, ButtonIntent } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitButtonGroup example";
    preferred-width: 520px;
    preferred-height: 300px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Button Group"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitButtonGroup { theme: root.theme; accessible-name: "Navigation"; wrap: true;
            KitButton { theme: root.theme; text: "Back"; activated => { root.status = "Action requested"; } }
            KitButton { theme: root.theme; text: "Next"; activated => { root.status = "Action requested"; } }
        }
        KitButtonGroup { theme: root.theme; accessible-name: "Document commands"; attached: true; actions: [
            { token: 11, generation: 1, text: "Save", intent: ButtonIntent.outline },
            { token: 23, generation: 1, text: "Export", intent: ButtonIntent.outline }
        ]; activated(token, generation) => { root.status = "Action requested: " + token; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
