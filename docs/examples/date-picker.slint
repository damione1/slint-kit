import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole, KitStack } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

import { KitDatePicker, CivilDateView, WeekStart, CalendarOutsideDays, CalendarWeekRows } from "@kit";
export component Example inherits Window {
    // Report errors first; request focus separately for one invalid control.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    preferred-width: 600px; preferred-height: 460px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Date picker";
    callback chosen(CivilDateView);
    callback cleared();
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        field := KitDatePicker {
            // Use the window reading direction; an explicit flow can override the theme.
            flow: root.theme.direction;
            today: {year: 2026, month: 10, day: 19};
            clearable: true; clear-label: "Clear date";
            configuration-message: "Check calendar dates and bounds.";
            // Names stay Monday-first even when the week begins on Sunday.
            week-start: WeekStart.sunday;
            // Corrected default: adjacent-month days are dimmed; the grid keeps six weeks.
            outside-days: CalendarOutsideDays.dim;
            week-rows: CalendarWeekRows.fixed;
            // Formatting names are independent of the short visible weekday labels.
            month-short-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            weekday-names: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
            weekday-short-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
            accessible-date-pattern: "%A %-d %B %Y"; title-pattern: "%B %Y";
            today-label: "Today"; range-start-label: "Range start";
            range-end-label: "Range end"; in-range-label: "In selected range";
            label: "Appointment";
            accepted-date: {year: 2026, month: 10, day: 19};
            min: "2026-10-01"; max: "2027-12-31";
            unavailable-weekdays: [WeekStart.saturday, WeekStart.sunday];
            unavailable-ranges: [{start: {year: 2026, month: 10, day: 13}, end: {year: 2026, month: 10, day: 15}}];
            chosen(date) => { root.chosen(date); }
            cleared => { root.cleared(); }
        }
    }
}
