import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldError, ValidationTiming, ChoiceRow, KitSelect, DropdownPlacement, KitTheme, KitThemes, SelectionAvailability } from "@kit";

// Accessible Expand opens only; ordinary activation still toggles. Controlled owners acknowledge the requested state.
    // Native editing keeps focus; option positions do not imply an active-descendant relation.
export component Example inherits Window {
    // Report errors first; request focus separately for one invalid control.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    default-font-family: InterFont.family;
    title: "KitSelect example";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    // Host-readable markers are matched by token; controlled markers wait for selected acknowledgement.
    out property <[ChoiceRow]> projected-choice-rows: field.choice-rows;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Select"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        // Opt into native search; this component now defaults to searchable:false.
        // Call slint_kit::install once per window for native input and selection services.
        field := KitSelect { placement: DropdownPlacement.auto; popup-width: 320px; searchable: true; focus-search-on-open: true; search-label: "Search views"; empty-label: "No matching views"; required: true; validation-timing: ValidationTiming.on-blur; theme: root.theme; label: "Workspace view"; placeholder: "Choose a view"; options: [{ token: 11, generation: 1, label: "Overview", description: "Project summary", disabled: false }, { token: 23, generation: 1, label: "Activity", description: "Recent changes", disabled: false }, { token: 38, generation: 1, label: "Settings", description: "Project preferences", disabled: false }]; selected: { present: true, token: 11 }; clearable: true; items: [{ token: 23, trailing-text: "New" }]; cleared => { root.status = "Selection cleared"; }  chosen(row) => { root.status = "Chosen: " + row.label; } }
        if field.error-visible: KitFieldError { theme: root.theme; text: field.validation-message; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
