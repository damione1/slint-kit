import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitRangeSlider, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitRangeSlider example";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Range Slider"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Price range · $20–$75"; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; } KitRangeSlider { theme: root.theme; label: "Price range"; lower-position: 0.2; upper-position: 0.75; lower-label: "$20"; upper-label: "$75"; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
