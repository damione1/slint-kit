// SPDX-License-Identifier: GPL-3.0-or-later
import { InterFont } from "@kit-fonts/inter.slint";
import { KitButton, KitText, KitTextFlow, KitTextField, KitPopover, KitStack, KitInline, KitScrollArea,
    KitTheme, KitThemes, KitSelectionService, TextFragment, PopoverAnchor, PopoverTicket, CloseReason } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    preferred-width: 640px; preferred-height: 540px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    in-out property <bool> second-document;
    in property <bool> route-active: true;
    in property <[TextFragment]> fragments: root.second-document ? [
        {item: {token: 100, generation: 2, label: "Vermilion", disabled: false}, suffix: ", "},
        {item: {token: 101, generation: 2, label: "ultramarine", disabled: false}, suffix: " "},
        {item: {token: 102, generation: 2, label: "and", disabled: true}, suffix: " "},
        {item: {token: 103, generation: 2, label: "saffron", disabled: false}, suffix: " "},
        {item: {token: 104, generation: 2, label: "form", disabled: false}, suffix: " "},
        {item: {token: 105, generation: 2, label: "a", disabled: true}, suffix: " "},
        {item: {token: 106, generation: 2, label: "study", disabled: false}, suffix: " "},
        {item: {token: 107, generation: 2, label: "of", disabled: true}, suffix: " "},
        {item: {token: 108, generation: 2, label: "interdisciplinarychromatography", disabled: false}, suffix: ". "},
        {item: {token: 109, generation: 2, label: "Each", disabled: false}, suffix: " "},
        {item: {token: 110, generation: 2, label: "sample", disabled: false}, suffix: " "},
        {item: {token: 111, generation: 2, label: "carries", disabled: false}, suffix: " "},
        {item: {token: 112, generation: 2, label: "a", disabled: true}, suffix: " "},
        {item: {token: 113, generation: 2, label: "handwritten", disabled: false}, suffix: " "},
        {item: {token: 114, generation: 2, label: "annotation", disabled: false}, suffix: ". "}
    ] : [
        {item: {token: 10, generation: 1, label: "Heather", disabled: false}, suffix: ", "},
        {item: {token: 11, generation: 1, label: "ferns", disabled: false}, suffix: " "},
        {item: {token: 12, generation: 1, label: "and", disabled: true}, suffix: " "},
        {item: {token: 13, generation: 1, label: "lichens", disabled: false}, suffix: " "},
        {item: {token: 14, generation: 1, label: "cover", disabled: false}, suffix: " "},
        {item: {token: 15, generation: 1, label: "the", disabled: true}, suffix: " "},
        {item: {token: 16, generation: 1, label: "rocks", disabled: false}, suffix: " "},
        {item: {token: 17, generation: 1, label: "by", disabled: true}, suffix: " "},
        {item: {token: 18, generation: 1, label: "the", disabled: true}, suffix: " "},
        {item: {token: 19, generation: 1, label: "sea", disabled: true}, suffix: ". "},
        {item: {token: 20, generation: 1, label: "After", disabled: false}, suffix: " "},
        {item: {token: 21, generation: 1, label: "rain", disabled: false}, suffix: ", "},
        {item: {token: 22, generation: 1, label: "their", disabled: false}, suffix: " "},
        {item: {token: 23, generation: 1, label: "colours", disabled: false}, suffix: " "},
        {item: {token: 24, generation: 1, label: "change", disabled: false}, suffix: " "},
        {item: {token: 25, generation: 1, label: "in", disabled: true}, suffix: " "},
        {item: {token: 26, generation: 1, label: "the", disabled: true}, suffix: " "},
        {item: {token: 27, generation: 1, label: "morning", disabled: false}, suffix: " "},
        {item: {token: 28, generation: 1, label: "light", disabled: false}, suffix: ". "}
    ];
    in-out property <string> heading;
    in-out property <string> note;
    in-out property <string> status;
    out property <PopoverTicket> ticket: editor.ticket;
    in-out property <length> document-offset <=> scroller.content-y;
    out property <bool> editing: editor.open;
    callback saved(PopoverTicket, string, string);
    callback opened();
    callback dismissed(CloseReason);
    callback focus-returned(PopoverTicket);

    public function edit(anchor: PopoverAnchor) -> bool {
        if (!editor.show-at(anchor)) { return false; }
        root.heading = KitSelectionService.source(KitSelectionService.fragment-options(root.fragments), anchor.token).label;
        root.note = "";
        return true;
    }
    public function save(proposal: PopoverTicket) -> bool {
        let heading = root.heading;
        let note = root.note;
        if (heading == "" || !editor.finish(proposal)) { return false; }
        root.status = heading;
        root.saved(proposal, heading, note);
        return true;
    }
    public function cancel() { editor.dismiss(CloseReason.programmatic); }
    KitStack {
        theme: root.theme; inset: regular; alignment: stretch; vertical-stretch: 1; visible: root.route-active;
        document-switch := KitButton {
            theme: root.theme; text: root.second-document ? "Previous notebook" : "Next notebook";
            activated => { root.second-document = !root.second-document; }
        }
        KitText { theme: root.theme; role: title; text: root.second-document ? "Colour atlas" : "Coastal herbarium"; }
        scroller := KitScrollArea {
            theme: root.theme; inset: tight;
            paragraph := KitTextFlow {
                theme: root.theme; enabled: root.route-active; fragments: root.fragments;
                activated(anchor) => { root.edit(anchor); }
            }
        }
        KitButton { theme: root.theme; text: "Mark as read"; activated => { root.status = "Notebook read"; } }
        if root.status != "": KitText { theme: root.theme; text: root.status; }
    }
    editor := KitPopover {
        x: 0px; y: 0px; width: 0px; height: 0px;
        trigger-kind: external; theme: root.theme; disabled: !root.route-active;
        viewport: {width: root.width, height: root.height};
        popup-width: 310px * root.theme.text-scale;
        popup-height: root.height;
        anchor-available(token, generation) => { return paragraph.available(token, generation); }
        restore-focus(origin) => {
            root.focus-returned(origin);
            if (!editor.open && root.route-active && !paragraph.focus-fragment(origin.token, origin.generation)) {
                document-switch.take-focus();
            }
        }
        opened => { root.opened(); }
        dismissed(reason) => { root.dismissed(reason); }
        KitStack {
            theme: root.theme; gap: compact;
            KitTextField { theme: root.theme; accessible-name: "Heading"; placeholder: "Heading"; text <=> root.heading;
                commit-requested => { root.save(editor.ticket); } }
            KitTextField { theme: root.theme; accessible-name: "Annotation"; placeholder: "Annotation"; text <=> root.note;
                commit-requested => { root.save(editor.ticket); } }
            KitInline {
                theme: root.theme; gap: compact;
                KitButton { theme: root.theme; text: "Cancel"; activated => { root.cancel(); } }
                KitButton { theme: root.theme; text: "Save"; intent: primary;
                    disabled: root.heading == "" || !paragraph.available(editor.ticket.token, editor.ticket.generation);
                    activated => { root.save(editor.ticket); } }
            }
        }
    }
}
