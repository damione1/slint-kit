import { InterFont } from "@kit/fonts/inter.slint";
import { KitOtpField, FieldDecoration, KitTheme, KitThemes, FieldAccess, ValidationTiming } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitOtpField";
    preferred-width: 480px; preferred-height: 570px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    VerticalLayout {
        padding: 24px; spacing: 24px; alignment: start;
        KitOtpField {
            theme: root.theme; label: "Empty code, six available slots";
            decoration: FieldDecoration.underlined; slots: 6;
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Letters and digits";
            slots: 6; pattern: "[A-Za-z0-9]*"; text: "ABC123";
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Masked code (read-only)";
            slots: 6; text: "731952"; input-type: InputType.password; access: FieldAccess.read-only;
            validation-timing: ValidationTiming.on-submit;
        }
        KitOtpField {
            theme: root.theme; label: "Grouped display at rest";
            slots: 7; pattern: "[A-Z]{2}[0-9]{5}"; text: "FG76657";
            text-letter-spacing: 0px; text-inset: 0px;
            display-text: self.text == "FG76657" ? "FG‑76657" : self.text;
            validation-timing: ValidationTiming.on-submit;
        }
    }
}
