import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { AvatarShape, AvatarInteraction, KitAvatar, KitSurface, KitBadge, Tone, KitTheme, KitThemes } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "People and profiles"; preferred-width: 580px; preferred-height: 380px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> status: "Select Elliot’s portrait to open the profile.";
    in-out property <string> demo-status;
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "A familiar face for every profile"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        KitSurface { theme: root.theme;
            HorizontalLayout { spacing: 16px;
                KitAvatar { theme: root.theme; size: 72px; source: @image-url("../quickstart/avatar/ui/assets/fsociety-mask.jpg"); accessible-name: "Open Elliot Alderson’s profile"; interaction: AvatarInteraction.action; activated => { root.demo-status = "Profile requested"; } }
                VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 6px;
                    Text { text: "Elliot Alderson"; color: root.theme.text-primary; font-size: 18px * root.theme.text-scale; font-weight: 600; }
                    Text { text: "Security engineer · Allsafe"; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                    KitBadge { theme: root.theme; tone: Tone.success; leading-icon: root.theme.icons.check; text: "fsociety"; }
                }
            }
        }
        HorizontalLayout { alignment: start; spacing: 16px;
            KitAvatar { theme: root.theme; initials: "EA"; accessible-name: "Elliot Alderson initials"; size: 56px; }
            KitAvatar { theme: root.theme; initials: "DA"; accessible-name: "Darlene Alderson initials"; shape: AvatarShape.rounded; size: 56px; }
            KitAvatar { theme: root.theme; source: @image-url("../quickstart/avatar/ui/assets/fsociety-mask.jpg"); accessible-name: "Elliot Alderson, fsociety mask"; shape: AvatarShape.rounded; size: 56px; }
            KitAvatar { theme: root.theme; initials: "AM"; accessible-name: "Angela Moss initials"; shape: AvatarShape.square; size: 56px; }
        }
        Text { text: root.demo-status != "" ? root.demo-status : root.status; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; accessible-live-region: polite; }
    }
}
