import { InterFont } from "@kit/fonts/inter.slint";
import { LayoutSpace, KitMetrics, TypographyRole, KitStack } from "@kit";
import { KitThemes } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

import { KitTimePicker, FieldCommit, LocalTimeView } from "@kit";
// Typed host values require install(&window); matching text preserves the static preview.
export component Example inherits Window {
    // Report errors first; request focus separately for one invalid control.
    public function report-validation() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }

    max-width: 100000px; max-height: 100000px;
    default-font-family: InterFont.family;
    preferred-width: 600px; preferred-height: 460px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    changed theme => { KitThemeContext.current = root.theme; }
    title: "Time picker";
    callback committed(FieldCommit);
    callback chosen(LocalTimeView);
    callback cleared();
    KitStack { inset: LayoutSpace.roomy;
        Text { text: root.title; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        field := KitTimePicker { accepted-time: {present: true, time: {hour: 9, minute: 30}}; label: "Appointment time"; text: "09:30"; required: true; chosen(value) => { root.chosen(value); } cleared => { root.cleared(); } committed(value) => { root.committed(value); } }
    }
}
