import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { AlertSeverity, KitAlert, KitButton, ButtonIntent, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitAlert example";
    preferred-width: 480px;
    preferred-height: 300px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Alert"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitAlert { theme: root.theme; severity: AlertSeverity.success; title: "Changes saved"; message: "Your team can now see the updated project."; dismissible: true; dismiss-label: "Dismiss Changes saved"; dismissed => { root.status = "Dismiss requested"; } }
        KitAlert { theme: root.theme; severity: AlertSeverity.error; title: "Upload failed"; message: "The connection was lost before the file finished."; KitButton { theme: root.theme; text: "Retry"; activated => { root.status = "Retry requested"; } } KitButton { theme: root.theme; text: "Details"; intent: ButtonIntent.quiet; activated => { root.status = "Details requested"; } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
