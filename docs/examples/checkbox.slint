import { CheckState, KitCheckbox, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitCheckbox example";
    preferred-width: 360px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Checkbox"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitCheckbox { theme: root.theme; label: "Send me product updates"; state: CheckState.checked; toggled(state) => { root.status = "Checkbox change requested"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
