import { InterFont } from "@kit-fonts/inter.slint";
import { KitTheme, KitThemes, KitStack, KitText, KitImage, KitInline, KitDivider } from "@kit";

export component Example inherits Window {
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    background: root.theme.canvas;
    preferred-width: 420px;
    preferred-height: 150px;
    max-width: 100000px;
    max-height: 100000px;
    KitStack {
        theme: root.theme; inset: regular;
        KitInline {
            theme: root.theme; alignment: space-between;
            KitImage {
                theme: root.theme;
                width: 120px; height: 48px;
                source: root.theme.canvas == KitThemes.dark.canvas
                    ? @image-url("../quickstart/image/ui/assets/wordmark-dark.png")
                    : @image-url("../quickstart/image/ui/assets/wordmark.png");
                purpose: informative; label: "Slint Kit";
            }
            KitText { theme: root.theme; role: caption; text: "Library"; }
        }
        KitDivider { theme: root.theme; }
    }
}
