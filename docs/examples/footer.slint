import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitFooter, KitInline, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitFooter example";
    preferred-width: 480px;
    preferred-height: 240px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Footer"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitFooter { theme: root.theme; Text { text: "Slint Kit · Native applications, thoughtfully composed."; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }KitInline { KitButton { theme: root.theme; text: "Documentation"; activated => { root.status = "Action requested"; } }KitButton { theme: root.theme; text: "Contact"; activated => { root.status = "Action requested"; } } } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
