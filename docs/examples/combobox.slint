import { KitFieldError, ValidationTiming, KitKeyResult } from "@kit";
import { KitMetrics, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
import { KitCombobox, KitTheme, KitThemes, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, SearchPresentation } from "@kit";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability }

// Accessible Expand opens only; ordinary activation still toggles. Controlled owners acknowledge the requested state.
// label names the field; placeholder is an empty hint and the native draft is its accessible value.
export component Example inherits Window {
    // Report errors first; request focus separately for one invalid control.
    public function report-validation() -> bool { return workspace.report-validity(); }
    public function focus-invalid() -> bool { return workspace.focus-if-invalid(); }

    in-out property <string> status;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint combobox";
    preferred-width: 480px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Personal", description: "Private notes and drafts", disabled: false }, { token: 25, generation: 1, label: "Shared", description: "Team documents", disabled: false }, { token: 39, generation: 1, label: "Archive", description: "Completed projects", disabled: false }, { token: 53, generation: 1, label: "Design studio", description: "UI systems and tokens", disabled: false }, { token: 67, generation: 1, label: "Engineering", description: "Architecture and releases", disabled: false }, { token: 81, generation: 1, label: "Marketing", description: "Campaigns and launches", disabled: false }, { token: 95, generation: 1, label: "Research lab", description: "User studies", disabled: false }, { token: 109, generation: 1, label: "Community", description: "Public discussions", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Find your workspace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Type in the inline field to filter workspaces, or browse with the arrow keys."; color: root.theme.text-secondary; wrap: word-wrap; }
        workspace := KitCombobox { required: true; validation-timing: ValidationTiming.on-blur; theme: root.theme;
            label: "Workspace";
            placeholder: "Search workspaces…";
            clearable: true;
            options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Chosen: " + row.label; }

            query <=> root.query;
            search-state: SearchPresentation.ready;
            tab-navigation(reverse) => { return KitKeyResult.reject; }
        }
        if workspace.error-visible: KitFieldError { theme: root.theme; text: workspace.validation-message; }
        selected-label-view := Text { text: "Accepted workspace: " + workspace.selected-label; color: root.theme.text-primary; }
    }
}
