import { KitMetrics, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
import { KitCombobox, KitTheme, KitThemes, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, SearchPresentation } from "@kit";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability }

export component Example inherits Window {
    in-out property <string> status;
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint combobox";
    preferred-width: 480px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options: [{ token: 11, generation: 1, label: "Personal", description: "", disabled: false }, { token: 25, generation: 1, label: "Shared", description: "", disabled: false }, { token: 39, generation: 1, label: "Archive", description: "", disabled: false }, { token: 53, generation: 1, label: "Design studio", description: "", disabled: false }, { token: 67, generation: 1, label: "Engineering", description: "", disabled: false }, { token: 81, generation: 1, label: "Marketing", description: "", disabled: false }, { token: 95, generation: 1, label: "Research lab", description: "", disabled: false }, { token: 109, generation: 1, label: "Community", description: "", disabled: false }];

    in-out property <string> query;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Find your workspace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Search eight workspaces by name, or browse with the arrow keys."; color: root.theme.text-secondary; wrap: word-wrap; }
        workspace := KitCombobox { theme: root.theme;
            label: "Workspace";
            options: root.options; selected: { present: true, token: 11 }; chosen(row) => { root.status = "Chosen: " + row.label; }

            query <=> root.query;
            search-state: SearchPresentation.ready;
            tab-navigation(reverse) => { return reject; }
        }
        selected-label-view := Text { text: "Accepted workspace: " + workspace.selected-label; color: root.theme.text-primary; }
    }
}
