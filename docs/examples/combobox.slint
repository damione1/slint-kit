import { InterFont } from "@kit/fonts/inter.slint";
import { KitCombobox, KitThemes, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, SearchPresentation } from "@kit/kit.slint";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability }

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "Slint combobox";
    preferred-width: 480px;
    preferred-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: KitThemes.light.canvas;
    in property <[OptionRow]> rows: [{ token: 11, generation: 1, label: "Personal", description: "", disabled: false }, { token: 25, generation: 1, label: "Shared", description: "", disabled: false }, { token: 39, generation: 1, label: "Archive", description: "", disabled: false }, { token: 53, generation: 1, label: "Design studio", description: "", disabled: false }, { token: 67, generation: 1, label: "Engineering", description: "", disabled: false }, { token: 81, generation: 1, label: "Marketing", description: "", disabled: false }, { token: 95, generation: 1, label: "Research lab", description: "", disabled: false }, { token: 109, generation: 1, label: "Community", description: "", disabled: false }];
    in property <SelectState> select-state: { open: false, generation: 1, active-index: 0, active: { present: true, token: 11 }, selected: { present: true, token: 11 }, selection-availability: SelectionAvailability.available };
    in property <string> selected-label: "Personal";
    in-out property <string> query;
    callback select-open();
    callback select-navigate(NavigationStep);
    callback select-activate(int, int);
    callback select-dismiss(CloseReason);
    callback select-query(string);
    callback select-typeahead(string);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Find your workspace"; color: KitThemes.light.text-primary; font-size: 22px; font-weight: 600; wrap: word-wrap; }
        Text { text: "Search eight workspaces by name, or browse with the arrow keys."; color: KitThemes.light.text-secondary; wrap: word-wrap; }
        workspace := KitCombobox {
            label: "Workspace";
            rows: root.rows;
            state: root.select-state;
            query <=> root.query;
            selected-label: root.selected-label;
            search-state: SearchPresentation.ready;
            open-requested => { root.select-open(); }
            navigate(step) => { root.select-navigate(step); }
            activate(token, generation) => { root.select-activate(token, generation); }
            dismiss(reason) => { root.select-dismiss(reason); }
            query-edited(text) => { root.select-query(text); }
            typeahead(text) => { root.select-typeahead(text); }
            tab-navigation(reverse) => { return reject; }
        }
        selected-label-view := Text { text: "Accepted workspace: " + root.selected-label; color: KitThemes.light.text-primary; }
    }
}
