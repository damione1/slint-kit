import { InterFont } from "@kit-fonts/inter.slint";
import { KitThemes, KitTheme, KitScrollArea, KitText, KitFieldRow, KitShortcutField } from "@kit";

component ReadingShortcut inherits KitFieldRow {
    in-out property <string> accepted;
    in property <bool> allow-shift;
    private property <string> rejection;
    error-message: root.rejection;
    orientation: root.width < 500px * root.theme.text-scale ? vertical : horizontal;
    padding-bottom: KitThemes.focus-outset(root.theme.focus);
    focus-requested => { field.take-focus(); }
    field := KitShortcutField {
        theme: root.theme; label: root.label; access: root.access;
        description: root.error-message == "" ? root.description : root.error-message;
        value-label: root.accepted; allow-modifier-only: root.allow-shift;
        changed recorder-focused => { if (self.recorder-focused) { root.ensure-visible(KitThemes.scroll-behavior(root.theme)); } }
        captured(ticket, event) => {
            let mods = event.modifiers;
            let plain = !mods.control && !mods.alt && !mods.shift && !mods.meta;
            if (plain && (event.text == Key.F2 || event.text == Key.F3)) {
                if (self.finish(ticket)) { root.accepted = event.text == Key.F2 ? "F2" : "F3"; root.rejection = ""; }
            } else if (self.retry(ticket)) { root.rejection = "Use one of the listed keys."; }
        }
        modifier-released(ticket, event) => {
            if (event.text == Key.Shift || event.text == Key.ShiftR) {
                if (self.finish(ticket)) { root.accepted = "Shift"; root.rejection = ""; }
            } else if (self.retry(ticket)) { root.rejection = "Use one of the listed keys."; }
        }
        clear-requested(ticket) => { if (self.finish(ticket)) { root.accepted = ""; root.rejection = ""; } }
        cancelled => { root.rejection = ""; }
    }
}

export component Example inherits Window {
    in-out property <KitTheme> theme: KitThemes.light;
    default-font-family: InterFont.family;
    background: root.theme.canvas;
    preferred-width: 640px; preferred-height: 320px;
    max-width: 100000px; max-height: 100000px;
    KitScrollArea {
        inset: regular; theme: root.theme;
        KitText { theme: root.theme; role: subtitle; text: "Reading shortcuts"; }
        ReadingShortcut {
            theme: root.theme; label: "Next page"; description: "Choose F2 or F3.";
            accepted: "F2";
        }
        ReadingShortcut {
            theme: root.theme; label: "Show outline"; show-divider: true;
            description: "Choose F2, F3 or Shift alone."; allow-shift: true;
        }
    }
}
