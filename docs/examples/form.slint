import { KitForm, KitTextField, KitEmailField, KitDateField, KitCheckbox, CheckState, KitButton, KitFieldError, KitTheme, KitThemes } from "@kit";
export component Example inherits Window {
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <bool> consent-reported;
    background: root.theme.canvas;
    preferred-width: 520px; preferred-height: 680px;
    callback submit-requested();
    VerticalLayout { padding: 24px;
        form := KitForm {
            theme: root.theme;
            accessible-name: "Registration";
            validation-requested => {
                let name-valid = name.report-validity();
                let email-valid = email.report-validity();
                let birth-valid = birth.report-validity();
                let consent-valid = consent.report-validity();
                root.consent-reported = true;
                if (!name-valid) { name.focus-if-invalid(); }
                else if (!email-valid) { email.focus-if-invalid(); }
                else if (!birth-valid) { birth.focus-if-invalid(); }
                else if (!consent-valid) { consent.focus-if-invalid(); }
                return name-valid && email-valid && birth-valid && consent-valid;
            }
            submit-requested => { root.submit-requested(); }
            reset-requested => {
                name.reset-field(); email.reset-field(); birth.reset-field();
                consent.state = CheckState.unchecked; consent.reset-validation(); root.consent-reported = false;
            }
            name := KitTextField { theme: root.theme; label: "Name"; required: true; }
            email := KitEmailField { theme: root.theme; label: "Email"; required: true; }
            birth := KitDateField { theme: root.theme; label: "Birth date"; required: true; }
            consent := KitCheckbox { theme: root.theme; label: "Accept the terms"; required: true; }
            if root.consent-reported && !consent.validity.valid: KitFieldError { theme: root.theme; text: consent.validation-message; }
            HorizontalLayout {
                alignment: start;
                KitButton { theme: root.theme; text: "Register"; activated => { form.submit(); } }
                KitButton { theme: root.theme; text: "Reset"; activated => { form.reset(); } }
            }
        }
    }
}
