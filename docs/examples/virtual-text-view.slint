import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitTheme, KitThemes, KitVirtualTextView } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitVirtualTextView example";
    preferred-width: 620px;
    preferred-height: 540px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Virtual Text View"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitVirtualTextView { theme: root.theme; height: 390px; generation: 1; lines: [{ token: 101, number: 1, text: "# Field notes", selected: false }, { token: 205, number: 2, text: "A shared space for observations.", selected: true }, { token: 309, number: 3, text: "Keep identities stable as rows move.", selected: false }, { token: 413, number: 4, text: "Use native editing for selected lines.", selected: false }, { token: 500, number: 5, text: "## Plan for the next release", selected: false }, { token: 517, number: 6, text: "[x] Collect interview notes", selected: false }, { token: 534, number: 7, text: "[x] Build an interactive prototype", selected: false }, { token: 551, number: 8, text: "[ ] Invite the team to the design review", selected: false }, { token: 568, number: 9, text: "[ ] Walk through the flow with the keyboard", selected: false }, { token: 585, number: 10, text: "[ ] Check contrast in both themes", selected: false }, { token: 602, number: 11, text: "[ ] Respect reduced-motion preferences", selected: false }, { token: 619, number: 12, text: "## Ready to share", selected: false }, { token: 636, number: 13, text: "Capture the details while they are fresh.", selected: false }, { token: 653, number: 14, text: "Choose the next small improvement.", selected: false }, { token: 670, number: 15, text: "Good software leaves room for people to think.", selected: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
