import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitDropdownMenu, KitTheme, KitThemes } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitDropdownMenu example";
    preferred-width: 480px;
    preferred-height: 320px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status: "No action yet";
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;
        KitDropdownMenu {
            theme: root.theme;
            text: "Actions";
            options: [{ token: 11, generation: 1, label: "Rename", description: "Change the project name", disabled: false }, { token: 23, generation: 1, label: "Duplicate", description: "Copy the project", disabled: false }, { token: 38, generation: 1, label: "Archive", description: "Move out of the list", disabled: false }];
            chosen(row) => { root.status = "Chosen: " + row.label; }
        }
        Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; }
    }
}
