// Display projections are fixtures. Validate accepted domain values in Rust.
import { KitIsoWeekField, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    title: "KitIsoWeekField example";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Iso Week Field"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitIsoWeekField { theme: root.theme; label: "Sprint week"; text: "2026-W42"; edited(value) => { root.status = "Draft: " + value; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
