// This static view emits render tokens; lifetime and closure observation belong to Rust.
// Keep the ToastId returned by ToastBinding::push, then use toasts.dismiss_id(id).
// toasts.update(id, replacement_view, lifetime) preserves the typed action and pause sources.
// on_closed receives (ToastId, action clone, ToastCloseReason) after model/timer publication.
// See the controllers guide for a copyable typed closure observer; no Slint close-reason prop exists.
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { AlertSeverity, KitTheme, KitThemes, KitToast } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitToast example";
    preferred-width: 480px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Toast"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitToast { theme: root.theme; entry: { token: 11, title: "Project archived", dismiss-label: "Dismiss Project archived", message: "Your notes are safely stored.", action-label: "Undo", severity: AlertSeverity.success, dismissible: true }; action(token) => { root.status = "Undo requested"; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
