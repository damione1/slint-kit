import { InterFont } from "@kit/fonts/inter.slint";
import { LucideIcons } from "@kit/icons/lucide/all.slint";
import { KitChipButton, KitTheme, KitThemes, KitMetrics, Tone, TypographyRole } from "@kit/kit.slint";
export component Example inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Chip Button";
    preferred-width: 560px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    in-out property <int> active: 2;
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Filter the queue"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Each chip shows one slice of the orders. The selected chip takes its status tone."; color: root.theme.text-secondary; wrap: word-wrap; }
        FlexboxLayout { spacing: root.theme.spacing.unit * 2; flex-wrap: wrap; alignment: start;
            KitChipButton { theme: root.theme; label: "All orders"; glyph: LucideIcons.inbox(); tone: Tone.accent; selected: root.active == 1; activated => { root.active = 1; } }
            KitChipButton { theme: root.theme; label: "Awaiting shipment"; glyph: LucideIcons.package(); tone: Tone.information; selected: root.active == 2; activated => { root.active = 2; } }
            KitChipButton { theme: root.theme; label: "In transit"; glyph: LucideIcons.truck(); tone: Tone.success; selected: root.active == 3; activated => { root.active = 3; } }
            KitChipButton { theme: root.theme; label: "Delayed"; glyph: LucideIcons.clock(); tone: Tone.warning; selected: root.active == 4; activated => { root.active = 4; } }
            KitChipButton { theme: root.theme; label: "Returned"; tone: Tone.danger; selected: root.active == 5; activated => { root.active = 5; } }
        }
    }
}
