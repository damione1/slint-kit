import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSegmentedControl, KitTheme, KitThemes, ChoiceDirection } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitSegmentedControl example";
    preferred-width: 420px;
    preferred-height: 420px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Segmented Control"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitSegmentedControl { theme: root.theme; rows: [{ token: 11, label: "Email", selected: true, disabled: false }, { token: 23, label: "Push", selected: false, disabled: false }, { token: 38, label: "SMS", selected: false, disabled: true }]; generation: 1; active-token: 11; activate(token, generation) => { root.status = "Choice token " + token; } }
        KitSegmentedControl { theme: root.theme; width: 200px; direction: ChoiceDirection.vertical; label: "Row density"; rows: [{ token: 41, label: "Compact", selected: false, disabled: false }, { token: 42, label: "Comfortable", selected: true, disabled: false }, { token: 43, label: "Spacious", selected: false, disabled: false }]; generation: 1; active-token: 42; activate(token, generation) => { root.status = "Density token " + token; } }
        KitSegmentedControl { theme: root.theme; columns: 2; label: "Four choices"; rows: [{ token: 51, label: "One", selected: true }, { token: 52, label: "Two", selected: false }, { token: 53, label: "Three", selected: false }, { token: 54, label: "Four", selected: false }]; icons: [{ token: 51, glyph: root.theme.icons.check }]; generation: 1; active-token: 51; activate(token, generation) => { root.status = "Choice " + token; } }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
