import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitBreadcrumbs, KitTheme, KitThemes } from "@kit/kit.slint";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitBreadcrumbs example";
    preferred-width: 480px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Breadcrumbs"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitBreadcrumbs { theme: root.theme; rows: [{ token: 11, generation: 1, label: "Workspace", disabled: false }, { token: 23, generation: 1, label: "Projects", disabled: false }, { token: 38, generation: 1, label: "Field notes", disabled: false }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
