import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSteps, KitTheme, KitThemes, StepState } from "@kit";

export component Example inherits Window {
    default-font-family: InterFont.family;
    title: "KitSteps example";
    preferred-width: 520px;
    preferred-height: 540px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> status;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Steps"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitSteps { theme: root.theme; interactive: true; entries: [
            { token: 11, generation: 1, label: "Account", description: "Credentials and security", state: StepState.complete, enabled: true },
            { token: 23, generation: 1, label: "Workspace", description: "Project details", state: StepState.current, enabled: true },
            { token: 38, generation: 1, label: "Invite team", description: "Available after setup", state: StepState.pending, enabled: false },
        ]; step-activated(token, generation) => { root.status = "Step requested: " + token; } }
        KitSteps { theme: root.theme; orientation: Orientation.horizontal; entries: [{ token: 11, label: "Account", state: StepState.complete }, { token: 23, label: "Workspace", state: StepState.current }, { token: 38, label: "Invite team", state: StepState.pending }]; }
        if root.status != "": Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
    }
}
