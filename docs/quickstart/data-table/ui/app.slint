import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitDataTable, KitThemes, TableRow, TableColumn, DataSortDirection, DataAlignment, NavigationStep } from "@kit";
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint data table";
    preferred-width: 620px; preferred-height: 520px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in property <[TableRow]> rows;
    in property <DataSortDirection> name-sort: DataSortDirection.unsorted;
    in property <int> generation;
    in property <int> active-index: -1;
    in property <string> selected-label: "No selection";
    callback sort();
    callback choose(int, int);
    callback move(NavigationStep);
    VerticalLayout {
        padding: 24px; spacing: 16px;
        Text { text: "The people behind the work"; color: root.theme.text-primary; font-size: 22px; font-weight: 600; wrap: word-wrap; }
        Text { text: "8 teammates · sort by name or select a row to see its accepted identity."; color: root.theme.text-secondary; wrap: word-wrap; }
        table := KitDataTable { theme: root.theme;
            height: 350px; rows: root.rows; columns: [{token: 1, label: "Name", sortable: true, sort: root.name-sort, alignment: DataAlignment.leading}, {token: 2, label: "Team", sortable: false, alignment: DataAlignment.leading}, {token: 3, label: "Status", sortable: false, alignment: DataAlignment.leading}];
            generation: root.generation; active-index: root.active-index;
            sort-requested(token) => { root.sort(); }
            activate(token, generation) => { root.choose(token, generation); }
            navigate(step) => { root.move(step); }
        }
        Text { text: root.selected-label; color: root.theme.text-primary; }
    }
}
