export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitDivider, KitTextField, KitTheme, KitThemes } from "@kit/kit.slint";

export enum DemoAction { sign-in }

export component App inherits Window {
    title: "KitDivider example";
    preferred-width: 420px;
    preferred-height: 270px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> status: "Choose an action.";
    callback action-requested(DemoAction);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Divider"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitTextField { theme: root.theme; label: "Email address"; placeholder: "you@example.com"; } KitDivider { theme: root.theme; label: "or continue with"; } KitButton { theme: root.theme; text: "Single sign-on"; activated => { root.action-requested(DemoAction.sign-in); } }
        Text { text: root.status; color: root.theme.text-secondary; wrap: word-wrap; }
    }
}
