import { KitTheme, KitThemeContext, LayoutSpace } from "@kit";

import { KitDateTimeField, LocalDateTimeView, KitStack, KitButton } from "@kit";
// install(&window) formats the atomic typed pair into both native editors.
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    preferred-width: 560px; preferred-height: 440px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "Local date and time";
    callback chosen(LocalDateTimeView);
    callback cleared();
    out property <LocalDateTimeView> accepted-value: control.accepted-value;
    KitStack { inset: LayoutSpace.roomy;
        control := KitDateTimeField { clearable: true; clear-label: "Clear date and time"; accepted-value: {date: {year: 2026, month: 10, day: 17}, time: {hour: 9, minute: 30}}; label: "Appointment"; required: false; chosen(value) => { root.chosen(value); } cleared => { root.cleared(); } }
        KitButton { text: "Apply"; activated => { control.commit(); } }
    }
}
