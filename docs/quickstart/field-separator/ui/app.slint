import { KitFieldSeparator, KitTextField, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitFieldSeparator example";
    preferred-width: 420px;
    preferred-height: 290px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> draft-0: "alex@example.com";
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Field Separator"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitTextField { theme: root.theme; label: "Work email"; text <=> root.draft-0; } KitFieldSeparator { theme: root.theme; } KitTextField { theme: root.theme; label: "Personal email"; placeholder: "Optional"; }
    }
}
