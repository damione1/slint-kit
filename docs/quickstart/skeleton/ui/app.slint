export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSurface, KitSkeleton, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitSkeleton example";
    preferred-width: 420px;
    preferred-height: 300px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Skeleton"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitSurface { theme: root.theme;
            HorizontalLayout { spacing: 16px;
                KitSkeleton { theme: root.theme; width: 48px; height: 48px; border-radius: 24px; }
                VerticalLayout { alignment: center; spacing: 10px;
                    KitSkeleton { theme: root.theme; height: 18px; }
                    KitSkeleton { theme: root.theme; height: 12px; max-width: 240px; }
                }
            }
            KitSkeleton { theme: root.theme; height: 14px; }
            KitSkeleton { theme: root.theme; height: 14px; max-width: 280px; }
        }
    }
}
