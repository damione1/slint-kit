
import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit";
import { LucideArrows } from "@kit/icons/lucide/arrows.slint";
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitResetButton, KitTextField, KitThemes, FormAction } from "@kit";
export { FormAction }
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitResetButton";
    preferred-width: 460px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <string> draft: "Field notes";
    in property <string> result: "Edit the draft, then use the action.";
    callback reset-draft();
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        KitTextField { theme: root.theme; label: "Project name"; text <=> root.draft; }
        action := KitResetButton { theme: root.theme; leading-icon: LucideArrows.rotate-ccw(); text: "Reset draft"; form-action(action) => { root.reset-draft(); } }
        Text { text: root.result; color: root.theme.text-primary; wrap: word-wrap; }
    }
}
