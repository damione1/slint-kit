import { LayoutSpace } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

// SPDX-License-Identifier: GPL-3.0-or-later

import { KitRangeSlider, KitStack, KitThemeContext, DecimalRangeView } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "KitRangeSlider example"; preferred-width: 560px; preferred-height: 360px;
    background: KitThemeContext.current.canvas;
    callback limits-changed(DecimalRangeView);
    KitStack { inset: LayoutSpace.roomy; KitRangeSlider { label: "Allowed range"; value: {lower: "20", upper: "65"}; spec: {minimum: "0", maximum: "100", step: "5"}; chosen(value) => { root.limits-changed(value); } } }
}
