export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitChatBubble, ChatSide, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitChatBubble example";
    preferred-width: 520px;
    preferred-height: 460px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Chat Bubble"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitChatBubble { theme: root.theme; side: ChatSide.start; author: "Elliot Alderson"; text: "The workspace is ready for review."; metadata: "Today, 09:30"; }
        KitChatBubble { theme: root.theme; side: ChatSide.start; author: "Elliot Alderson"; text: "Could you check the project settings?"; metadata: "Today, 09:31"; }
        KitChatBubble { theme: root.theme; side: ChatSide.end; author: "You"; text: "Yes, I’ll review them this afternoon."; metadata: "Today, 09:32 · Delivered"; }
    }
}
