import { KitPagination, NavigationStep, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    title: "KitPagination example";
    preferred-width: 520px;
    preferred-height: 200px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <int> page;
    callback navigate(NavigationStep);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        control := KitPagination { theme: root.theme; page-index: root.page; page-count: 4; navigate(step) => { root.navigate(step); } }
        result := Text { text: "Page " + (root.page + 1) + " of 4"; color: root.theme.text-primary; }
    }

}
