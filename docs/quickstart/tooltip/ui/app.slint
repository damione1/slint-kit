export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitTooltip, KitTooltipLayer, KitButton, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitTooltip example";
    preferred-width: 520px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    in property <int> created;
    callback create();
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        tip := KitTooltip {
            theme: root.theme; text: "Create a project in this workspace.";
            target-focused: create-button.focus-visible;
            viewport-width: root.width; viewport-height: root.height;
            create-button := KitButton { theme: root.theme; text: "New project"; leading-icon: root.theme.icons.plus; activated => { root.create(); } }
        }
        Text { text: "Hover for a hint, or use Tab to focus the action. Escape dismisses the hint."; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
        result := Text { text: "Projects created: " + root.created; color: root.theme.text-primary; }
    }
    layer := KitTooltipLayer { viewport-width: root.width; viewport-height: root.height; }
}
