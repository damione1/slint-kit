export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSubmitButton, KitTextField, KitThemes, FormAction } from "@kit/kit.slint";
export { FormAction }
export component App inherits Window {
    title: "KitSubmitButton";
    preferred-width: 460px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: KitThemes.light.canvas;
    in-out property <string> draft: "Field notes";
    in property <string> result: "Edit the draft, then use the action.";
    callback form-action(FormAction, string);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        KitTextField { label: "Project name"; text <=> root.draft; }
        action := KitSubmitButton { text: "Create project"; form-action(action) => { root.form-action(action, root.draft); } }
        Text { text: root.result; color: KitThemes.light.text-primary; wrap: word-wrap; }
    }
}
