export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitSubmitButton, KitTextField, KitThemes, FormAction } from "@kit/kit.slint";
export { FormAction }
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitSubmitButton";
    preferred-width: 460px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <string> draft: "Field notes";
    in property <string> result: "Edit the draft, then use the action.";
    callback form-action(FormAction, string);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        KitTextField { theme: root.theme; label: "Project name"; text <=> root.draft; }
        action := KitSubmitButton { theme: root.theme; text: "Create project"; form-action(action) => { root.form-action(action, root.draft); } }
        Text { text: root.result; color: root.theme.text-primary; wrap: word-wrap; }
    }
}
