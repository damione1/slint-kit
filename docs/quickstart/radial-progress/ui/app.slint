import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitRadialProgress, KitButton, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    title: "KitRadialProgress example";
    preferred-width: 520px;
    preferred-height: 300px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <int> percent: 65;
    in-out property <bool> playing;
    callback advance();
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        control := KitRadialProgress { theme: root.theme; label: "Upload"; value: root.percent / 100; }
        HorizontalLayout { alignment: start; spacing: 12px;
            KitButton { theme: root.theme; text: "Advance upload"; activated => { root.advance(); } }
            KitButton { theme: root.theme; text: root.playing ? "Pause" : "Animate"; activated => { root.playing = !root.playing; } }
        }
        result := Text { text: root.percent + "% uploaded"; color: root.theme.text-primary; }
    }
    Timer { interval: 850ms; running: root.playing && !root.theme.reduced-motion; triggered => { root.advance(); } }
}
