import { KitFieldGroup, KitTextField, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitFieldGroup example";
    preferred-width: 420px;
    preferred-height: 280px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> draft-0: "Alex";
    in-out property <string> draft-1: "Morgan";
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Field Group"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitFieldGroup { KitTextField { theme: root.theme; label: "First name"; text <=> root.draft-0; } KitTextField { theme: root.theme; label: "Last name"; text <=> root.draft-1; } }
    }
}
