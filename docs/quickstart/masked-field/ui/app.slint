import { KitTheme, KitThemeContext, KitFieldDescription, LayoutSpace } from "@kit";

import { KitMaskedField, KitStack, KitButton, FieldCommit } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    preferred-width: 520px; preferred-height: 320px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "Reference";
    callback committed(FieldCommit);
    KitStack { inset: LayoutSpace.roomy;
        control := KitMaskedField {
            label: "Reference"; text: "12-34"; required: true; spec-key: "value";

            committed(value) => { root.committed(value); }
        }
        KitButton { text: "Apply"; activated => { control.commit(); } }
        KitFieldDescription { text: "Accepted: " + control.accepted-text; }
        KitButton { text: "Cancel edit"; activated => { control.cancel-edit(); } }
    }
}
