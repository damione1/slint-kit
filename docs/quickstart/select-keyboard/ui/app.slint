import { KitTheme, KitThemeContext, KitMetrics, TypographyRole, OptionRow, SelectionRef, NavigationStep, KitButton, KitSelectKeyboard, KitOption, KitSurface, KitIcon } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitSelectKeyboard example";
    preferred-width: 560px; preferred-height: 480px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options;
    in-out property <SelectionRef> selected;
    callback destination-chosen(OptionRow);

    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        KitSurface { theme: root.theme;
        control := KitSelectKeyboard {
            focus-on-tab-navigation: true; height: 180px * root.theme.text-scale;
            options: root.options; selected <=> root.selected;
            chosen(row) => { root.destination-chosen(row); }
            VerticalLayout {
                for row in control.rows: KitOption {
                    theme: root.theme; option-data: row; height: 54px * root.theme.text-scale;
                    active: control.state.active.present && control.state.active.token == row.token;
                    selected: control.state.selected.present && control.state.selected.token == row.token;
                    activate(token, generation) => { control.choose-option(token, generation); }
                    HorizontalLayout { spacing: root.theme.spacing.unit * 3;
                        KitIcon { theme: root.theme; glyph: root.theme.icons.article; ink: root.theme.accent; }
                        Text { text: row.label; color: row.disabled ? root.theme.disabled-text : root.theme.text-primary; vertical-alignment: center; }
                    }
                }
            }
        }
        }
        HorizontalLayout { spacing: 12px; KitButton { text: "Next destination"; activated => { control.move-active(NavigationStep.next); } } KitButton { text: "Find Settings"; activated => { control.type-ahead("Settings"); } } }
        Text { text: "Selected: " + control.selected-label; color: root.theme.text-primary; }
    }
}
