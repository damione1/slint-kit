export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitHero, KitTheme, KitThemes } from "@kit/kit.slint";

export enum DemoAction { create-workspace }

export component App inherits Window {
    title: "KitHero example";
    preferred-width: 520px;
    preferred-height: 300px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> status: "Choose an action.";
    callback action-requested(DemoAction);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Hero"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitHero { theme: root.theme; title: "Make room for ideas."; description: "A shared workspace for your next project."; KitButton { theme: root.theme; text: "Create workspace"; activated => { root.action-requested(DemoAction.create-workspace); } } }
        Text { text: root.status; color: root.theme.text-secondary; wrap: word-wrap; }
    }
}
