import { InterFont } from "@kit/fonts/inter.slint";
import { LucideIcons } from "@kit/icons/lucide/all.slint";
import { KitChipButton, KitTheme, KitThemeContext, KitMetrics, Tone, TypographyRole } from "@kit";
// A closed set the code owns: Rust receives the generated OrderFilter enum.
export enum OrderFilter { all, awaiting-shipment, in-transit, delayed, returned }
export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Chip Button";
    preferred-width: 560px; preferred-height: 260px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemeContext.current;
    background: root.theme.canvas;
    in property <OrderFilter> active: OrderFilter.awaiting-shipment;
    in property <string> status;
    callback choose(OrderFilter);
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Filter the queue"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Each chip shows one slice of the orders. The selected chip takes its status tone."; color: root.theme.text-secondary; wrap: word-wrap; }
        FlexboxLayout { spacing: root.theme.spacing.unit * 2; flex-wrap: wrap; alignment: start;
            KitChipButton { theme: root.theme; label: "All orders"; glyph: LucideIcons.inbox(); tone: Tone.accent; selected: root.active == OrderFilter.all; activated => { root.choose(OrderFilter.all); } }
            KitChipButton { theme: root.theme; label: "Awaiting shipment"; glyph: LucideIcons.package(); tone: Tone.information; selected: root.active == OrderFilter.awaiting-shipment; activated => { root.choose(OrderFilter.awaiting-shipment); } }
            KitChipButton { theme: root.theme; label: "In transit"; glyph: LucideIcons.truck(); tone: Tone.success; selected: root.active == OrderFilter.in-transit; activated => { root.choose(OrderFilter.in-transit); } }
            KitChipButton { theme: root.theme; label: "Delayed"; glyph: LucideIcons.clock(); tone: Tone.warning; selected: root.active == OrderFilter.delayed; activated => { root.choose(OrderFilter.delayed); } }
            KitChipButton { theme: root.theme; label: "Returned"; tone: Tone.danger; selected: root.active == OrderFilter.returned; activated => { root.choose(OrderFilter.returned); } }
        }
        result := Text { text: root.status; color: root.theme.text-secondary; }
    }
}
