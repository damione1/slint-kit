import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCarousel, KitBadge, Tone, KitProgress, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    title: "KitCarousel example";
    preferred-width: 600px;
    preferred-height: 610px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <[OptionRow]> rows;
    in property <SelectState> select-state;
    in property <string> selected-label: "Alpine morning";
    in property <image> alpine; in property <image> desert; in property <image> coast;
    in-out property <string> query;
    callback select-open();
    callback select-navigate(NavigationStep);
    callback select-activate(int, int);
    callback select-dismiss(CloseReason);
    callback select-query(string);
    callback select-typeahead(string);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "A change of scenery"; color: root.theme.text-primary; font-size: 24px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Three places to pause, explore, and find your next idea."; color: root.theme.text-secondary; wrap: word-wrap; }
        control := KitCarousel {
            theme: root.theme; rows: root.rows; state: root.select-state; action-label: "Open";
            KitBadge { theme: root.theme; tone: Tone.accent; leading-icon: root.theme.icons.article; text: "CURATED DESTINATIONS"; }
            Rectangle { height: 200px; border-radius: root.theme.shape.radius-container; clip: true;
                Image { width: parent.width; height: parent.height; source: root.select-state.active-index == 1 ? root.desert : root.select-state.active-index == 2 ? root.coast : root.alpine; image-fit: cover; accessible-role: image; accessible-label: root.select-state.active-index == 1 ? "Original illustration of terracotta desert dunes at sunset" : root.select-state.active-index == 2 ? "Original illustration of blue coastal hills" : "Original illustration of alpine peaks under a pale sky"; }
            }
            KitProgress { theme: root.theme; label: "Explore the collection"; value: (root.select-state.active-index + 1) / max(1,root.rows.length); }
            navigate(step) => { root.select-navigate(step); }
            activate(token, generation) => { root.select-activate(token, generation); }
        }
        result := Text { text: "Selected: " + root.selected-label; color: root.theme.text-primary; }
    }

}
