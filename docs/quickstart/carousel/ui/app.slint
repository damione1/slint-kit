import { KitTheme, KitThemeContext, KitMetrics, TypographyRole, OptionRow, SelectionRef, KitCarousel, KitBadge, Tone, KitProgress } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitCarousel example";
    preferred-width: 560px; preferred-height: 610px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options;
    in-out property <SelectionRef> selected;
    callback destination-chosen(OptionRow);
    in property <SelectionRef> desert-key;
    in property <SelectionRef> coast-key;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "A change of scenery"; color: root.theme.text-primary; font-size: 24px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Three places to pause, explore, and find your next idea."; color: root.theme.text-secondary; wrap: word-wrap; }
        control := KitCarousel {
            theme: root.theme; options: root.options; selected <=> root.selected; action-label: "Open";
            chosen(row) => { root.destination-chosen(row); }
            KitBadge { theme: root.theme; tone: Tone.accent; text: "CURATED DESTINATIONS"; }
            Rectangle { height: 200px; border-radius: root.theme.shape.radius-container; clip: true;
                Image { width: parent.width; height: parent.height;
                    source: control.state.active.present && control.state.active.token == root.desert-key.token ? @image-url("assets/desert.png") : control.state.active.present && control.state.active.token == root.coast-key.token ? @image-url("assets/coast.png") : @image-url("assets/alpine.png");
                    image-fit: cover; accessible-role: image; accessible-label: control.rows[control.state.active-index].label;
                }
            }
            KitProgress { theme: root.theme; label: "Explore the collection"; value: (control.state.active-index + 1) / max(1,control.rows.length); }
        }
        Text { text: "Selected: " + control.selected-label; color: root.theme.text-primary; }

    }
}
