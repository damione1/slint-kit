import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldSet, KitTextField, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    default-font-family: InterFont.family;
    title: "KitFieldSet example";
    preferred-width: 440px;
    preferred-height: 310px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> draft-0: "Montréal";
    in-out property <string> draft-1: "H2Y 1C6";
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Field Set"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitFieldSet { theme: root.theme; legend: "Shipping address"; KitTextField { theme: root.theme; label: "City"; text <=> root.draft-0; } KitTextField { theme: root.theme; label: "Postal code"; text <=> root.draft-1; } }
    }
}
