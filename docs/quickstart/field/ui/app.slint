import { KitField, KitFieldDescription, KitFieldLabel, KitTextField, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitField example";
    preferred-width: 420px;
    preferred-height: 220px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> draft-0: "Alex Morgan";
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Field"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitField { KitFieldLabel { theme: root.theme; text: "Display name";  focus-requested => { editor.take-focus(); } } editor := KitTextField { theme: root.theme; text <=> root.draft-0; } KitFieldDescription { theme: root.theme; text: "Visible to your team."; } }
    }
}
