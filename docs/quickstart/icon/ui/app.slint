export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitGlyphs, KitIcon, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitIcon example";
    preferred-width: 360px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Icon"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        HorizontalLayout { alignment: start; spacing: 24px; KitIcon { glyph: KitGlyphs.check(); ink: root.theme.accent; } KitIcon { glyph: KitGlyphs.search(); ink: root.theme.text-primary; } KitIcon { glyph: KitGlyphs.warning(); ink: root.theme.warning; } }
    }
}
