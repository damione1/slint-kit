import { KitTheme, KitThemeContext, KitMetrics, TypographyRole, OptionRow, KitAccordion } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitAccordion example";
    preferred-width: 560px; preferred-height: 360px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in property <[OptionRow]> options;
    callback section-expanded(OptionRow, bool);

    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        control := KitAccordion {
            theme: root.theme; options: root.options;
            expansion-changed(row, expanded) => { root.section-expanded(row, expanded); }
        }
        Text { text: "Last section: " + control.selected-label; color: root.theme.text-primary; }

    }
}
