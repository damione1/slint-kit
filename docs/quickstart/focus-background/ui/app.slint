import { InterFont } from "@kit-fonts/inter.slint";
import { KitTheme, KitThemeContext, KitStack, KitText, KitTextArea, KitFocusBackground } from "@kit";

export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    background: root.theme.canvas;
    preferred-width: 420px;
    preferred-height: 240px;
    max-width: 100000px;
    max-height: 100000px;
    KitFocusBackground {
        KitStack {
            theme: root.theme; inset: regular;
            KitTextArea { theme: root.theme; label: "Notes"; }
            KitText { theme: root.theme; role: caption; text: "Click below the editor to leave the field."; }
        }
    }
}
