import { KitStat, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitStat example";
    preferred-width: 360px;
    preferred-height: 210px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Stat"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitStat { theme: root.theme; label: "Active projects"; value: "24"; description: "4 added this month"; }
    }
}
