export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitCard, KitBadge, Tone, KitTabs, KitProgress, OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitTabs example";
    preferred-width: 520px;
    preferred-height: 490px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    in property <[OptionRow]> rows;
    in property <SelectState> select-state;
    in property <string> selected-label: "Overview";
    in-out property <string> query;
    callback select-open();
    callback select-navigate(NavigationStep);
    callback select-activate(int, int);
    callback select-dismiss(CloseReason);
    callback select-query(string);
    callback select-typeahead(string);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Studio workspace"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        control := KitTabs {
            theme: root.theme; rows: root.rows; state: root.select-state;
            navigate(step) => { root.select-navigate(step); }
            activate(token, generation) => { root.select-activate(token, generation); }
            dismiss(reason) => { root.select-dismiss(reason); }
            typeahead(text) => { root.select-typeahead(text); }
        }
        KitCard { theme: root.theme;
            KitBadge { theme: root.theme; leading-icon: root.theme.icons.check; text: root.selected-label == "Overview" ? "PROJECT SNAPSHOT" : root.selected-label == "Activity" ? "LATEST UPDATES" : "PREFERENCES"; tone: Tone.accent; }
            Text { text: root.selected-label == "Overview" ? "A clearer view of what’s next" : root.selected-label == "Activity" ? "Good work is happening" : "A workspace that fits you"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { text: root.selected-label == "Overview" ? "The autumn collection is taking shape. Research is complete, prototypes are ready, and the team is preparing its next design review." : root.selected-label == "Activity" ? "Today · Elliot shared the updated prototypes.\nYesterday · Darlene completed the accessibility review.\nMonday · Angela added three research notes." : "Notifications · Email and desktop enabled\nVisibility · Shared with your team\nLanguage · English"; color: root.theme.text-secondary; wrap: word-wrap; }
            Text { text: root.selected-label == "Overview" ? "8 tasks completed    ·    3 people collaborating" : root.selected-label == "Activity" ? "All changes are saved in your workspace." : "Your choices stay with this workspace."; color: root.theme.accent; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            if root.selected-label == "Overview": KitProgress { theme: root.theme; label: "Milestone progress"; value: 0.65; }
        }
        result := Text { text: "Selected: " + root.selected-label; color: root.theme.text-secondary; }
    }

}
