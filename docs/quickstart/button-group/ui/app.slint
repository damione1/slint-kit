
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButtonGroup, ButtonGroupEntry, KitTheme, KitThemes } from "@kit";

export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitButtonGroup example";
    preferred-width: 520px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    in property <string> status: "Choose an action.";
    in property <[ButtonGroupEntry]> actions;
    callback action-requested(int, int);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Button Group"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitButtonGroup { theme: root.theme; accessible-name: "Navigation commands"; attached: true; actions: root.actions;
            activated(token, generation) => { root.action-requested(token, generation); }
        }
        Text { text: root.status; color: root.theme.text-secondary; wrap: word-wrap; }
    }
}
