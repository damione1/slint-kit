import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitButton, KitButtonGroup, KitTheme, KitThemes } from "@kit/kit.slint";

export enum DemoAction { back, next }

export component App inherits Window {
    default-font-family: InterFont.family;
    title: "KitButtonGroup example";
    preferred-width: 360px;
    preferred-height: 160px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> status: "Choose an action.";
    callback action-requested(DemoAction);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Button Group"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitButtonGroup { KitButton { theme: root.theme; text: "Back"; activated => { root.action-requested(DemoAction.back); } }KitButton { theme: root.theme; text: "Next"; activated => { root.action-requested(DemoAction.next); } } }
        Text { text: root.status; color: root.theme.text-secondary; wrap: word-wrap; }
    }
}
