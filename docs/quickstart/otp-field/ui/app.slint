import { KitTheme, KitThemeContext, LayoutSpace } from "@kit";

import { KitOtpField, KitStack, KitButton, KitFieldDescription, FieldCommit, FieldDecoration, FieldAccess, CommitPolicy, ValidationTiming } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    preferred-width: 520px; preferred-height: 900px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "Verification codes";
    callback numeric(FieldCommit); callback alpha(FieldCommit); callback grouped(FieldCommit);
    KitStack { inset: LayoutSpace.roomy;
        numeric := KitOtpField { label: "Start with an empty code"; slots: 6; required: true; decoration: FieldDecoration.underlined; validation-timing: ValidationTiming.on-submit; commit-policy: CommitPolicy.on-submit; spec-key: "numeric"; committed(value) => { root.numeric(value); } }
        KitButton { text: "Accept numeric code"; activated => { numeric.commit(); } }
        KitFieldDescription { text: "Accepted: " + numeric.accepted-text; }
        alpha := KitOtpField { label: "Letters and digits"; text: "ABC123"; slots: 6; pattern: "[A-Za-z0-9]*"; required: true; validation-timing: ValidationTiming.on-submit; commit-policy: CommitPolicy.on-submit; spec-key: "alpha"; committed(value) => { root.alpha(value); } }
        KitOtpField { label: "The same code, masked"; text: alpha.text; slots: 6; pattern: "[A-Za-z0-9]*"; input-type: InputType.password; access: FieldAccess.read-only; }
        KitButton { text: "Accept alphanumeric code"; activated => { alpha.commit(); } }
        KitFieldDescription { text: "Accepted: " + alpha.accepted-text; }
        grouped := KitOtpField { label: "Seven-character code, grouped at rest"; description: "Paste the raw code without a separator."; text: "FG76657"; slots: 7; pattern: "[A-Z]{2}[0-9]{5}"; required: true; validation-timing: ValidationTiming.on-submit; commit-policy: CommitPolicy.on-submit; spec-key: "grouped"; committed(value) => { root.grouped(value); } }
        KitButton { text: "Accept grouped code"; activated => { grouped.commit(); } }
        KitFieldDescription { text: "Accepted raw code: " + grouped.accepted-text; }
    }
}
