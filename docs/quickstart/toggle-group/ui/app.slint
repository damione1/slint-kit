import { KitTheme, KitThemeContext, KitMetrics, TypographyRole, KitToggleGroup, OptionRow, SelectionRef } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Delivery channels"; preferred-width: 560px; preferred-height: 440px;
    background: root.theme.canvas;
    in property <[OptionRow]> options;
    in-out property <[SelectionRef]> selected;
    callback membership-changed(OptionRow, bool);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Keep in the loop"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Choose your notification channels. Email is selected initially; SMS is unavailable."; color: root.theme.text-secondary; wrap: word-wrap; }
        KitToggleGroup { theme: root.theme; options: root.options; selected <=> root.selected; selection-changed(row, added) => { root.membership-changed(row, added); } }
        Text { text: "Selected channels: " + root.selected.length; color: root.theme.text-secondary; }
    }
}
