import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
import { KitChip, KitButton, KitTheme, KitThemes, ChipRow } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    title: "Chip";
    preferred-width: 560px; preferred-height: 300px;
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    in property <[ChipRow]> chips; callback remove(int); callback reset();
    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
        Text { text: "Make it your own"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; }
        Text { text: "Tags keep a project easy to find. Remove a tag or restore the set."; color: root.theme.text-secondary; wrap: word-wrap; }
        FlexboxLayout { spacing: 10px; flex-wrap: wrap; alignment: start;
            for chip in root.chips: KitChip { theme: root.theme; chip: chip; remove-requested(token) => { root.remove(token); } }
        }
        KitButton { theme: root.theme; text: "Restore tags"; activated => { root.reset(); } }
        result := Text { text: root.chips.length + " tags selected"; color: root.theme.text-secondary; }
    }
}
