export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitMultiSelect, OptionRow, ChoiceRow, ChipRow, SelectState, NavigationStep, SelectionAvailability, KitTheme, KitThemes } from "@kit/kit.slint";
export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitMultiSelect example";
    preferred-width: 520px;
    preferred-height: 540px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    in property <[OptionRow]> rows;
    in property <[ChoiceRow]> choices;
    in property <[ChipRow]> chips;
    in property <SelectState> select-state;
    in property <string> result;
    callback toggle(int, int);
    callback navigate(NavigationStep);
    callback open();
    callback close();
    callback remove(int);
    callback query(string);
    callback typeahead(string);
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Keep in the loop"; color: root.theme.text-primary; font-size: 22px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
        Text { text: "Choose your notification channels. Selected channels appear above. Remove a chip to make it available again."; color: root.theme.text-secondary; wrap: word-wrap; }
        control := KitMultiSelect {
            theme: root.theme; rows: root.rows; chips: root.chips; state: root.select-state; placeholder: "Add another channel";
            open-requested => { root.open(); }
            navigate(step) => { root.navigate(step); }
            activate(token, generation) => { root.toggle(token, generation); }
            dismiss(reason) => { root.close(); }
            tab-navigation(reverse) => { return reject; }
            query-edited(text) => { root.query(text); }
            typeahead(text) => { root.typeahead(text); }
            remove-requested(token) => { root.remove(token); }
        }
        result := Text { text: root.result; color: root.theme.text-secondary; wrap: word-wrap; }
    }

}
