export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
import { KitTimePicker, KitButton, KitThemes, ValidationPresentation, TimeSegment, TimeAdjustment } from "@kit/kit.slint";
export { TimeSegment, TimeAdjustment }
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Local time"; preferred-width: 520px; preferred-height: 400px;
    max-width: 100000px; max-height: 100000px; background: root.theme.canvas;
    in-out property <string> draft; in property <string> error; in property <string> accepted;
    callback edited(string); callback commit(); callback blurred(); callback cancel();
    callback adjust(TimeSegment,TimeAdjustment);
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        control := KitTimePicker { theme: root.theme;
            required: true;
            label: "Local time"; text <=> root.draft; error: root.error;
            
            
            edited(value) => { root.edited(value); }
            commit-requested(value) => { root.commit(); }
            cancelled => { root.cancel(); }
            
            adjust(segment,direction)=>{root.adjust(segment,direction);}
        }
        KitButton { theme: root.theme; text: "Accept"; activated => { root.commit(); } }
        Text { text: "Accepted: " + root.accepted; color: root.theme.text-primary; wrap: word-wrap; }
    }
}
