export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFocusTarget, KitTextField, KitThemes, FocusRequest, KitButton } from "@kit/kit.slint";
export { FocusRequest }
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitFocusTarget";
    preferred-width: 460px;
    preferred-height: 260px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <string> draft;
    in property <FocusRequest> focus-request;
    callback request-focus();
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        KitButton { theme: root.theme; text: "Focus project name"; activated => { root.request-focus(); } }
        KitFocusTarget {
            token: 42; generation: 1; request: root.focus-request;
            focus-requested => { editor.take-focus(); }
            editor := KitTextField { theme: root.theme; label: "Project name"; text <=> root.draft; }
        }
        Text { text: "Draft: " + root.draft; color: root.theme.text-primary; }
    }
}
