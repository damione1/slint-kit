import { KitSlider, KitStack, KitFieldDescription, LayoutSpace, KitTheme, KitThemeContext } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "KitSlider example"; preferred-width: 560px; preferred-height: 360px;
    background: root.theme.canvas;
    in-out property <string> volume: "65";
    callback volume-changed(string);
    KitStack { theme: root.theme; inset: LayoutSpace.roomy;
        KitSlider { theme: root.theme; label: "Volume"; value <=> root.volume;
            value-label: root.volume + " percent";
            spec: {minimum: "0", maximum: "100", step: "5"};
            chosen(value) => { root.volume-changed(value); }
        }
        KitFieldDescription { theme: root.theme; text: "Value: " + root.volume; }
    }
}
