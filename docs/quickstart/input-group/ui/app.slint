import { KitInputGroup, KitInputGroupText, KitTheme, KitThemes } from "@kit/kit.slint";

export component App inherits Window {
    title: "KitInputGroup example";
    preferred-width: 420px;
    preferred-height: 180px;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <string> draft-0: "example.com";
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Input Group"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitInputGroup { theme: root.theme; focused: editor.has-focus; HorizontalLayout { spacing: 8px; KitInputGroupText { theme: root.theme; text: "https://"; } editor := TextInput { accessible-label: "Website"; font-size: 14px * root.theme.text-scale; vertical-alignment: center; text <=> root.draft-0; color: root.theme.text-primary; } KitInputGroupText { theme: root.theme; text: "/"; } } }
    }
}
