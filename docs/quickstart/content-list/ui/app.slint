export { KitThemeContext, KitThemes } from "@kit/kit.slint";
import { KitMetrics, KitTheme, KitThemeContext, TypographyRole } from "@kit/kit.slint";
import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitContentList, KitThemes, ContentItem, NavigationStep } from "@kit/kit.slint";
export { ContentItem, NavigationStep }
export component App inherits Window {
    in-out property <KitTheme> theme: KitThemeContext.current;
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "Slint content list";
    preferred-width: 580px; preferred-height: 650px;
    max-width: 100000px; max-height: 100000px;
    background: root.theme.canvas;
    in property <[ContentItem]> items;
    in property <int> active-index: -1;
    in property <string> selected-label: "Choose an article";
    callback choose(int, int);
    callback move(NavigationStep);
    VerticalLayout {
        padding: 24px; spacing: 16px;
        Text { text: "A little inspiration for your next build"; color: root.theme.text-primary; font-size: 22px; font-weight: 600; wrap: word-wrap; }
        Text { text: "Practical guides for thoughtful, accessible native applications."; color: root.theme.text-secondary; wrap: word-wrap; }
        list := KitContentList { theme: root.theme; height: 440px; items: root.items; generation: 1;
            active-index: root.active-index;
            activate(token, generation) => { root.choose(token, generation); }
            navigate(step) => { root.move(step); }
        }
        Text { text: root.selected-label; color: root.theme.text-primary; }
    }
}
