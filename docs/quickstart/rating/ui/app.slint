import { LayoutSpace } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

// SPDX-License-Identifier: GPL-3.0-or-later

import { KitRating, KitStack, KitThemeContext, RatingView } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "KitRating example"; preferred-width: 560px; preferred-height: 360px;
    background: KitThemeContext.current.canvas;
    callback feedback-changed(RatingView);
    KitStack { inset: LayoutSpace.roomy; KitRating { label: "Your rating"; scale: 5; chosen(value) => { root.feedback-changed(value); } } }
}
