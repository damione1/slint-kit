import { InterFont } from "@kit/fonts/inter.slint";
export { KitFormValidation, HtmlInputKind, NumberInputFormat, KitInputConstraints, KitValidationResult, KitValidityState } from "@kit/kit.slint";
import {KitZonedDateTimeField,KitButton,KitThemes,CivilDateView,LocalTimeView,LocalDateTimeView,LocalDateTimeDraft,ZonedDateTimeDraft,ZonedTimePresentation,AmbiguousTimeChoice} from "@kit/kit.slint";
export {CivilDateView,LocalTimeView,LocalDateTimeView,LocalDateTimeDraft,ZonedDateTimeDraft,ZonedTimePresentation,AmbiguousTimeChoice}
export component App inherits Window {
    default-font-family: InterFont.family;
 title:"zoned-date-time-field";preferred-width:560px;preferred-height:660px;max-width:100000px;max-height:100000px;background:KitThemes.light.canvas;
 in-out property <string> date-text:"2026-10-17";in-out property <string> time-text:"09:30";in-out property <string> zone-text:"America/Toronto";
 in property <LocalDateTimeView> accepted-local;in property <string> error;in property <string> accepted;
 in property <ZonedTimePresentation> resolution;callback commit(ZonedDateTimeDraft);callback edit();callback choose(AmbiguousTimeChoice);callback cancel();
 VerticalLayout {padding:24px;spacing:16px;alignment:start;
 control:=KitZonedDateTimeField{label:"Appointment";date-text<=>root.date-text;time-text<=>root.time-text;date-error:root.error;
 zone-text<=>root.zone-text;accepted-local:root.accepted-local;resolution:root.resolution;resolution-message:root.error;resolve-requested(draft)=>{root.commit(draft);}ambiguity-chosen(choice)=>{root.choose(choice);}
 edited(draft)=>{root.edit();}cancelled=>{root.cancel();}
 }
 KitButton{text:"Resolve time zone";activated=>{root.commit({date:root.date-text,time:root.time-text,zone:root.zone-text});}}
 Text{text:"Accepted: "+root.accepted;color:KitThemes.light.text-primary;wrap:word-wrap;}
 }
}
