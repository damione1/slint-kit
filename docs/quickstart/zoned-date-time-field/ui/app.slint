import { KitTheme, KitThemeContext, LayoutSpace } from "@kit";

import { KitZonedDateTimeField, ZonedDateTimeCommit, KitStack, KitButton } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    preferred-width: 560px; preferred-height: 660px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "Zoned date and time";
    callback chosen(ZonedDateTimeCommit);
    KitStack { inset: LayoutSpace.roomy;
        control := KitZonedDateTimeField { label: "Appointment"; date-text: "2026-11-01"; time-text: "01:30"; zone-text: "America/Toronto"; required: true; chosen(value) => { root.chosen(value); } }
        KitButton { text: "Resolve time"; activated => { control.resolve(); } }
    }
}
