
import { KitMetrics, KitThemeContext, TypographyRole } from "@kit";
import { InterFont } from "@kit/fonts/inter.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
// Display projections are fixtures. Validate accepted domain values in Rust.
import { KitTheme, KitThemes, KitTimeline, Tone } from "@kit";

export component App inherits Window {
    default-font-family: InterFont.family;
    default-font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
    title: "KitTimeline example";
    preferred-width: 600px;
    preferred-height: 350px * root.theme.text-scale;
    max-width: 100000px;
    max-height: 100000px;
    background: root.theme.canvas;
    in-out property <KitTheme> theme: KitThemeContext.current;
    VerticalLayout {
        padding: 24px; spacing: 16px; alignment: start;
        Text { text: "Timeline"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
        KitTimeline { theme: root.theme; entries: [{ tone: Tone.accent, glyph: root.theme.icons.article, title: "Project created", description: "Elliot opened the workspace.", metadata: "09:00" }, { tone: Tone.success, glyph: root.theme.icons.check, title: "Research shared", description: "Darlene added the interview notes.", metadata: "09:30" }, { tone: Tone.warning, glyph: root.theme.icons.warning, title: "Ready for review", description: "The team can leave feedback.", metadata: "10:15" }]; }
    }
}
