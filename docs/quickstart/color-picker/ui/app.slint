import { LayoutSpace } from "@kit";
import { KitTheme, KitThemeContext } from "@kit";

// SPDX-License-Identifier: GPL-3.0-or-later

import { KitColorPicker, KitStack, KitThemeContext, SrgbColorView, KitButton } from "@kit";
export component App inherits Window {
    max-width: 100000px; max-height: 100000px;
    in-out property <KitTheme> theme <=> KitThemeContext.current;
    title: "KitColorPicker example"; preferred-width: 560px; preferred-height: 550px;
    background: KitThemeContext.current.canvas;
    callback accent-changed(SrgbColorView);
    KitStack { inset: LayoutSpace.roomy; control := KitColorPicker { label: "Accent color"; accepted-color: {red: 79, green: 70, blue: 229, alpha: 255}; chosen(value) => { root.accent-changed(value); } }
        KitButton { text: "Apply color"; activated => { control.commit(); } } }
}
