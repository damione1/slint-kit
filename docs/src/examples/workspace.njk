<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="robots" content="noindex"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Workspace · Slint Kit</title>
<style>*{box-sizing:border-box}body{display:flex;flex-direction:column;height:100dvh;overflow:hidden;margin:0;font:14px system-ui;background:#f1f5f9;color:#0f172a}header{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 20px;background:white;border-bottom:1px solid #cbd5e1}label{display:flex;gap:6px;align-items:center}select{font:inherit;padding:6px;border:1px solid #94a3b8;border-radius:6px;background:white}a{color:#4338ca}.runtime-note{flex-shrink:0;margin:0;padding:7px 20px;font-size:12px;line-height:1.5;background:#e0e7ff;color:#312e81;border-bottom:1px solid #c7d2fe}main{position:relative;flex:1;min-height:0}canvas{display:block;width:100%!important;height:100%!important;outline:none}#loading{position:absolute;inset:32px;pointer-events:none}</style></head>
<body><header><strong>Slint Kit · Workspace</strong><label>Mode <select name="mode"><option value="light">Light</option><option value="dark">Dark</option></select></label><label>Text <select name="scale"><option value="1">100%</option><option value="2">200%</option></select></label><label>Screen <select name="scene"><option value="account">Account</option><option value="projects">Projects</option><option value="dialog">Edit dialog</option></select></label><label>Brand <select name="brand"><option value="default">Default</option><option value="studio">Studio teal</option></select></label><label>Language <select name="lang"><option value="en">English</option><option value="fr">Français</option></select></label><a href="/guides/workspace/" data-copy="guide">Use this example</a><details><summary data-copy="licenses">Source &amp; licenses</summary><a data-download="source.tar.gz">GPL source bundle</a> · <a data-download="LICENSE">GPL license</a> · <a data-download="NOTICE.txt">Notice</a> · <a data-download="THIRD_PARTY_NOTICES.txt">Third-party notices</a></details></header>
<p class="runtime-note" data-copy="runtime">Live Slint interface · Rust compiled to WebAssembly. The same source builds as a native application.</p>
<main><div id="loading" role="status">Loading Slint components…</div><canvas id="canvas" tabindex="0" aria-label="Interactive workspace"></canvas></main>
<script type="module">
const french=new URLSearchParams(location.search).get('lang')==='fr';document.documentElement.lang=french?'fr':'en';
if(french){const labels={mode:'Mode',scale:'Texte',scene:'Écran',brand:'Marque',lang:'Langue'},options={light:'Clair',dark:'Sombre',account:'Compte',projects:'Projets',dialog:'Dialogue d’édition',default:'Par défaut',studio:'Studio turquoise',en:'Anglais',fr:'Français'};for(const select of document.querySelectorAll('select')){select.parentElement.firstChild.textContent=labels[select.name]+' ';for(const option of select.options)if(options[option.value])option.textContent=options[option.value]}document.querySelector('[data-copy="guide"]').textContent='Utiliser cet exemple';document.querySelector('[data-copy="guide"]').href='/fr/guides/workspace/';document.querySelector('[data-copy="runtime"]').textContent='Interface Slint réelle · Rust compilé en WebAssembly. Le même code se compile en application native.';document.querySelector('[data-copy="licenses"]').textContent='Sources et licences';document.title='Espace de travail · Slint Kit';document.querySelector('header strong').textContent='Slint Kit · Espace de travail';document.querySelector('canvas').setAttribute('aria-label','Espace de travail interactif');document.querySelector('[data-download="source.tar.gz"]').textContent='Sources GPL';document.querySelector('[data-download="LICENSE"]').textContent='Licence GPL';document.querySelector('[data-download="THIRD_PARTY_NOTICES.txt"]').textContent='Avis de tiers';document.querySelector('#loading').textContent='Chargement des composants Slint…'}
const defaults={mode:'light',scale:'1',scene:'account',brand:'default',lang:'en'}, params=new URLSearchParams(location.search);params.delete('theme');
for(const select of document.querySelectorAll('select')){select.value=params.get(select.name)||defaults[select.name];select.addEventListener('change',()=>{for(const input of document.querySelectorAll('select'))params.set(input.name,input.value);location.search=params.toString()})}
try{const manifest=await fetch('/assets/workspace-preview/manifest.json').then(response=>{if(!response.ok)throw Error('Preview assets unavailable');return response.json()});for(const link of document.querySelectorAll('[data-download]'))link.href=manifest.base+'/'+link.dataset.download;const module=await import(manifest.module);window.workspacePreview=module;try{await module.default()}catch(error){if(!String(error).includes("Using exceptions for control flow, don't mind me."))throw error}document.querySelector('#loading').remove();document.querySelector('canvas').dataset.ready='true';if(params.get('scene')==='dialog')document.querySelector('canvas').focus()}catch(error){document.querySelector('#loading').textContent=(french?'Aperçu indisponible : ':'Preview unavailable: ')+error.message;console.error(error)}
</script></body></html>
