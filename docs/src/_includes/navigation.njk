<p class="nav-heading">{{ ui[locale].guides }}</p>
{% for key, label in { 'getting-started': ui[locale].start, 'controllers': ui[locale].controllers, 'forms': ui[locale].forms, 'themes': ui[locale].themes, 'native': ui[locale].native, 'table-example': ui[locale].tableExample } %}
<a href="{{ ('guides/' + key + '/') | localeUrl(locale) }}"{% if translationKey == 'guides/' + key + '/' %} aria-current="page"{% endif %}>{{ label }}</a>
{% endfor %}
<a href="{{ 'guides/migration-0-4/' | localeUrl(locale) }}"{% if translationKey == 'guides/migration-0-4/' %} aria-current="page"{% endif %}>{% if locale == 'fr' %}Migrer vers la 0.4{% else %}Migrating to 0.4{% endif %}</a>
<a href="{{ 'guides/workspace/' | localeUrl(locale) }}"{% if translationKey == 'guides/workspace/' %} aria-current="page"{% endif %}>{% if locale == 'fr' %}Composer une application{% else %}Compose an application{% endif %}</a>
<p class="nav-heading">{{ ui[locale].components }} <span>{{ components.length }}</span></p>
<a href="{{ 'components/' | localeUrl(locale) }}">{{ ui[locale].catalogue }}</a>
<a href="{{ 'components/icon/' | localeUrl(locale) }}"{% if translationKey == 'components/icon/' %} aria-current="page"{% endif %}>{% if locale == 'fr' %}Icônes Lucide{% else %}Lucide icons{% endif %}</a>
{% for family, label in ui.families %}
{% set members = components | whereFamily(family) %}
<details class="family"{% if entry and entry.component.family == family %} open{% endif %}>
  <summary>{{ label[locale] }} <span>{{ members.length }}</span></summary>
  {% for component in members %}<a href="{{ ('components/' + component.slug + '/') | localeUrl(locale) }}" title="{{ component.name }}"{% if entry and entry.component.name == component.name %} aria-current="page"{% endif %}>{{ component | componentLabel(locale) }}</a>{% endfor %}
</details>
{% endfor %}
