<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ seo.title }}</title>
  <meta name="description" content="{{ seo.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Slint Kit">
  <meta property="og:title" content="{{ seo.title }}">
  <meta property="og:description" content="{{ seo.description }}">
  <meta property="og:url" content="{{ seo.url }}">
  <meta property="og:locale" content="{{ seo.locale }}">
  <meta property="og:locale:alternate" content="{{ seo.alternateLocale }}">
  <meta property="og:image" content="{{ seo.image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ seo.imageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo.title }}">
  <meta name="twitter:description" content="{{ seo.description }}">
  <meta name="twitter:image" content="{{ seo.image }}">
  <meta name="twitter:image:alt" content="{{ seo.imageAlt }}">
  <script type="application/ld+json">{{ seo | structuredData(site, locale) | scriptJson | safe }}</script>
  <link rel="icon" href="/assets/branding/slint-kit-symbol.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/site.css' | versionedAsset }}">
  {% if site.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ translationKey | localeUrl('fr') }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ translationKey | localeUrl('en') }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ translationKey | localeUrl('en') }}">
  <script src="{{ '/assets/site.js' | versionedAsset }}" defer></script>
</head>
<body>
<a class="skip" href="#main">{{ ui[locale].skip }}</a>
<header class="topbar">
  <a class="brand" href="{{ '' | localeUrl(locale) }}" aria-label="Slint Kit — {{ ui[locale].home }}">
    <img src="/assets/branding/slint-kit-symbol.svg" alt="" width="32" height="40"><span>Slint <b>Kit</b></span>
  </a>
  <span class="site-label">{{ ui[locale].documentation }}</span>
  <nav class="toplinks" aria-label="{% if locale == 'fr' %}Navigation principale{% else %}Main navigation{% endif %}">
    <a href="{{ 'components/' | localeUrl(locale) }}"{% if translationKey == 'components/' %} aria-current="page"{% endif %}>{{ ui[locale].components }}</a>
    <a href="{{ site.repository }}">GitHub<span class="sr-only"> ({{ ui[locale].source }})</span></a>
    {% if locale == 'fr' %}<a class="language" href="{{ translationKey | localeUrl('en') }}" lang="en" hreflang="en" aria-label="This page in English">EN</a>{% else %}<a class="language" href="{{ translationKey | localeUrl('fr') }}" lang="fr" hreflang="fr" aria-label="Cette page en français">FR</a>{% endif %}
  </nav>
</header>
<div class="page-shell{% if home %} home-shell{% endif %}">
{% if not home %}
<aside class="sidebar">
  <nav class="desktop-nav" aria-label="{{ ui[locale].documentation }}">
  {% include "navigation.njk" %}
  </nav>
  <details class="mobile-nav">
  <summary>{{ ui[locale].documentation }}</summary>
  <nav aria-label="{{ ui[locale].documentation }}">
  {% include "navigation.njk" %}
  </nav>
  </details>
</aside>
{% endif %}
<main id="main" tabindex="-1" class="{% if home %}homepage{% else %}article{% endif %}">
{% if seo.breadcrumbs.length %}<nav class="breadcrumbs" aria-label="{% if locale == 'fr' %}Fil d’Ariane{% else %}Breadcrumb{% endif %}"><ol>{% for crumb in seo.breadcrumbs %}<li>{% if loop.last %}<span aria-current="page">{{ crumb.name }}</span>{% else %}<a href="{{ crumb.url }}">{{ crumb.name }}</a>{% endif %}</li>{% endfor %}</ol></nav>{% endif %}
{{ content | safe }}</main>
</div>
<footer class="site-footer"><span>Slint Kit</span> <a href="{{ site.repository }}/blob/main/LICENSE">{{ ui[locale].license }}</a></footer>
</body>
</html>
