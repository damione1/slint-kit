import { KitStat, KitButton, Tone, KitTheme, KitThemes } from "@kit";
export component StatFixture inherits Window {
    width: 300px; height: 200px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <Tone> tone;
    background: root.theme.canvas;
    KitStat { x: 24px; y: 24px; width: parent.width - 48px; theme: root.theme; tone: root.tone; label: "Revenue"; value: "88"; leading-icon: root.theme.icons.check; }
}

export component BusyButtonFixture inherits Window {
    width: 240px; height: 120px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    background: root.theme.canvas;
    KitButton { x: 24px; y: 24px; width: self.preferred-width; height: self.preferred-height; theme: root.theme; text: "Save"; busy: true; busy-label: "Saving changes"; }
}

import { KitFilePicker, KitDirectoryPicker, KitSteps, StepState, HostRequestPresentation } from "@kit";
export component FileLocalizationFixture inherits Window {
    width: 1000px; height: 800px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    background: root.theme.canvas;
    VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
        KitFilePicker { theme: root.theme; label: "Pièces jointes"; request-state: HostRequestPresentation.unsupported; entries: [{ token: 1, generation: 1, name: "notes.txt", removable: true }]; }
        KitDirectoryPicker { theme: root.theme; label: "Destination"; selected-name: "Projet"; request-state: HostRequestPresentation.cancelled; }
        KitSteps { theme: root.theme; entries: [
            { token: 1, label: "Préparer", state: StepState.current },
            { token: 2, label: "Envoyer", state: StepState.complete },
            { token: 3, label: "Vérifier", state: StepState.error },
            { token: 4, label: "Terminer", state: StepState.pending },
        ]; }
    }
}

import { KitPressable } from "@kit";
export component DisabledActionFocusFixture inherits Window {
    width: 460px; height: 200px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <bool> disabled;
    in property <bool> busy;
    out property <bool> standard-focused: standard.has-focus;
    out property <bool> standard-focus-visible: standard.focus-visible;
    out property <bool> custom-focused: custom.has-focus;
    out property <bool> custom-focus-visible: custom.focus-visible;
    callback focus-observed(bool, bool);
    out property <bool> fallback-focused: fallback.has-focus;
    public function focus-fallback() { fallback.focus(); }
    public function focus-action(is-custom: bool) {
        if (is-custom) { custom.take-focus(); } else { standard.take-focus(); }
    }
    fallback := FocusScope {
        width: 0px; height: 0px;
        focus-on-tab-navigation: false;
        accessible-role: none;
    }
    background: root.theme.canvas;
    VerticalLayout { padding: 24px; spacing: 16px; alignment: start;
        standard := KitButton {
            theme: root.theme; text: "Standard action";
            disabled: root.disabled; busy: root.busy;
            focus-observed(value) => { root.focus-observed(false, value); }
        }
        custom := KitPressable {
            preferred-width: title.preferred-width + 2 * self.padding-inline;
            theme: root.theme; accessible-name: "Custom action";
            disabled: root.disabled; busy: root.busy;
            focus-observed(value) => { root.focus-observed(true, value); }
            title := Text { text: "Custom action"; color: custom.disabled ? custom.recipe.disabled-foreground : custom.recipe.foreground; font-family: root.theme.typography.family; font-size: custom.text-size; }
        }
    }
}

import { KitFileDropZone, FieldAccess, DropCapability } from "@kit";
export component DropZoneFixture inherits Window {
    width: 420px; height: 240px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <FieldAccess> access;
    background: root.theme.canvas;
    callback browse();
    callback child-activated();
    in property <bool> composed-action;
    out property <bool> focused: zone.has-focus;
    public function focus-zone() { zone.take-focus(); }
    VerticalLayout { padding: 24px; alignment: start;
        zone := KitFileDropZone { theme: root.theme; access: root.access; capability: DropCapability.available; label: "Choose or drop documents"; description: "PDF and text files"; browse-requested => { root.browse(); }
            if root.composed-action: KitButton { theme: root.theme; text: "Additional action"; activated => { root.child-activated(); } }
        }
    }
}

import { ButtonIntent } from "@kit";
export component ButtonPaletteFixture inherits Window {
    width: 1040px; height: 140px;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <int> link-actions;
    in property <bool> link-disabled;
    public function focus-link() { link.take-focus(); }
    background: root.theme.canvas;
    HorizontalLayout { padding: 24px; spacing: 16px; alignment: start;
        KitButton { theme: root.theme; intent: ButtonIntent.success; text: "Confirm"; }
        KitButton { theme: root.theme; intent: ButtonIntent.warning; text: "Review"; }
        KitButton { theme: root.theme; intent: ButtonIntent.information; text: "Details"; }
        KitButton { theme: root.theme; intent: ButtonIntent.destructive; text: "Delete"; }
        link := KitButton { theme: root.theme; intent: ButtonIntent.link; text: "Learn more"; disabled: root.link-disabled; activated => { root.link-actions += 1; } }
    }
}

import { KitIcon, KitScrollBar, KitSurface, KitCard, KitContainer, IconRecipe, ScrollBarRecipe, SurfaceRecipe, SurfaceLevel, ControlSize } from "@kit";
export component RecipeOverrideFixture inherits Window {
    width: 700px; height: 400px;
    in-out property <KitTheme> theme: KitThemes.light;
    in-out property <IconRecipe> icon-recipe: KitThemes.icon-recipe(root.theme, ControlSize.medium);
    in-out property <ScrollBarRecipe> scroll-recipe: KitThemes.scroll-bar-recipe(root.theme);
    in-out property <SurfaceRecipe> surface-recipe: KitThemes.surface-recipe(root.theme, SurfaceLevel.flat);
    in property <SurfaceLevel> card-level;
    out property <SurfaceRecipe> card-recipe: card.recipe;
    background: root.theme.canvas;
    KitIcon { x: 24px; y: 24px; theme: root.theme; glyph: root.theme.icons.check; recipe: root.icon-recipe; }
    KitScrollBar { x: 100px; y: 24px; width: self.preferred-width; height: 180px; theme: root.theme; maximum: 300px; page-size: 100px; recipe: root.scroll-recipe; }
    KitSurface { x: 180px; y: 24px; width: 180px; height: 100px; theme: root.theme; recipe: root.surface-recipe; }
    card := KitCard { x: 400px; y: 24px; width: 220px; height: self.preferred-height; theme: root.theme; level: root.card-level; Text { text: "Card"; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: root.theme.typography.size-control * root.theme.text-scale; } }
    KitContainer { x: 24px; y: 250px; width: 600px; height: self.preferred-height; max-content-width: 140px; theme: root.theme; bounded-body := Rectangle { height: 32px; Text { text: "Bounded"; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: root.theme.typography.size-control * root.theme.text-scale; } } }
}

import { KitAvatar, AvatarSize } from "@kit";
export component AvatarSizingFixture inherits Window {
    width: 420px; height: 260px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <bool> disabled;
    background: root.theme.canvas;
    KitAvatar { x: 24px; y: 24px; theme: root.theme; size: 24px; initials: "EA"; }
    KitAvatar { x: 80px; y: 24px; theme: root.theme; size: 96px; initials: "EA"; accessible-name: "Large initials";
        large-status := Rectangle {
            x: parent.width - self.width; y: parent.height - self.height;
            width: root.theme.spacing.unit * 2; height: self.width;
            border-radius: self.width / 2; background: root.theme.success;
            accessible-role: none;
        }
    }
    KitAvatar { x: 220px; y: 24px; theme: root.theme; avatar-size: AvatarSize.compact; accessible-name: "Unknown profile"; disabled: root.disabled; }
}
