import { KitColorField, SrgbColorView, ColorAlphaMode, KitMultiSelect, KitTagInput, ChipRow, KitTimePicker, TimeSegment, TimeAdjustment, KitThemes, KitTheme, FieldAccess } from "@kit/kit.slint";

export component FormCorrectionsFixture inherits Window {
    width: 640px; height: 760px;
    in property <float> text-scale: 1;
    in property <length> viewport-width: 640px;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[ChipRow]> chips;
    out property <length> chips-width: multi.width;
    out property <length> window-width: root.width;
    out property <bool> picker-open: color.picker-open;
    private property <KitTheme> base-theme: KitThemes.light;
    private property <KitTheme> theme: {canvas:root.base-theme.canvas,surface:root.base-theme.surface,surface-raised:root.base-theme.surface-raised,text-primary:root.base-theme.text-primary,text-secondary:root.base-theme.text-secondary,placeholder:root.base-theme.placeholder,accent:root.base-theme.accent,on-accent:root.base-theme.on-accent,accent-hover:root.base-theme.accent-hover,accent-pressed:root.base-theme.accent-pressed,accent-subtle:root.base-theme.accent-subtle,selection:root.base-theme.selection,on-selection:root.base-theme.on-selection,danger:root.base-theme.danger,danger-hover:root.base-theme.danger-hover,danger-pressed:root.base-theme.danger-pressed,danger-subtle:root.base-theme.danger-subtle,success:root.base-theme.success,success-subtle:root.base-theme.success-subtle,warning:root.base-theme.warning,warning-subtle:root.base-theme.warning-subtle,information:root.base-theme.information,information-subtle:root.base-theme.information-subtle,border-subtle:root.base-theme.border-subtle,border-strong:root.base-theme.border-strong,hover:root.base-theme.hover,pressed:root.base-theme.pressed,disabled-fill:root.base-theme.disabled-fill,disabled-text:root.base-theme.disabled-text,scrim:root.base-theme.scrim,shape:root.base-theme.shape,elevation:root.base-theme.elevation,focus:root.base-theme.focus,typography:root.base-theme.typography,spacing:root.base-theme.spacing,motion:root.base-theme.motion,icons:root.base-theme.icons,reduced-motion:true,text-scale:root.text-scale};
    callback color-requested(SrgbColorView);
    callback adjust(TimeSegment,TimeAdjustment);
    public function open-picker() { color.open-picker(); }
    VerticalLayout {
        width: root.viewport-width;
        padding: 20px; spacing: 16px; alignment: start;
        color := KitColorField {
            theme: root.theme; access: root.access;
            label: "Accent"; text: "#4F46E5FF";
            alpha-mode: ColorAlphaMode.editable;
            accepted-color: {red:79,green:70,blue:229,alpha:255}; swatch:#4f46e5;
            color-requested(value) => { root.color-requested(value); }
        }
        multi := KitMultiSelect { theme: root.theme; access: root.access; chips: root.chips; }
        tags := KitTagInput { theme: root.theme; access: root.access; chips: root.chips; label: "Tags"; }
        time := KitTimePicker { theme: root.theme; access: root.access; label: "Start time"; text: "11:30"; adjust(segment,direction) => { root.adjust(segment,direction); } }
    }
}
