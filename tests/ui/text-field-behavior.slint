import { KitTextField, KitTextArea, CommitPolicy, ValidationTiming, FieldCommit, FieldAccess, TextPurpose, FieldState, TextLineMode, KitTheme, KitThemes } from "@kit";
export component TextFieldBehaviorFixture inherits Window {
    width: 600px; height: 400px;
    in-out property <string> text;
    in property <bool> multiline;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <CommitPolicy> policy: CommitPolicy.on-change-when-valid;
    in property <bool> required;
    in property <int> minimum: -1;
    in property <ValidationTiming> timing: ValidationTiming.on-submit;
    out property <bool> error-visible: field.validation-visible;
    out property <bool> dirty: field.dirty;
    out property <bool> has-focus: field.has-focus;
    callback committed(FieldCommit);
    callback invalid();
    public function focus-field() { field.take-focus(); }
    public function blur-field() { other.focus(); }
    public function report() -> bool { return field.report-validity(); }
    public function focus-invalid() -> bool { return field.focus-if-invalid(); }
    out property <int> cursor: field.cursor-position;
    out property <int> anchor: field.selection-anchor;
    public function selection(anchor: int, cursor: int) { field.set-selection(anchor, cursor); }
    public function insert(text: string) { field.insert-at-cursor(text); }
    public function undo() { field.undo(); }
    public function redo() { field.redo(); }
    public function select-all() { field.select-all(); }
    other := FocusScope { width: 0px; height: 0px; }
    VerticalLayout {
        padding: 24px; alignment: start;
        field := KitTextField {
            theme: root.theme; line-mode: root.multiline ? TextLineMode.multiline : TextLineMode.single-line;
            label: "Name"; text <=> root.text;
            commit-policy: root.policy; required: root.required;
            min-length: root.minimum; validation-timing: root.timing;
            committed(value) => { root.committed(value); }
            invalid => { root.invalid(); }
        }
    }
}
