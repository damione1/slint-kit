    out property <int> direct-cursor: direct.cursor-position-byte-offset;
    out property <int> direct-anchor: direct.anchor-position-byte-offset;
    out property <int> wrapped-cursor: wrapped.cursor-position-byte-offset;
    out property <int> wrapped-anchor: wrapped.anchor-position-byte-offset;
    out property <int> scrolled-cursor: scrolled.cursor-position-byte-offset;
    out property <int> scrolled-anchor: scrolled.anchor-position-byte-offset;
    direct := TextInput {
        x: 24px; y: 24px; width: 552px; height: 60px;
