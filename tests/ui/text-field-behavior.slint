        accessible-label: "Direct"; color: KitThemes.light.text-primary;
    }
    TouchArea {
        x: 24px; y: 120px; width: 552px; height: 60px;
        wrapped := TextInput {
            text: root.text; single-line: false; wrap: word-wrap;
            accessible-label: "Wrapped"; color: KitThemes.light.text-primary;
        }
    }
    TouchArea {
        x: 24px; y: 216px; width: 552px; height: 60px;
        viewport := Flickable {
            interactive: true; mouse-drag-pan-enabled: false;
            content-width: self.width; content-height: 300px;
            scrolled := TextInput {
                width: viewport.width; height: viewport.content-height;
                text: root.text; single-line: false; wrap: word-wrap;
                accessible-label: "Scrolled"; color: KitThemes.light.text-primary;
