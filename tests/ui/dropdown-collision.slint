import { DropdownPlacement, KitSelect, KitCombobox, KitMultiSelect, KitTextField, KitTheme, KitThemes, KitMetrics, OptionRow, SelectState, SelectionRef, Ownership, KitKeyResult } from "@kit";
export enum DropdownProbeKind { select, combobox, multi-select }
export component DropdownCollisionFixture inherits Window {
    width: root.narrow ? 220px : 560px; height: 560px;
    in property <DropdownProbeKind> kind;
    in property <bool> narrow;
    in property <bool> bottom;
    in property <DropdownPlacement> placement: DropdownPlacement.auto;
    // A 300px popup width; otherwise each control keeps its own default width.
    in property <bool> wide;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <[OptionRow]> options;
    in property <Ownership> ownership: Ownership.local;
    in-out property <SelectionRef> single-value;
    in-out property <[SelectionRef]> multiple-value;
    in-out property <int> proposals;
    out property <OptionRow> last-proposal;
    out property <SelectState> state: root.kind == DropdownProbeKind.select ? single.state : root.kind == DropdownProbeKind.combobox ? combo.state : multi.state;
    out property <int> page-rows: root.kind == DropdownProbeKind.select ? single.page-rows : root.kind == DropdownProbeKind.combobox ? combo.page-rows : multi.page-rows;
    in-out property <string> combo-text <=> combo.text;
    in-out property <string> outside-text <=> outside.text;
    out property <bool> outside-focused: outside.has-focus;
    background: root.theme.canvas;
    public function take-focus() {
        if (root.kind == DropdownProbeKind.select) { single.take-focus(); }
        else if (root.kind == DropdownProbeKind.combobox) { combo.take-focus(); }
        else { multi.take-focus(); }
    }
    function advance-tab() -> KitKeyResult { outside.take-focus(); return KitKeyResult.accept; }
    single := KitSelect {
        visible: root.kind == DropdownProbeKind.select;
        x: root.bottom ? parent.width - self.width - 8px : 8px;
        y: root.bottom ? parent.height - self.height - 8px : 90px;
        width: 160px; height: self.preferred-height;
        placement: root.placement; popup-width: root.wide ? 300px : max(self.width, KitMetrics.select-popup-min-width(root.theme));
        theme: root.theme; options: root.options; ownership: root.ownership;
        selected <=> root.single-value;
        searchable: true; focus-search-on-open: false; label: "Single choice";
        chosen(row) => { root.proposals += 1; root.last-proposal = row; }
        tab-navigation(reverse) => { return root.advance-tab(); }
    }
    combo := KitCombobox {
        visible: root.kind == DropdownProbeKind.combobox;
        x: root.bottom ? parent.width - self.width - 8px : 8px;
        y: root.bottom ? parent.height - self.height - 8px : 90px;
        width: 160px; height: self.preferred-height;
        placement: root.placement; popup-width: root.wide ? 300px : self.width;
        theme: root.theme; options: root.options; ownership: root.ownership;
        selected <=> root.single-value; label: "Editable choice";
        chosen(row) => { root.proposals += 1; root.last-proposal = row; }
        tab-navigation(reverse) => { return root.advance-tab(); }
    }
    multi := KitMultiSelect {
        visible: root.kind == DropdownProbeKind.multi-select;
        x: root.bottom ? parent.width - self.width - 8px : 8px;
        y: root.bottom ? parent.height - self.height - 8px : 90px;
        width: 160px; height: self.preferred-height;
        placement: root.placement; popup-width: root.wide ? 300px : max(self.width, KitMetrics.select-popup-min-width(root.theme));
        theme: root.theme; options: root.options; ownership: root.ownership;
        selected <=> root.multiple-value;
        searchable: true; focus-search-on-open: false; label: "Multiple choices";
        selection-changed(row, added) => { root.proposals += 1; root.last-proposal = row; }
        tab-navigation(reverse) => { return root.advance-tab(); }
    }
    outside := KitTextField { x: 8px; y: 8px; width: parent.width - 16px; theme: root.theme; label: "Outside editor"; }
}
