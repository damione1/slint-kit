import { ScrollView } from "std-widgets.slint";
export component DirectValidationFixture inherits Window {
    width: 640px; height: 1150px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    background: root.theme.canvas;
    in-out property <FieldAccess> access: FieldAccess.editable;
    out property <bool> sentinel-focus: sentinel.has-focus;
    out property <bool> consent-focus: consent.has-focus;
    out property <KitValidityState> consent-validity: consent.validity;
    out property <KitValidityState> selection-validity: selection.validity;
    out property <KitValidityState> attachment-validity: attachment.validity;
    out property <KitValidityState> meeting-validity: meeting.validity;
    out property <bool> consent-candidate: consent.will-validate;
    out property <bool> selection-candidate: selection.will-validate;
    out property <bool> attachment-candidate: attachment.will-validate;
    out property <bool> meeting-candidate: meeting.will-validate;
    out property <string> consent-message: consent.validation-message;
    out property <string> selection-message: selection.validation-message;
    out property <string> attachment-message: attachment.validation-message;
    out property <string> meeting-message: meeting.validation-message;
    public function focus-sentinel() { sentinel.take-focus(); }
    public function focus-consent() { consent.take-focus(); }
    public function focus-selection() { selection.take-focus(); }
    public function focus-attachment() { attachment.take-focus(); }
    public function focus-meeting() { meeting.take-focus(); }
    public function report-consent() -> bool { return consent.report-validity(); }
    public function report-selection() -> bool { return selection.report-validity(); }
    public function report-attachment() -> bool { return attachment.report-validity(); }
    public function report-meeting() -> bool { return meeting.report-validity(); }
    public function focus-invalid-consent() -> bool { return consent.focus-if-invalid(); }
    public function focus-invalid-selection() -> bool { return selection.focus-if-invalid(); }
    public function focus-invalid-attachment() -> bool { return attachment.focus-if-invalid(); }
    public function focus-invalid-meeting() -> bool { return meeting.focus-if-invalid(); }
    VerticalLayout { padding: 24px; spacing: root.theme.spacing.unit * 3; alignment: start;
        sentinel := KitTextField { theme: root.theme; label: "Focus sentinel"; }
        consent := KitCheckbox { theme: root.theme; access: root.access; label: "Consent"; required: true; }
        selection := KitSelect { theme: root.theme; access: root.access; placeholder: "Choose a region"; required: true; options: [{token: 17, generation: 1, label: "Region", description: "Available region", disabled: false}]; }
        attachment := KitFilePicker { theme: root.theme; access: root.access; label: "Attachment"; required: true; }
        meeting := KitDateTimeField { theme: root.theme; access: root.access; label: "Meeting"; required: true; }
    }
}

export component ZonedReportFocusFixture inherits Window {
    width: 640px;
    height: 640px;
    in-out property <int> invalid-count;
    out property <bool> sentinel-focus: sentinel.has-focus;
    out property <bool> zoned-focus: zoned.editor-focused;
    in-out property <string> date-text <=> zoned.date-text;
    in-out property <string> time-text <=> zoned.time-text;
    in-out property <string> zone-text <=> zoned.zone-text;
    public function focus-sentinel() { sentinel.take-focus(); }
    public function report-zoned() -> bool { return zoned.report-validity(); }
    public function focus-invalid-zoned() -> bool { return zoned.focus-if-invalid(); }
    VerticalLayout {
        sentinel := KitTextField { label: "Focus sentinel"; }
        zoned := KitZonedDateTimeField {
            label: "Local meeting and time zone";
            required: true;
            invalid => { root.invalid-count += 1; }
        }
    }
}

