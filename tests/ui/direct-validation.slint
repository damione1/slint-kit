import { KitTextField, KitZonedDateTimeField } from "@kit";
export component ZonedReportFocusFixture inherits Window {
    width: 640px;
    height: 640px;
    out property <bool> sentinel-focus: sentinel.has-focus;
    out property <bool> zoned-focus: zoned.editor-focused;
    out property <string> date-text: zoned.date-text;
    public function focus-sentinel() { sentinel.take-focus(); }
    public function take-focus-zoned() { zoned.take-focus(); }
    VerticalLayout {
        sentinel := KitTextField { label: "Focus sentinel"; }
        zoned := KitZonedDateTimeField { label: "Local meeting and time zone"; required: true; }
    }
}
