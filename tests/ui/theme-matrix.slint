export component ThemeMatrixFixture inherits Window {
    width: 1920px; height: 720px;
    ThemeMatrixCell { x: 0px; width: 480px; theme: KitThemes.light; }
    ThemeMatrixCell { x: 480px; width: 480px; theme: KitThemes.dark; }
    ThemeMatrixCell { x: 960px; width: 480px; theme: TailwindThemes.light; }
    ThemeMatrixCell { x: 1440px; width: 480px; theme: TailwindThemes.dark; }
