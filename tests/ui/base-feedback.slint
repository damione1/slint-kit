import { KitTheme, KitThemes, KitButton, KitTooltip, KitTooltipLayer, KitToast, KitToastHost, ToastEntry, ToastInteraction, KitAlert, AlertSeverity, KitProgress, KitRadialProgress, KitSpinner, KitSkeleton, KitContainer, KitScrollArea, KitCard, KitCardHeader, KitCardBody, KitWrap, KitTextField, ContentWidth, TooltipRecipe, KitTimeline, TimelineEntry, KitDivider } from "@kit/kit.slint";

export component BaseFeedbackFixture inherits Window {
    width: 640px; height: 480px;
    in property <KitTheme> theme: KitThemes.light;
    in property <length> viewport-width: root.width;
    in property <length> viewport-height: root.height;
    in property <bool> layer-enabled: true;
    in property <string> help: "Keyboard help";
    public pure function tooltip(theme: KitTheme) -> TooltipRecipe { return KitThemes.tooltip-recipe(theme); }
    in-out property <bool> alert-visible: true;
    out property <bool> target-focused: target.has-focus;
    out property <bool> tooltip-visible: tooltip.keyboard-visible;
    callback toast-action(int);
    callback toast-dismiss(int);
    callback toast-interaction(int,ToastInteraction,bool);
    callback alert-dismissed();
    public function focus-trigger() { target.take-focus(); }
    public function blur-trigger() { other.take-focus(); }
    Rectangle {
        x: 600px; y: 440px; width: 30px; height: 24px; clip: true;
        tooltip := KitTooltip {
            theme: root.theme; target-focused: target.has-focus; text: root.help;
            target := KitButton { theme: root.theme; text: "Tooltip target"; }
        }
    }
    other := KitButton { x: 460px; y: 20px; theme: root.theme; text: "Other target"; }
    KitToast {
        x: 20px; y: 100px; width: 400px; height: 180px; theme: root.theme;
        entry: {token:42,title:"Saved",message:"Changes are ready",action-label:"Undo",severity:AlertSeverity.success,dismissible:true};
        action(token) => { root.toast-action(token); }
        dismiss(token) => { root.toast-dismiss(token); }
        interaction(token,source,engaged) => { root.toast-interaction(token,source,engaged); }
    }
    if root.alert-visible: KitAlert {
        x: 20px; y: 300px; width: 400px; theme: root.theme;
        title: "Review needed"; message: "Your draft is safe.";
        severity: AlertSeverity.error; dismissible: true;
        dismissed => { root.alert-visible = false; root.alert-dismissed(); }
    }
    KitTooltipLayer { enabled: root.layer-enabled; viewport-width: root.viewport-width; viewport-height: root.viewport-height; }
}

export component BaseProgressFixture inherits Window {
    width: 640px; height: 480px;
    in property <KitTheme> theme: KitThemes.light;
    in property <float> progress;
    VerticalLayout { padding: 20px; spacing: 24px; alignment: start;
        KitProgress { theme: root.theme; value: root.progress; label: "Upload progress"; }
        KitRadialProgress { theme: root.theme; value: root.progress; label: "Review progress"; }
        spinner := KitSpinner { theme: root.theme; label: "Loading preview"; }
        skeleton := KitSkeleton { theme: root.theme; }
    }
}

// Consumer composition: the card must fit its children after a conditional is
// materialized, at the current width, without adding height for unused wrapping.
export component BaseConditionalAlertFixture inherits Window {
    width: root.viewport-width; height: 900px;
    in property <length> viewport-width: 720px;
    in property <KitTheme> theme: KitThemes.light;
    in property <string> message: "Your session is ready.";
    in property <bool> dismissible;
    in property <bool> expanded: true;
    KitScrollArea {
        KitCard { theme: root.theme;
            KitCardHeader { theme: root.theme; title: "Welcome"; description: "Connect to your installation."; }
            if root.expanded: KitCardBody {
                KitAlert { theme: root.theme; title: "Signed in"; message: root.message; dismissible: root.dismissible; }
                KitButton { theme: root.theme; text: "Continue"; }
            }
        }
    }
}

export component BaseLayoutFixture inherits Window {
    width: 800px; height: 700px;
    in property <KitTheme> theme: KitThemes.light;
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 260px;
    in-out property <string> draft: "Keep this draft";
    out property <bool> editor-focused: editor.has-focus;
    out property <length> content-width: container.available-width;
    out property <length> scroll-content-height: scroll.content-height;
    out property <length> scroll-viewport-height: scroll.visible-height;
    out property <length> scroll-offset: scroll.content-y;
    public function reveal-range(top: length, bottom: length) { scroll.reveal(top,bottom); }
    public function focus-editor() { editor.take-focus(); }
    public function reveal-editor() {
        let top = editor.absolute-position.y - scroll.absolute-position.y - scroll.content-y;
        scroll.reveal(top, top + editor.height);
    }
    scroll := KitScrollArea {
        width: root.viewport-width; height: root.viewport-height;
        container := KitContainer {
            content-width: ContentWidth.reading;
            card := KitCard { theme: root.theme;
                KitCardHeader { theme: root.theme; title: "A collection shaped together"; description: "Every small detail has room to breathe as the content grows."; }
                KitCardBody {
                    editor := KitTextField { theme: root.theme; label: "Collection title"; text <=> root.draft; }
                    KitWrap {
                        KitButton { theme: root.theme; text: "Review"; }
                        KitButton { theme: root.theme; text: "Publish"; }
                    }
                }
            }
        }
    }
}

// A host measures exactly its toasts: no space is reserved below the last one.
export component ToastHostFixture inherits Window {
    width: 520px; height: 420px;
    in property <[ToastEntry]> entries: [{ token: 1, title: "Project archived", message: "Your project can be restored.", action-label: "Undo", severity: AlertSeverity.success, dismissible: true }];
    VerticalLayout {
        alignment: start;
        host := KitToastHost { entries: root.entries; }
        Text { text: "Below the host"; }
        // Repeated surfaces measure their content, shadow or not.
        cards := VerticalLayout {
            alignment: start;
            for title in ["Repeated card"]: KitCard { KitCardHeader { title: title; } }
        }
        Text { text: "Below the cards"; }
    }
}


// Timeline geometry and paused loading placeholders share the theme's scale.
export component BaseDisplayQualityFixture inherits Window {
    width: 420px; height: 600px;
    in property <KitTheme> theme: KitThemes.light;
    in property <KitTheme> dark: KitThemes.dark;
    in property <bool> running: true;
    in property <[TimelineEntry]> entries: [
        {title:"Project created",description:"A draft is ready for review.",metadata:"Today · 09:10"},
        {title:"First review completed",description:"The network findings are ready to share.",metadata:"Today · 10:05"}
    ];
    VerticalLayout {
        padding: 24px; spacing: 24px; alignment: start;
        KitTimeline { theme: root.theme; entries: root.entries; }
        KitDivider { theme: root.theme; label: "Activity"; }
        KitSkeleton { theme: root.theme; running: root.running; }
    }
}
