            month-names: root.month-names; month-short-names: root.month-short-names; weekday-names: root.weekday-names; weekday-short-names: root.weekday-short-names; weekdays: root.weekdays; accessible-date-pattern: root.accessible-date-pattern; title-pattern: root.title-pattern; today-label: root.today-label; range-start-label: root.range-start-label; range-end-label: root.range-end-label; in-range-label: root.in-range-label;
        }
        range := KitDateRangePicker {
            theme: root.theme; label: "range"; today: {year: 2026, month: 10, day: 2}; week-start: root.week-start;
            selected <=> root.range-selection;
            month-names: root.month-names; month-short-names: root.month-short-names; weekday-names: root.weekday-names; weekday-short-names: root.weekday-short-names; weekdays: root.weekdays; accessible-date-pattern: root.accessible-date-pattern; title-pattern: root.title-pattern; today-label: root.today-label; range-start-label: root.range-start-label; range-end-label: root.range-end-label; in-range-label: root.in-range-label;
        }
    }
}

export component CalendarLabelsRenderFixture inherits Window {
    preferred-width: 520px;
    in property <KitTheme> theme: KitThemes.light;
    background: root.theme.canvas;
    VerticalLayout {
        padding: 24px;
        calendar := KitCalendar {
            theme: root.theme;
            selected: {year: 2026, month: 10, day: 1};
            today: {year: 2026, month: 10, day: 2};
            month-names: ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"];
            weekday-names: ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"];
            weekdays: ["L", "M", "M", "J", "V", "S", "D"];
            title-pattern: "%B %Y — calendrier de réservation";
            today-label: "Aujourd’hui";
        }
    }
}
