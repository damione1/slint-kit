import { KitCalendar, KitCalendarService, CalendarDay, CivilDateView, KitTheme, KitThemes, FieldAccess, Ownership, WeekStart, CalendarConfigurationState } from "@kit";
export component CalendarServiceFixture inherits Window {
    width: 1000px; height: 740px;
    in property <KitTheme> theme: KitThemes.light;
    in property <Ownership> ownership: Ownership.local;
    in property <FieldAccess> access: FieldAccess.editable;
    out property <CivilDateView> first-selected: first.selected;
    out property <CivilDateView> first-focused: first.focused;
    out property <CivilDateView> second-selected: second.selected;
    out property <CivilDateView> second-focused: second.focused;
    public function acknowledge-first(date: CivilDateView) { first.selected = date; }
    public function focus-first() { first.take-focus(); }
    public function focus-second() { second.take-focus(); }
    callback first-chosen(CivilDateView);
    background: root.theme.canvas;
    HorizontalLayout {
        first := KitCalendar {
            theme: root.theme; access: root.access; ownership: root.ownership; label: "First calendar";
            selected: {year: 2024, month: 2, day: 28};
            min: "2024-02-01"; max: "2024-03-31";
            chosen(date) => { root.first-chosen(date); }
        }
        second := KitCalendar {
            theme: root.theme; label: "Second calendar";
            selected: {year: 2026, month: 12, day: 31};
        }
    }
}

import { KitDatePicker, KitDateRangePicker, KitDateTimeField, DateRangeView, LocalDateTimeView } from "@kit";
export component ControlledTemporalFixture inherits Window {
    width: 800px; height: 1000px;
    out property <CivilDateView> picked: picker.accepted-date;
    out property <DateRangeView> range-value: range.selected;
    out property <LocalDateTimeView> local-value: local.accepted-value;
    callback date-proposed(CivilDateView);
    callback range-proposed(DateRangeView);
    callback local-proposed(LocalDateTimeView);
    public function propose-date(date: CivilDateView) { picker.accept-date(date); }
    public function acknowledge-date(date: CivilDateView) { picker.accepted-date = date; }
    public function focus-range() { range.take-focus(); }
    public function apply-range() { range.apply(); }
    public function acknowledge-range(value: DateRangeView) { range.selected = value; }
    public function propose-local() { local.commit(); }
    public function acknowledge-local(value: LocalDateTimeView) { local.accepted-value = value; }
    VerticalLayout {
        alignment: start;
        picker := KitDatePicker { ownership: Ownership.controlled; accepted-date: {year: 2026, month: 10, day: 1}; chosen(date) => { root.date-proposed(date); } }
        range := KitDateRangePicker { ownership: Ownership.controlled; selected: {start: {year: 2026, month: 10, day: 1}, end: {year: 2026, month: 10, day: 3}}; chosen(value) => { root.range-proposed(value); } }
        local := KitDateTimeField { ownership: Ownership.controlled; accepted-value: {date: {year: 2026, month: 10, day: 1}, time: {hour: 9, minute: 30}}; date-text: "2026-10-05"; time-text: "10:30"; chosen(value) => { root.local-proposed(value); } }
    }
}

export component CalendarConstraintFixture inherits Window {
    width: 800px; height: 760px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <WeekStart> week-start: WeekStart.monday;
    in-out property <CivilDateView> selected: {year: 2026, month: 10, day: 19};
    in property <string> min;
    in property <string> max;
    in property <[WeekStart]> unavailable-weekdays;
    out property <CalendarConfigurationState> configuration-state: calendar.configuration-state;
    background: root.theme.canvas;
    calendar := KitCalendar {
        x: 24px; y: 24px; width: 700px; height: self.preferred-height;
        theme: root.theme; week-start: root.week-start;
        selected <=> root.selected; min: root.min; max: root.max; unavailable-weekdays: root.unavailable-weekdays;
        weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    }
}


export component StoredRangeFixture inherits Window {
    width: 800px; height: 1000px;
    in-out property <KitTheme> theme: KitThemes.light;
    out property <DateRangeView> selected: picker.selected;
    public function take-focus() { picker.take-focus(); }
    public function cancel() { picker.cancel(); }
    public function apply() { picker.apply(); }
    background: root.theme.canvas;
    picker := KitDateRangePicker {
        x: 24px; y: 24px; width: 700px;
        theme: root.theme;
        selected: {start: {year: 2026, month: 10, day: 1}, end: {year: 2026, month: 10, day: 3}};
        min: "2026-10-05"; max: "2026-10-31";
    }
}


export component WeekdayHeaderFixture inherits Window {
    width: 800px; height: 760px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <WeekStart> week-start: WeekStart.monday;
    in-out property <CivilDateView> selected: {year: 2026, month: 10, day: 19};
    in-out property <CivilDateView> calendar-focused: root.selected;
    out property <CivilDateView> chosen-date;
    background: root.theme.canvas;
    KitCalendar {
        x: 24px; y: 24px; width: 700px; height: self.preferred-height;
        theme: root.theme; week-start: root.week-start;
        selected <=> root.selected; focused <=> root.calendar-focused;
        weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
        chosen(date) => { root.chosen-date = date; }
    }
}

export component CalendarTodayFixture inherits Window {
    width: 800px; height: 1300px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <string> min;
    in property <string> max;
    in property <[WeekStart]> unavailable-weekdays;
    in property <CivilDateView> explicit-today;
    in property <bool> override-today;
    in-out property <CivilDateView> accepted-date;
    out property <CivilDateView> date-today: date.today;
    out property <CivilDateView> range-today: range.today;
    out property <CivilDateView> date-focus: date.focused;
    out property <CivilDateView> range-focus: range.focused;
    out property <[CalendarDay]> date-days: date.days;
    public function open-date() { date.open = true; }
    public function close-date() { date.open = false; }
    public function focus-range() { range.take-focus(); }
    out property <[CalendarDay]> range-days: range.days;
    background: root.theme.canvas;
    VerticalLayout {
        padding: 24px; spacing: 24px; alignment: start;
        date := KitDatePicker {today: root.override-today ? root.explicit-today : KitCalendarService.today; accepted-date <=> root.accepted-date; theme: root.theme; label: "Date"; min: root.min; max: root.max; unavailable-weekdays: root.unavailable-weekdays;}
        range := KitDateRangePicker {theme: root.theme; min: root.min; max: root.max; unavailable-weekdays: root.unavailable-weekdays;}
    }
}

import { ChoiceFlow } from "@kit";

export component CalendarFlowFixture inherits Window {
    width: 800px; height: 1000px;
    in-out property <KitTheme> theme: KitThemes.light;
    in property <WeekStart> week-start: WeekStart.monday;
    in-out property <CivilDateView> focused <=> control.focused;
    out property <ChoiceFlow> flow: control.flow;
    out property <[CalendarDay]> days: control.days;
    public function override-flow(value: ChoiceFlow) { control.flow = value; }
