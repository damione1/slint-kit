import { KitStrings, KitColorField, KitColorPicker, KitButton, KitTheme, KitThemes, Ownership, FieldAccess, ColorAlphaMode, SrgbColorView, ColorValue } from "@kit";
export component ColorLifecycleFixture inherits Window {
    width: 900px; height: 1200px;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <bool> required: true;
    in property <bool> clearable;
    in-out property <string> custom-validity;
    in property <string> empty-label: "No color";
    in property <Ownership> ownership: Ownership.local;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ColorAlphaMode> alpha-mode: ColorAlphaMode.editable;
    in-out property <ColorValue> field-value <=> field.accepted-value;
    in-out property <ColorValue> picker-value <=> picker.accepted-value;
    out property <bool> field-valid: field.validity.valid;
    out property <bool> picker-valid: picker.validity.valid;
    in-out property <int> field-cleared;
    in-out property <int> picker-cleared;
    public function clear-field() { field.clear(); }
    public function clear-picker() { picker.clear(); }
    public function open-field-picker() { field.open-picker(); }
    public function cancel-field-picker() { field.cancel-picker(); }
    out property <SrgbColorView> field-color: field.accepted-value.color;
    out property <SrgbColorView> picker-color: picker.accepted-value.color;
    in-out property <string> field-text <=> field.text;
    in-out property <string> hex-text <=> picker.hex-text;
    in-out property <string> red-text <=> picker.red-text;
    in-out property <string> green-text <=> picker.green-text;
    in-out property <string> blue-text <=> picker.blue-text;
    in-out property <string> alpha-text <=> picker.alpha-text;
    in-out property <int> field-chosen;
    in-out property <int> picker-chosen;
    in-out property <int> field-requests;
    in-out property <int> channel-requests;
    in-out property <SrgbColorView> field-proposal;
    in-out property <SrgbColorView> picker-proposal;
    public function commit-field() { field.commit(); }
    public function commit-picker() { picker.commit(); }
    public function blur() { outside.take-focus(); }
    background: root.theme.canvas;
    VerticalLayout {
        padding: 24px; spacing: 24px; alignment: start;
        field := KitColorField {
            theme: root.theme; ownership: root.ownership; access: root.access;
            required: root.required; clearable: root.clearable; empty-label: root.empty-label; custom-validity <=> root.custom-validity;
            clear-label: "Clear standalone color"; label: "Standalone color"; alpha-mode: root.alpha-mode;
            accepted-value: {present: true, color: {red: 1, green: 2, blue: 3, alpha: 255}};
            cleared => { root.field-cleared += 1; }
            chosen(value) => { root.field-chosen += 1; root.field-proposal = value; }
            commit-requested(text) => { root.field-requests += 1; }
        }
        picker := KitColorPicker {
            theme: root.theme; ownership: root.ownership; access: root.access;
            required: root.required; clearable: root.clearable; empty-label: root.empty-label; custom-validity <=> root.custom-validity;
            clear-label: "Clear picker color"; label: "Picker color"; alpha-mode: root.alpha-mode;
            accepted-value: {present: true, color: {red: 4, green: 5, blue: 6, alpha: 255}};
            cleared => { root.picker-cleared += 1; }
            chosen(value) => { root.picker-chosen += 1; root.picker-proposal = value; }
            channel-commit-requested(channel,text) => { root.channel-requests += 1; }
        }
        outside := KitButton { theme: root.theme; text: "Outside"; }
    }
}

import { KitTextField } from "@kit";
// The exact native editor/menu primitive, with no color synchronization layer.
export component ColorNativeEditingReference inherits Window {
    width: 900px; height: 1200px;
    in property <bool> numeric;
    in property <int> host-version;
    in-out property <string> text: root.numeric ? "4" : "#010203FF";
    editor := KitTextField {
        x: 24px; y: 24px; width: parent.width - 48px;
        accessible-name: "Native reference";
        text <=> root.text;
        input-type: root.numeric ? InputType.decimal : InputType.text;
        min: root.numeric ? "0" : ""; max: root.numeric ? "255" : ""; step: root.numeric ? "1" : "any";
    }
}

// The public field at either edge of a small window, independent of a host layout.
export component ColorPopupFixture inherits Window {
    width: root.narrow ? 320px : 560px; height: 560px;
    in property <bool> narrow;
    in property <bool> bottom;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <Ownership> ownership: Ownership.local;
    in-out property <ColorValue> value <=> field.accepted-value;
    in-out property <int> proposals;
    out property <SrgbColorView> proposal;
    in-out property <int> drafts;
    out property <SrgbColorView> draft;
    in-out property <int> draft-cancels;
    out property <bool> open: field.picker-open;
    background: root.theme.canvas;
    public function open-picker() { field.open-picker(); }
    public function cancel-picker() { field.cancel-picker(); }
    field := KitColorField {
        x: root.bottom ? parent.width - self.width - 8px : 8px;
        y: root.bottom ? parent.height - self.height - 8px : 8px;
        width: min(260px, parent.width - 16px); height: self.preferred-height;
        theme: root.theme; label: "Accent"; alpha-mode: ColorAlphaMode.editable;
        required: false; ownership: root.ownership;
        accepted-value: {present: true, color: {red: 12, green: 34, blue: 56, alpha: 78}};
        chosen(value) => { root.proposals += 1; root.proposal = value; }
        draft-changed(value) => { root.drafts += 1; root.draft = value; }
        draft-cancelled => { root.draft-cancels += 1; }
    }
}

// Every built-in string of the field and the picker overridden by the host.
export component ColorLabelsFixture inherits Window {
    width: 560px; height: 900px;
    in property <KitTheme> theme: KitThemes.light;
    in property <bool> localized: true;
    in property <string> description: "Hexadécimal sRGB";
    background: root.theme.canvas;
    public function open-picker() { field.open-picker(); }
    field := KitColorField {
        x: 8px; y: 8px; width: 260px; height: self.preferred-height;
        theme: root.theme; label: "Accent"; alpha-mode: ColorAlphaMode.editable; required: false;
        palette: [#ef4444, #22c55e];
        accepted-value: {present: true, color: {red: 12, green: 34, blue: 56, alpha: 78}};
        description: root.description;
        red-label: root.localized ? "Rouge" : KitStrings.color-red-label;
        green-label: root.localized ? "Vert" : KitStrings.color-green-label;
        blue-label: root.localized ? "Bleu" : KitStrings.color-blue-label;
        alpha-label: root.localized ? "Opacité" : KitStrings.color-alpha-label;
        cancel-label: root.localized ? "Annuler" : KitStrings.color-cancel-label;
        apply-label: root.localized ? "Appliquer la couleur" : KitStrings.color-apply-label;
        open-template: root.localized ? "Ouvrir le sélecteur de couleur pour {label}" : KitStrings.color-open-template;
        title-template: root.localized ? "{label} · sRGB" : KitStrings.color-title-template;
        draft-template: root.localized ? "{label} (brouillon)" : KitStrings.color-draft-template;
        preview-label: root.localized ? "Aperçu du brouillon" : KitStrings.color-preview-label;
        choice-template: root.localized ? "Choisir RVB {red}, {green}, {blue}" : KitStrings.color-choice-template;
        palette-labels: root.localized ? ["Rouge vif", ""] : [];
    }
    picker := KitColorPicker {
        x: 8px; y: 200px; width: 260px; height: self.preferred-height;
        theme: root.theme; label: "Fond"; alpha-mode: ColorAlphaMode.editable;
        red-label: root.localized ? "Rouge" : KitStrings.color-red-label;
        green-label: root.localized ? "Vert" : KitStrings.color-green-label;
        blue-label: root.localized ? "Bleu" : KitStrings.color-blue-label;
        alpha-label: root.localized ? "Opacité" : KitStrings.color-alpha-label;
        channel-placeholder: root.localized ? "0 à 255" : KitStrings.color-channel-placeholder;
    }
}
