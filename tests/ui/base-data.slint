// SPDX-License-Identifier: GPL-3.0-or-later
import { ColumnStep, TableEditOutcome, TableEditBlurPolicy, TableUnchangedEditPolicy, TableEditBounds, TableHeaderFocus, KitKeyResult, KitDataTable, KitContentList, KitVirtualTextView, KitTextField, TableColumn, TableRow, ColumnWidth, ColumnSizing, ColumnCeiling, ContentItem, TextLine, TextViewAccess, NavigationStep, KitTheme, KitThemes, ControlSize, FieldCommit, CellCommit, RowGesture } from "@kit";
export { ColumnStep, ColumnWidth, ColumnSizing, ColumnCeiling }

export enum DataFixtureCollection { table, content, document }

export component BaseDataFixture inherits Window {
    width: 960px; height: 1000px;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    in property <ControlSize> table-size: ControlSize.medium;
    in property <length> table-height: 240px;
    in property <length> content-height: 250px;
    in property <length> document-height: 320px;
    in property <TextViewAccess> document-access: TextViewAccess.edit-line;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <[ContentItem]> items;
    in property <string> content-empty-label;
    in property <[TextLine]> lines;
    in property <bool> table-interactive: true;
    in property <TableHeaderFocus> table-header-focus: TableHeaderFocus.individual;
    in property <string> table-header-label: "Column headers";
    in property <string> table-unnamed-row-label: "Row";
    in property <string> table-resize-label: "width";
    in property <string> table-ascending-label: "ascending";
    in property <string> table-descending-label: "descending";
    in property <int> table-generation: 1;
    in property <int> content-generation: 1;
    in property <int> line-generation: 1;
    in property <int> table-active: -1;
    in-out property <int> table-active-column <=> table.active-column;
    out property <bool> table-editing: table.editing;
    out property <string> table-edit-error: table.edit-error;
    in property <TableEditBlurPolicy> table-edit-blur-policy: TableEditBlurPolicy.commit-or-drop;
    in property <TableUnchangedEditPolicy> table-unchanged-edit-policy: TableUnchangedEditPolicy.report;
    out property <int> table-edit-row: table.edit-row-token;
    out property <int> table-edit-column: table.edit-column-token;
    out property <int> table-edit-generation: table.edit-generation;
    out property <string> table-edit-draft: table.edit-draft;
    out property <TableEditBounds> table-edit-bounds: table.edit-bounds;
    in property <int> content-active: -1;
    in property <int> line-active: -1;
    in-out property <string> line-draft;
    in property <string> line-error;
    in property <string> document-editor-label: "Edit selected line";
    in property <string> document-save-label: "Save line";
    in property <string> document-copy-label: "Copy";
    in-out property <string> pasted;
    in property <int> near-end-rows: 3;
    callback near-end(DataFixtureCollection);
    out property <int> table-first-visible: table.first-visible-index;
    out property <int> table-visible-rows: table.visible-row-count;
    out property <bool> table-end-near: table.end-near;
    public function scroll-table-to(index: int) { table.scroll-to-index(index); }
    public function restore-table-scroll(x: length, y: length) { table.set-scroll(x,y); }
    public function table-to-top() { table.scroll-to-top(); }
    public function reveal-table() { table.reveal-active(); }
    out property <int> content-first-visible: content.first-visible-index;
    out property <int> content-visible-rows: content.visible-row-count;
    out property <bool> content-end-near: content.end-near;
    public function scroll-content-to(index: int) { content.scroll-to-index(index); }
    public function restore-content-scroll(x: length, y: length) { content.set-scroll(x,y); }
    public function content-to-top() { content.scroll-to-top(); }
    public function reveal-content() { content.reveal-active(); }
    out property <int> line-first-visible: document.first-visible-index;
    out property <int> line-visible-rows: document.visible-row-count;
    out property <bool> line-end-near: document.end-near;
    public function scroll-line-to(index: int) { document.scroll-to-index(index); }
    public function restore-line-scroll(x: length, y: length) { document.set-scroll(x,y); }
    public function line-to-top() { document.scroll-to-top(); }
    public function reveal-line() { document.reveal-active(); }
    out property <int> table-page-rows: table.page-rows;
    out property <int> content-page-rows: content.page-rows;
    out property <int> line-page-rows: document.page-rows;
    out property <length> table-scroll: table.scroll-y;
    out property <length> table-scroll-x: table.scroll-x;
    out property <length> table-width: table.width;
    out property <length> content-scroll: content.scroll-y;
    out property <length> content-scroll-x: content.scroll-x;
    out property <length> line-scroll: document.scroll-y;
    out property <length> line-scroll-x: document.scroll-x;
    callback navigate(DataFixtureCollection, NavigationStep);
    callback table-key-event(KeyEvent) -> KitKeyResult;
    table-key-event(event) => { return KitKeyResult.reject; }
    callback table-activated(int,int);
    callback content-activated(int,int);
    callback table-gesture(int,int,RowGesture);
    callback content-gesture(int,int,RowGesture);
    callback line-selected(int,int);
    callback line-committed(int,int,string);
    callback line-copied(int,int);
    callback sort-requested(int);
    callback resize-requested(int, length);
    callback autosize-requested(int);
    callback reorder-requested(int, int);
    callback cell-committed(CellCommit);
    callback table-edit-started(int, int, int);
    callback table-edit-ended(int, int, int, TableEditOutcome, string);
    callback validate-table-edit(int, int, int, FieldCommit) -> string;
    validate-table-edit(row, column, generation, commit) => { return ""; }
    public function edit-table() { table.edit-active(); }
    public function commit-table() { table.commit-edit(); }
    public function cancel-table() { table.cancel-edit(); }
    public function sort-table-column() { table.sort-active-column(); }
    public function resize-table-column(delta: length) { table.resize-active-column(delta); }
    public function reorder-table-column(step: ColumnStep) { table.reorder-active-column(step); }
    public function focus-table() { table.take-focus(); }
    public function focus-content() { content.take-focus(); }
    public function focus-document() { document.take-focus(); }
    public function focus-paste() { paste.take-focus(); }
    VerticalLayout {
        padding: 16px; spacing: 12px; alignment: start;
        table := KitDataTable {
            near-end-rows: root.near-end-rows; near-end => { root.near-end(DataFixtureCollection.table); }
            theme: root.theme; control-size: root.table-size; height: root.table-height; columns: root.columns; rows: root.rows;
            generation: root.table-generation; active-index: root.table-active;
            interactive: root.table-interactive; header-focus: root.table-header-focus; header-label: root.table-header-label;
            label: "Products fixture"; unnamed-row-label: root.table-unnamed-row-label; resize-label: root.table-resize-label;
            sort-ascending-label: root.table-ascending-label;
            sort-descending-label: root.table-descending-label;
            key-event(event) => { return root.table-key-event(event); }
            navigate(step) => { root.navigate(DataFixtureCollection.table,step); }
            activate(token,generation) => { root.table-activated(token,generation); }
            gesture(token,generation,gesture) => { root.table-gesture(token,generation,gesture); }
            sort-requested(token) => { root.sort-requested(token); }
            resize-requested(token, width) => { root.resize-requested(token, width); }
            autosize-requested(token) => { root.autosize-requested(token); }
            reorder-requested(source, target) => { root.reorder-requested(source, target); }
            edit-blur-policy: root.table-edit-blur-policy; unchanged-edit-policy: root.table-unchanged-edit-policy;
            edit-started(row,column,generation) => {root.table-edit-started(row,column,generation);}
            edit-ended(row,column,generation,outcome,message) => {root.table-edit-ended(row,column,generation,outcome,message);}
            validate-edit(row,column,generation,commit) => { return root.validate-table-edit(row,column,generation,commit); }
            cell-committed(proposal) => { root.cell-committed(proposal); }
        }
        content := KitContentList {
            near-end-rows: root.near-end-rows; near-end => { root.near-end(DataFixtureCollection.content); }
            theme: root.theme; height: root.content-height; items: root.items; generation: root.content-generation; active-index: root.content-active;
            label: "Articles fixture";
            empty-label: root.content-empty-label;
            navigate(step) => { root.navigate(DataFixtureCollection.content,step); }
            activate(token,generation) => { root.content-activated(token,generation); }
            gesture(token,generation,gesture) => { root.content-gesture(token,generation,gesture); }
        }
        document := KitVirtualTextView {
            near-end-rows: root.near-end-rows; near-end => { root.near-end(DataFixtureCollection.document); }
            theme: root.theme; height: root.document-height; lines: root.lines; generation: root.line-generation; active-index: root.line-active;
            access: root.document-access; line-draft <=> root.line-draft; error: root.line-error;
            label: "Document fixture"; editor-label: root.document-editor-label; save-label: root.document-save-label; copy-label: root.document-copy-label;
            navigate(step) => { root.navigate(DataFixtureCollection.document,step); }
            select-line(token,generation) => { root.line-selected(token,generation); }
            commit-line(token,generation,text) => { root.line-committed(token,generation,text); }
            copy-requested(token,generation) => { root.line-copied(token,generation); }
        }
        paste := KitTextField { text <=> root.pasted; label: "Clipboard proof"; }
    }
}
