import { KitButton, KitTheme, KitThemes, ControlWidth, ControlSize, KitGlyphs, KitMetrics } from "@kit";
export component ButtonSizingFixture inherits Window {
    width: 240px; height: 240px;
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlWidth> mode: ControlWidth.fill;
    in property <bool> disabled;
    in property <bool> busy;
    callback activation-started();
    Rectangle {
        width: 160px; height: 100px;
        VerticalLayout {
            alignment: start;
            KitButton {
                theme: root.theme; control-width: root.mode;
                disabled: root.disabled; busy: root.busy;
                activation-started => { root.activation-started(); }
                control-size: ControlSize.comfortable;
                accessible-name: "Bounded action";
                text: "A long workspace name that must fit the available space";
            }
        }
    }
}

// Empty space beyond the target makes either viewport edge reachable.
export component ButtonScrollFixture inherits Window {
    width: 320px; height: 220px;
    in property <KitTheme> theme: KitThemes.light;
    out property <length> outline-top: target.absolute-position.y - KitThemes.focus-outset(target.focus-ring);
    out property <length> outline-bottom: target.absolute-position.y + target.height + KitThemes.focus-outset(target.focus-ring);
    out property <length> viewport-top: scroll.absolute-position.y;
    out property <length> viewport-bottom: scroll.absolute-position.y + scroll.height;
    out property <bool> target-focused: target.has-focus;
    public function reset-above() { scroll.content-y = 0px; }
    public function reset-below() { scroll.content-y = -440px; }
    public function focus-outside() { outside.take-focus(); }
    outside := KitButton { x:20px; y:8px; text:"Outside scroll"; }
    scroll := Flickable {
        x:20px; y:80px; width:280px; height:120px;
        content-height:560px; content-width:self.width;
        target := KitButton {
            x:20px; y:240px; width:220px; height:self.preferred-height;
            theme:root.theme; text:"Reveal full outline";
        }
    }
}

export component ButtonWrapFixture inherits Window {
    width: 640px; height: 900px;
    background: root.theme.canvas;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark: KitThemes.dark;
    in property <length> available-width: 180px;
    in property <bool> busy;
    in property <bool> disabled;
    out property <bool> focused: wrapped.has-focus;
    out property <length> content-height: measure.preferred-height;
    out property <length> padding-block: wrapped.padding-block;
    callback activated();
    public function take-focus() { wrapped.take-focus(); }
    measure := Text {
        visible: false; accessible-role: none;
        width: wrapped.width - 2 * wrapped.padding-inline - 2 * (KitMetrics.icon-size(root.theme, wrapped.control-size) + KitMetrics.inline-gap(root.theme));
        text: wrapped.text; wrap: word-wrap;
        font-family: root.theme.typography.family; font-size: wrapped.text-size; font-weight: wrapped.text-weight;
    }
    VerticalLayout {
        padding: root.theme.spacing.unit * 4; spacing: root.theme.spacing.unit * 4; alignment: start;
        Rectangle {
            width: root.available-width; height: baseline.preferred-height;
            baseline := KitButton {
                theme: root.theme; control-width: ControlWidth.fill;
                text: "Save all workspace changes before leaving";
            }
        }
        Rectangle {
            width: root.available-width; height: wrapped.preferred-height;
            wrapped := KitButton {
                theme: root.theme; control-width: ControlWidth.fill;
                text: "Save all workspace changes before leaving";
                text-wrap: word-wrap;
                leading-icon: KitGlyphs.close(); trailing-icon: KitGlyphs.close();
                busy: root.busy; disabled: root.disabled;
                activated => { root.activated(); }
            }
        }
        KitButton {
            theme: root.theme; text: "Save changes\nand continue"; text-wrap: word-wrap;
        }
    }
}
