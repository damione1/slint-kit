import { KitButton, KitTheme, KitThemes, ControlWidth, ControlSize } from "@kit/kit.slint";
export component ButtonSizingFixture inherits Window {
    width: 240px; height: 240px;
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlWidth> mode: ControlWidth.fill;
    Rectangle {
        width: 160px; height: 100px;
        VerticalLayout {
            alignment: start;
            KitButton {
                theme: root.theme; control-width: root.mode;
                control-size: ControlSize.comfortable;
                accessible-name: "Bounded action";
                text: "A long workspace name that must fit the available space";
            }
        }
    }
}

// Empty space beyond the target makes either viewport edge reachable.
export component ButtonScrollFixture inherits Window {
    width: 320px; height: 220px;
    in property <KitTheme> theme: KitThemes.light;
    out property <length> outline-top: target.absolute-position.y - KitThemes.focus-outset(target.focus-ring);
    out property <length> outline-bottom: target.absolute-position.y + target.height + KitThemes.focus-outset(target.focus-ring);
    out property <length> viewport-top: scroll.absolute-position.y;
    out property <length> viewport-bottom: scroll.absolute-position.y + scroll.height;
    out property <bool> target-focused: target.has-focus;
    public function reset-above() { scroll.content-y = 0px; }
    public function reset-below() { scroll.content-y = -440px; }
    public function focus-outside() { outside.take-focus(); }
    outside := KitButton { x:20px; y:8px; text:"Outside scroll"; }
    scroll := Flickable {
        x:20px; y:80px; width:280px; height:120px;
        content-height:560px; content-width:self.width;
        target := KitButton {
            x:20px; y:240px; width:220px; height:self.preferred-height;
            theme:root.theme; text:"Reveal full outline";
        }
    }
}
