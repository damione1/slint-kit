import { KitMenu, KitAccordion, KitSelect, KitCombobox, KitRadioGroup, KitSelectKeyboard, NavigationStep, OptionRow, SelectionRef, SelectState, SelectionRetention, KitValidityState, KitTheme, KitThemes, ExpansionMode, Ownership, FieldAccess, KitMenuBar, KitTabs, KitCarousel, KitSegmentedControl, KitToggleGroup, TabActivation, ChoiceDirection, ChoiceFlow } from "@kit";
export component SelectionServiceFixture inherits Window {
    width: 800px; height: 1000px;
    in property <[OptionRow]> options;
    in property <KitTheme> theme: KitThemes.light;
    in property <ExpansionMode> expansion-mode: ExpansionMode.single;
    in property <Ownership> ownership: Ownership.local;
    in property <SelectionRetention> combo-retention: SelectionRetention.retain;
    in property <bool> combo-allow-custom: false;
    in property <bool> combo-clearable: false;
    in property <int> combo-min-query-length: 0;
    in property <duration> combo-query-debounce: 0ms;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <bool> first-wrap: true;
    in property <TabActivation> tab-activation: TabActivation.manual;
    in property <ChoiceFlow> nav-flow: ChoiceFlow.left-to-right;
    in property <ChoiceDirection> toggle-direction: ChoiceDirection.horizontal;
    out property <SelectState> first-state: first.state;
    out property <SelectState> second-state: second.state;
    out property <SelectState> popup-state: popup.state;
    out property <SelectState> combo-state: combo.state;
    out property <string> combo-selected-label: combo.selected-label;
    out property <bool> combo-focused: combo.has-focus;
    in-out property <int> combo-open-requests;
    out property <bool> first-focused: first.has-focus;
    in-out property <string> combo-text <=> combo.text;
    in-out property <string> combo-query <=> combo.query;
    out property <KitValidityState> combo-validity: combo.validity;
    out property <int> popup-page-rows: popup.page-rows;
    out property <int> first-page-rows: first.page-rows;
    out property <SelectionRef> radio-selected: radio.selected;
    out property <SelectionRef> tabs-selected: tabs.selected;
    out property <SelectState> tabs-state: tabs.state;
    out property <SelectState> menubar-state: menubar.state;
    out property <SelectState> carousel-state: carousel.state;
    out property <SelectionRef> segments-selected: segments.selected;
    out property <int> toggles-active: toggles.active-token;
    in-out property <SelectionRef> acknowledged <=> first.selected;
    in-out property <SelectionRef> combo-selected <=> combo.selected;
    in-out property <[SelectionRef]> expanded <=> accordion.expanded;
    out property <[SelectionRef]> local-expanded: local-accordion.expanded;
    out property <int> local-expanded-count: local-accordion.expanded.length;
    callback expansion-changed(OptionRow, bool);
    callback first-chosen(OptionRow);
    callback second-chosen(OptionRow);
    callback combo-chosen(OptionRow);
    callback combo-query-edited(string);
    callback combo-custom-chosen(string);
    callback combo-cleared();
    callback keyboard-chosen(OptionRow);
    out property <SelectState> keyboard-state: keyboard.state;
    public function move-keyboard(step: NavigationStep) { keyboard.move-active(step); }
    public function type-keyboard(text: string) { keyboard.type-ahead(text); }
    public function choose-keyboard() { keyboard.choose-option(keyboard.state.active.token, keyboard.state.generation); }
    keyboard := KitSelectKeyboard {
        width: 0px; height: 0px; enabled: false; options: root.options;
        chosen(row) => { root.keyboard-chosen(row); }
    }
    public function focus-first() { first.take-focus(); }
    public function focus-second() { second.take-focus(); }
    public function focus-popup() { popup.take-focus(); }
    public function focus-combo() { combo.take-focus(); }
    public function clear-combo() { combo.clear(); }
    public function focus-radio() { radio.take-focus(); }
    public function focus-tabs() { tabs.take-focus(); }
    public function focus-menubar() { menubar.take-focus(); }
    public function focus-carousel() { carousel.take-focus(); }
    public function focus-segments() { segments.take-focus(); }
    public function focus-toggles() { toggles.take-focus(); }
    public function search-first(text: string) { first.query = text; }
    background: root.theme.canvas;
    VerticalLayout {
        HorizontalLayout {
            first := KitMenu { theme: root.theme; options: root.options; ownership: root.ownership; wrap: root.first-wrap; chosen(row) => { root.first-chosen(row); } }
            second := KitMenu { theme: root.theme; options: root.options; chosen(row) => { root.second-chosen(row); } }
        }
        popup := KitSelect { theme: root.theme; options: root.options; access: root.access; }
        combo := KitCombobox {
            theme: root.theme; options: root.options; ownership: root.ownership; retention: root.combo-retention;
            allow-custom-value: root.combo-allow-custom; clearable: root.combo-clearable;
            min-query-length: root.combo-min-query-length; query-debounce: root.combo-query-debounce;
            required: true; access: root.access;
            chosen(row) => { root.combo-chosen(row); }
            open-requested => { root.combo-open-requests += 1; }
            query-edited(text) => { root.combo-query-edited(text); }
            custom-chosen(text) => { root.combo-custom-chosen(text); }
            cleared => { root.combo-cleared(); }
        }
        accordion := KitAccordion { theme: root.theme; options: root.options; mode: root.expansion-mode; ownership: root.ownership; expansion-changed(row, expanded) => { root.expansion-changed(row, expanded); } }
        local-accordion := KitAccordion { theme: root.theme; options: root.options; mode: root.expansion-mode; }
        radio := KitRadioGroup { theme: root.theme; options: root.options; access: root.access; label: "Destination"; }
        tabs := KitTabs { theme: root.theme; options: root.options; activation: root.tab-activation; flow: root.nav-flow; }
        menubar := KitMenuBar { theme: root.theme; options: root.options; flow: root.nav-flow; }
        carousel := KitCarousel { theme: root.theme; options: root.options; flow: root.nav-flow; }
        segments := KitSegmentedControl { theme: root.theme; options: root.options; columns: 2; label: "Segments"; }
        toggles := KitToggleGroup { theme: root.theme; options: root.options; direction: root.toggle-direction; flow: root.nav-flow; label: "Toggles"; }
    }
}
