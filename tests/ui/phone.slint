import { KitTelephoneField, KitTextField, KitTheme, KitThemes, KitButton, KitValidityState, PhoneNumberMode, FieldAccess, ValidationPresentation } from "@kit/kit.slint";
export { PhoneNumberMode } from "@kit/kit.slint";
export component PhoneFixture inherits Window {
    preferred-width: 600px; preferred-height: 400px; max-width: 100000px; max-height: 100000px;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> dark-theme: KitThemes.dark;
    background: root.theme.canvas;
    in property <PhoneNumberMode> number-mode: PhoneNumberMode.national;
    in property <int> expected-digits: 10;
    in property <int> min-digits: 1;
    in property <int> max-digits: 15;
    in property <string> display-mask: "## ## ## ## ##";
    in property <string> pattern;
    in property <string> business-error;
    in property <FieldAccess> access: FieldAccess.editable;
    in-out property <string> draft: "0612345678";
    in-out property <string> clipboard;
    in-out property <string> accepted;
    out property <string> canonical: phone.value;
    out property <string> formatted: phone.display-text;
    out property <KitValidityState> validity: phone.validity;
    out property <string> error: phone.validation-message;
    out property <string> format-error: phone.format-error;
    callback commit(string);
    public function focus-phone() { phone.take-focus(); }
    public function select-phone() { phone.select-all(); }
    public function blur-phone() { clipboard.take-focus(); }
    public function copy-clipboard() { clipboard.take-focus(); clipboard.select-all(); clipboard.copy-selection(); }
    public function report() -> bool { return phone.report-validity(); }
    VerticalLayout { padding: 24px; spacing: 16px; alignment: start;
        phone := KitTelephoneField { theme: root.theme; label: "Phone"; required: true;
            text <=> root.draft; number-mode: root.number-mode; expected-digits: root.expected-digits; min-digits: root.min-digits; max-digits: root.max-digits;
            display-mask: root.display-mask; pattern: root.pattern; access: root.access; error: root.business-error; validation: root.business-error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
            commit-requested(value) => { root.commit(value); }
        }
        clipboard := KitTextField { theme: root.theme; label: "Other field"; text <=> root.clipboard; }
        Text { text: "Accepted: " + root.accepted; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
        KitButton { theme: root.theme; text: "Accept"; activated => { if (phone.report-validity()) { root.commit(phone.value); } } }
    }
}
