import { KitTheme, KitThemes, KitKeypad, KitCodeIndicator, FieldAccess, ControlSize, ButtonIntent } from "@kit";

// A keypad and a code indicator; the fixture, like a host, counts the digits
// without the keypad holding them.
export component KeypadFixture inherits Window {
    width: 520px; height: 720px;
    background: root.theme.canvas;
    in property <KitTheme> theme: KitThemes.light;
    out property <KitTheme> light: KitThemes.light;
    out property <KitTheme> dark: KitThemes.dark;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <bool> can-confirm;
    in property <bool> digits-enabled: true;
    in property <bool> can-delete: true;
    in property <bool> show-confirm: true;
    in property <string> extra-label;
    in property <bool> extra-enabled: true;
    in property <bool> handle-escape;
    callback extra-pressed();
    callback cancelled();
    in property <length> available-width: 480px;
    callback activation-started();
    in property <ControlSize> control-size: ControlSize.comfortable;
    in property <int> code-length: 4;
    in property <int> code-filled: 2;
    out property <length> keypad-width: keypad.width;
    out property <length> keypad-height: keypad.height;
    out property <length> mark-row-height: indicator.height;
    callback digit-entered(int);
    callback deleted();
    callback confirmed();
    public function focus-keypad() { keypad.take-focus(); }

    indicator := KitCodeIndicator {
        x: 20px; y: 20px; width: 480px; height: self.preferred-height;
        theme: root.theme;
        length: root.code-length; filled: root.code-filled;
        label: root.code-filled + " of " + root.code-length + " digits entered";
    }
    keypad := KitKeypad {
        x: 20px; y: 80px; width: min(root.available-width, self.preferred-width); height: self.preferred-height;
        theme: root.theme; control-size: root.control-size; access: root.access;
        label: "Access code"; confirm-label: "Unlock"; can-confirm: root.can-confirm;
        digits-enabled: root.digits-enabled; can-delete: root.can-delete; show-confirm: root.show-confirm;
        extra-label: root.extra-label; extra-enabled: root.extra-enabled; handle-escape: root.handle-escape;
        extra => { root.extra-pressed(); }
        cancel => { root.cancelled(); }
        activation-started => { root.activation-started(); }
        digit(value) => { root.digit-entered(value); }
        delete-requested => { root.deleted(); }
        confirm => { root.confirmed(); }
    }
}
