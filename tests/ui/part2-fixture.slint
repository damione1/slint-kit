import { KitTheme, KitThemes, KitTextField, KitPasswordField, KitSearchField, KitEmailField, KitUrlField, KitTelephoneField, KitTextArea, KitOtpField, KitMaskedField, KitIntegerField, KitDecimalField, KitMoneyField, KitPercentField, KitQuantityField, KitDurationField, KitNumberStepper, KitButton, KitSelect, KitField, KitFieldLabel, KitFieldDescription, KitFieldError, KitFieldGroup, KitFieldSet, KitInputGroup, KitFieldSeparator, FieldAccess, ValidationPresentation, SecretVisibility, ControlSize, CheckState, KitCheckbox, KitSwitch, KitRadioGroup, KitSegmentedControl, KitToggleGroup, KitMultiSelect, KitTagInput, KitCombobox, KitSlider, KitRangeSlider, KitRating, ChoiceRow, NavigationStep, KitCalendar, KitDateField, KitDatePicker, KitDateRangePicker, KitMonthField, KitYearField, KitIsoWeekField, CalendarDay, CalendarNavigation, KitTimeField, KitTimePicker, KitDateTimeField, KitZonedDateTimeField, KitFilePicker, KitDirectoryPicker, KitFileDropZone, KitColorField, KitColorPicker, ChoiceFlow, ColorAlphaMode, ColorChannel, ZonedTimePresentation } from "@kit/kit.slint";

export component Part2Fixture inherits Window {
    width: 1100px; height: 1000px;
    in property <KitTheme> theme: KitThemes.light;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in-out property <string> name-text;
    in-out property <string> password-text;
    in-out property <string> search-text;
    in-out property <string> area-text;
    in-out property <SecretVisibility> secret-visibility;
    in property <CheckState> check-state: CheckState.mixed;
    in property <[ChoiceRow]> choices;
    in property <int> active-token;
    in property <float> slider-position: 0.5;
    in property <[CalendarDay]> calendar-days;
    in property <int> calendar-active;
    in-out property <bool> picker-open;
    out property <bool> name-focused: name.has-focus;
    out property <bool> password-focused: password.has-focus;
    out property <bool> search-focused: search.has-focus;
    out property <bool> area-focused: area.has-focus;
    out property <bool> radio-focused: radio.has-focus;
    out property <bool> calendar-focused: calendar.has-focus;
    out property <length> simple-height: simple.height;
    out property <length> button-height: intrinsic-button.height;
    out property <length> select-height: intrinsic-select.height;
    out property <length> area-height: area.height;
    callback name-edited(string);
    callback name-committed(string);
    callback area-committed(string);
    callback checkbox-toggled(CheckState);
    callback radio-navigate(NavigationStep);
    callback radio-activate(int,int);
    callback slider-navigate(NavigationStep);
    callback slider-position-requested(float);
    callback slider-started();
    callback slider-committed();
    callback slider-cancelled();
    callback calendar-navigate(CalendarNavigation);
    callback calendar-choose(CalendarDay);
    callback picker-choose(CalendarDay);
    public function focus-name() { name.take-focus(); }
    public function select-name() { name.select-all(); }
    public function focus-password() { password.take-focus(); }
    public function focus-search() { search.take-focus(); }
    public function focus-area() { area.take-focus(); }
    public function focus-radio() { radio.take-focus(); }
    public function focus-slider() { slider.take-focus(); }
    public function focus-calendar() { calendar.take-focus(); }
    VerticalLayout {
        x: 20px; y: 20px; width: 360px; height: root.height - 40px;
        spacing: 16px;
        simple := KitTextField { theme: root.theme; control-size: root.control-size; accessible-name: "Intrinsic text"; }
        intrinsic-button := KitButton { theme: root.theme; control-size: root.control-size; text: "Intrinsic action"; }
        intrinsic-select := KitSelect { theme: root.theme; control-size: root.control-size; placeholder: "Intrinsic select"; }
        name := KitTextField { theme: root.theme; control-size: root.control-size; access: root.access; validation: root.validation; label: "Full name"; description: "Your name remains visible and editable after changing theme."; error: "Please enter a name."; text <=> root.name-text; edited(text) => { root.name-edited(text); } commit-requested(text) => { root.name-committed(text); } }
        password := KitPasswordField { theme: root.theme; control-size: root.control-size; access: root.access; label: "Password"; text <=> root.password-text; secret-visibility <=> root.secret-visibility; }
        search := KitSearchField { theme: root.theme; control-size: root.control-size; access: root.access; label: "Find a person"; text <=> root.search-text; }
        area := KitTextArea { theme: root.theme; access: root.access; label: "Notes"; min-lines: 2; max-lines: 4; text <=> root.area-text; commit-requested(text) => { root.area-committed(text); } }
        Rectangle { vertical-stretch: 1; }
    }
    VerticalLayout {
        x: 420px; y: 20px; width: 340px; height: root.height - 40px;
        spacing: 16px;
        KitCheckbox { theme: root.theme; access: root.access; label: "Project notifications"; state: root.check-state; toggled(state) => { root.checkbox-toggled(state); } }
        KitSwitch { theme: root.theme; access: root.access; label: "Activity updates"; }
        radio := KitRadioGroup { theme: root.theme; access: root.access; label: "Billing cadence"; rows: root.choices; generation: 7; active-token: root.active-token; navigate(step) => { root.radio-navigate(step); } activate(token,generation) => { root.radio-activate(token,generation); } }
        slider := KitSlider { theme: root.theme; access: root.access; position: root.slider-position; label: "Volume"; value-label: "50 percent"; navigate(step) => { root.slider-navigate(step); } position-requested(value) => { root.slider-position-requested(value); } gesture-started => { root.slider-started(); } committed => { root.slider-committed(); } cancelled => { root.slider-cancelled(); } }
        KitDatePicker { theme: root.theme; label: "Reservation date"; calendar-button-label: "Calendrier"; calendar-accessible-name: "Ouvrir le calendrier de réservation"; previous-month-label: "Mois précédent"; next-month-label: "Mois suivant"; placeholder: "AAAA-MM-JJ"; description: "Date civile explicite"; days: root.calendar-days; active-index: root.calendar-active; title: "October 2026"; open <=> root.picker-open; choose(day) => { root.picker-choose(day); } }
        calendar := KitCalendar { theme: root.theme; access: root.access; days: root.calendar-days; active-index: root.calendar-active; title: "October 2026"; label: "Reservation calendar"; navigate(step) => { root.calendar-navigate(step); } choose(day) => { root.calendar-choose(day); } }
        Rectangle { vertical-stretch: 1; }
    }
}

