export component QaOptionDemo inherits OptionDemo {
    in-out property <KitTheme> test-theme <=> root.theme;
    in property <[OptionRow]> test-options; options: root.test-options;
}
export component QaKeyboardDemo inherits KeyboardDemo {
    in-out property <KitTheme> test-theme <=> root.theme;
    in property <[OptionRow]> test-options; options: root.test-options;
