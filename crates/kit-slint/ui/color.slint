import { KitKeyResult } from "keyboard.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { ValidationPresentation } from "shared-contracts.slint";
import { KitTheme, KitThemes, ControlSize, ButtonIntent, KitThemeContext, KitMetrics, TypographyRole, SurfaceLevel, SurfaceRecipe, ColorPopupRecipe } from "theme.slint";
import { ElevatedSurface } from "elevation.slint";
import { KitPressable, KitButton } from "button.slint";
import { KitFieldLabel, KitFieldDescription, KitFieldError } from "field.slint";
import { KitValidityState } from "validation.slint";
import { KitTextField } from "input.slint";
import { KitIcon } from "icons.slint";
import { KitStrings } from "strings.slint";
import { ScrollFrame } from "scroll.slint";
import { KitSlider } from "choice.slint";
import { FieldAccess, NavigationStep } from "contracts.slint";
import { ColorAlphaMode } from "shared-contracts.slint";
export { ColorAlphaMode } from "shared-contracts.slint";

import { KitFieldService, ColorChannel, SrgbColorView, ColorValue, ColorResult, FieldCommit, PopupViewport, PopupGeometry } from "field-service.slint";
export { ColorChannel, SrgbColorView, ColorValue } from "field-service.slint";
import { Ownership } from "shared-contracts.slint";

component ColorDraftChannel inherits HorizontalLayout {
    in property <KitTheme> theme;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <string> label;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <int> value;
    callback requested(int);
    callback cancelled();
    spacing: root.theme.spacing.unit * 3;
    Text { text: root.label; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); min-width: 48px * root.theme.text-scale; horizontal-stretch: 0; vertical-alignment: center; }
    KitSlider {
        // A channel shares its row with a label and a byte value. Keep its
        // thumb usable while allowing the caller's narrow viewport to fit.
        min-width: self.preferred-height;
        theme: root.theme; control-size: root.control-size; access: root.access; label: root.label + " draft"; value: root.value; position: root.value / 255;
        ownership: Ownership.controlled; spec: {minimum: "0", maximum: "255", step: "1"};
        cancelled => { root.cancelled(); }
        position-requested(position) => { root.requested(round(max(0,min(1,position)) * 255)); }
        navigate(step) => {
            root.requested(step == NavigationStep.first ? 0 : step == NavigationStep.last ? 255 : max(0,min(255,root.value + (step == NavigationStep.next ? 1 : step == NavigationStep.previous ? -1 : step == NavigationStep.page-next ? 16 : -16))));
        }
    }
    value-text := Text { text: root.value; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); min-width: 26px * root.theme.text-scale; horizontal-stretch: 0; vertical-alignment: center; horizontal-alignment: right; }
}

// All channels are sRGB byte projections, never implicit HSL/linear RGB.
// The native hex draft may be incomplete; only Rust's SrgbColor parser commits.
export component KitColorField inherits Rectangle {
    in property <bool> required: true;
    // Messages are overridable so a host can localise the colour field.
    in property <string> required-message: KitStrings.required-message;
    in property <string> pattern-message: root.alpha-mode == ColorAlphaMode.editable ? "Use #RRGGBB or #RRGGBBAA." : "Use #RRGGBB.";
    in property <string> placeholder: root.alpha-mode == ColorAlphaMode.editable ? "#RRGGBBAA" : "#RRGGBB";
    in property <string> description: root.alpha-mode == ColorAlphaMode.editable ? "sRGB hexadecimal, including alpha" : "sRGB hexadecimal";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: editor.validity;
    out property <bool> will-validate: editor.will-validate;
    out property <string> validation-message: editor.validation-message;
    callback invalid();
    public function check-validity() -> bool { return editor.check-validity(); }
    public function report-validity() -> bool { return editor.report-validity(); }
    public function focus-if-invalid() -> bool { return editor.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { editor.reset-validation(); }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ColorAlphaMode> alpha-mode: ColorAlphaMode.opaque;
    in-out property <ColorValue> accepted-value: {present: true, color: {red: 0, green: 0, blue: 0, alpha: 255}};
    in property <string> empty-label: KitStrings.color-empty-label;
    in property <color> swatch: rgba(root.accepted-value.color.red, root.accepted-value.color.green, root.accepted-value.color.blue, root.accepted-value.color.alpha / 255);
    // Quick choices offered by the picker: application data, not theme tokens.
    in property <[color]> palette: [#ef4444,#f59e0b,#22c55e,#06b6d4,#4f46e5,#a855f7,#111827,#ffffff];
    in property <string> label: "Color";
    in property <string> error;
    in-out property <string> text: KitFieldService.ready && root.accepted-value.present ? KitFieldService.color-format(root.accepted-value.color, root.alpha-mode) : "";
    callback edited(string);
    callback commit-requested(string);
    callback cancelled();
    callback color-requested(SrgbColorView);
    // Service installation can populate the text binding after TextField.init.
    // Seed its accepted baseline too, without replacing an authored native draft.
    private property <bool> service-ready: KitFieldService.ready;
    changed service-ready => {
        if (root.service-ready) {
            editor.acknowledge({present: root.accepted-value.present, text: root.accepted-value.present ? KitFieldService.color-format(root.accepted-value.color, root.alpha-mode) : ""});
        }
    }
    changed accepted-value => { root.sync-text(); }
    changed alpha-mode => { root.sync-text(); }
    function sync-text() {
        if (!editor.has-focus && KitFieldService.ready) {
            root.text = root.accepted-value.present ? KitFieldService.color-format(root.accepted-value.color, root.alpha-mode) : "";
            editor.acknowledge({present: root.accepted-value.present, text: root.text});
        }
    }
    out property <bool> picker-open: popup.is-open && root.access == FieldAccess.editable;
    private property <SrgbColorView> draft;
    private property <SurfaceRecipe> popup-surface: KitThemes.surface-recipe(root.theme, SurfaceLevel.popover);
    private property <ColorPopupRecipe> popup-recipe: KitThemes.color-popup-recipe(root.theme);
    private property <length> popup-inset: root.popup-recipe.inset;
    private property <PopupViewport> popup-viewport;
    public function open-picker() {
        if (root.access == FieldAccess.editable) {
            root.draft = root.accepted-value.present ? root.accepted-value.color : {red: 0, green: 0, blue: 0, alpha: 255};
            if (root.alpha-mode == ColorAlphaMode.opaque) { root.draft.alpha = 255; }
            root.popup-viewport = KitFieldService.popup-viewport();
            popup.show();
        }
    }
    public function cancel-picker() { popup.close(); swatch-button.take-focus(); }
    changed access => { if (root.access != FieldAccess.editable && root.picker-open) { root.cancel-picker(); } }
    changed picker-open => { if (!root.picker-open) { popup.close(); swatch-button.take-focus(); } }
    public function take-focus() { editor.take-focus(); }
    public function clear() { editor.clear(); }
    in property <bool> clearable;
    in property <string> clear-label: KitStrings.clear-label;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit;
        if root.label != "": KitFieldLabel {theme:root.theme;text:root.label;access:root.access;focus-requested=>{editor.take-focus();}}
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            editor := KitTextField {
                required: root.required; custom-validity <=> root.custom-validity;
                // This is the native draft's commit baseline, not host color
                // ownership. A proposal must not repeat on the following blur.
                ownership: Ownership.local; clearable: root.clearable; clear-label: root.clear-label;
                pattern: root.alpha-mode == ColorAlphaMode.editable ? "#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" : "#[0-9a-fA-F]{6}";
                required-message: root.required-message; pattern-message: root.pattern-message;
                error: root.error; show-validation-message: false;
                invalid => { root.invalid(); }
                theme:root.theme;control-size:root.control-size;access:root.access;accessible-name:root.label;
                validation:root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
                text <=> root.text;
                focus-observed(focused) => { if (!focused) { root.sync-text(); } }
                placeholder: root.placeholder;
                edited(text) => { root.edited(text); }
                committed(value) => { root.accept-typed(value); }
                commit-requested(text) => { root.commit-requested(text); }
                cancelled => { root.cancelled(); }
            }
            swatch-button := KitPressable {
                theme: root.theme; control-size: root.control-size;
                preferred-width: self.preferred-height;
                accessible-name: "Open color picker for " + root.label;
                accessible-description: root.accepted-value.present ? root.text : root.empty-label;
                disabled: root.access != FieldAccess.editable;
                recipe: KitThemes.icon-button-recipe(root.theme,root.control-size);
                border-width: root.theme.shape.border-width; border-color: root.theme.border-subtle;
                activated => { root.open-picker(); }
                key-event(event) => { if (event.text == Key.Escape && root.picker-open) { root.cancel-picker(); return KitKeyResult.accept; } return KitKeyResult.reject; }
                Rectangle { visible: root.accepted-value.present; x:root.theme.spacing.unit;y:root.theme.spacing.unit;width:parent.width - 2 * self.x;height:parent.height - 2 * self.y;border-radius:max(0px,swatch-button.corner-radius - root.theme.spacing.unit);background:root.swatch; }
                if !root.accepted-value.present: KitIcon { theme: root.theme; control-size: root.control-size; glyph: root.theme.icons.close; }
            }
        }
        KitFieldDescription {theme:root.theme;text:root.description;}
        if root.error == "" && editor.validation-visible && editor.validation-message != "": KitFieldError { theme: root.theme; text: editor.validation-message; }
        if root.error != "": KitFieldError {theme:root.theme;text:root.error;}
    }
    popup := PopupWindow {
        // Width is independent of the height-for-width content measurement.
        width: min(root.popup-recipe.width, max(0px, root.popup-viewport.width - 2 * root.popup-recipe.gap));
        private property <length> body-height: popup-content.preferred-height + 2 * root.popup-inset;
        private property <PopupGeometry> placement: KitFieldService.place-popup({x: root.absolute-position.x, y: root.absolute-position.y, anchor-width: root.width, anchor-height: root.height, width: self.width, height: self.body-height, gap: root.popup-recipe.gap}, root.popup-viewport);
        x: self.placement.x; y: self.placement.y;
        height: self.placement.height;
        close-policy: close-on-click-outside;
        Rectangle {
            ElevatedSurface { recipe: root.popup-surface; }
            popup-keys := FocusScope {
                forward-focus: cancel-button;
                private property <bool> shown: root.picker-open;
                init => { self.focus(); }
                changed shown => { if (self.shown) { self.focus(); } }
                key-pressed(event) => { if (event.text == Key.Escape) { root.cancel-picker(); return accept; } return reject; }
                popup-scroll := ScrollFrame {
                    theme: root.theme;
                    x: root.popup-inset; y: root.popup-inset;
                    width: max(0px, parent.width - 2 * root.popup-inset);
                    height: max(0px, parent.height - 2 * root.popup-inset);
                    min-width: 0px; min-height: 0px;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    content-width: self.visible-width;
                    content-height: popup-content.preferred-height;
                    popup-content := VerticalLayout {
                    x: 0px; y: 0px; width: popup-scroll.visible-width;
                    height: self.preferred-height; alignment: start;
                    spacing: root.theme.spacing.unit * 4;
                    Text { text: root.label + " · sRGB"; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); color: root.theme.text-primary; font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
                    Rectangle {
                        height: root.popup-recipe.preview-height; border-radius: root.theme.shape.radius-control; border-width: root.theme.shape.border-width; border-color: root.theme.border-subtle;
                        background: rgba(root.draft.red,root.draft.green,root.draft.blue,root.draft.alpha / 255);
                        accessible-role: image; accessible-label: "Draft color preview";
                    }
                    FlexboxLayout {
                        spacing: root.theme.spacing.unit * 2; alignment: start; flex-wrap: wrap;
                        for choice in root.palette: KitPressable {
                            theme: root.theme; control-size: ControlSize.compact;
                            disabled: root.access != FieldAccess.editable;
                            private property <length> side: KitMetrics.density(root.theme, ControlSize.compact).height;
                            // The draft's current choice keeps an accent edge, so the
                            // selection reads without relying on the swatch color.
                            private property <bool> chosen: choice.red == root.draft.red && choice.green == root.draft.green && choice.blue == root.draft.blue;
                            preferred-width: self.side; min-height: self.side; preferred-height: self.side; max-height: self.side;
                            recipe: KitThemes.icon-button-recipe(root.theme,ControlSize.compact);
                            accessible-item-selectable: true; accessible-item-selected: self.chosen;
                            border-width: self.chosen ? root.theme.shape.border-width-strong : root.theme.shape.border-width;
                            border-color: self.chosen ? root.theme.accent : root.theme.border-strong;
                            key-event(event) => { if (event.text == Key.Escape) { root.cancel-picker(); return KitKeyResult.accept; } return KitKeyResult.reject; }
                            accessible-name: "Choose RGB " + choice.red + ", " + choice.green + ", " + choice.blue;
                            activated => { root.draft = {red:choice.red,green:choice.green,blue:choice.blue,alpha:root.draft.alpha}; }
                            Rectangle { x:root.theme.spacing.unit;y:root.theme.spacing.unit;width:parent.width - 2 * self.x;height:parent.height - 2 * self.y; background: choice; border-radius: max(0px,parent.border-radius - root.theme.spacing.unit); }
                        }
                    }
                    ColorDraftChannel { theme: root.theme; control-size: root.control-size; access: root.access; label: "Red"; value: root.draft.red; cancelled => { root.cancel-picker(); } requested(value) => { root.draft.red = value; } }
                    ColorDraftChannel { theme: root.theme; control-size: root.control-size; access: root.access; label: "Green"; value: root.draft.green; cancelled => { root.cancel-picker(); } requested(value) => { root.draft.green = value; } }
                    ColorDraftChannel { theme: root.theme; control-size: root.control-size; access: root.access; label: "Blue"; value: root.draft.blue; cancelled => { root.cancel-picker(); } requested(value) => { root.draft.blue = value; } }
                    if root.alpha-mode == ColorAlphaMode.editable: ColorDraftChannel { theme: root.theme; control-size: root.control-size; access: root.access; label: "Alpha"; value: root.draft.alpha; cancelled => { root.cancel-picker(); } requested(value) => { root.draft.alpha = value; } }
                    FlexboxLayout {
                        alignment: end; spacing: root.theme.spacing.unit * 2; flex-wrap: wrap;
                        cancel-button := KitButton { key-event(event) => { if (event.text == Key.Escape) { root.cancel-picker(); return KitKeyResult.accept; } return KitKeyResult.reject; } theme: root.theme; control-size: root.control-size; text: "Cancel"; activated => { root.cancel-picker(); } }
                        KitButton { theme: root.theme; control-size: root.control-size; text: "Apply color"; disabled: root.access != FieldAccess.editable; key-event(event) => { if (event.text == Key.Escape) { root.cancel-picker(); return KitKeyResult.accept; } return KitKeyResult.reject; } intent: ButtonIntent.primary; activated => { if (root.access == FieldAccess.editable) { root.accept-color(root.draft); root.color-requested(root.draft); } popup.close(); swatch-button.take-focus(); } }
                    }
                    }
                }
            }
        }
    }
    in property <Ownership> ownership: Ownership.local;
    callback chosen(SrgbColorView);
    callback cleared();
    private property <ColorResult> result;
    // The native field engine admits required/custom-validity and deduplicates
    // Enter/blur before the color codec sees a value, including absence.
    public function commit() { editor.commit(); }
    function accept-typed(value: FieldCommit) {
        if (root.access != FieldAccess.editable || !KitFieldService.ready) { return; }
        root.result = KitFieldService.color-parse(value.value.text, root.alpha-mode);
        root.publish();
    }
    function accept-color(value: SrgbColorView) {
        if (root.access != FieldAccess.editable || !KitFieldService.ready) { return; }
        root.result = KitFieldService.color-validate(value, root.alpha-mode);
        root.publish();
    }
    function publish() {
        if (!root.result.valid) { return; }
        let value = root.result.value;
        let present = value.present;
        let color = value.color;
        if (!present && !root.accepted-value.present) { return; }
        if (root.ownership == Ownership.local) { root.accepted-value = value; }
        if (present) { root.chosen(color); }
        else { root.cleared(); }
        root.sync-text();
    }
}

component ColorChannelEditor inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ColorChannel> channel;
    in property <string> label;
    in property <string> error;
    in property <float> position;
    in-out property <string> text;
    in property <string> accepted-text;
    in property <string> slider-value: root.accepted-text;
    changed accepted-text => { root.sync-text(); }
    function sync-text() {
        if (!editor.has-focus) {
            root.text = root.accepted-text;
            editor.acknowledge({present: true, text: root.text});
        }
    }
    callback edited(ColorChannel,string);
    callback commit-requested(ColorChannel,string);
    callback value-committed(ColorChannel,string);
    callback position-requested(ColorChannel,float);
    callback navigate(ColorChannel,NavigationStep);
    callback gesture-started(ColorChannel);
    callback committed(ColorChannel);
    callback cancelled(ColorChannel);
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit;
        editor := KitTextField { theme: root.theme; control-size: root.control-size; access: root.access; text <=> root.text; label: root.label; error: root.error; input-type: InputType.decimal; min: "0"; max: "255"; step: "1"; input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false }; validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine; placeholder: "0–255";
            focus-observed(focused) => { if (!focused) { root.sync-text(); } }
            edited(text) => { root.edited(root.channel,text); }
            committed(value) => { root.value-committed(root.channel,value.value.text); }
            commit-requested(text) => { root.commit-requested(root.channel,text); }
        }
        KitSlider { theme: root.theme; control-size: root.control-size; access: root.access; position: root.position; label: root.label; value: root.slider-value;
            ownership: Ownership.controlled; spec: {minimum: "0", maximum: "255", step: "1"};
            position-requested(position) => { root.position-requested(root.channel,position); }
            navigate(step) => { root.navigate(root.channel,step); }
            gesture-started => { root.gesture-started(root.channel); }
            committed => { root.committed(root.channel); }
            cancelled => { root.cancelled(root.channel); }
        }
    }
}

export component KitColorPicker inherits Rectangle {
    in property <bool> required: true;
    in property <string> required-message: KitStrings.required-message;
    in property <string> pattern-message: root.alpha-mode == ColorAlphaMode.editable ? "Use #RRGGBB or #RRGGBBAA." : "Use #RRGGBB.";
    in property <string> placeholder: root.alpha-mode == ColorAlphaMode.editable ? "#RRGGBBAA" : "#RRGGBB";
    in property <string> description: root.alpha-mode == ColorAlphaMode.editable ? "sRGB hexadecimal, including alpha" : "sRGB hexadecimal";
    // Quick choices of the picker popup; replace or empty to change them.
    in property <[color]> palette: [#ef4444,#f59e0b,#22c55e,#06b6d4,#4f46e5,#a855f7,#111827,#ffffff];
    in property <bool> clearable;
    in property <string> clear-label: KitStrings.clear-label;
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: field.validity;
    out property <bool> will-validate: field.will-validate;
    out property <string> validation-message: field.validation-message;
    callback invalid();
    public function check-validity() -> bool { return field.check-validity(); }
    public function report-validity() -> bool { return field.report-validity(); }
    public function focus-if-invalid() -> bool { return field.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { field.reset-validation(); }
    public function clear() { field.clear(); }
    public function take-focus() { field.take-focus(); }
    private property <SrgbColorView> editable-color: root.accepted-value.present ? root.accepted-value.color : {red: 0, green: 0, blue: 0, alpha: 255};
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ColorAlphaMode> alpha-mode: ColorAlphaMode.opaque;
    in-out property <ColorValue> accepted-value: {present: true, color: {red: 0, green: 0, blue: 0, alpha: 255}};
    in property <string> empty-label: KitStrings.color-empty-label;
    in property <color> swatch: rgba(root.accepted-value.color.red, root.accepted-value.color.green, root.accepted-value.color.blue, root.accepted-value.color.alpha / 255);
    in property <string> label: "Color";
    in property <string> hex-error;
    in property <string> red-error;
    in property <string> green-error;
    in property <string> blue-error;
    in property <string> alpha-error;
    in-out property <string> hex-text: KitFieldService.ready && root.accepted-value.present ? KitFieldService.color-format(root.accepted-value.color, root.alpha-mode) : "";
    in-out property <string> red-text: root.accepted-value.present ? "" + root.accepted-value.color.red : "";
    in-out property <string> green-text: root.accepted-value.present ? "" + root.accepted-value.color.green : "";
    in-out property <string> blue-text: root.accepted-value.present ? "" + root.accepted-value.color.blue : "";
    in-out property <string> alpha-text: root.accepted-value.present ? "" + root.accepted-value.color.alpha : "";
    callback hex-edited(string);
    callback hex-commit-requested(string);
    callback color-requested(SrgbColorView);
    callback channel-edited(ColorChannel,string);
    callback channel-commit-requested(ColorChannel,string);
    callback channel-position-requested(ColorChannel,float);
    callback channel-navigate(ColorChannel,NavigationStep);
    callback gesture-started(ColorChannel);
    callback committed(ColorChannel);
    callback cancelled(ColorChannel);
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 4;
        field := KitColorField { ownership: Ownership.controlled;
            required: root.required; required-message: root.required-message; pattern-message: root.pattern-message; placeholder: root.placeholder; description: root.description; palette: root.palette; clearable: root.clearable; clear-label: root.clear-label; empty-label: root.empty-label;
            custom-validity <=> root.custom-validity; invalid => { root.invalid(); }
            chosen(value) => { root.publish-value({present: true, color: value}); }
            cleared => { root.publish-value({}); } theme: root.theme; control-size: root.control-size; access: root.access; alpha-mode: root.alpha-mode; accepted-value: root.accepted-value; swatch: root.swatch; label: root.label; error: root.hex-error; text <=> root.hex-text; edited(text) => { root.hex-edited(text); } commit-requested(text) => { root.hex-commit-requested(text); } color-requested(color) => { root.color-requested(color); } }
        ColorChannelEditor { theme: root.theme; control-size: root.control-size; access: root.access; channel: ColorChannel.red; label: "Red"; error: root.red-error; text <=> root.red-text; accepted-text: root.accepted-value.present ? "" + root.accepted-value.color.red : ""; slider-value: root.editable-color.red; position: root.editable-color.red / 255;
            edited(channel,text) => { root.channel-edited(channel,text); }
            value-committed(channel,text) => { root.change-channel(channel,text); }
            commit-requested(channel,text) => { root.channel-commit-requested(channel,text); }
            position-requested(channel,value) => { root.move-channel(channel,value); root.channel-position-requested(channel,value); } navigate(channel,step) => { root.navigate-channel(channel,step); root.channel-navigate(channel,step); }
            gesture-started(channel) => { root.snapshot = root.accepted-value; root.gesture-started(channel); } committed(channel) => { root.committed(channel); } cancelled(channel) => { root.publish-value(root.snapshot); root.cancelled(channel); }
        }
        ColorChannelEditor { theme: root.theme; control-size: root.control-size; access: root.access; channel: ColorChannel.green; label: "Green"; error: root.green-error; text <=> root.green-text; accepted-text: root.accepted-value.present ? "" + root.accepted-value.color.green : ""; slider-value: root.editable-color.green; position: root.editable-color.green / 255;
            edited(channel,text) => { root.channel-edited(channel,text); }
            value-committed(channel,text) => { root.change-channel(channel,text); }
            commit-requested(channel,text) => { root.channel-commit-requested(channel,text); }
            position-requested(channel,value) => { root.move-channel(channel,value); root.channel-position-requested(channel,value); } navigate(channel,step) => { root.navigate-channel(channel,step); root.channel-navigate(channel,step); }
            gesture-started(channel) => { root.snapshot = root.accepted-value; root.gesture-started(channel); } committed(channel) => { root.committed(channel); } cancelled(channel) => { root.publish-value(root.snapshot); root.cancelled(channel); }
        }
        ColorChannelEditor { theme: root.theme; control-size: root.control-size; access: root.access; channel: ColorChannel.blue; label: "Blue"; error: root.blue-error; text <=> root.blue-text; accepted-text: root.accepted-value.present ? "" + root.accepted-value.color.blue : ""; slider-value: root.editable-color.blue; position: root.editable-color.blue / 255;
            edited(channel,text) => { root.channel-edited(channel,text); }
            value-committed(channel,text) => { root.change-channel(channel,text); }
            commit-requested(channel,text) => { root.channel-commit-requested(channel,text); }
            position-requested(channel,value) => { root.move-channel(channel,value); root.channel-position-requested(channel,value); } navigate(channel,step) => { root.navigate-channel(channel,step); root.channel-navigate(channel,step); }
            gesture-started(channel) => { root.snapshot = root.accepted-value; root.gesture-started(channel); } committed(channel) => { root.committed(channel); } cancelled(channel) => { root.publish-value(root.snapshot); root.cancelled(channel); }
        }
        if root.alpha-mode == ColorAlphaMode.editable: ColorChannelEditor { theme: root.theme; control-size: root.control-size; access: root.access; channel: ColorChannel.alpha; label: "Alpha"; error: root.alpha-error; text <=> root.alpha-text; accepted-text: root.accepted-value.present ? "" + root.accepted-value.color.alpha : ""; slider-value: root.editable-color.alpha; position: root.editable-color.alpha / 255;
            edited(channel,text) => { root.channel-edited(channel,text); }
            value-committed(channel,text) => { root.change-channel(channel,text); }
            commit-requested(channel,text) => { root.channel-commit-requested(channel,text); }
            position-requested(channel,value) => { root.move-channel(channel,value); root.channel-position-requested(channel,value); } navigate(channel,step) => { root.navigate-channel(channel,step); root.channel-navigate(channel,step); }
            gesture-started(channel) => { root.snapshot = root.accepted-value; root.gesture-started(channel); } committed(channel) => { root.committed(channel); } cancelled(channel) => { root.publish-value(root.snapshot); root.cancelled(channel); }
        }
    }
    in property <Ownership> ownership: Ownership.local;
    private property <ColorResult> result;
    private property <ColorValue> snapshot: root.accepted-value;
    callback chosen(SrgbColorView);
    callback cleared();
    // No alpha editor is mounted in opaque mode to project host changes.
    changed accepted-value => { root.sync-hidden-alpha(); }
    changed alpha-mode => { root.sync-hidden-alpha(); }
    function sync-hidden-alpha() { if (root.alpha-mode == ColorAlphaMode.opaque) { root.alpha-text = root.accepted-value.present ? "" + root.accepted-value.color.alpha : ""; } }
    public function commit() { field.commit(); }
    function change-channel(channel: ColorChannel, text: string) {
        if (root.access != FieldAccess.editable || !KitFieldService.ready) { return; }
        root.result = KitFieldService.color-channel(root.editable-color, channel, text, root.alpha-mode);
        root.publish();
    }
    function move-channel(channel: ColorChannel, position: float) {
        if (!KitFieldService.ready) { return; }
        root.change-channel(channel, KitFieldService.slider-pointer("0", position, {minimum: "0", maximum: "255", step: "1"}));
    }
    function navigate-channel(channel: ColorChannel, step: NavigationStep) {
        if (!KitFieldService.ready) { return; }
        root.change-channel(channel, KitFieldService.slider-navigate(KitFieldService.color-component(root.editable-color, channel), step, {minimum: "0", maximum: "255", step: "1"}));
    }
    function publish() {
        if (root.result.valid) { root.publish-value(root.result.value); }
    }
    function publish-value(value: ColorValue) {
        if (root.access != FieldAccess.editable || !KitFieldService.ready) { return; }
        let present = value.present;
        let color = value.color;
        if (!present && !root.accepted-value.present) { return; }
        if (root.ownership == Ownership.local) { root.accepted-value = value; }
        if (present) { root.chosen(color); }
        else { root.cleared(); }
    }
}
