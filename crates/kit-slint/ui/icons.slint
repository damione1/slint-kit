import { KitTheme, KitThemes, KitThemeContext, KitMetrics, ControlSize, IconRecipe } from "theme.slint";
import { IconGlyph, IconStroke } from "icons/glyph.slint";
export { IconGlyph, IconStroke }

// The kit's own glyphs: original stroked paths on the 24-unit grid Lucide
// uses, so the theme's icon stroke token weighs the same on both sets. No
// external icon assets. Lucide icons are generated separately into
// `@kit/icons/lucide/` and are not copied here.
export global KitGlyphs {
    public pure function chevron-down() -> IconGlyph { return { stroke: "M 4.5 9 L 12 16.5 L 19.5 9", fill: "", viewbox: 24 }; }
    public pure function chevron-left() -> IconGlyph { return { stroke: "M 15 4.5 L 7.5 12 L 15 19.5", fill: "", viewbox: 24 }; }
    public pure function chevron-right() -> IconGlyph { return { stroke: "M 9 4.5 L 16.5 12 L 9 19.5", fill: "", viewbox: 24 }; }
    public pure function close() -> IconGlyph { return { stroke: "M 6 6 L 18 18 M 18 6 L 6 18", fill: "", viewbox: 24 }; }
    public pure function eye() -> IconGlyph { return { stroke: "M 3 12 C 7.5 3 16.5 3 21 12 C 16.5 21 7.5 21 3 12 Z M 15 12 C 15 16.05 9 16.05 9 12 C 9 7.95 15 7.95 15 12 Z", fill: "", viewbox: 24 }; }
    public pure function eye-hidden() -> IconGlyph { return { stroke: "M 3 3 L 21 21 M 3 12 C 7.5 3 16.5 3 21 12 C 18 18 12 19.5 7.5 16.5 M 9 9 C 6 13.5 12 18 15 13.5", fill: "", viewbox: 24 }; }
    public pure function search() -> IconGlyph { return { stroke: "M 15.75 15.75 L 21 21 M 18 10.5 C 18 14.7 14.7 18 10.5 18 C 6.3 18 3 14.7 3 10.5 C 3 6.3 6.3 3 10.5 3 C 14.7 3 18 6.3 18 10.5 Z", fill: "", viewbox: 24 }; }
    public pure function check() -> IconGlyph { return { stroke: "M 4.5 12 L 9.75 17.25 L 19.5 6.75", fill: "", viewbox: 24 }; }
    public pure function minus() -> IconGlyph { return { stroke: "M 4.5 12 L 19.5 12", fill: "", viewbox: 24 }; }
    public pure function plus() -> IconGlyph { return { stroke: "M 4.5 12 L 19.5 12 M 12 4.5 L 12 19.5", fill: "", viewbox: 24 }; }
    public pure function arrow-up-right() -> IconGlyph { return { stroke: "M 6 18 L 18 6 M 6 6 L 18 6 L 18 18", fill: "", viewbox: 24 }; }
    public pure function warning() -> IconGlyph { return { stroke: "M 12 3 L 21 19.5 L 3 19.5 Z M 12 9 L 12 13.5 M 12 16.5 L 12 17.25", fill: "", viewbox: 24 }; }
    public pure function chevron-up() -> IconGlyph { return { stroke: "M 4.5 15 L 12 7.5 L 19.5 15", fill: "", viewbox: 24 }; }
    public pure function bell() -> IconGlyph { return { stroke: "M 6 9 C 6 1.5 18 1.5 18 9 L 18 15 L 21 18 L 3 18 L 6 15 Z M 9 21 L 15 21", fill: "", viewbox: 24 }; }
    public pure function menu() -> IconGlyph { return { stroke: "M 3 6 L 21 6 M 3 12 L 21 12 M 3 18 L 21 18", fill: "", viewbox: 24 }; }
    public pure function information() -> IconGlyph { return { stroke: "M 21 12 C 21 24 3 24 3 12 C 3 0 21 0 21 12 Z M 12 10.5 L 12 16.5 M 12 6.75 L 12 7.5", fill: "", viewbox: 24 }; }
    public pure function article() -> IconGlyph { return { stroke: "M 6 3 L 18 3 L 18 21 L 6 21 Z M 9 7.5 L 15 7.5 M 9 12 L 15 12 M 9 16.5 L 13.5 16.5", fill: "", viewbox: 24 }; }
    public pure function home() -> IconGlyph { return { stroke: "M 3 10.5 L 12 3 L 21 10.5 M 6 9 L 6 21 L 10.5 21 L 10.5 15 L 15 15 L 15 21 L 18 21 L 18 9", fill: "", viewbox: 24 }; }
    public pure function grid() -> IconGlyph { return { stroke: "M 3 3 L 9 3 L 9 9 L 3 9 Z M 15 3 L 21 3 L 21 9 L 15 9 Z M 3 15 L 9 15 L 9 21 L 3 21 Z M 15 15 L 21 15 L 21 21 L 15 21 Z", fill: "", viewbox: 24 }; }
    public pure function copy() -> IconGlyph { return { stroke: "M 9 9 L 21 9 L 21 21 L 9 21 Z M 15 4.5 L 15 3 L 3 3 L 3 15 L 4.5 15", fill: "", viewbox: 24 }; }
    public pure function upload() -> IconGlyph { return { stroke: "M 4.5 15 L 4.5 21 L 19.5 21 L 19.5 15 M 12 16.5 L 12 3 M 6 9 L 12 3 L 18 9", fill: "", viewbox: 24 }; }
    public pure function download() -> IconGlyph { return { stroke: "M 4.5 15 L 4.5 21 L 19.5 21 L 19.5 15 M 12 3 L 12 15 M 6 9 L 12 15 L 18 9", fill: "", viewbox: 24 }; }
    public pure function heart() -> IconGlyph { return { stroke: "M 12 21 L 3 12 C -1.5 3 7.5 0 12 6 C 16.5 0 25.5 3 21 12 Z", fill: "", viewbox: 24 }; }
    public pure function cart() -> IconGlyph { return { stroke: "M 1.5 3 L 4.5 3 L 7.5 16.5 L 19.5 16.5 M 6 7.5 L 21 7.5 L 19.5 13.5 L 7.5 13.5 M 9 19.5 L 9 21 M 18 19.5 L 18 21", fill: "", viewbox: 24 }; }
    public pure function clock() -> IconGlyph { return { stroke: "M 21 12 C 21 24 3 24 3 12 C 3 0 21 0 21 12 Z M 12 6 L 12 12 L 16.5 15", fill: "", viewbox: 24 }; }
    public pure function settings() -> IconGlyph { return { stroke: "M 3 6 L 21 6 M 3 12 L 21 12 M 3 18 L 21 18 M 7.5 3 L 7.5 9 M 16.5 9 L 16.5 15 M 10.5 15 L 10.5 21", fill: "", viewbox: 24 }; }
    public pure function file() -> IconGlyph { return { stroke: "M 6 3 L 13.5 3 L 19.5 9 L 19.5 21 L 6 21 Z M 13.5 3 L 13.5 9 L 19.5 9", fill: "", viewbox: 24 }; }
    public pure function trash() -> IconGlyph { return { stroke: "M 4.5 6 L 19.5 6 M 9 3 L 15 3 M 6 6 L 7.5 21 L 16.5 21 L 18 6 M 10.5 9 L 10.5 16.5 M 13.5 9 L 13.5 16.5", fill: "", viewbox: 24 }; }
}

// decorative: hidden from assistive technology, because the surrounding control
// or text already says what the icon shows. informative: the icon carries
// meaning of its own and is announced as an image named by `label`, which
// must then be set.
export enum IconPurpose { decorative, informative }

// A glyph painted by a round-capped, round-joined stroke, then by a solid fill
// for the glyph's filled shapes. Size follows `control-size` and the theme's
// text scale; the stroke width follows the theme's icon stroke token and
// `stroke-mode`, including at an explicit width and height. The parent passes
// `ink` from its recipe.
export component KitIcon inherits Rectangle {
    in property <IconGlyph> glyph;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <IconPurpose> purpose: IconPurpose.decorative;
    in property <IconStroke> stroke-mode: IconStroke.scaled;
    in property <string> label;
    private property <IconRecipe> recipe: KitThemes.icon-recipe(root.theme, root.control-size);
    in property <color> ink: root.recipe.color;
    // The drawn stroke width in logical pixels.
    out property <length> stroke-width: KitThemes.icon-stroke-width(root.recipe, root.glyph, root.stroke-mode, min(root.width, root.height));
    width: root.recipe.size; height: root.recipe.size;
    horizontal-stretch: 0; vertical-stretch: 0;
    // Slint fits a Path's view box into the Path's box shrunk by the stroke
    // width and offset by half of it, where SVG maps the view box onto the
    // whole box. Each Path is therefore one stroke width larger than the icon
    // and moved back by half, so the view box lands exactly on the icon. The
    // fill layer keeps the same stroke width, unpainted, to share that mapping.
    Path {
        x: -root.stroke-width / 2; y: -root.stroke-width / 2;
        width: root.width + root.stroke-width; height: root.height + root.stroke-width;
        viewbox-width: root.glyph.viewbox; viewbox-height: root.glyph.viewbox;
        commands: root.glyph.stroke;
        stroke: root.ink; stroke-width: root.stroke-width; fill: transparent;
        stroke-line-cap: round; stroke-line-join: round;
    }
    if root.glyph.fill != "": Path {
        x: -root.stroke-width / 2; y: -root.stroke-width / 2;
        width: root.width + root.stroke-width; height: root.height + root.stroke-width;
        viewbox-width: root.glyph.viewbox; viewbox-height: root.glyph.viewbox;
        commands: root.glyph.fill;
        stroke: transparent; stroke-width: root.stroke-width; fill: root.ink;
    }
    // Slint fixes `accessible-role` at compile time, so the informative role
    // lives on a node that exists only for informative icons.
    if root.purpose == IconPurpose.informative: Rectangle {
        width: 100%; height: 100%;
        accessible-role: image;
        accessible-label: root.label;
    }
}

// Internal: an icon that turns between two glyphs, like a chevron that points
// down while closed and up while open. At rest it draws the glyph of its state
// unrotated, so every renderer shows the right direction, including the
// software renderer, which does not rotate paths. On a change it swaps the
// glyph at once and starts it rotated back onto the old direction, then turns
// it home over the theme's fast duration (instantly with reduced motion).
export component TurningIcon inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <color> ink: KitThemes.icon-recipe(root.theme, root.control-size).color;
    in property <bool> turned;
    in property <IconGlyph> rest-glyph;
    in property <IconGlyph> turned-glyph;
    // The clockwise angle that carries `rest-glyph` onto `turned-glyph`.
    in property <angle> turn: 180deg;
    private property <angle> target: root.turned ? root.turn : 0deg;
    private property <angle> eased: root.target;
    animate eased { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.fast; easing: ease-in-out; }
    // The rotation currently applied: zero at rest.
    out property <angle> rotation: root.eased - root.target;
    // The glyph drawn for the current state.
    out property <IconGlyph> glyph: root.turned ? root.turned-glyph : root.rest-glyph;
    width: KitMetrics.icon-size(root.theme, root.control-size); height: self.width;
    horizontal-stretch: 0; vertical-stretch: 0;
    // Slint does not rotate a component's root, so the icon turns inside it.
    KitIcon {
        width: root.width; height: root.height;
        theme: root.theme; control-size: root.control-size; ink: root.ink;
        glyph: root.glyph;
        transform-rotation: root.rotation;
    }
}
