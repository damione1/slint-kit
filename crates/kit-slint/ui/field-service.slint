import { OptionRow } from "contracts.slint";
import { TextEditLabels, TextEditAvailability, TextEditCommandResult, TextMenuPlacement, TextMenuGeometry } from "text-edit.slint";
import { NavigationStep, RangeThumb, ColorAlphaMode } from "shared-contracts.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { FieldAction, CommitPolicy, FieldAccess, Ownership, StepDirection, NumberStepStatus } from "shared-contracts.slint";
import { KitFieldMessages } from "strings.slint";
import { KitInputConstraints } from "validation.slint";
export struct FieldValue { present: bool, text: string }
export struct FieldState {
    accepted: FieldValue, draft: string, dirty: bool, touched: bool,
    error: string, committed: bool, value: FieldValue,
}
export struct FieldCommit { value: FieldValue, constraints: KitInputConstraints, spec: string }
export struct SliderSpec { minimum: string, maximum: string, step: string }
export struct DecimalRangeView { lower: string, upper: string }
export enum ColorChannel { red, green, blue, alpha }
export struct SrgbColorView { red: int, green: int, blue: int, alpha: int }
export struct ColorResult { valid: bool, value: SrgbColorView, text: string }
// `text` is the next draft only when `status` is `stepped`.
export struct NumberStepResult { status: NumberStepStatus, text: string }
// Float projection for accessible value bounds only. An absent bound is
// -inf/+inf and `step="any"` is 0, because Slint always publishes the floats.
export struct NumberRangeView { minimum: float, maximum: float, step: float }
export global KitFieldService {
    pure callback text-menu-options(TextEditLabels, TextEditAvailability) -> [OptionRow];
    pure callback text-menu-command(OptionRow) -> TextEditCommandResult;
    callback text-menu-placement(TextMenuPlacement) -> TextMenuGeometry;
    callback edit-selection(string);
    pure callback color-format(SrgbColorView, ColorAlphaMode) -> string;
    pure callback color-validate(SrgbColorView, ColorAlphaMode) -> ColorResult;
    pure callback color-parse(string, ColorAlphaMode) -> ColorResult;
    pure callback color-component(SrgbColorView, ColorChannel) -> string;
    pure callback color-channel(SrgbColorView, ColorChannel, string, ColorAlphaMode) -> ColorResult;
    pure callback slider-valid(string, SliderSpec) -> bool;
    pure callback range-valid(DecimalRangeView, SliderSpec) -> bool;
    pure callback slider-position(string, SliderSpec) -> float;
    pure callback slider-pointer(string, float, SliderSpec) -> string;
    pure callback slider-navigate(string, NavigationStep, SliderSpec) -> string;
    pure callback range-pointer(DecimalRangeView, RangeThumb, float, SliderSpec) -> DecimalRangeView;
    pure callback range-navigate(DecimalRangeView, RangeThumb, NavigationStep, SliderSpec) -> DecimalRangeView;
    in-out property <bool> ready;
    pure callback display(string, string) -> string;
    // Exact HTML stepping: `count` lattice steps, or a jump to the bound in the direction.
    pure callback step-number(string, KitInputConstraints, StepDirection, int) -> NumberStepResult;
    pure callback step-number-to-bound(string, KitInputConstraints, StepDirection) -> NumberStepResult;
    pure callback number-range(KitInputConstraints) -> NumberRangeView;
    pure callback reduce(FieldState, FieldAction, string, KitInputConstraints, CommitPolicy, Ownership, string, bool, KitFieldMessages) -> FieldState;
}
