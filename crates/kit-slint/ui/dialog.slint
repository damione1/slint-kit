import { KitTheme, KitThemes, KitThemeContext, SurfaceLevel, SurfaceRecipe } from "theme.slint";
import { DialogState, CloseReason } from "contracts.slint";
import { ElevatedSurface } from "elevation.slint";
export { DialogState, CloseReason } from "contracts.slint";
export enum DialogTabPolicy { host, native }

// Modal host: rendered last in its window. Topmost is projected by OverlayStack;
// arbitrary content enters the focus registry via KitFocusTarget.
export component KitDialogSurface inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <DialogState> state;
    in property <bool> dismiss-on-backdrop: true;
    // Native traversal follows the actual mounted controls. Its window host
    // must make background controls ineligible while this modal is open.
    in property <DialogTabPolicy> tab-policy: DialogTabPolicy.host;
    callback dismiss(CloseReason);
    callback focus-next(bool);
    visible: root.state.open;
    background: root.theme.scrim;
    TouchArea {
        // A modal consumes wheel events outside its panel. Scrollable panel
        // descendants receive their own events first through normal hit testing.
        scroll-event(event) => { return accept; }
        clicked => {
            if (root.state.topmost && !root.state.busy && root.dismiss-on-backdrop) { root.dismiss(CloseReason.outside-press); }
        }
    }
    FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (root.state.topmost && root.tab-policy == DialogTabPolicy.host && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.focus-next(event.modifiers.shift || event.text == Key.Backtab); return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (!root.state.topmost) { return reject; }
            if (event.text == Key.Escape) {
                if (!root.state.busy) { root.dismiss(CloseReason.escape); }
                return accept;
            }
            if (event.text == Key.Back) {
                if (!root.state.busy) { root.dismiss(CloseReason.system-back); }
                return accept;
            }
            return reject;
        }
        @children
    }
}
// Place composed header/body/footer inside this panel to consume backdrop hits.
export component KitDialogPanel inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> accessible-name;
    in property <string> accessible-description-text;
    accessible-role: groupbox;
    accessible-label: root.accessible-name;
    accessible-description: root.accessible-description-text;
    private property <SurfaceRecipe> recipe: KitThemes.surface-recipe(root.theme, SurfaceLevel.overlay);
    // The host stays transparent: the surface and its two-layer shadow paint
    // under the composed content, with the host's radius (a drawer squares it).
    border-radius: root.recipe.radius;
    ElevatedSurface { recipe: root.recipe; radius: root.border-radius; }
    TouchArea { }
    @children
}
export component KitDialogHeader inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    min-height: root.theme.spacing.unit * 8;
    HorizontalLayout { spacing: root.theme.spacing.unit * 3; @children }
}
export component KitDialogBody inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    min-height: root.theme.spacing.unit * 12;
    VerticalLayout { spacing: root.theme.spacing.unit * 3; @children }
}
export component KitDialogFooter inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    min-height: root.theme.spacing.unit * 12;
    HorizontalLayout { spacing: root.theme.spacing.unit * 2; alignment: end; @children }
}

export { KitFocusTarget } from "focus.slint";
