import { SurfaceRecipe } from "theme.slint";

// A dialog or popover surface with both layers of its web shadow stacked
// under it. Place it as the first child of a transparent host, so the host's
// content paints above it.
//
// Each layer is a rectangle inset by the layer's spread (a negative spread
// shrinks it). Its fill stays hidden under the surface painted after it, so
// only its shadow shows past the surface edge. Without elevation both layers
// are transparent and only the surface itself is painted.
export component ElevatedSurface inherits Rectangle {
    in property <SurfaceRecipe> recipe;
    // A host may square its corners (a drawer's edge panel) by passing its own radius.
    in property <length> radius: root.recipe.radius;
    for layer in [root.recipe.ambient-shadow, root.recipe.shadow]: Rectangle {
        visible: layer.color.to-hsv().alpha > 0;
        x: -layer.spread;
        y: -layer.spread;
        width: max(0px, root.width + 2 * layer.spread);
        height: max(0px, root.height + 2 * layer.spread);
        border-radius: max(0px, root.radius + layer.spread);
        background: root.recipe.fill;
        drop-shadow-offset-y: layer.offset-y;
        drop-shadow-blur: layer.blur;
        drop-shadow-color: layer.color;
    }
    Rectangle {
        background: root.recipe.fill;
        border-radius: root.radius;
        border-width: root.recipe.border-width;
        border-color: root.recipe.border;
    }
}
