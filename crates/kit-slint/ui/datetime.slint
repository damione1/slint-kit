import { Ownership, CommitPolicy, FieldAction } from "shared-contracts.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { ValidationPresentation } from "shared-contracts.slint";
import { KitFieldError } from "field.slint";
import { KitStrings } from "strings.slint";
import { KitTheme, KitThemes, ButtonIntent, ControlSize, KitThemeContext, KitMetrics, TypographyRole } from "theme.slint";
import { KitButton, KitIconButton } from "button.slint";
import { KitGlyphs } from "icons.slint";
import { FormConstraintState, KitFormValidation } from "validation.slint";
import { KitValidityState } from "validation.slint";
import { HtmlInputKind } from "validation.slint";
import { KitTextField } from "input.slint";
import { KitDateField, CivilDateView } from "calendar.slint";
import { FieldAccess } from "contracts.slint";
import { TimePrecision, ClockFormat } from "shared-contracts.slint";
export { TimePrecision, ClockFormat } from "shared-contracts.slint";

import { TimeSegment, TimeAdjustment, ZonedTimePresentation, AmbiguousTimeChoice, ZonedOccurrenceSelection, ZonedAcceptance, LocalTimeView, LocalDateTimeView, LocalDateTimeDraft, ZonedDateTimeDraft, ZonedDateTimeResult, ZonedDateTimeCommit, KitTimeService } from "datetime-service.slint";
export { TimeSegment, TimeAdjustment, ZonedTimePresentation, AmbiguousTimeChoice, ZonedOccurrenceSelection, ZonedAcceptance, LocalTimeView, LocalDateTimeView, LocalDateTimeDraft, ZonedDateTimeDraft, ZonedDateTimeResult, ZonedDateTimeCommit, KitTimeService } from "datetime-service.slint";
import { FieldCommit, FieldState, FieldValue } from "field-service.slint";

component TimeSegmentControl inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <TimeSegment> segment;
    in property <string> label;
    callback adjust(TimeSegment,TimeAdjustment);
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: root.theme.spacing.unit * 2;
        alignment: start;
        Text { min-width: 72px * root.theme.text-scale; horizontal-stretch: 0; text: root.label; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); vertical-alignment: center; wrap: word-wrap; }
        KitIconButton { theme: root.theme; control-size: root.control-size; glyph: root.theme.icons.minus; accessible-name: "Decrease " + root.label; disabled: root.access != FieldAccess.editable; activated => { root.adjust(root.segment,TimeAdjustment.decrement); } }
        KitIconButton { theme: root.theme; control-size: root.control-size; glyph: root.theme.icons.plus; accessible-name: "Increase " + root.label; disabled: root.access != FieldAccess.editable; activated => { root.adjust(root.segment,TimeAdjustment.increment); } }
    }
}

// The native editor owns caret/selection/IME. The host parses LocalTime and
// applies the format and precision policy; editing never creates an instant.
export component KitTimeField inherits KitTextField {
    input-kind: HtmlInputKind.time;
    validation-twelve-hour: root.clock-format == ClockFormat.twelve-hour;
    step: root.precision == TimePrecision.second ? "1" : "60";
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in property <LocalTimeView> accepted-time;
    in property <ClockFormat> clock-format: ClockFormat.twenty-four-hour;
    in property <TimePrecision> precision: TimePrecision.minute;
    placeholder: root.clock-format == ClockFormat.twelve-hour ? (root.precision == TimePrecision.second ? "hh:mm:ss AM" : "hh:mm AM") : (root.precision == TimePrecision.second ? "HH:mm:ss" : "HH:mm");
    description: root.clock-format == ClockFormat.twenty-four-hour ? "24-hour local time" : "12-hour local time, including AM or PM";
}

export component KitTimePicker inherits Rectangle {
    in property <string> spec-key;
    in property <Ownership> ownership: Ownership.local;
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    out property <FieldState> field-state: editor.field-state;
    out property <string> accepted-text: editor.accepted-text;
    public function acknowledge(value: FieldValue) { editor.acknowledge(value); }
    callback committed(FieldCommit);
    public function commit() { editor.commit(); }
    public function cancel-edit() { editor.cancel-edit(); }
    function adjust-time(segment: TimeSegment, direction: TimeAdjustment) {
        if (root.access != FieldAccess.editable) { return; }
        if (KitTimeService.ready) {
            root.text = KitTimeService.adjust(root.text, root.precision, root.clock-format, segment, direction);
            editor.commit();
        }
        root.adjust(segment, direction);
    }

    in property <bool> required;
    in property <string> min;
    in property <string> max;
    in property <string> step: root.precision == TimePrecision.second ? "1" : "60";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: editor.validity;
    out property <bool> will-validate: editor.will-validate;
    out property <string> validation-message: editor.validation-message;
    callback invalid();
    public function check-validity() -> bool { return editor.check-validity(); }
    public function report-validity() -> bool { return editor.report-validity(); }
    public function focus-if-invalid() -> bool { return editor.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { editor.reset-validation(); }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <LocalTimeView> accepted-time;
    in property <ClockFormat> clock-format: ClockFormat.twenty-four-hour;
    in property <TimePrecision> precision: TimePrecision.minute;
    in property <string> label;
    in property <string> error;
    in-out property <string> text;
    callback edited(string);
    callback commit-requested(string);
    callback adjust(TimeSegment,TimeAdjustment);
    callback cancelled();
    public function take-focus() { editor.take-focus(); }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        editor := KitTimeField {
                ownership: root.ownership; commit-policy: root.commit-policy; spec-key: root.spec-key; committed(value) => { root.committed(value); }
                required: root.required; min: root.min; max: root.max; step: root.step;
                custom-validity <=> root.custom-validity;
                invalid => { root.invalid(); }
 theme: root.theme; control-size: root.control-size; access: root.access; accepted-time: root.accepted-time; clock-format: root.clock-format; precision: root.precision; label: root.label; error: root.error; text <=> root.text; edited(text) => { root.edited(text); } commit-requested(text) => { root.commit-requested(text); } cancelled => { root.cancelled(); } }
        TimeSegmentControl { theme: root.theme; control-size: root.control-size; access: root.access; segment: TimeSegment.hour; label: "Hours"; adjust(segment,direction) => { root.adjust-time(segment,direction); } }
        TimeSegmentControl { theme: root.theme; control-size: root.control-size; access: root.access; segment: TimeSegment.minute; label: "Minutes"; adjust(segment,direction) => { root.adjust-time(segment,direction); } }
        if root.precision == TimePrecision.second: TimeSegmentControl { theme: root.theme; control-size: root.control-size; access: root.access; segment: TimeSegment.second; label: "Seconds"; adjust(segment,direction) => { root.adjust-time(segment,direction); } }
    }
}

// Separate date and time editors compose one commit payload. No half-accepted
// application value is emitted when just one of the drafts parses successfully.
export component KitDateTimeField inherits Rectangle {
    in property <Ownership> ownership: Ownership.local;
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    private property <LocalDateTimeView> candidate;
    private property <LocalDateTimeDraft> current-draft: {date: root.date-text, time: root.time-text};
    // Native edits since the last acceptance; host text assignments are not typing.
    private property <bool> draft-dirty;
    callback chosen(LocalDateTimeView);
    callback cleared();
    // Enter, commit() and leaving the whole group share this acceptance path.
    // Blur reads validity without firing `invalid`: the constraint state already
    // noted the touch and shows errors by its timing. An unchanged pair is not
    // chosen again.
    function accept-pair(action: FieldAction) {
        if (root.access != FieldAccess.editable || !KitTimeService.ready) { return; }
        if (action == FieldAction.blur || action == FieldAction.edit ? !root.validity.valid : !root.report-validity()) { return; }
        if (root.date-text == "" && root.time-text == "") {
            root.draft-dirty = false;
            if (root.accepted-value != {}) {
                if (root.ownership == Ownership.local) { root.accepted-value = {}; }
                root.cleared();
            }
            if (action == FieldAction.submit) { root.commit-requested(root.current-draft); }
            return;
        }
        root.candidate = KitTimeService.parse-local(root.current-draft, root.precision, root.clock-format);
        if (root.candidate.date.year == 0) { return; }
        root.draft-dirty = false;
        if (root.candidate != root.accepted-value) {
            if (root.ownership == Ownership.local) { root.accepted-value = root.candidate; }
            root.chosen(root.candidate);
        }
        if (action == FieldAction.submit) { root.commit-requested(root.current-draft); }
    }
    public function commit() { root.accept-pair(FieldAction.submit); }

    in property <bool> required;
    in property <bool> clearable;
    in property <string> clear-label: KitStrings.clear-label;
    private property <bool> show-clear: root.clearable && (root.date-text != "" || root.time-text != "");
    in property <string> min;
    in property <string> max;
    in property <string> step: root.precision == TimePrecision.second ? "1" : "60";
    in property <string> default-value;
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { return checks.report-validity(); }
    public function focus-if-invalid() -> bool { if (root.will-validate && !root.validity.valid) { root.take-focus(); return true; } return false; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.date-time-local; access: root.access; required: root.required;
        min: root.min; max: root.max; step: root.step; default-value: root.default-value;
        twelve-hour: root.clock-format == ClockFormat.twelve-hour;
        text: root.date-text == "" && root.time-text == "" ? "" : root.date-text + "T" + root.time-text;
        custom-validity: root.custom-validity != "" ? root.custom-validity : root.date-error != "" ? root.date-error : root.time-error;
        invalid => { root.invalid(); }
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in-out property <LocalDateTimeView> accepted-value;
    in property <ClockFormat> clock-format: ClockFormat.twenty-four-hour;
    in property <TimePrecision> precision: TimePrecision.minute;
    in property <string> label;
    in property <string> date-placeholder: "YYYY-MM-DD";
    in property <string> date-description: "Civil date; no time zone";
    in property <string> time-description: root.clock-format == ClockFormat.twenty-four-hour ? "24-hour local time" : "12-hour local time, including AM or PM";
    in property <string> date-label: root.label + " — date";
    in property <string> time-label: root.label + " — time";
    in property <string> date-error;
    in property <string> time-error;
    in-out property <string> date-text;
    in-out property <string> time-text;
    callback edited(LocalDateTimeDraft);
    callback commit-requested(LocalDateTimeDraft);
    callback cancelled();
    callback focus-observed(bool);
    out property <bool> editor-focused: date.has-focus || time.has-focus;
    // Moving between the date and time editors keeps the group focused; only
    // leaving the group is a blur for the atomic pair.
    private property <bool> control-focused: root.editor-focused || clear-action.has-focus;
    changed control-focused => {
        if (!root.control-focused) {
            checks.note-blur();
            if (root.commit-policy == CommitPolicy.on-blur && root.draft-dirty) { root.accept-pair(FieldAction.blur); }
        }
        root.focus-observed(root.control-focused);
    }
    public function take-focus() { date.take-focus(); }
    // Request each public native clear action independently. Each editor owns
    // its undo entry; only two empty, valid drafts can accept absence.
    public function clear() {
        if (root.access != FieldAccess.editable || !KitTimeService.ready) { return; }
        date.clear(); time.clear();
    }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 4;
        date := KitDateField {
            theme: root.theme; control-size: root.control-size; access: root.access; accepted-date: root.accepted-value.date; text <=> root.date-text; label: root.date-label; error: root.date-error; placeholder: root.date-placeholder; description: root.date-description;
            edited(text) => { checks.note-edit(); root.draft-dirty = true; root.edited({date: text, time: root.time-text}); if (root.commit-policy == CommitPolicy.on-change-when-valid) { root.accept-pair(FieldAction.edit); } }
            commit-requested(text) => { root.commit(); }
            cancelled => { root.cancelled(); }
        }
        HorizontalLayout {
            spacing: root.show-clear ? KitMetrics.inline-gap(root.theme) : 0px;
            time := KitTimeField {
                step: "any";
                theme: root.theme; control-size: root.control-size; access: root.access; accepted-time: root.accepted-value.time; clock-format: root.clock-format; precision: root.precision; text <=> root.time-text; label: root.time-label; error: root.time-error; description: root.time-description;
                edited(text) => { checks.note-edit(); root.draft-dirty = true; root.edited({date: root.date-text, time: text}); if (root.commit-policy == CommitPolicy.on-change-when-valid) { root.accept-pair(FieldAction.edit); } }
                commit-requested(text) => { root.commit(); }
                cancelled => { root.cancelled(); }
            }
            clear-action := KitIconButton {
                theme: root.theme; control-size: ControlSize.compact; glyph: root.theme.icons.close;
                layout-order: time.trailing-adornment-order;
                cross-axis-self-alignment: center;
                visible: root.show-clear; min-width: 0px;
                preferred-width: root.show-clear ? self.preferred-height : 0px; max-width: self.preferred-width;
                accessible-name: root.clear-label; focus-on-pointer: false;
                disabled: !root.show-clear || root.access != FieldAccess.editable;
                activated => { root.clear(); }
            }
        }
        if checks.show-error && root.date-error == "" && root.time-error == "": KitFieldError { theme: root.theme; text: checks.validation-message; }
    }
}

export component KitZonedDateTimeField inherits Rectangle {
    out property <ZonedOccurrenceSelection> occurrence-selection: root.selected-occurrence;
    private property <ZonedOccurrenceSelection> selected-occurrence;
    changed resolution => { if (root.resolution != ZonedTimePresentation.ambiguous) { root.selected-occurrence = ZonedOccurrenceSelection.unselected; } }
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    private property <ZonedDateTimeResult> result;
    private property <ZonedDateTimeDraft> current: {date: root.date-text, time: root.time-text, zone: root.zone-text};
    private property <ZonedDateTimeDraft> resolved-draft;
    private property <ZonedDateTimeDraft> pressed-draft;
    // Native edits since the last resolution; host text assignments are not typing.
    private property <bool> draft-dirty;
    callback chosen(ZonedDateTimeCommit);
    public function resolve() { root.resolve-draft(FieldAction.submit); }
    // Enter in any part, resolve() and leaving the whole group share this path.
    // Blur reads validity without firing `invalid`; each native editor already
    // shows its own errors.
    function resolve-draft(action: FieldAction) {
        if (root.access != FieldAccess.editable || !KitTimeService.ready) { return; }
        root.selected-occurrence = ZonedOccurrenceSelection.unselected;
        root.result = {state: ZonedTimePresentation.unresolved};
        if (action == FieldAction.blur ? !root.validity.valid : !root.report-validity()) { return; }
        root.draft-dirty = false;
        root.resolved-draft = root.current;
        root.result = KitTimeService.resolve(root.current, root.precision, root.clock-format);
        root.resolve-requested(root.current);
        if (root.result.state == ZonedTimePresentation.unique) { root.chosen({local: root.result.local, zone: root.zone-text, acceptance: ZonedAcceptance.unique}); }
    }
    function accept-occurrence(choice: AmbiguousTimeChoice) {
        if (root.access != FieldAccess.editable || root.pressed-draft != root.current || root.resolution != ZonedTimePresentation.ambiguous || root.selected-occurrence != ZonedOccurrenceSelection.unselected) { return; }
        root.selected-occurrence = choice == AmbiguousTimeChoice.earlier ? ZonedOccurrenceSelection.earlier : ZonedOccurrenceSelection.later;
        if (root.resolved-draft == root.current && root.result.state == ZonedTimePresentation.ambiguous) {
            root.chosen({local: root.result.local, zone: root.zone-text, acceptance: choice == AmbiguousTimeChoice.earlier ? ZonedAcceptance.earlier : ZonedAcceptance.later});
        }
        root.ambiguity-chosen(choice);
    }
    changed current => {
        // A host may resolve its new draft synchronously inside chosen().
        if (root.resolved-draft != root.current) {
            root.selected-occurrence = ZonedOccurrenceSelection.unselected;
            root.result = {state: ZonedTimePresentation.unresolved};
        }
    }

    in property <bool> required;
    in property <string> min;
    in property <string> max;
    in property <string> step: root.precision == TimePrecision.second ? "1" : "60";
    in-out property <string> custom-validity;
    in property <string> invalid-zone-message: "Please enter a known IANA time zone.";
    out property <KitValidityState> validity: KitFormValidation.combine(local.validity, zone.validity);
    out property <bool> will-validate: local.will-validate || zone.will-validate;
    out property <string> validation-message: !local.validity.valid ? local.validation-message : zone.validation-message;
    callback invalid();
    public function check-validity() -> bool { let a = local.check-validity(); let b = zone.check-validity(); return a && b; }
    public function report-validity() -> bool { let local-valid = local.report-validity(); let zone-valid = zone.report-validity(); return local-valid && zone-valid; }
    public function focus-if-invalid() -> bool { if (local.focus-if-invalid()) { return true; } return zone.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { local.reset-validation(); zone.reset-validation(); }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <LocalDateTimeView> accepted-local;
    in property <ClockFormat> clock-format: ClockFormat.twenty-four-hour;
    in property <TimePrecision> precision: TimePrecision.minute;
    in property <string> label;
    in property <string> date-placeholder: "YYYY-MM-DD";
    in property <string> date-description: "Civil date; no time zone";
    in property <string> time-description: root.clock-format == ClockFormat.twenty-four-hour ? "24-hour local time" : "12-hour local time, including AM or PM";
    in property <string> date-label: root.label + " — date";
    in property <string> time-label: root.label + " — time";
    in property <string> zone-label: "Time zone";
    in property <string> zone-placeholder: "America/Toronto";
    in property <string> zone-description: "IANA time zone identifier";
    in property <string> earlier-accepted-message: "Earlier occurrence accepted.";
    in property <string> later-accepted-message: "Later occurrence accepted.";
    in property <string> earlier-label: "Use the earlier occurrence";
    in property <string> later-label: "Use the later occurrence";
    in property <string> date-error;
    in property <string> time-error;
    in property <string> zone-error;
    in property <string> resolution-message: root.resolution == ZonedTimePresentation.ambiguous ? "This local time occurs twice. Choose an occurrence." : root.resolution == ZonedTimePresentation.nonexistent ? "This local time does not exist in this time zone." : root.resolution == ZonedTimePresentation.invalid-zone ? root.invalid-zone-message : root.resolution == ZonedTimePresentation.unique ? "Local time resolved." : "";
    in property <ZonedTimePresentation> resolution: root.result.state;
    in-out property <string> date-text;
    in-out property <string> time-text;
    in-out property <string> zone-text;
    callback edited(ZonedDateTimeDraft);
    callback resolve-requested(ZonedDateTimeDraft);
    callback ambiguity-chosen(AmbiguousTimeChoice);
    callback ambiguity-started();
    callback focus-observed(bool);
    out property <bool> editor-focused: local.editor-focused || zone.has-focus;
    // The date, time and zone editors form one group: moving between them is
    // not a blur; leaving all three resolves the typed draft.
    changed editor-focused => {
        if (!root.editor-focused && root.commit-policy == CommitPolicy.on-blur && root.draft-dirty) { root.resolve-draft(FieldAction.blur); }
        root.focus-observed(root.editor-focused);
    }
    callback cancelled();
    public function take-focus() { local.take-focus(); }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 4;
        local := KitDateTimeField {
            // The zoned group owns the blur; the inner pair only commits on Enter.
            commit-policy: CommitPolicy.on-submit;
            required: root.required || root.zone-text != ""; min: root.min; max: root.max; step: root.step;
            custom-validity: root.custom-validity != "" ? root.custom-validity
                : (root.resolution == ZonedTimePresentation.ambiguous && root.selected-occurrence == ZonedOccurrenceSelection.unselected) || root.resolution == ZonedTimePresentation.nonexistent || root.resolution == ZonedTimePresentation.invalid-zone
                    ? (root.resolution-message != "" ? root.resolution-message : "Resolve the local time in this time zone.") : "";
            invalid => { root.invalid(); }
            theme: root.theme; control-size: root.control-size; access: root.access; accepted-value: root.accepted-local; clock-format: root.clock-format; precision: root.precision; label: root.label; date-label: root.date-label; time-label: root.time-label; date-placeholder: root.date-placeholder; date-description: root.date-description; time-description: root.time-description; date-error: root.date-error; time-error: root.time-error; date-text <=> root.date-text; time-text <=> root.time-text;
            edited(draft) => { root.draft-dirty = true; root.edited({date: draft.date, time: draft.time, zone: root.zone-text}); }
            commit-requested(draft) => { root.resolve(); }
            cancelled => { root.cancelled(); }
        }
        zone := KitTextField {
            required: root.required || root.date-text != "" || root.time-text != "";
            custom-validity: KitFormValidation.ready && root.zone-text != "" && !KitFormValidation.valid-time-zone(root.zone-text) ? root.invalid-zone-message : "";
            invalid => { root.invalid(); }
            theme: root.theme; control-size: root.control-size; access: root.access; text <=> root.zone-text; label: root.zone-label; placeholder: root.zone-placeholder; description: root.zone-description; error: root.zone-error; validation: root.zone-error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
            edited(text) => { root.draft-dirty = true; root.edited({date: root.date-text, time: root.time-text, zone: text}); }
            commit-requested(text) => { root.resolve(); }
        }
        if root.resolution != ZonedTimePresentation.unresolved: Text {
            text: root.selected-occurrence == ZonedOccurrenceSelection.unselected ? root.resolution-message : root.selected-occurrence == ZonedOccurrenceSelection.earlier ? root.earlier-accepted-message : root.later-accepted-message;
            color: root.resolution == ZonedTimePresentation.unique || root.selected-occurrence != ZonedOccurrenceSelection.unselected ? root.theme.text-secondary : root.theme.danger;
            font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.resolution == ZonedTimePresentation.ambiguous: VerticalLayout {
            spacing: root.theme.spacing.unit * 2;
            KitButton { theme: root.theme; control-size: root.control-size; text: root.earlier-label; accessible-checkable: true; accessible-checked: root.selected-occurrence == ZonedOccurrenceSelection.earlier; intent: root.selected-occurrence == ZonedOccurrenceSelection.earlier ? ButtonIntent.primary : ButtonIntent.secondary; disabled: root.access != FieldAccess.editable || root.selected-occurrence != ZonedOccurrenceSelection.unselected; activation-started => { root.pressed-draft = root.current; root.ambiguity-started(); } activated => { root.accept-occurrence(AmbiguousTimeChoice.earlier); } }
            KitButton { theme: root.theme; control-size: root.control-size; text: root.later-label; accessible-checkable: true; accessible-checked: root.selected-occurrence == ZonedOccurrenceSelection.later; intent: root.selected-occurrence == ZonedOccurrenceSelection.later ? ButtonIntent.primary : ButtonIntent.secondary; disabled: root.access != FieldAccess.editable || root.selected-occurrence != ZonedOccurrenceSelection.unselected; activation-started => { root.pressed-draft = root.current; root.ambiguity-started(); } activated => { root.accept-occurrence(AmbiguousTimeChoice.later); } }
        }
    }
}
