// SPDX-License-Identifier: GPL-3.0-or-later
// A vector icon: SVG path `commands` on a square grid of `viewbox` units,
// painted by a round-capped, round-joined stroke `stroke` units wide. Glyphs
// come from generated or kit globals (`LucideIcons.arrow-up()`,
// `KitGlyphs.check()`); writing one by hand is possible but explicit.
export struct IconGlyph { commands: string, viewbox: float, stroke: float }
