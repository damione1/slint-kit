// SPDX-License-Identifier: GPL-3.0-or-later
import { FieldAccess, ValidationPresentation } from "shared-contracts.slint";
import { IconGlyph, IconStroke } from "icons/glyph.slint";
import { LucideIcons } from "icons/lucide/all.slint";
export struct KitIconSet { close: IconGlyph, check: IconGlyph, minus: IconGlyph, plus: IconGlyph, chevron-down: IconGlyph, chevron-up: IconGlyph, chevron-left: IconGlyph, chevron-right: IconGlyph, eye: IconGlyph, eye-hidden: IconGlyph, search: IconGlyph, information: IconGlyph, warning: IconGlyph, bell: IconGlyph, article: IconGlyph }
export enum ControlSize { compact, medium, comfortable }
export enum ControlWidth { intrinsic, fill }
export enum TypographyRole { caption, control, body, subtitle, title }
// secondary is a filled neutral surface; outline is a transparent bordered
// control; quiet is borderless (the web's ghost).
export enum ButtonIntent { primary, secondary, outline, quiet, destructive }
// Presentation-only token vocabulary: Rust consumers use the generated Slint
// enums. A level names a shadow; the theme supplies that shadow's geometry.
export enum ElevationLevel { none, xs, sm, md, lg, xl }
// outside: a ring around the host, separated by `offset`. inside: a ring drawn
// over the host's own edge, for tightly packed rows, cells and thumbs.
export enum FocusRingStyle { outside, inside }
export enum SurfaceLevel { flat, raised, overlay, popover }
export enum AlertSeverity { information, success, warning, error }

// One layer of a web box shadow. Slint draws one shadow per element and has
// no spread: a surface's own drop-shadow paints `key` and ignores `spread`.
// Dialogs and popovers stack both layers on rectangles inset by `spread`.
export struct ShadowLayer { offset-y: length, blur: length, spread: length, color: color }
// The two layers of a web shadow: `key` is the dominant, directional one,
// `ambient` the tighter one under it.
export struct KitShadow { key: ShadowLayer, ambient: ShadowLayer }
// Radii by role. Pill radii are clamped by recipes to half the shorter side.
// `icon-stroke` is the icon line weight: grid units for a scaled stroke,
// logical pixels for an absolute one (see IconStroke).
export struct KitShape {
    radius-control: length, radius-container: length, radius-overlay: length, radius-pill: length,
    border-width: length, border-width-strong: length, icon-stroke: float,
}
export struct KitElevation {
    control: ElevationLevel, container: ElevationLevel, overlay: ElevationLevel, popover: ElevationLevel,
    xs: KitShadow, sm: KitShadow, md: KitShadow, lg: KitShadow, xl: KitShadow,
}
export struct KitFocusRing { style: FocusRingStyle, width: length, offset: length, color: color, invalid-color: color }
// `family` is an open set (system or embedded font); empty keeps the window's
// default font family. Sizes are unscaled: recipes multiply them by text-scale.
export struct KitTypography {
    family: string, family-monospace: string,
    weight-regular: int, weight-medium: int, weight-semibold: int, weight-bold: int,
    size-caption: length, size-control: length, size-body: length, size-subtitle: length, size-title: length,
    line-height-control: length,
}
// Paddings and heights by ControlSize; one spacing unit derives gaps and insets.
export struct KitControlDensity { height: length, padding-inline: length, padding-block: length }
export struct KitSpacing { unit: length, compact: KitControlDensity, medium: KitControlDensity, comfortable: KitControlDensity }
export struct KitMotion { fast: duration, base: duration, slow: duration }
export struct KitTheme {
    canvas: color, surface: color, surface-raised: color,
    text-primary: color, text-secondary: color, placeholder: color,
    accent: color, on-accent: color, accent-hover: color, accent-pressed: color, accent-subtle: color,
    selection: color, on-selection: color,
    danger: color, danger-hover: color, danger-pressed: color, danger-subtle: color, success: color, success-subtle: color,
    warning: color, warning-subtle: color, information: color, information-subtle: color,
    border-subtle: color, border-strong: color,
    hover: color, pressed: color, disabled-fill: color, disabled-text: color, scrim: color,
    shape: KitShape, elevation: KitElevation, focus: KitFocusRing, typography: KitTypography,
    spacing: KitSpacing, motion: KitMotion, icons: KitIconSet,
    reduced-motion: bool, text-scale: float,
}

export struct ButtonRecipe {
    fill: brush, hover-fill: brush, pressed-fill: brush, disabled-fill: brush,
    foreground: color, disabled-foreground: color, border: color,
    radius: length, padding-inline: length, padding-block: length, border-width: length, height: length,
    font-size: length, font-weight: int,
    busy-mark-size: length, busy-mark-stroke: length,
    // The control's elevation: the key layer of `elevation`, painted under it.
    elevation: ElevationLevel, shadow: ShadowLayer,
    focus: KitFocusRing,
}
export struct FieldRecipe {
    fill: brush, border: color, hover-border: color, foreground: color, placeholder: color, selection: color, on-selection: color,
    radius: length, border-width: length, padding-inline: length, padding-block: length, height: length, font-size: length,
    focus: KitFocusRing,
}
export struct SurfaceRecipe { fill: brush, border: color, radius: length, border-width: length, elevation: ElevationLevel, shadow: ShadowLayer, ambient-shadow: ShadowLayer }
export struct ChoiceRecipe {
    box-size: length, box-radius: length, mark-stroke: length, radio-dot-size: length, label-gap: length,
    track-width: length, track-height: length, track-radius: length, thumb-size: length, thumb-inset: length,
    check-size: length, mixed-width: length,
    slider-track-height: length, slider-thumb-size: length,
    group-radius: length, group-padding: length, group-gap: length,
    transition: duration, focus: KitFocusRing,
}
// Rows of a list or menu. The active row is the keyboard target of its
// composite and paints `focus` over its own edge; selected rows keep a tint.
export struct OptionRecipe {
    fill: brush, hover-fill: brush, pressed-fill: brush, active-fill: brush, selected-fill: brush,
    foreground: color, selected-foreground: color, disabled-foreground: color,
    radius: length, padding-inline: length, height: length, font-size: length,
    focus: KitFocusRing,
}
// An icon's box, inks and stroke token. The drawn stroke width also depends on
// the glyph's grid and the stroke mode: see `KitThemes.icon-stroke-width`.
export struct IconRecipe { size: length, color: color, disabled-color: color, stroke: float }
// A severity's tint, edge and mark, so alerts stay distinguishable without
// relying on their titles.
export struct AlertRecipe { fill: color, border: color, mark: color, radius: length, border-width: length, inset: length, gap: length }
// A tooltip bubble: inverted ink, its own inline and block padding, and a
// reading width it never exceeds. `gap` separates it from its anchor and from
// the window edges.
export struct TooltipRecipe {
    fill: color, foreground: color, radius: length, padding-inline: length, padding-block: length,
    max-width: length, font-size: length, gap: length,
}
// A scroll bar overlays its viewport edge. `thickness` is its footprint; the
// thumb grows from `thumb-thickness` to `active-thumb-thickness` under the pointer.
export struct ScrollBarRecipe {
    thickness: length, thumb-thickness: length, active-thumb-thickness: length, inset: length, min-thumb-length: length,
    thumb: color, active-thumb: color, track: color, active-track: color,
    transition: duration,
}

// Metrics derive from theme tokens; text sizes and control heights follow text-scale.
export global KitMetrics {
    public pure function label-gap(theme: KitTheme) -> length { return theme.spacing.unit * 2; }
    // Between the items of one control row: adornments, an editor and its
    // actions, a group of buttons.
    public pure function inline-gap(theme: KitTheme) -> length { return theme.spacing.unit * 2; }
    public pure function help-gap(theme: KitTheme) -> length { return theme.spacing.unit; }
    public pure function field-gap(theme: KitTheme) -> length { return theme.spacing.unit * 4; }
    public pure function section-gap(theme: KitTheme) -> length { return theme.spacing.unit * 6; }
    public pure function footer-gap(theme: KitTheme) -> length { return theme.spacing.unit * 3; }
    public pure function font-size(theme: KitTheme, role: TypographyRole) -> length {
        return (role == TypographyRole.caption ? theme.typography.size-caption
            : role == TypographyRole.control ? theme.typography.size-control
            : role == TypographyRole.body ? theme.typography.size-body
            : role == TypographyRole.subtitle ? theme.typography.size-subtitle
            : theme.typography.size-title) * theme.text-scale;
    }
    public pure function density(theme: KitTheme, size: ControlSize) -> KitControlDensity {
        return size == ControlSize.compact ? theme.spacing.compact : size == ControlSize.comfortable ? theme.spacing.comfortable : theme.spacing.medium;
    }
    // Menu, tab and breadcrumb rows: at least a control, and one scaled line
    // of text with two spacing units above and below it.
    public pure function row-height(theme: KitTheme, size: ControlSize) -> length {
        return max(KitMetrics.control-height(theme, size), theme.typography.line-height-control * theme.text-scale + theme.spacing.unit * 4);
    }
    // Tailwind size-3.5/4/5, scaled with text so icons stay legible at 200%.
    public pure function icon-size(theme: KitTheme, size: ControlSize) -> length {
        return (size == ControlSize.compact ? 14px : size == ControlSize.comfortable ? 20px : 16px) * theme.text-scale;
    }
    // A control never clips one line of scaled text inside its block padding.
    public pure function control-height(theme: KitTheme, size: ControlSize) -> length {
        return max(KitMetrics.density(theme, size).height, theme.typography.line-height-control * theme.text-scale + 2 * KitMetrics.density(theme, size).padding-block);
    }
}

export global KitThemes {
    out property <KitTheme> light: {
        canvas: #f1f5f9 /* slate-100 */, surface: #ffffff /* white */, surface-raised: #ffffff /* white */,
        text-primary: #0f172a /* slate-900 */, text-secondary: #475569 /* slate-600 */, placeholder: #475569 /* slate-600: AA on the slate-100 canvas */,
        accent: #4f46e5 /* indigo-600 */, on-accent: #ffffff /* white */,
        accent-hover: #4338ca /* indigo-700 */, accent-pressed: #3730a3 /* indigo-800 */, accent-subtle: #eef2ff /* indigo-50 */,
        selection: #c7d2fe /* indigo-200 */, on-selection: #0f172a /* slate-900 */,
        danger: #b91c1c /* red-700 */, danger-hover: #991b1b /* red-800 */, danger-pressed: #7f1d1d /* red-900 */, danger-subtle: #fef2f2 /* red-50 */,
        success: #16a34a /* green-600 */, success-subtle: #f0fdf4 /* green-50 */,
        warning: #d97706 /* amber-600 */, warning-subtle: #fffbeb /* amber-50 */,
        information: #0284c7 /* sky-600 */, information-subtle: #f0f9ff /* sky-50 */,
        // border-strong outlines controls that a light border would hide:
        // checkboxes, radios, switch and slider tracks, outline buttons.
        border-subtle: #e2e8f0 /* slate-200 */, border-strong: #64748b /* slate-500: visible control boundaries */,
        hover: #f1f5f9 /* slate-100 */, pressed: #e2e8f0 /* slate-200 */,
        disabled-fill: #f1f5f9 /* slate-100 */, disabled-text: #94a3b8 /* slate-400 */, scrim: #00000080 /* black/50 */,
        // rounded-md, rounded-lg, rounded-xl and rounded-full.
        shape: { radius-control: 6px, radius-container: 8px, radius-overlay: 12px, radius-pill: 9999px, border-width: 1px, border-width-strong: 2px, icon-stroke: 2 },
        elevation: {
            // Filled buttons carry shadow-xs, cards shadow-sm, popovers
            // shadow-md and dialogs shadow-lg.
            control: ElevationLevel.xs, container: ElevationLevel.sm, overlay: ElevationLevel.lg, popover: ElevationLevel.md,
            // shadow-xs .. shadow-xl, rgb(0 0 0 / 0.05) and rgb(0 0 0 / 0.1).
            xs: { key: { offset-y: 1px, blur: 2px, spread: 0px, color: #0000000d }, ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } },
            sm: { key: { offset-y: 1px, blur: 3px, spread: 0px, color: #0000001a }, ambient: { offset-y: 1px, blur: 2px, spread: -1px, color: #0000001a } },
            md: { key: { offset-y: 4px, blur: 6px, spread: -1px, color: #0000001a }, ambient: { offset-y: 2px, blur: 4px, spread: -2px, color: #0000001a } },
            lg: { key: { offset-y: 10px, blur: 15px, spread: -3px, color: #0000001a }, ambient: { offset-y: 4px, blur: 6px, spread: -4px, color: #0000001a } },
            xl: { key: { offset-y: 20px, blur: 25px, spread: -5px, color: #0000001a }, ambient: { offset-y: 8px, blur: 10px, spread: -6px, color: #0000001a } },
        },
        // ring-2 ring-offset-2 in indigo-500; invalid fields ring in red-600.
        focus: { style: FocusRingStyle.outside, width: 2px, offset: 2px, color: #6366f1 /* indigo-500 */, invalid-color: #dc2626 /* red-600 */ },
        typography: {
            family: "", family-monospace: "monospace", weight-regular: 400, weight-medium: 500, weight-semibold: 600, weight-bold: 700,
            // text-xs, text-sm, text-base, text-xl and text-3xl; text-sm line height.
            size-caption: 12px, size-control: 14px, size-body: 14px, size-subtitle: 18px, size-title: 30px,
            line-height-control: 20px,
        },
        // --spacing: 0.25rem. Heights h-8, h-9 and h-10; paddings px-3/px-4/px-6, py-1.5/py-2.
        spacing: {
            unit: 4px,
            compact: { height: 32px, padding-inline: 12px, padding-block: 6px },
            medium: { height: 36px, padding-inline: 14px, padding-block: 6px },
            comfortable: { height: 40px, padding-inline: 24px, padding-block: 8px },
        },
        // duration-150, duration-200 and duration-300.
        motion: { fast: 150ms, base: 200ms, slow: 300ms },
        icons: { close: LucideIcons.x(), check: LucideIcons.check(), minus: LucideIcons.minus(), plus: LucideIcons.plus(), chevron-down: LucideIcons.chevron-down(), chevron-up: LucideIcons.chevron-up(), chevron-left: LucideIcons.chevron-left(), chevron-right: LucideIcons.chevron-right(), eye: LucideIcons.eye(), eye-hidden: LucideIcons.eye-off(), search: LucideIcons.search(), information: LucideIcons.info(), warning: LucideIcons.triangle-alert(), bell: LucideIcons.bell(), article: LucideIcons.file-text() },
        reduced-motion: false, text-scale: 1,
    };
    out property <KitTheme> dark: {
        // Raised surfaces (popovers, dialogs) keep the card tone, as shadcn's
        // dark popover does: border, shadow and scrim set them apart, so the
        // slate-800 hover and border stay visible on every surface.
        canvas: #020617 /* slate-950 */, surface: #0f172a /* slate-900 */, surface-raised: #0f172a /* slate-900 */,
        text-primary: #f8fafc /* slate-50 */, text-secondary: #94a3b8 /* slate-400 */, placeholder: #94a3b8 /* slate-400 */,
        // Labels on the indigo-400 accent use slate-950 (6.8:1): indigo-950
        // passed AA at 5.4:1 but read as low-contrast indigo on indigo.
        accent: #818cf8 /* indigo-400 */, on-accent: #020617 /* slate-950 */,
        accent-hover: #a5b4fc /* indigo-300 */, accent-pressed: #c7d2fe /* indigo-200 */, accent-subtle: #1e1b4b /* indigo-950 */,
        selection: #3730a3 /* indigo-800 */, on-selection: #f8fafc /* slate-50 */,
        danger: #f87171 /* red-400 */, danger-hover: #fca5a5 /* red-300 */, danger-pressed: #fecaca /* red-200 */, danger-subtle: #450a0a /* red-950 */,
        success: #4ade80 /* green-400 */, success-subtle: #052e16 /* green-950 */,
        warning: #fbbf24 /* amber-400 */, warning-subtle: #451a03 /* amber-950 */,
        information: #38bdf8 /* sky-400 */, information-subtle: #082f49 /* sky-950 */,
        border-subtle: #1e293b /* slate-800 */, border-strong: #64748b /* slate-500: visible control boundaries */,
        hover: #1e293b /* slate-800 */, pressed: #334155 /* slate-700 */,
        disabled-fill: #1e293b /* slate-800 */, disabled-text: #64748b /* slate-500 */, scrim: #000000b3 /* black/70 */,
        shape: { radius-control: 6px, radius-container: 8px, radius-overlay: 12px, radius-pill: 9999px, border-width: 1px, border-width-strong: 2px, icon-stroke: 2 },
        elevation: {
            control: ElevationLevel.xs, container: ElevationLevel.sm, overlay: ElevationLevel.lg, popover: ElevationLevel.md,
            // The light geometry at rgb(0 0 0 / 0.3): a 10% shadow vanishes on slate-950.
            xs: { key: { offset-y: 1px, blur: 2px, spread: 0px, color: #00000026 }, ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } },
            sm: { key: { offset-y: 1px, blur: 3px, spread: 0px, color: #0000004d }, ambient: { offset-y: 1px, blur: 2px, spread: -1px, color: #0000004d } },
            md: { key: { offset-y: 4px, blur: 6px, spread: -1px, color: #0000004d }, ambient: { offset-y: 2px, blur: 4px, spread: -2px, color: #0000004d } },
            lg: { key: { offset-y: 10px, blur: 15px, spread: -3px, color: #0000004d }, ambient: { offset-y: 4px, blur: 6px, spread: -4px, color: #0000004d } },
            xl: { key: { offset-y: 20px, blur: 25px, spread: -5px, color: #0000004d }, ambient: { offset-y: 8px, blur: 10px, spread: -6px, color: #0000004d } },
        },
        focus: { style: FocusRingStyle.outside, width: 2px, offset: 2px, color: #818cf8 /* indigo-400 */, invalid-color: #f87171 /* red-400 */ },
        typography: {
            family: "", family-monospace: "monospace", weight-regular: 400, weight-medium: 500, weight-semibold: 600, weight-bold: 700,
            size-caption: 12px, size-control: 14px, size-body: 14px, size-subtitle: 18px, size-title: 30px,
            line-height-control: 20px,
        },
        spacing: {
            unit: 4px,
            compact: { height: 32px, padding-inline: 12px, padding-block: 6px },
            medium: { height: 36px, padding-inline: 14px, padding-block: 6px },
            comfortable: { height: 40px, padding-inline: 24px, padding-block: 8px },
        },
        motion: { fast: 150ms, base: 200ms, slow: 300ms },
        icons: { close: LucideIcons.x(), check: LucideIcons.check(), minus: LucideIcons.minus(), plus: LucideIcons.plus(), chevron-down: LucideIcons.chevron-down(), chevron-up: LucideIcons.chevron-up(), chevron-left: LucideIcons.chevron-left(), chevron-right: LucideIcons.chevron-right(), eye: LucideIcons.eye(), eye-hidden: LucideIcons.eye-off(), search: LucideIcons.search(), information: LucideIcons.info(), warning: LucideIcons.triangle-alert(), bell: LucideIcons.bell(), article: LucideIcons.file-text() },
        reduced-motion: false, text-scale: 1,
    };
    // How far an outline extends beyond its host; inside rings extend nowhere.
    public pure function focus-outset(ring: KitFocusRing) -> length {
        return ring.style == FocusRingStyle.outside ? ring.offset + ring.width : 0px;
    }
    // The theme's ring drawn over the host edge, for rows and cells whose
    // neighbours would cover an outside ring.
    public pure function inset-focus(theme: KitTheme) -> KitFocusRing {
        return { style: FocusRingStyle.inside, width: theme.focus.width, offset: 0px, color: theme.focus.color, invalid-color: theme.focus.invalid-color };
    }
    public pure function elevation-shadow(theme: KitTheme, level: ElevationLevel) -> KitShadow {
        return level == ElevationLevel.xs ? theme.elevation.xs
            : level == ElevationLevel.sm ? theme.elevation.sm
            : level == ElevationLevel.md ? theme.elevation.md
            : level == ElevationLevel.lg ? theme.elevation.lg
            : level == ElevationLevel.xl ? theme.elevation.xl
            : { key: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent }, ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } };
    }
    public pure function shadow(theme: KitTheme, level: ElevationLevel) -> ShadowLayer {
        return KitThemes.elevation-shadow(theme, level).key;
    }
    public pure function ambient-shadow(theme: KitTheme, level: ElevationLevel) -> ShadowLayer {
        return KitThemes.elevation-shadow(theme, level).ambient;
    }
    public pure function icon-button-recipe(theme: KitTheme, size: ControlSize) -> ButtonRecipe {
        return {
            fill: transparent, hover-fill: theme.hover, pressed-fill: theme.pressed,
            disabled-fill: transparent, foreground: theme.text-primary,
            disabled-foreground: theme.disabled-text, border: transparent,
            radius: theme.shape.radius-control, padding-inline: 0px, padding-block: 0px, border-width: 0px,
            height: KitMetrics.control-height(theme, size),
            font-size: KitMetrics.font-size(theme, TypographyRole.control), font-weight: theme.typography.weight-medium,
            busy-mark-size: 14px, busy-mark-stroke: theme.shape.border-width-strong,
            // A borderless control stays flat, like a quiet button.
            elevation: ElevationLevel.none, shadow: KitThemes.shadow(theme, ElevationLevel.none),
            focus: theme.focus,
        };
    }
    public pure function button-recipe(theme: KitTheme, intent: ButtonIntent, size: ControlSize) -> ButtonRecipe {
        return {
            fill: intent == ButtonIntent.primary ? theme.accent : intent == ButtonIntent.destructive ? theme.danger
                : intent == ButtonIntent.secondary ? theme.surface : transparent,
            hover-fill: intent == ButtonIntent.primary ? theme.accent-hover : intent == ButtonIntent.destructive ? theme.danger-hover : theme.hover,
            pressed-fill: intent == ButtonIntent.primary ? theme.accent-pressed : intent == ButtonIntent.destructive ? theme.danger-pressed : theme.pressed,
            disabled-fill: intent == ButtonIntent.outline ? transparent : theme.disabled-fill,
            foreground: intent == ButtonIntent.primary || intent == ButtonIntent.destructive ? theme.on-accent : theme.text-primary,
            disabled-foreground: theme.disabled-text,
            border: intent == ButtonIntent.secondary ? theme.border-subtle : intent == ButtonIntent.outline ? theme.border-strong : transparent,
            radius: theme.shape.radius-control,
            padding-inline: KitMetrics.density(theme, size).padding-inline,
            padding-block: KitMetrics.density(theme, size).padding-block,
            border-width: intent == ButtonIntent.secondary || intent == ButtonIntent.outline ? theme.shape.border-width : 0px,
            height: KitMetrics.density(theme, size).height,
            font-size: KitMetrics.font-size(theme, size == ControlSize.comfortable ? TypographyRole.body : TypographyRole.control),
            font-weight: theme.typography.weight-medium,
            busy-mark-size: 14px, busy-mark-stroke: theme.shape.border-width-strong,
            // Filled intents lift by the theme's control elevation. Outline and
            // quiet controls show their parent through a transparent fill, which
            // a shadow would tint, so they stay flat.
            elevation: intent == ButtonIntent.outline || intent == ButtonIntent.quiet ? ElevationLevel.none : theme.elevation.control,
            shadow: KitThemes.shadow(theme, intent == ButtonIntent.outline || intent == ButtonIntent.quiet ? ElevationLevel.none : theme.elevation.control),
            focus: theme.focus,
        };
    }
    public pure function field-recipe(theme: KitTheme, size: ControlSize, access: FieldAccess, validation: ValidationPresentation) -> FieldRecipe {
        return {
            // Read-only content stays legible and selectable on the canvas tone,
            // so it reads as not editable without looking disabled.
            fill: access == FieldAccess.disabled ? theme.disabled-fill : access == FieldAccess.read-only ? theme.canvas : theme.surface,
            border: validation == ValidationPresentation.invalid ? theme.danger : theme.border-subtle,
            hover-border: validation == ValidationPresentation.invalid ? theme.danger
                : access == FieldAccess.editable ? theme.border-strong : theme.border-subtle,
            foreground: access == FieldAccess.disabled ? theme.disabled-text : theme.text-primary,
            placeholder: theme.placeholder, selection: theme.selection, on-selection: theme.on-selection,
            radius: theme.shape.radius-control, border-width: theme.shape.border-width,
            padding-inline: KitMetrics.density(theme, size).padding-inline,
            padding-block: KitMetrics.density(theme, size).padding-block,
            height: KitMetrics.control-height(theme, size),
            font-size: KitMetrics.font-size(theme, TypographyRole.control),
            // An invalid field keeps its ring geometry and announces the error color.
            focus: {
                style: theme.focus.style, width: theme.focus.width, offset: theme.focus.offset,
                color: validation == ValidationPresentation.invalid ? theme.focus.invalid-color : theme.focus.color,
                invalid-color: theme.focus.invalid-color,
            },
        };
    }
    // A popover trigger (select, combobox): its field surface, activated like
    // a button. Only an editable trigger answers hover and press.
    public pure function trigger-recipe(theme: KitTheme, field: FieldRecipe, access: FieldAccess) -> ButtonRecipe {
        return {
            fill: field.fill,
            hover-fill: access == FieldAccess.editable ? theme.hover : field.fill,
            pressed-fill: access == FieldAccess.editable ? theme.pressed : field.fill,
            disabled-fill: theme.disabled-fill,
            foreground: field.foreground, disabled-foreground: theme.disabled-text,
            border: field.border,
            radius: field.radius, padding-inline: field.padding-inline, padding-block: field.padding-block,
            border-width: field.border-width, height: field.height, font-size: field.font-size,
            font-weight: theme.typography.weight-regular,
            busy-mark-size: 14px, busy-mark-stroke: theme.shape.border-width-strong,
            elevation: ElevationLevel.none, shadow: KitThemes.shadow(theme, ElevationLevel.none),
            focus: field.focus,
        };
    }
    // A data-table row: a flat, square pressable that fills its cell grid and
    // paints the theme's ring over its own edge while its table owns focus.
    public pure function table-row-recipe(theme: KitTheme, size: ControlSize) -> ButtonRecipe {
        return {
            fill: transparent, hover-fill: theme.hover, pressed-fill: theme.pressed, disabled-fill: theme.disabled-fill,
            foreground: theme.text-primary, disabled-foreground: theme.disabled-text, border: transparent,
            radius: 0px, padding-inline: 0px, padding-block: KitMetrics.density(theme, size).padding-block, border-width: 0px,
            height: KitMetrics.control-height(theme, size) + theme.spacing.unit * 2,
            font-size: KitMetrics.font-size(theme, TypographyRole.control), font-weight: theme.typography.weight-regular,
            busy-mark-size: 14px, busy-mark-stroke: theme.shape.border-width-strong,
            elevation: ElevationLevel.none, shadow: KitThemes.shadow(theme, ElevationLevel.none),
            focus: KitThemes.inset-focus(theme),
        };
    }
    public pure function surface-recipe(theme: KitTheme, level: SurfaceLevel) -> SurfaceRecipe {
        return {
            fill: level == SurfaceLevel.flat ? theme.surface : theme.surface-raised,
            border: theme.border-subtle,
            radius: level == SurfaceLevel.overlay || level == SurfaceLevel.popover ? theme.shape.radius-overlay : theme.shape.radius-container,
            border-width: theme.shape.border-width,
            elevation: level == SurfaceLevel.overlay ? theme.elevation.overlay : level == SurfaceLevel.popover ? theme.elevation.popover : theme.elevation.container,
            shadow: KitThemes.shadow(theme, level == SurfaceLevel.overlay ? theme.elevation.overlay : level == SurfaceLevel.popover ? theme.elevation.popover : theme.elevation.container),
            ambient-shadow: KitThemes.ambient-shadow(theme, level == SurfaceLevel.overlay ? theme.elevation.overlay : level == SurfaceLevel.popover ? theme.elevation.popover : theme.elevation.container),
        };
    }
    // The box of a checkbox or radio by ControlSize: Tailwind size-4/5/6.
    public pure function choice-box-size(size: ControlSize) -> length {
        return size == ControlSize.compact ? 16px : size == ControlSize.comfortable ? 24px : 20px;
    }
    // Checkbox, radio, switch and slider geometry, sized by ControlSize. Marks,
    // track and thumb derive from the box, so they keep their proportions; a
    // box corner never exceeds a quarter of the box. Segmented and toggle
    // groups nest their options' control radius inside their own padding.
    public pure function choice-recipe(theme: KitTheme, size: ControlSize) -> ChoiceRecipe {
        return {
            box-size: KitThemes.choice-box-size(size),
            box-radius: min(theme.shape.radius-control, KitThemes.choice-box-size(size) / 4),
            mark-stroke: theme.shape.border-width-strong,
            radio-dot-size: KitThemes.choice-box-size(size) / 2, label-gap: theme.spacing.unit * 2.5,
            track-width: KitThemes.choice-box-size(size) * 1.9, track-height: KitThemes.choice-box-size(size) + 2px,
            track-radius: min(theme.shape.radius-pill, (KitThemes.choice-box-size(size) + 2px) / 2),
            thumb-size: KitThemes.choice-box-size(size) - 2px, thumb-inset: 2px,
            check-size: KitThemes.choice-box-size(size) * 0.7, mixed-width: KitThemes.choice-box-size(size) * 0.6,
            slider-track-height: theme.spacing.unit, slider-thumb-size: KitThemes.choice-box-size(size) - 4px,
            group-radius: theme.shape.radius-control + theme.spacing.unit * 0.75,
            group-padding: theme.spacing.unit * 0.75, group-gap: theme.spacing.unit * 1.5,
            transition: theme.reduced-motion ? 0ms : theme.motion.fast,
            focus: KitThemes.inset-focus(theme),
        };
    }
    // Rows of a list or menu: one keyboard target owns focus and the active
    // row carries the inset ring over its accent-subtle tint.
    public pure function option-recipe(theme: KitTheme, size: ControlSize) -> OptionRecipe {
        return {
            fill: transparent, hover-fill: theme.hover, pressed-fill: theme.pressed,
            active-fill: theme.accent-subtle, selected-fill: theme.accent-subtle,
            foreground: theme.text-primary, selected-foreground: theme.accent, disabled-foreground: theme.disabled-text,
            radius: theme.shape.radius-control,
            padding-inline: KitMetrics.density(theme, size).padding-inline,
            height: KitMetrics.density(theme, size).height,
            font-size: KitMetrics.font-size(theme, TypographyRole.control),
            focus: KitThemes.inset-focus(theme),
        };
    }
    public pure function alert-recipe(theme: KitTheme, severity: AlertSeverity) -> AlertRecipe {
        return {
            fill: severity == AlertSeverity.error ? theme.danger-subtle : severity == AlertSeverity.warning ? theme.warning-subtle
                : severity == AlertSeverity.success ? theme.success-subtle : theme.information-subtle,
            border: severity == AlertSeverity.error ? theme.danger : severity == AlertSeverity.warning ? theme.warning
                : severity == AlertSeverity.success ? theme.success : theme.information,
            mark: severity == AlertSeverity.error ? theme.danger : severity == AlertSeverity.warning ? theme.warning
                : severity == AlertSeverity.success ? theme.success : theme.information,
            radius: theme.shape.radius-container, border-width: theme.shape.border-width,
            inset: theme.spacing.unit * 4, gap: theme.spacing.unit * 3,
        };
    }
    // Tailwind's px-3 py-1.5 text-xs bubble, capped at max-w-xs (80 units),
    // which grows with text-scale so a scaled line still fits.
    public pure function tooltip-recipe(theme: KitTheme) -> TooltipRecipe {
        return {
            fill: theme.text-primary, foreground: theme.surface, radius: theme.shape.radius-control,
            padding-inline: theme.spacing.unit * 3, padding-block: theme.spacing.unit * 1.5,
            max-width: theme.spacing.unit * 80 * theme.text-scale,
            font-size: KitMetrics.font-size(theme, TypographyRole.caption), gap: theme.spacing.unit * 2,
        };
    }
    public pure function scroll-bar-recipe(theme: KitTheme) -> ScrollBarRecipe {
        return {
            thickness: 14px, thumb-thickness: 6px, active-thumb-thickness: 8px, inset: 3px, min-thumb-length: 24px,
            thumb: theme.border-strong, active-thumb: theme.text-secondary, track: transparent, active-track: theme.hover,
            transition: theme.reduced-motion ? 0ms : theme.motion.fast,
        };
    }
    public pure function icon-recipe(theme: KitTheme, size: ControlSize) -> IconRecipe {
        return {
            size: KitMetrics.icon-size(theme, size), color: theme.text-secondary, disabled-color: theme.disabled-text,
            stroke: theme.shape.icon-stroke,
        };
    }
    // scaled: the token in grid units at the drawn extent, as an SVG stroke
    // scales with its view box, so 2 on 24 is 1.33px at 16px and 2.67px at
    // 32px; a glyph without a grid draws nothing. absolute: the token in
    // logical pixels, whatever the extent.
    public pure function icon-stroke-width(recipe: IconRecipe, glyph: IconGlyph, mode: IconStroke, extent: length) -> length {
        return mode == IconStroke.absolute ? recipe.stroke * 1px
            : glyph.viewbox > 0 ? extent * recipe.stroke / glyph.viewbox : 0px;
    }
}

// The default theme of every component. Assign `current` once, from Slint or
// from Rust after re-exporting this global from the application's main file;
// each control may override `theme`. Caller-provided @children require explicit
// bindings; this global does not implement an ancestor cascade.
export global KitThemeContext {
    in-out property <KitTheme> current: KitThemes.light;
}
