import { HtmlInputKind, FieldAccess, NumberInputFormat } from "shared-contracts.slint";
export { HtmlInputKind } from "shared-contracts.slint";
import { ChoiceRow } from "contracts.slint";
export enum ValidationTiming { on-blur, on-input, on-submit }
export struct KitValidityState {
    valid: bool, value-missing: bool, type-mismatch: bool, pattern-mismatch: bool,
    too-long: bool, too-short: bool, range-underflow: bool, range-overflow: bool,
    step-mismatch: bool, bad-input: bool, custom-error: bool,
}
export struct KitInputConstraints {
    kind: HtmlInputKind, number-format: NumberInputFormat, twelve-hour: bool, required: bool, multiple: bool, min-length: int, max-length: int,
    pattern: string, pattern-enabled: bool, min: string, max: string, step: string,
    default-value: string, custom-error: string, disabled: bool, read-only: bool,
}
export struct KitValidationResult {
    validity: KitValidityState, value: string, will-validate: bool, pattern-error: string, hard-error: bool,
}
// Register once per window with init_form_validation! before showing the UI.
// Pure callbacks run the same native/WASM Rust engine; no browser DOM dependency.
export global KitFormValidation {
    in-out property <bool> ready;
    in-out property <bool> phone-focused;
    in-out property <int> focus-generation;
    public pure function combine(a: KitValidityState, b: KitValidityState) -> KitValidityState { return {valid: a.valid && b.valid, value-missing: a.value-missing || b.value-missing, type-mismatch: a.type-mismatch || b.type-mismatch, pattern-mismatch: a.pattern-mismatch || b.pattern-mismatch, too-long: a.too-long || b.too-long, too-short: a.too-short || b.too-short, range-underflow: a.range-underflow || b.range-underflow, range-overflow: a.range-overflow || b.range-overflow, step-mismatch: a.step-mismatch || b.step-mismatch, bad-input: a.bad-input || b.bad-input, custom-error: a.custom-error || b.custom-error}; }

    pure callback valid-time-zone(string) -> bool;
    pure callback count-selected([ChoiceRow]) -> int;
    pure callback numeric-insertion(string) -> bool;
    pure callback phone-insertion(string) -> bool;
    pure callback phone-paste(string) -> bool;
    pure callback phone-value(string) -> string;
    pure callback phone-display(string, string) -> string;
    pure callback phone-mask-error(string) -> string;
    pure callback phone-error(string, bool, bool, int, int, string, string) -> string;
    pure callback evaluate(KitInputConstraints, string, bool, bool, int) -> KitValidationResult;
}
// A nonvisual state component, reusable with custom skins and composed fields.
export component FormConstraintState inherits Rectangle {
    width: 0px; height: 0px;
    in property <bool> twelve-hour;
    in property <NumberInputFormat> number-format: NumberInputFormat.canonical;
    in property <HtmlInputKind> kind: HtmlInputKind.text;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <bool> required;
    in property <bool> multiple;
    in property <int> min-length: -1;
    in property <int> max-length: -1;
    in property <string> pattern;
    in property <bool> pattern-enabled: root.pattern != "";
    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    in property <string> text;
    in property <bool> checked;
    in property <int> selected-count;
    in property <ValidationTiming> validation-timing: ValidationTiming.on-blur;
    in-out property <string> custom-validity;
    in property <string> required-message: "Please fill out this field.";
    in property <string> email-message: "Please enter a valid email address.";
    in property <string> url-message: "Please enter a valid absolute URL.";
    in property <string> pattern-message: "Please match the requested format.";
    in property <string> too-short-message: "Please enter at least " + root.min-length + " characters.";
    in property <string> too-long-message: "Please enter no more than " + root.max-length + " characters.";
    in property <string> underflow-message: "The minimum value is " + root.min + ".";
    in property <string> overflow-message: "The maximum value is " + root.max + ".";
    in property <string> step-message: "Please enter a value matching the requested step.";
    in property <string> bad-input-message: "Please enter a valid value.";
    out property <bool> validation-ready: KitFormValidation.ready;
    private property <KitValidationResult> result: KitFormValidation.ready ? KitFormValidation.evaluate({
        kind: root.kind, number-format: root.number-format, twelve-hour: root.twelve-hour, required: root.required, multiple: root.multiple,
        min-length: root.min-length, max-length: root.max-length,
        pattern: root.pattern, pattern-enabled: root.pattern-enabled,
        min: root.min, max: root.max, step: root.step, default-value: root.default-value,
        custom-error: root.custom-validity, disabled: root.access == FieldAccess.disabled,
        read-only: root.access == FieldAccess.read-only,
    }, root.text, root.dirty, root.checked, root.selected-count) : {
        validity: {valid: false, bad-input: true}, value: root.text, will-validate: false,
    };
    out property <KitValidityState> validity: root.result.validity;
    out property <bool> will-validate: root.result.will-validate;
    out property <string> value: root.result.value;
    out property <string> pattern-error: root.result.pattern-error;
    out property <string> validation-message: !root.will-validate || root.validity.valid ? ""
        : root.validity.custom-error ? root.custom-validity
        : root.validity.value-missing ? root.required-message
        : root.validity.type-mismatch ? (root.kind == HtmlInputKind.email ? root.email-message : root.url-message)
        : root.validity.pattern-mismatch ? root.pattern-message
        : root.validity.too-short ? root.too-short-message
        : root.validity.too-long ? root.too-long-message
        : root.validity.range-underflow ? root.underflow-message
        : root.validity.range-overflow ? root.overflow-message
        : root.validity.step-mismatch ? root.step-message : root.bad-input-message;
    out property <bool> dirty;
    out property <bool> touched;
    private property <bool> reported;
    out property <bool> show-error: root.will-validate && !root.validity.valid && (root.reported || (root.dirty && root.result.hard-error)
        || (root.validation-timing == ValidationTiming.on-input && root.dirty)
        || (root.validation-timing == ValidationTiming.on-blur && root.touched));
    callback invalid();
    public function note-edit() { root.dirty = true; }
    public function note-blur() { root.touched = true; }
    public function reset-validation() { root.dirty = false; root.touched = false; root.reported = false; }
    public function check-validity() -> bool {
        if (!root.validation-ready) { root.invalid(); return false; }
        if (!root.will-validate || root.validity.valid) { return true; }
        root.invalid(); return false;
    }
    public function report-validity() -> bool { root.reported = true; return root.check-validity(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
}
