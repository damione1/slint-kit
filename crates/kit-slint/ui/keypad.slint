import { KitTheme, KitThemeContext, KitMetrics, ButtonIntent, ControlSize, ControlWidth, TypographyRole } from "theme.slint";
import { KitPressable } from "button.slint";
import { KitIcon, IconGlyph } from "icons.slint";
import { FieldAccess, ValidationPresentation } from "contracts.slint";
import { FocusOutline } from "focus.slint";
import { KitModalContext } from "modal.slint";
import { KitKeyResult } from "keyboard.slint";

// One keypad key: its glyph, or its text when the glyph is empty. The text
// is always the key's accessible name. A key is at least a square touch
// target of twelve spacing units and grows with enlarged text.
component KeypadKey inherits KitPressable {
    in property <string> text;
    in property <IconGlyph> glyph;
    private property <bool> has-glyph: root.glyph.stroke != "" || root.glyph.fill != "";
    control-width: ControlWidth.fill;
    min-height: max(root.theme.spacing.unit * 12, KitMetrics.control-height(root.theme, root.control-size), root.text-size * 1.4 + 2 * root.padding-block);
    min-width: max(root.theme.spacing.unit * 12, root.has-glyph ? KitMetrics.icon-size(root.theme, root.control-size) : root.text-size);
    preferred-width: root.min-height;
    accessible-name: root.text;
    Rectangle {
        if root.has-glyph: KitIcon {
            theme: root.theme; control-size: root.control-size;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            glyph: root.glyph;
            ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        }
        if !root.has-glyph: Text {
            text: root.text;
            color: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
            font-family: root.theme.typography.family; font-size: root.text-size; font-weight: root.text-weight;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A numeric keypad for a code, a PIN or a quantity: digits 1 to 9, then
// delete, 0 and confirm (or one extra key instead of confirm). The keypad emits intentions only and never holds the
// entered digits; the host keeps the code and shows its progress, for example
// with KitCodeIndicator. `delete-requested()` asks to remove the last digit,
// never the whole code.
//
// While `access` is editable, typed 0 to 9 and Backspace reach the same
// callbacks whenever the keypad or any key has focus. Return confirms on the
// keypad itself. Return and Space first activate a key that shows keyboard
// focus, as on any button. A pointer press hands focus back to the keypad
// without a focus ring, so Return after tapped digits confirms instead of
// repeating the last digit. A read-only or disabled keypad emits nothing.
//
// The twelve keys are one tab stop with roving focus: Tab reaches the key that
// last had focus, and the arrow keys move between keys without wrapping,
// skipping unavailable keys. Home and End go to the ends of the row. The
// layout is not mirrored in right-to-left text, as on any numeric pad.
export component KitKeypad inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert, like every kit control.
    in property <int> modal-layer;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.comfortable;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <string> label;
    // Ten visible digit labels in keypad order: 1 to 9, then 0.
    in property <[string]> digit-labels: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    in property <string> delete-label: "Delete";
    in property <IconGlyph> delete-glyph: root.theme.icons.delete;
    in property <string> confirm-label: "Confirm";
    in property <IconGlyph> confirm-glyph: root.theme.icons.check;
    in property <ButtonIntent> confirm-intent: ButtonIntent.primary;
    // The host enables confirm once its code is complete.
    in property <bool> can-confirm;
    // Hosts that fill the code disable the digits (`digits-enabled: false`)
    // and the delete key (`can-delete: false`) while a key cannot apply.
    in property <bool> digits-enabled: true;
    in property <bool> can-delete: true;
    // `show-confirm: false` hides confirm and frees the bottom-right slot for
    // one extra key, such as a decimal separator or a cancel key, labelled by
    // `extra-label` and `extra-glyph`. An empty `extra-label` leaves the slot
    // empty. The key emits `extra()`; the host decides what it enters.
    in property <bool> show-confirm: true;
    in property <string> extra-label;
    in property <IconGlyph> extra-glyph;
    in property <bool> extra-enabled: true;
    // Opt in to Escape: when true, Escape on an editable keypad emits
    // `cancel()` and is consumed; otherwise Escape reaches the surroundings.
    in property <bool> handle-escape: false;
    // Press feedback begins before a pointer or Space activation commits.
    callback activation-started();
    callback digit(int);
    callback delete-requested();
    callback confirm();
    callback extra();
    callback cancel();
    // Focuses the keypad itself, so typed digits reach it without moving
    // focus onto a key.
    public function take-focus() { keys.focus(); }
    // A key that a pointer pressed holds focus without a ring; focus returns
    // to the keypad so typed Return confirms. A key that shows keyboard focus
    // keeps it.
    function settle-pointer-focus(key-has-focus: bool, key-shows-focus: bool) {
        if (key-has-focus && !key-shows-focus) {
            keys.pointer-return = true;
            keys.focus();
        }
    }
    // Roving focus. The twelve keys are one tab stop: only `roving-key`, the
    // key that last held focus (or the first available key), is reachable with
    // Tab. Arrow keys move between keys, Home and End to the ends of the row.
    // The layout is never mirrored, as on any numeric pad, so Left and Right
    // always move to the key drawn on that side, in right-to-left text too.
    // Index = row * 3 + column; 9 is delete, 10 is zero, 11 is confirm or extra.
    private property <int> active-key;
    private property <int> roving-key: root.key-available(root.active-key) ? root.active-key
        : root.first-available(0, 1, 2) >= 0 ? root.first-available(0, 1, 2)
        : root.first-available(3, 4, 5) >= 0 ? root.first-available(3, 4, 5)
        : root.first-available(6, 7, 8) >= 0 ? root.first-available(6, 7, 8)
        : root.first-available(9, 10, 11);
    pure function key-available(index: int) -> bool {
        if (index < 9) { return index >= 0 && root.digits-active; }
        if (index == 9) { return root.delete-active; }
        if (index == 10) { return root.digits-active; }
        if (index == 11) { return root.editable && (root.show-confirm ? root.can-confirm : root.extra-label != "" && root.extra-enabled); }
        return false;
    }
    // The first available key among up to three candidates, or -1.
    pure function first-available(a: int, b: int, c: int) -> int {
        return root.key-available(a) ? a : root.key-available(b) ? b : root.key-available(c) ? c : -1;
    }
    function focus-key(index: int) {
        if (index == 0) { k0.take-focus(); } else if (index == 1) { k1.take-focus(); } else if (index == 2) { k2.take-focus(); }
        else if (index == 3) { k3.take-focus(); } else if (index == 4) { k4.take-focus(); } else if (index == 5) { k5.take-focus(); }
        else if (index == 6) { k6.take-focus(); } else if (index == 7) { k7.take-focus(); } else if (index == 8) { k8.take-focus(); }
        else if (index == 9) { k9.take-focus(); } else if (index == 10) { k10.take-focus(); } else if (index == 11) { k11.take-focus(); }
    }
    // The key an arrow, Home or End press moves to from `from`, or -1.
    pure function target(from: int, text: string) -> int {
        let column = Math.mod(from, 3);
        let row = Math.floor(from / 3);
        if (text == Key.LeftArrow) { return column == 0 ? -1 : root.first-available(from - 1, column == 2 ? from - 2 : -1, -1); }
        if (text == Key.RightArrow) { return column == 2 ? -1 : root.first-available(from + 1, column == 0 ? from + 2 : -1, -1); }
        if (text == Key.UpArrow) { return row == 0 ? -1 : root.first-available(from - 3, row >= 2 ? from - 6 : -1, row == 3 ? from - 9 : -1); }
        if (text == Key.DownArrow) { return row == 3 ? -1 : root.first-available(from + 3, row <= 1 ? from + 6 : -1, row == 0 ? from + 9 : -1); }
        if (text == Key.Home) { return root.first-available(row * 3, row * 3 + 1, row * 3 + 2); }
        if (text == Key.End) { return root.first-available(row * 3 + 2, row * 3 + 1, row * 3); }
        return -1;
    }
    function navigate(from: int, event: KeyEvent) -> KitKeyResult {
        if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta || event.modifiers.shift) { return KitKeyResult.reject; }
        if (event.text != Key.LeftArrow && event.text != Key.RightArrow && event.text != Key.UpArrow && event.text != Key.DownArrow && event.text != Key.Home && event.text != Key.End) { return KitKeyResult.reject; }
        let target = root.target(from, event.text);
        if (target >= 0 && target != from) { root.focus-key(target); }
        return KitKeyResult.accept;
    }
    private property <bool> editable: root.access == FieldAccess.editable;
    private property <bool> digits-active: root.editable && root.digits-enabled;
    private property <bool> delete-active: root.editable && root.can-delete;
    private property <length> gap: KitMetrics.inline-gap(root.theme);
    private property <length> digit-size: KitMetrics.font-size(root.theme, TypographyRole.title);
    min-width: grid.min-width; min-height: grid.min-height;
    preferred-width: grid.preferred-width; preferred-height: grid.preferred-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    accessible-role: groupbox; accessible-label: root.label;
    accessible-enabled: root.access != FieldAccess.disabled && !KitModalContext.inert(root.modal-layer);
    forward-focus: keys;
    keys := FocusScope {
        private property <bool> keyboard-focus;
        private property <bool> confirm-held;
        private property <bool> pointer-return;
        width: root.width; height: root.height;
        enabled: root.access != FieldAccess.disabled && !KitModalContext.inert(root.modal-layer);
        focus-on-tab-navigation: false;
        focus-on-click: false;
        focus-gained(reason) => {
            self.keyboard-focus = !self.pointer-return && (reason == FocusReason.tab-navigation || reason == FocusReason.programmatic);
            self.pointer-return = false;
        }
        focus-lost(reason) => { self.confirm-held = false; }
        // Keys pressed on a focused key that it does not handle arrive here.
        key-pressed(event) => {
            if (!root.editable) { return reject; }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) { return reject; }
            if (event.text == Key.Backspace || event.text == Key.Delete) {
                if (!root.delete-active) { return reject; }
                root.activation-started(); if (root.delete-active) { root.delete-requested(); } return accept;
            }
            if (event.text == Key.Escape) {
                if (!root.handle-escape) { return reject; }
                root.activation-started(); if (root.editable && root.handle-escape) { root.cancel(); } return accept;
            }
            if (event.text == Key.Return) {
                if (!root.show-confirm || !root.can-confirm) { return reject; }
                if (!self.confirm-held) { self.confirm-held = true; root.activation-started(); if (root.editable && root.show-confirm && root.can-confirm) { root.confirm(); } }
                return accept;
            }
            // One character that parses as a number is a digit from 0 to 9.
            if (event.text.character-count == 1 && event.text.is-float()) { if (!root.digits-active) { return reject; } root.activation-started(); if (root.digits-active) { root.digit(event.text.to-float()); } return accept; }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return) { self.confirm-held = false; }
            return reject;
        }
        grid := GridLayout {
            width: parent.width; height: parent.height;
            spacing: root.gap;
            Row {
                k0 := KeypadKey { tab-stop: root.roving-key == 0; focus-observed(focused) => { if (focused) { root.active-key = 0; } } key-event(event) => { return root.navigate(0, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[0]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(1); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k1 := KeypadKey { tab-stop: root.roving-key == 1; focus-observed(focused) => { if (focused) { root.active-key = 1; } } key-event(event) => { return root.navigate(1, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[1]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(2); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k2 := KeypadKey { tab-stop: root.roving-key == 2; focus-observed(focused) => { if (focused) { root.active-key = 2; } } key-event(event) => { return root.navigate(2, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[2]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(3); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
            }
            Row {
                k3 := KeypadKey { tab-stop: root.roving-key == 3; focus-observed(focused) => { if (focused) { root.active-key = 3; } } key-event(event) => { return root.navigate(3, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[3]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(4); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k4 := KeypadKey { tab-stop: root.roving-key == 4; focus-observed(focused) => { if (focused) { root.active-key = 4; } } key-event(event) => { return root.navigate(4, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[4]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(5); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k5 := KeypadKey { tab-stop: root.roving-key == 5; focus-observed(focused) => { if (focused) { root.active-key = 5; } } key-event(event) => { return root.navigate(5, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[5]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(6); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
            }
            Row {
                k6 := KeypadKey { tab-stop: root.roving-key == 6; focus-observed(focused) => { if (focused) { root.active-key = 6; } } key-event(event) => { return root.navigate(6, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[6]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(7); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k7 := KeypadKey { tab-stop: root.roving-key == 7; focus-observed(focused) => { if (focused) { root.active-key = 7; } } key-event(event) => { return root.navigate(7, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[7]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(8); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k8 := KeypadKey { tab-stop: root.roving-key == 8; focus-observed(focused) => { if (focused) { root.active-key = 8; } } key-event(event) => { return root.navigate(8, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[8]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(9); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
            }
            Row {
                k9 := KeypadKey { tab-stop: root.roving-key == 9; focus-observed(focused) => { if (focused) { root.active-key = 9; } } key-event(event) => { return root.navigate(9, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.quiet; text: root.delete-label; glyph: root.delete-glyph; disabled: !root.delete-active; activation-started => { root.activation-started(); } activated => { root.delete-requested(); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                k10 := KeypadKey { tab-stop: root.roving-key == 10; focus-observed(focused) => { if (focused) { root.active-key = 10; } } key-event(event) => { return root.navigate(10, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; text-size: root.digit-size; text-weight: root.theme.typography.weight-medium; text: root.digit-labels[9]; disabled: !root.digits-active; activation-started => { root.activation-started(); } activated => { root.digit(0); root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
                // The bottom-right key is confirm, or the extra key once confirm is hidden.
                k11 := KeypadKey { tab-stop: root.roving-key == 11; focus-observed(focused) => { if (focused) { root.active-key = 11; } } key-event(event) => { return root.navigate(11, event); } modal-layer: root.modal-layer; theme: root.theme; control-size: root.control-size; intent: root.show-confirm ? root.confirm-intent : ButtonIntent.quiet; text: root.show-confirm ? root.confirm-label : root.extra-label; glyph: root.show-confirm ? root.confirm-glyph : root.extra-glyph; visible: root.show-confirm || root.extra-label != ""; disabled: !root.editable || (root.show-confirm ? !root.can-confirm : !root.extra-enabled); activation-started => { root.activation-started(); } activated => { if (root.show-confirm) { root.confirm(); } else { root.extra(); } root.settle-pointer-focus(self.has-focus, self.focus-visible); } }
            }
        }
    }
    if keys.has-focus && keys.keyboard-focus: FocusOutline {
        ring: root.theme.focus;
        radius: root.theme.shape.radius-container;
        host-width: root.width; host-height: root.height;
    }
}

// The progress of a code entry: one mark per expected digit, the first
// `filled` of them filled. It shows how many digits the host holds, never
// which. The host supplies the accessible `label`, such as "2 of 4 digits".
export component KitCodeIndicator inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <int> length;
    in property <int> filled;
    in property <string> label;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    private property <length> mark: root.theme.spacing.unit * (root.control-size == ControlSize.compact ? 2 : root.control-size == ControlSize.comfortable ? 4 : 3) * root.theme.text-scale;
    private property <color> ink: root.validation == ValidationPresentation.invalid ? root.theme.danger : root.validation == ValidationPresentation.valid ? root.theme.success : root.theme.text-primary;
    private property <color> outline: root.validation == ValidationPresentation.invalid ? root.theme.danger : root.validation == ValidationPresentation.valid ? root.theme.success : root.theme.border-strong;
    accessible-role: text; accessible-label: root.label;
    accessible-live-region: polite;
    HorizontalLayout {
        alignment: center;
        spacing: root.theme.spacing.unit * 3;
        padding-top: root.theme.spacing.unit; padding-bottom: root.theme.spacing.unit;
        for index in max(0, root.length): Rectangle {
            private property <bool> set: index < root.filled;
            width: root.mark; height: root.mark;
            border-radius: min(root.theme.shape.radius-pill, self.height / 2);
            background: self.set ? root.ink : transparent;
            border-width: self.set ? 0px : root.theme.shape.border-width-strong;
            border-color: root.outline;
        }
    }
}
