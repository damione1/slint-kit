import { Ownership, CommitPolicy } from "shared-contracts.slint";
import { FieldCommit, FieldState, FieldValue } from "field-service.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitValidityState } from "validation.slint";
import { NumberInputFormat } from "shared-contracts.slint";
import { KitTextField } from "input.slint";
import { KitField, KitFieldLabel, KitFieldDescription, KitFieldError } from "field.slint";
import { KitTheme, KitThemes, ControlSize, ButtonIntent, KitMetrics, KitThemeContext } from "theme.slint";
import { KitPressable } from "button.slint";
import { KitIcon, KitGlyphs } from "icons.slint";
import { FieldAccess, ValidationPresentation, StepDirection } from "shared-contracts.slint";
export { StepDirection } from "shared-contracts.slint";

// Native numeric filtering rejects letters on typing and paste. Decimal mode
// retains signs and incomplete decimals; Rust still parses exact domain values,
// integer constraints, scale and bounds without accepting renderer floats.
export component KitIntegerField inherits KitTextField {
    step: "1"; input-type: InputType.decimal;
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
    // Slint fixes `accessible-role` at compile time and every text field keeps
    // one native editor, so the spin button role sits on the numeric component
    // root with the range and the increment/decrement actions; the editor
    // below it still exposes its text, caret and selection.
    accessible-role: spinbox;
    accessible-label: root.accessible-name;
    accessible-value: root.text;
    accessible-value-minimum: root.number-range.minimum;
    accessible-value-maximum: root.number-range.maximum;
    accessible-value-step: root.number-range.step;
    accessible-enabled: root.access != FieldAccess.disabled;
    accessible-read-only: root.access == FieldAccess.read-only;
    accessible-action-increment => { root.step-by(StepDirection.increment, 1); }
    accessible-action-decrement => { root.step-by(StepDirection.decrement, 1); }
}
export component KitDecimalField inherits KitIntegerField { step: "any"; }
export component KitMoneyField inherits KitDecimalField { }
export component KitPercentField inherits KitDecimalField { suffix: "%"; }
export component KitQuantityField inherits KitDecimalField { }
// Match the presentation suffix to FieldSpec::duration(unit, rules).
// The explicit Rust unit owns conversion; this alias edits a decimal quantity.
export component KitDurationField inherits KitDecimalField { }

export component KitNumberStepper inherits KitField {
    in property <string> spec-key;
    in property <Ownership> ownership: Ownership.local;
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    out property <FieldState> field-state: editor.field-state;
    out property <string> accepted-text: editor.accepted-text;
    public function acknowledge(value: FieldValue) { editor.acknowledge(value); }
    callback committed(FieldCommit);
    public function commit() { editor.commit(); }
    public function cancel-edit() { editor.cancel-edit(); }

    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <bool> required;
    in property <string> min;
    in property <string> max;
    in property <string> step: "1";
    in property <int> page-steps: 10;
    in property <bool> wheel-stepping;
    in property <NumberInputFormat> number-format: NumberInputFormat.canonical;
    in property <string> default-value;
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: editor.validity;
    out property <bool> will-validate: editor.will-validate;
    out property <string> validation-message: editor.validation-message;
    callback invalid();
    public function check-validity() -> bool { return editor.check-validity(); }
    public function report-validity() -> bool { return editor.report-validity(); }
    public function focus-if-invalid() -> bool { return editor.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { editor.reset-validation(); }
    in property <string> label;
    in property <string> description;
    in property <string> error;
    in property <string> placeholder;
    in property <string> prefix;
    in property <string> suffix;
    in property <bool> can-increment: true;
    in property <bool> can-decrement: true;
    in property <string> increment-label: "Increase value";
    in property <string> decrement-label: "Decrease value";
    in-out property <string> text;
    out property <bool> has-focus: editor.has-focus;
    callback edited(string);
    callback commit-requested(string);
    callback cancelled();
    callback focus-observed(bool);
    callback step-requested(StepDirection);
    public function take-focus() { editor.take-focus(); }
    if root.label != "": KitFieldLabel {
        theme: root.theme; text: root.label; access: root.access;
        focus-requested => { root.take-focus(); }
    }
    HorizontalLayout {
        spacing: KitMetrics.inline-gap(root.theme);
        editor := KitDecimalField {
            modal-layer: root.modal-layer;
            ownership: root.ownership; commit-policy: root.commit-policy; spec-key: root.spec-key; committed(value) => { root.committed(value); }
            show-validation-message: false; error: root.error;
            required: root.required; min: root.min; max: root.max; step: root.step;
            page-steps: root.page-steps; wheel-stepping: root.wheel-stepping;
            number-format: root.number-format; default-value: root.default-value;
            custom-validity <=> root.custom-validity;
            invalid => { root.invalid(); }
            theme: root.theme; control-size: root.control-size;
            access: root.access; validation: root.validation;
            accessible-name: root.label;
            placeholder: root.placeholder; prefix: root.prefix; suffix: root.suffix;
            text <=> root.text;
            edited(value) => { root.edited(value); }
            commit-requested(value) => { root.commit-requested(value); }
            cancelled => { root.cancelled(); }
            focus-observed(value) => { root.focus-observed(value); }
        }
        for direction in [StepDirection.decrement, StepDirection.increment]: step := KitPressable {
            theme: root.theme; modal-layer: root.modal-layer; intent: ButtonIntent.secondary; control-size: root.control-size;
            min-height: Math.max(KitMetrics.control-height(root.theme, root.control-size), self.recipe.height, self.text-size * 1.4 + 2 * self.padding-block);
            preferred-width: KitMetrics.control-height(root.theme, root.control-size);
            min-width: self.preferred-width;
            // Spin buttons are pointer targets: keyboard users step with the
            // arrow, page and Home/End keys of the editor, so they add no tab
            // stops. A step hands focus to the editor, so a press must not
            // focus the button first or that handover would cancel its repeat.
            tab-stop: false; focus-on-pointer: false; repeat-on-hold: true;
            disabled: root.access != FieldAccess.editable || (direction == StepDirection.increment ? !root.can-increment : !root.can-decrement) || !editor.can-step(direction);
            accessible-name: direction == StepDirection.increment ? root.increment-label : root.decrement-label;
            activated => { if (editor.step-number(direction)) { root.step-requested(direction); } }
            Rectangle {
                KitIcon {
                theme: root.theme; control-size: root.control-size;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                glyph: direction == StepDirection.increment ? root.theme.icons.plus : root.theme.icons.minus;
                ink: step.disabled ? step.recipe.disabled-foreground : step.recipe.foreground;
                }
            }
        }
    }
    if root.error == "" && editor.validation-visible && editor.validation-message != "": KitFieldError { theme: root.theme; text: editor.validation-message; }
    if root.validation == ValidationPresentation.invalid && root.error != "": KitFieldError { theme: root.theme; text: root.error; }
    if root.description != "": KitFieldDescription { theme: root.theme; text: root.description; }
}
