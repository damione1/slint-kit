import { KitIcon, IconKind } from "icons.slint";
import { KitTheme, KitThemes, KitThemeContext, KitFocusRing, ButtonRecipe, ButtonIntent, ControlSize, ControlWidth } from "theme.slint";
import { FocusOutline } from "focus.slint";
export { ButtonRecipe, ButtonIntent, ControlSize, ControlWidth } from "theme.slint";

// Content must be non-interactive; the primitive owns hit testing and activation.
export component KitPressable inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ButtonIntent> intent: ButtonIntent.secondary;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <ControlWidth> control-width: ControlWidth.intrinsic;
    in property <ButtonRecipe> recipe: KitThemes.button-recipe(root.theme, root.intent, root.control-size);
    in property <string> accessible-name;
    in property <bool> disabled;
    in property <bool> busy;
    in property <bool> tab-stop: true;
    // A composite that keeps keyboard focus itself sets this on its active
    // row; the row then paints `focus-ring` as if it held focus.
    in property <bool> focus-indicated;
    in property <KitFocusRing> focus-ring: root.recipe.focus;
    out property <bool> hovered: touch.has-hover && !root.disabled;
    out property <bool> pressed: (touch.pressed && root.pointer-armed && touch.has-hover) || root.space-held;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> focus-visible: keys.has-focus && root.keyboard-focus;
    callback activated();
    callback activation-started();
    callback key-event(event: KeyEvent) -> EventResult;
    callback focus-observed(bool);
    private property <bool> space-held;
    private property <bool> enter-held;
    private property <bool> pointer-armed;
    private property <bool> keyboard-focus: true;
    public function cancel-press() {
        root.space-held = false;
        root.enter-held = false;
        root.pointer-armed = false;
    }
    public function take-focus() { keys.focus(); }
    function activate-once() {
        if (!root.disabled && !root.busy) { root.activated(); }
    }
    changed disabled => { root.cancel-press(); }
    changed busy => { root.cancel-press(); }
    min-height: max(root.recipe.height, root.recipe.font-size * 1.4 + 2 * root.recipe.padding-block);
    preferred-height: root.min-height;
    max-height: root.preferred-height;
    vertical-stretch: 0;
    horizontal-stretch: root.control-width == ControlWidth.fill ? 1 : 0;
    preferred-width: 120px;
    max-width: root.control-width == ControlWidth.fill ? 100000px : root.preferred-width;
    border-radius: root.recipe.radius;
    border-width: root.recipe.border-width;
    border-color: root.recipe.border;
    background: root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: !root.disabled && !root.busy;
    accessible-action-default => { root.activation-started(); root.activate-once(); }
    forward-focus: keys;
    Rectangle {
        x: root.recipe.padding-inline;
        y: root.recipe.padding-block;
        width: max(0px, parent.width - 2 * root.recipe.padding-inline);
        height: max(0px, parent.height - 2 * root.recipe.padding-block);
        @children
    }
    keys := FocusScope {
        // Native keyboard traversal reveals this geometry in ancestor scrolls.
        // Include the painted outline; focus-on-click remains off, so this does
        // not enlarge the pointer target or change the button's layout size.
        x: -KitThemes.focus-outset(root.focus-ring);
        y: -KitThemes.focus-outset(root.focus-ring);
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        enabled: !root.disabled;
        focus-on-tab-navigation: root.tab-stop;
        focus-on-click: false;
        focus-gained(reason) => {
            root.keyboard-focus = reason != FocusReason.pointer-click;
            root.focus-observed(true);
        }
        focus-lost(reason) => {
            root.cancel-press();
            root.focus-observed(false);
        }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if (root.disabled || root.busy) { return reject; }
            if (root.key-event(event) == accept) { return accept; }
            if (event.text == Key.Space) {
                if (!root.space-held) { root.activation-started(); root.space-held = true; }
                return accept;
            }
            if (event.text == Key.Return) {
                if (!root.enter-held) { root.activation-started(); root.enter-held = true; root.activate-once(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space) {
                if (root.space-held) { root.space-held = false; root.activate-once(); }
                return accept;
            }
            if (event.text == Key.Return) { root.enter-held = false; return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: !root.disabled && !root.busy;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.activation-started();
                root.pointer-armed = true;
                keys.focus();
                root.keyboard-focus = false;
            }
            if (event.kind == PointerEventKind.cancel) { root.cancel-press(); }
        }
        clicked => {
            if (root.pointer-armed) { root.pointer-armed = false; root.activate-once(); }
        }
    }
    if root.focus-visible || root.focus-indicated: FocusOutline {
        ring: root.focus-ring; radius: root.recipe.radius;
        host-width: root.width; host-height: root.height;
    }
}

export component KitButton inherits KitPressable {
    in property <string> text;
    accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
    private property <length> natural-width: max(root.preferred-height, label.preferred-width + 2 * root.recipe.padding-inline);
    min-width: root.control-width == ControlWidth.fill ? 0px : root.natural-width;
    preferred-width: root.natural-width;
    label := Text {
        x: 0px; y: 0px;
        width: max(0px, root.width - 2 * root.recipe.padding-inline);
        height: max(0px, root.height - 2 * root.recipe.padding-block);
        opacity: root.busy ? 0 : 1;
        text: root.text;
        color: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        font-size: root.recipe.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    // The label stays in layout while a centered progress mark replaces it.
    // Busy therefore changes neither intrinsic width nor the content center.
    if root.busy: Rectangle {
        Path {
        x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        viewbox-width: 16; viewbox-height: 16;
        commands: "M 8 2 C 11.3 2 14 4.7 14 8 C 14 11.3 11.3 14 8 14 C 4.7 14 2 11.3 2 8";
        stroke: root.recipe.foreground; stroke-width: 2px; fill: transparent;
        }
    }
}

// View actions carry intent only; the application provides the typed payload.
export enum FormAction { submit, reset }
export component KitFormButton inherits KitButton {
    in property <FormAction> action: FormAction.submit;
    in property <bool> form-no-validate;
    callback validation-requested() -> bool;
    validation-requested => { return true; }
    callback form-action(FormAction);
    activated => {
        if (root.action != FormAction.submit || root.form-no-validate || root.validation-requested()) { root.form-action(root.action); }
    }
}
export component KitSubmitButton inherits KitFormButton {
    action: FormAction.submit;
    intent: ButtonIntent.primary;
}
export component KitResetButton inherits KitFormButton {
    action: FormAction.reset;
    intent: ButtonIntent.quiet;
}
export component KitIconButton inherits KitPressable {
    in property <IconKind> icon: IconKind.close;
    intent: ButtonIntent.quiet;
    recipe: KitThemes.icon-button-recipe(root.theme, root.control-size);
    preferred-width: root.preferred-height;
    min-width: self.preferred-width;
    Rectangle {
        KitIcon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            kind: root.icon;
            ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        }
    }
}
export component KitButtonGroup inherits HorizontalLayout {
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    @children
}
