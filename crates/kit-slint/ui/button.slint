import { KitKeyResult } from "keyboard.slint";
import { KitFormValidation } from "validation.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitIcon, IconGlyph } from "icons.slint";
import { KitTheme, KitThemes, KitThemeContext, KitFocusRing, KitMetrics, ButtonRecipe, ButtonIntent, ControlSize, ControlWidth, ChoiceFlow, ElevationLevel, FocusRingStyle } from "theme.slint";
import { FocusOutline } from "focus.slint";
import { KitStrings } from "strings.slint";
export { ButtonRecipe, ButtonIntent, ControlSize, ControlWidth } from "theme.slint";

component BusyMark inherits Rectangle {
    in property <ButtonRecipe> recipe;
    in property <KitTheme> theme;
    private property <int> phase;
    for index in 8: Rectangle {
        width: root.recipe.busy-mark-stroke * 2;
        height: self.width;
        border-radius: self.width / 2;
        x: (parent.width - self.width) / 2 + (root.recipe.busy-mark-size - self.width) / 2 * Math.cos(index * 45deg);
        y: (parent.height - self.height) / 2 + (root.recipe.busy-mark-size - self.height) / 2 * Math.sin(index * 45deg);
        background: root.recipe.foreground;
        opacity: root.theme.reduced-motion ? 1 : 0.2 + 0.8 * Math.mod(index + 8 - root.phase, 8) / 7;
    }
    Timer {
        interval: root.theme.motion.fast;
        running: !root.theme.reduced-motion;
        triggered => { root.phase = Math.mod(root.phase + 1, 8); }
    }
}

// Content must be non-interactive; the primitive owns hit testing and activation.
export component KitPressable inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ButtonIntent> intent: ButtonIntent.secondary;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <ControlWidth> control-width: ControlWidth.intrinsic;
    in property <ButtonRecipe> recipe: KitThemes.button-recipe(root.theme, root.intent, root.control-size);
    in property <length> corner-radius: root.recipe.radius;
    in property <length> padding-inline: root.recipe.padding-inline;
    in property <length> padding-block: root.recipe.padding-block;
    in property <length> text-size: root.recipe.font-size;
    in property <int> text-weight: root.recipe.font-weight;
    in property <string> accessible-name;
    // Supplementary help read after the name, e.g. the text of a wrapping KitTooltip.
    in property <string> description;
    in property <bool> disabled;
    in property <bool> busy;
    in property <string> busy-label: KitStrings.busy-label;
    in property <bool> tab-stop: true;
    in property <bool> activate-on-return: true;
    in property <bool> form-submit-on-return: false;
    // A pressable whose children host an open native editor hands the
    // pointer to them; keyboard activation and focus are unaffected.
    in property <bool> pointer-enabled: true;
    in property <bool> focus-on-pointer: true;
    // Holding the pointer repeats `activated`: first after the theme's
    // `motion.repeat-delay`, then every `motion.repeat-interval`. A press that
    // repeated activates nothing more on release, and the repeat stops when the
    // press ends or the control is disabled. Off for ordinary buttons.
    in property <bool> repeat-on-hold;
    // A composite that keeps keyboard focus itself sets this on its active
    // row; the row then paints `focus-ring` as if it held focus.
    in property <bool> focus-indicated;
    in property <KitFocusRing> focus-ring: root.recipe.focus;
    out property <bool> hovered: touch.has-hover && !root.disabled;
    out property <bool> pressed: (touch.pressed && root.pointer-armed && touch.has-hover) || root.space-held;
    out property <bool> has-focus: root.focused;
    out property <bool> focus-visible: root.focused && root.keyboard-focus;
    out property <length> pointer-x: touch.mouse-x;
    callback double-activated();
    callback activated();
    // Composition hook runs before the public activation notification.
    callback activation-allowed() -> bool;
    activation-allowed => { return true; }
    callback activation-started();
    callback key-event(event: KeyEvent) -> KitKeyResult;
    callback focus-observed(bool);
    private property <bool> space-held;
    private property <bool> enter-held;
    private property <bool> pointer-armed;
    private property <bool> repeat-held: root.repeat-on-hold && root.pointer-armed && touch.pressed && touch.has-hover && !root.disabled && !root.busy;
    private property <bool> repeat-started;
    private property <bool> repeated;
    changed repeat-held => { if (!root.repeat-held) { root.repeat-started = false; } }
    private property <bool> keyboard-focus;
    private property <bool> focused;
    public function cancel-press() {
        root.space-held = false;
        root.enter-held = false;
        root.pointer-armed = false;
    }
    // Like a disabled web control, a disabled pressable cannot take focus.
    public function take-focus() { if (!root.disabled) { keys.focus(); } }
    function activate-once() {
        if (!root.disabled && !root.busy && root.activation-allowed()) { root.activated(); }
    }
    changed disabled => {
        root.cancel-press();
        if (root.disabled) {
            // Slint ignores FocusOut once the native scope is disabled. Move
            // focus to an inert routing scope before notifying the host, so
            // Tab still reaches enclosing composite/modal keyboard scopes.
            let was-focused = root.focused;
            root.focused = false;
            root.keyboard-focus = false;
            if (was-focused) {
                routing.focus();
                root.focus-observed(false);
            }
        } else {
            // Public clear-focus only clears this scope when it owns focus;
            // a host's redirected focus is never cleared by this notification.
            routing.clear-focus();
        }
    }
    changed busy => { root.cancel-press(); }
    min-height: max(root.recipe.height, root.text-size * 1.4 + 2 * root.padding-block);
    preferred-height: root.min-height;
    max-height: root.preferred-height;
    vertical-stretch: 0;
    horizontal-stretch: root.control-width == ControlWidth.fill ? 1 : 0;
    preferred-width: 120px;
    max-width: root.control-width == ControlWidth.fill ? 100000px : root.preferred-width;
    border-radius: root.corner-radius;
    border-width: root.recipe.border-width;
    border-color: root.recipe.border;
    background: root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: !root.disabled && !root.busy;
    accessible-description: root.busy ? root.busy-label : root.description;
    accessible-action-default => {
        if (!root.disabled && !root.busy) { root.activation-started(); root.activate-once(); }
    }
    forward-focus: keys;
    // The recipe's elevation, painted by a child that repeats the host's own
    // fill and edge so only its shadow shows past them. A shadow on the host
    // itself would take part in its measured height inside a layout.
    if root.recipe.shadow.color.to-hsv().alpha > 0: Rectangle {
        background: root.background;
        border-radius: root.border-radius;
        border-width: root.border-width;
        border-color: root.border-color;
        drop-shadow-offset-y: root.recipe.shadow.offset-y;
        drop-shadow-blur: root.recipe.shadow.blur;
        drop-shadow-color: root.recipe.shadow.color;
    }
    Rectangle {
        x: root.padding-inline;
        y: root.padding-block;
        width: max(0px, parent.width - 2 * root.padding-inline);
        height: max(0px, parent.height - 2 * root.padding-block);
        @children
    }
    keys := FocusScope {
        // Native keyboard traversal reveals this geometry in ancestor scrolls.
        // Include the painted outline; focus-on-click remains off, so this does
        // not enlarge the pointer target or change the button's layout size.
        x: -KitThemes.focus-outset(root.focus-ring);
        y: -KitThemes.focus-outset(root.focus-ring);
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        // Keep FocusOut observable even when disabled changes before its
        // notification. Activation, pointer and traversal eligibility are
        // guarded by the public disabled state instead.
        focus-on-tab-navigation: root.tab-stop && !root.disabled;
        focus-on-click: false;
        focus-gained(reason) => {
            if (root.disabled) { routing.focus(); }
            else {
                let was-focused = root.focused;
                root.focused = true;
                if (reason == FocusReason.tab-navigation || reason == FocusReason.programmatic) { root.keyboard-focus = true; }
                else if (reason == FocusReason.pointer-click) { root.keyboard-focus = false; }
                if (!was-focused) { root.focus-observed(true); }
            }
        }
        focus-lost(reason) => {
            let was-focused = root.focused;
            root.focused = false;
            root.keyboard-focus = false;
            root.cancel-press();
            if (was-focused) { root.focus-observed(false); }
        }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if (root.disabled || root.busy) { return reject; }
            if (root.key-event(event) == KitKeyResult.accept) { return accept; }
            if (root.form-submit-on-return && event.text == Key.Return && KitFormValidation.implicit-submit-active(KitFormValidation.focus-generation)) {
                KitFormValidation.note-native-submit(KitFormValidation.focus-generation);
                return accept;
            }
            if (event.text == Key.Space) {
                if (!root.space-held) { root.activation-started(); root.space-held = true; }
                return accept;
            }
            if (root.activate-on-return && event.text == Key.Return) {
                if (!root.enter-held) { root.activation-started(); root.enter-held = true; root.activate-once(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space) {
                if (root.space-held) { root.space-held = false; root.activate-once(); }
                return accept;
            }
            if (root.activate-on-return && event.text == Key.Return) { root.enter-held = false; return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: !root.disabled && !root.busy && root.pointer-enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.activation-started();
                root.pointer-armed = true;
                root.repeated = false;
                if (root.focus-on-pointer) { keys.focus(); }
                root.keyboard-focus = false;
            }
            if (event.kind == PointerEventKind.cancel) { root.cancel-press(); }
        }
        double-clicked => { if (!root.disabled && !root.busy) { root.double-activated(); } }
        clicked => {
            if (root.pointer-armed) {
                root.pointer-armed = false;
                if (!root.repeated) { root.activate-once(); }
                root.repeated = false;
            }
        }
    }
    // Two timers, because a running Timer keeps its period: the delay timer
    // hands over to the interval timer after its first trigger.
    Timer {
        running: root.repeat-held && !root.repeat-started;
        interval: root.theme.motion.repeat-delay;
        triggered => {
            root.repeat-started = true;
            root.repeated = true;
            root.activate-once();
        }
    }
    Timer {
        running: root.repeat-held && root.repeat-started;
        interval: root.theme.motion.repeat-interval;
        triggered => {
            root.repeated = true;
            root.activate-once();
        }
    }
    // Not a control, tab stop or pointer target. It preserves ancestor key
    // routing after a focused action becomes ineligible.
    routing := FocusScope {
        width: 0px; height: 0px;
        focus-on-tab-navigation: false;
        focus-on-click: false;
        accessible-role: none;
    }
    if root.focus-visible || root.focus-indicated: FocusOutline {
        ring: root.focus-ring; radius: root.corner-radius;
        host-width: root.width; host-height: root.height;
    }
}

export component KitButton inherits KitPressable {
    in property <string> text;
    in property <TextWrap> text-wrap: no-wrap;
    in property <IconGlyph> leading-icon;
    in property <IconGlyph> trailing-icon;
    private property <length> icon-size: KitMetrics.icon-size(root.theme, root.control-size);
    private property <bool> has-leading: root.leading-icon.stroke != "" || root.leading-icon.fill != "";
    private property <bool> has-trailing: root.trailing-icon.stroke != "" || root.trailing-icon.fill != "";
    private property <length> icon-gap: KitMetrics.inline-gap(root.theme);
    private property <length> leading-width: root.has-leading ? root.icon-size + root.icon-gap : 0px;
    private property <length> trailing-width: root.has-trailing ? root.icon-size + root.icon-gap : 0px;
    private property <length> side-reserve: max(root.leading-width, root.trailing-width);
    accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
    // Flexbox resolves both axes through one cache. Observe its resolved width
    // before measuring height so intrinsic button height cannot feed that cache
    // back into the measurement's width binding.
    private property <length> measured-width;
    init => { root.measured-width = root.width; }
    changed width => { root.measured-width = root.width; }
    min-height: max(root.recipe.height, root.text-wrap == TextWrap.no-wrap
        ? root.text-size * 1.4 + 2 * root.padding-block
        : measure.preferred-height + 2 * root.padding-block);
    private property <length> natural-width: max(max(root.recipe.height, root.text-size * 1.4 + 2 * root.padding-block), label.preferred-width + 2 * root.side-reserve + 2 * root.padding-inline);
    min-width: root.control-width == ControlWidth.fill || root.text-wrap != TextWrap.no-wrap ? 0px : root.natural-width;
    preferred-width: root.natural-width;
    // Pressable injects these children into its padded content rectangle.
    // `parent` here is still the lexical Button, so use the content dimensions
    // explicitly rather than counting its padding a second time.
    if root.has-leading: KitIcon { theme: root.theme; control-size: root.control-size; glyph: root.leading-icon; x: root.theme.direction == ChoiceFlow.right-to-left ? root.width - 2 * root.padding-inline - self.width : 0px; y: (root.height - 2 * root.padding-block - self.height) / 2; opacity: root.busy ? 0 : 1; ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground; }
    if root.has-trailing: KitIcon { theme: root.theme; control-size: root.control-size; glyph: root.trailing-icon; x: root.theme.direction == ChoiceFlow.right-to-left ? 0px : root.width - 2 * root.padding-inline - self.width; y: (root.height - 2 * root.padding-block - self.height) / 2; opacity: root.busy ? 0 : 1; ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground; }
    label := Text {
        x: root.side-reserve; y: 0px;
        width: max(0px, root.width - 2 * root.padding-inline - 2 * root.side-reserve);
        height: max(0px, root.height - 2 * root.padding-block);
        opacity: root.busy ? 0 : 1;
        text: root.text;
        color: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        font-family: root.theme.typography.family; font-size: root.text-size; font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: root.text-wrap;
        overflow: root.text-wrap == TextWrap.no-wrap ? TextOverflow.elide : TextOverflow.clip;
    }
    measure := Text {
        visible: false; accessible-role: none;
        width: max(0px, root.measured-width - 2 * root.padding-inline - 2 * root.side-reserve);
        text: root.text; wrap: root.text-wrap;
        font-family: root.theme.typography.family; font-size: root.text-size; font-weight: root.text-weight;
    }
    if root.recipe.underline && !root.busy: link-rule := Rectangle {
        x: label.x + (label.width - self.width) / 2;
        y: label.y + (label.height + (root.text-wrap == TextWrap.no-wrap ? root.text-size : label.preferred-height)) / 2 + root.theme.spacing.unit / 2;
        width: min(label.width, label.preferred-width);
        height: root.theme.shape.border-width;
        background: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
    }
    // The label stays in layout while a centered progress mark replaces it.
    // Busy therefore changes neither intrinsic width nor the content center.
    if root.busy: BusyMark { recipe: root.recipe; theme: root.theme; }
}

// View actions carry intent only; the application provides the typed payload.
export enum FormAction { submit, reset }
export component KitFormButton inherits KitButton {
    in property <FormAction> action: FormAction.submit;
    in property <bool> form-no-validate;
    callback validation-requested() -> bool;
    validation-requested => { return false; }
    callback form-action(FormAction);
    activation-allowed => {
        if (root.action == FormAction.submit && !root.form-no-validate && !root.validation-requested()) { return false; }
        root.form-action(root.action);
        return true;
    }
}
export component KitSubmitButton inherits KitFormButton {
    action: FormAction.submit;
    intent: ButtonIntent.primary;
}
export component KitResetButton inherits KitFormButton {
    action: FormAction.reset;
    intent: ButtonIntent.secondary;
}
export component KitIconButton inherits KitPressable {
    // The action's glyph, e.g. `root.theme.icons.close` or `LucideIcons.trash()`.
    in property <IconGlyph> glyph;
    intent: ButtonIntent.quiet;
    recipe: KitThemes.button-recipe(root.theme, root.intent, root.control-size);
    padding-inline: 0px; padding-block: 0px;
    // Removing padding keeps the glyph centered, while the scaled control
    // line height still reserves a target larger than the glyph itself.
    min-height: max(root.recipe.height, KitMetrics.control-height(root.theme, root.control-size), root.text-size * 1.4 + 2 * root.padding-block);
    preferred-width: root.preferred-height;
    min-width: self.preferred-width;
    Rectangle {
        KitIcon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            theme: root.theme; control-size: root.control-size;
            glyph: root.glyph;
            opacity: root.busy ? 0 : 1;
            ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        }
    }
    if root.busy: BusyMark { recipe: root.recipe; theme: root.theme; }
}
export struct ButtonGroupEntry {
    token: int, generation: int, text: string, accessible-name: string,
    leading-icon: IconGlyph, trailing-icon: IconGlyph, intent: ButtonIntent,
    disabled: bool, busy: bool, busy-label: string,
}
component GroupButtonItem inherits KitButton {
    in property <ButtonGroupEntry> entry;
    in property <bool> attached;
    in property <bool> group-disabled;
    in property <string> default-busy-label;
    in property <bool> last;
    in property <Orientation> orientation;
    private property <ButtonRecipe> base-recipe: KitThemes.button-recipe(root.theme, root.entry.intent, root.control-size);
    recipe: {
        fill: root.base-recipe.fill, hover-fill: root.base-recipe.hover-fill, pressed-fill: root.base-recipe.pressed-fill,
        disabled-fill: root.base-recipe.disabled-fill, foreground: root.base-recipe.foreground, disabled-foreground: root.base-recipe.disabled-foreground,
        border: root.base-recipe.border, radius: root.attached ? 0px : root.base-recipe.radius,
        padding-inline: root.base-recipe.padding-inline, padding-block: root.base-recipe.padding-block,
        border-width: root.attached ? 0px : root.base-recipe.border-width,
        height: root.attached ? max(root.base-recipe.height, KitMetrics.control-height(root.theme, root.control-size)) : root.base-recipe.height, font-size: root.base-recipe.font-size, font-weight: root.base-recipe.font-weight, underline: root.base-recipe.underline,
        busy-mark-size: root.base-recipe.busy-mark-size, busy-mark-stroke: root.base-recipe.busy-mark-stroke,
        elevation: root.attached ? ElevationLevel.none : root.base-recipe.elevation,
        shadow: root.attached ? KitThemes.shadow(root.theme, ElevationLevel.none) : root.base-recipe.shadow,
        focus: { style: root.attached ? FocusRingStyle.inside : root.base-recipe.focus.style,
            width: root.base-recipe.focus.width, offset: root.base-recipe.focus.offset,
            color: root.base-recipe.focus.color, invalid-color: root.base-recipe.focus.invalid-color },
    };
    control-width: root.attached ? ControlWidth.fill : ControlWidth.intrinsic;
    text: root.entry.text; accessible-name: root.entry.accessible-name;
    leading-icon: root.entry.leading-icon; trailing-icon: root.entry.trailing-icon;
    disabled: root.group-disabled || root.entry.disabled; busy: root.entry.busy; busy-label: root.entry.busy-label != "" ? root.entry.busy-label : root.default-busy-label;
    private property <int> press-token;
    private property <int> press-generation;
    callback action-requested(int, int);
    activation-started => { root.press-token = root.entry.token; root.press-generation = root.entry.generation; }
    changed entry => { root.cancel-press(); }
    activated => { root.action-requested(root.press-token, root.press-generation); }
    if root.attached && !root.last: separator := Rectangle {
        x: root.orientation == Orientation.vertical || root.theme.direction == ChoiceFlow.right-to-left ? -root.padding-inline : root.width - root.padding-inline - self.width;
        y: root.orientation == Orientation.horizontal ? -root.padding-block : root.height - root.padding-block - self.height;
        width: root.orientation == Orientation.horizontal ? root.theme.shape.border-width : root.width;
        height: root.orientation == Orientation.horizontal ? root.height : root.theme.shape.border-width;
        background: root.theme.border-strong;
    }
}
export component KitButtonGroup inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <[ButtonGroupEntry]> actions;
    in property <Orientation> orientation: Orientation.horizontal;
    in property <bool> attached;
    in property <bool> wrap;
    in property <bool> disabled;
    in property <string> accessible-name;
    in property <string> busy-label: KitStrings.busy-label;
    in property <length> spacing: KitMetrics.inline-gap(root.theme);
    in property <LayoutAlignment> alignment: LayoutAlignment.start;
    in property <ControlSize> control-size: ControlSize.medium;
    callback activated(int, int);
    accessible-role: groupbox; accessible-label: root.accessible-name; accessible-orientation: root.orientation;
    preferred-width: content.preferred-width;
    min-width: root.wrap && !root.attached ? 0px : content.min-width;
    preferred-height: content.preferred-height; height: self.preferred-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    clip: root.attached;
    border-radius: root.attached ? root.theme.shape.radius-control : 0px;
    content := FlexboxLayout {
        width: root.width; height: self.preferred-height;
        flex-direction: root.orientation == Orientation.vertical ? FlexboxLayoutDirection.column : root.theme.direction == ChoiceFlow.right-to-left ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: root.wrap && !root.attached ? FlexboxLayoutWrap.wrap : FlexboxLayoutWrap.no-wrap;
        spacing: root.attached ? 0px : root.spacing;
        alignment: root.attached ? LayoutAlignment.stretch : root.alignment; cross-axis-alignment: root.attached ? CrossAxisAlignment.stretch : CrossAxisAlignment.start;
        for entry[index] in root.actions: GroupButtonItem {
            theme: root.theme; entry: entry; attached: root.attached; group-disabled: root.disabled;
            default-busy-label: root.busy-label; last: index + 1 == root.actions.length; orientation: root.orientation; control-size: root.control-size;
            action-requested(token, generation) => { root.activated(token, generation); }
        }
        @children
    }
    if root.attached: outline := Rectangle {
        border-radius: root.border-radius;
        border-color: root.theme.border-strong; border-width: root.theme.shape.border-width;
    }
}
