import { ScrollFrame, ScrollPanPolicy } from "scroll.slint";
import { NavigationStep } from "contracts.slint";
import { FocusOutline } from "focus.slint";
import { KitModalContext } from "modal.slint";
import { ElevationLevel, KitTheme, KitThemes, KitMetrics, TypographyRole, SurfaceLevel, SurfaceRecipe, KitThemeContext } from "theme.slint";
export { SurfaceLevel } from "theme.slint";

// Presentation-only contracts: Rust consumers use the generated Slint enums.
export enum LayoutSpace { none, tight, compact, regular, roomy, section }
export enum ContentWidth { reading, standard, wide, fluid }
export enum SurfaceBorder { none, subtle }
// Which axes a KitScrollArea scrolls. `both` treats the vertical axis as primary.
export enum ScrollAxes { vertical, horizontal, both }
// The edge of the primary axis that a scrolled viewport has reached.
export enum ScrollEdge { start, end }
export global KitLayoutMetrics {
    // Multiples of the theme's spacing unit: 0, 1, 2, 4, 6 and 8.
    public pure function space(theme: KitTheme, value: LayoutSpace) -> length {
        return theme.spacing.unit * (value == LayoutSpace.none ? 0 : value == LayoutSpace.tight ? 1 : value == LayoutSpace.compact ? 2 : value == LayoutSpace.regular ? 4 : value == LayoutSpace.roomy ? 6 : 8);
    }
    public pure function width-limit(theme: KitTheme, value: ContentWidth) -> length {
        return value == ContentWidth.reading ? theme.geometry.content-reading : value == ContentWidth.standard ? theme.geometry.content-standard : value == ContentWidth.wide ? theme.geometry.content-wide : theme.geometry.content-fluid;
    }
}

// A finite width comes from the parent. The inner column owns its natural height;
// the width limit never becomes the outer element's minimum width.
export component KitContainer inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ContentWidth> content-width: ContentWidth.standard;
    in property <length> max-content-width: KitLayoutMetrics.width-limit(root.theme, root.content-width);
    in property <LayoutSpace> gutter: LayoutSpace.regular;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    out property <length> available-width: body.width;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: body.preferred-height;
    body := VerticalLayout {
        y: 0px;
        width: min(max(0px, root.width - 2 * KitLayoutMetrics.space(root.theme, root.gutter)), root.max-content-width);
        x: (root.width - self.width) / 2;
        height: self.preferred-height;
        alignment: start;
        spacing: KitLayoutMetrics.space(root.theme, root.gap);
        @children
    }
}

export component KitStack inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <LayoutSpace> inset: LayoutSpace.none;
    spacing: KitLayoutMetrics.space(root.theme, root.gap);
    padding: KitLayoutMetrics.space(root.theme, root.inset);
    alignment: start;
    vertical-stretch: 0;
    @children
}

// Natural main-axis sizing; callers choose LayoutAlignment and each child's
// horizontal-stretch. This is intentionally a single line, not a flex-wrap API.
export component KitInline inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.compact;
    in property <LayoutSpace> inset: LayoutSpace.none;
    spacing: KitLayoutMetrics.space(root.theme, root.gap);
    padding: KitLayoutMetrics.space(root.theme, root.inset);
    alignment: start;
    vertical-stretch: 0;
    @children
}

// FlexboxLayout is public in Slint 1.18. It reflows ordinary children while
// retaining their instances, so focus and native editor state survive resizing.
export component KitWrap inherits FlexboxLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.compact;
    in property <LayoutSpace> inset: LayoutSpace.none;
    spacing: KitLayoutMetrics.space(root.theme, root.gap);
    padding: KitLayoutMetrics.space(root.theme, root.inset);
    flex-wrap: wrap;
    vertical-stretch: 0;
    @children
}

// Public Slint grid semantics: declare Row/col/rowspan at the call site.
// Automatic redistribution of opaque @children is not supported by Slint.
export component KitGrid inherits GridLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <LayoutSpace> inset: LayoutSpace.none;
    spacing: KitLayoutMetrics.space(root.theme, root.gap);
    padding: KitLayoutMetrics.space(root.theme, root.inset);
    vertical-stretch: 0;
    @children
}

export component KitSection inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> title;
    in property <string> description;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    spacing: KitLayoutMetrics.space(root.theme, root.gap);
    alignment: start;
    vertical-stretch: 0;
    if root.title != "": Text {
        text: root.title;
        color: root.theme.text-primary;
        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle);
        font-weight: root.theme.typography.weight-semibold;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    if root.description != "": Text {
        text: root.description;
        color: root.theme.text-secondary;
        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    @children
}

// Exactly one painted surface and one padding owner. This does not capture
// pointer/focus events; interactive card behavior belongs to KitPressable.
export component KitSurface inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <SurfaceLevel> level: SurfaceLevel.flat;
    in property <SurfaceBorder> border: SurfaceBorder.subtle;
    in property <LayoutSpace> inset: LayoutSpace.regular;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <length> corner-radius: root.recipe.radius;
    in property <ElevationLevel> elevation: root.recipe.elevation;
    in property <SurfaceRecipe> recipe: KitThemes.surface-recipe(root.theme, root.level);
    border-radius: root.corner-radius;
    border-width: root.border == SurfaceBorder.subtle ? root.recipe.border-width : 0px;
    border-color: root.recipe.border;
    background: root.recipe.fill;
    drop-shadow-offset-y: root.elevation == root.recipe.elevation ? root.recipe.shadow.offset-y : KitThemes.shadow(root.theme, root.elevation).offset-y;
    drop-shadow-blur: root.elevation == root.recipe.elevation ? root.recipe.shadow.blur : KitThemes.shadow(root.theme, root.elevation).blur;
    drop-shadow-color: root.elevation == root.recipe.elevation ? root.recipe.shadow.color : KitThemes.shadow(root.theme, root.elevation).color;
    vertical-stretch: 0;
    VerticalLayout {
        padding: KitLayoutMetrics.space(root.theme, root.inset);
        spacing: KitLayoutMetrics.space(root.theme, root.gap);
        alignment: start;
        @children
    }
}

// Finite viewport allocated by the parent. By default one width-bound column
// reflows its children and grows vertically. `axes` adds horizontal or
// two-axis scrolling, where the column takes the width of its widest child.
// `focusable` makes the viewport a tab stop with a focus ring: arrows, Page
// Up/Down, Space (Shift+Space reverses), Home and End scroll it. Scrollbars are
// themed KitScrollBar parts; the primary axis is vertical unless `axes` is
// horizontal, and drives `scroll-to-start`, `scroll-to-end`, `at-start`, `at-end`
// and `edge-reached`.
export component KitScrollArea inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert, like every kit control.
    in property <int> modal-layer;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <LayoutSpace> inset: LayoutSpace.none;
    in property <ScrollAxes> axes: ScrollAxes.vertical;
    // Opt-in keyboard scrolling: the viewport joins the tab order and keeps
    // accepting keys bubbled from focusable content.
    in property <bool> focusable: false;
    // Accessible name of the viewport group; name it whenever it is focusable.
    in property <string> label;
    // Distance of one arrow-key step; Page keys move a page minus one step.
    in property <length> line-step: root.theme.spacing.unit * 10;
    in property <bool> enabled <=> frame.enabled;
    in property <bool> overlay-scrollbars <=> frame.overlay-scrollbars;
    in property <ScrollBarPolicy> vertical-scrollbar-policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy;
    in property <bool> mouse-drag-pan-enabled <=> frame.mouse-drag-pan-enabled;
    in property <ScrollPanPolicy> pan-policy <=> frame.pan-policy;
    out property <length> visible-width: frame.visible-width;
    out property <length> visible-height: frame.visible-height;
    out property <length> content-width: frame.content-width;
    out property <length> content-height: frame.content-height;
    in-out property <length> content-y <=> frame.content-y;
    in-out property <length> content-x <=> frame.content-x;
    // Whether the primary axis overflows, and where its offset sits. A viewport
    // whose content fits is at both its start and its end.
    out property <bool> scrollable: root.range > 0px;
    out property <bool> at-start: root.offset >= 0px;
    out property <bool> at-end: root.offset <= -root.range;
    out property <bool> keyboard-focus;
    callback scrolled <=> frame.scrolled;
    // Emitted once when the primary axis arrives at an edge of overflowing
    // content, whether by pointer, keyboard or a programmatic move.
    callback edge-reached(ScrollEdge);
    private property <bool> horizontal-primary: root.axes == ScrollAxes.horizontal;
    private property <length> range: max(0px, root.horizontal-primary ? frame.content-width - frame.visible-width : frame.content-height - frame.visible-height);
    private property <length> offset: root.horizontal-primary ? frame.content-x : frame.content-y;
    changed at-start => { if (root.at-start && root.scrollable) { root.edge-reached(ScrollEdge.start); } }
    changed at-end => { if (root.at-end && root.scrollable) { root.edge-reached(ScrollEdge.end); } }
    public function take-focus() { keys.focus(); }
    public function scroll-to-start() {
        if (root.horizontal-primary) { root.content-x = 0px; } else { root.content-y = 0px; }
    }
    public function scroll-to-end() {
        if (root.horizontal-primary) { root.content-x = -root.range; } else { root.content-y = -root.range; }
    }
    public function reveal(top: length, bottom: length) {
        // An oversized target cannot expose both edges. Reveal its leading edge
        // only when hidden, preserving a saved position that already shows it.
        if (bottom - top > root.visible-height) {
            if (top < -root.content-y || top >= -root.content-y + root.visible-height) {
                root.content-y = -min(max(0px, root.content-height - root.visible-height), max(0px, top));
            }
        }
        else if (top < -root.content-y) { root.content-y = -max(0px, top); }
        else if (bottom > -root.content-y + root.visible-height) {
            root.content-y = -min(max(0px, root.content-height - root.visible-height), max(0px, bottom - root.visible-height));
        }
    }
    // Moves one axis by a navigation step. False when the axis cannot move, so
    // the key stays available to an outer scrolled ancestor.
    function move(step: NavigationStep, horizontal: bool) -> bool {
        let visible = horizontal ? frame.visible-width : frame.visible-height;
        let span = max(0px, (horizontal ? frame.content-width : frame.content-height) - visible);
        let current = horizontal ? frame.content-x : frame.content-y;
        let page = max(root.line-step, visible - root.line-step);
        let target = step == NavigationStep.next ? current - root.line-step
            : step == NavigationStep.previous ? current + root.line-step
            : step == NavigationStep.page-next ? current - page
            : step == NavigationStep.page-previous ? current + page
            : step == NavigationStep.first ? 0px : -span;
        let bounded = clamp(target, -span, 0px);
        if (bounded == current) { return false; }
        if (horizontal) { frame.content-x = bounded; } else { frame.content-y = bounded; }
        root.scrolled();
        return true;
    }
    min-width: frame.min-width;
    min-height: frame.min-height;
    preferred-width: 100%;
    preferred-height: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    keys := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.enabled && !KitModalContext.inert(root.modal-layer);
        accessible-enabled: root.enabled && !KitModalContext.inert(root.modal-layer);
        focus-on-tab-navigation: root.focusable;
        focus-on-click: root.focusable;
        accessible-role: groupbox;
        accessible-label: root.label;
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation || reason == FocusReason.programmatic;
        }
        focus-lost(reason) => { root.keyboard-focus = false; }
        key-pressed(event) => {
            if (!root.focusable || event.modifiers.control || event.modifiers.alt || event.modifiers.meta) { return reject; }
            root.keyboard-focus = true;
            let vertical = root.axes != ScrollAxes.horizontal;
            let sideways = root.axes != ScrollAxes.vertical;
            if (event.text == Key.Space) { return root.move(event.modifiers.shift ? NavigationStep.page-previous : NavigationStep.page-next, root.horizontal-primary) ? accept : reject; }
            if (event.text == Key.PageDown) { return root.move(NavigationStep.page-next, root.horizontal-primary) ? accept : reject; }
            if (event.text == Key.PageUp) { return root.move(NavigationStep.page-previous, root.horizontal-primary) ? accept : reject; }
            if (event.text == Key.Home) { return root.move(NavigationStep.first, root.horizontal-primary) ? accept : reject; }
            if (event.text == Key.End) { return root.move(NavigationStep.last, root.horizontal-primary) ? accept : reject; }
            if (vertical && event.text == Key.DownArrow) { return root.move(NavigationStep.next, false) ? accept : reject; }
            if (vertical && event.text == Key.UpArrow) { return root.move(NavigationStep.previous, false) ? accept : reject; }
            // Offsets are physical: the Left key reveals content on the left.
            if (sideways && event.text == Key.RightArrow) { return root.move(NavigationStep.next, true) ? accept : reject; }
            if (sideways && event.text == Key.LeftArrow) { return root.move(NavigationStep.previous, true) ? accept : reject; }
            return reject;
        }
        frame := ScrollFrame {
            theme: root.theme;
            width: root.width;
            height: root.height;
            vertical-scrollbar-policy: root.axes == ScrollAxes.horizontal ? ScrollBarPolicy.always-off : root.vertical-scrollbar-policy;
            horizontal-scrollbar-policy: root.axes == ScrollAxes.vertical ? ScrollBarPolicy.always-off : root.horizontal-scrollbar-policy;
            content-width: root.axes == ScrollAxes.vertical ? self.visible-width : max(self.visible-width, body.preferred-width);
            content-height: root.axes == ScrollAxes.horizontal ? self.visible-height : max(self.visible-height, body.preferred-height);
            body := VerticalLayout {
                y: 0px;
                width: frame.content-width;
                height: root.axes == ScrollAxes.horizontal ? frame.visible-height : self.preferred-height;
                padding: KitLayoutMetrics.space(root.theme, root.inset);
                spacing: KitLayoutMetrics.space(root.theme, root.gap);
                alignment: start;
                @children
            }
        }
        if root.focusable && root.keyboard-focus && keys.has-focus: FocusOutline {
            ring: KitThemes.inset-focus(root.theme); radius: 0px; host-width: root.width; host-height: root.height;
        }
    }
}

// Compose header, stretchable content, and footer as ordinary children in their
// reading order. The caller chooses which child consumes remaining height.
export component KitAppShell inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.none;
    background: root.theme.canvas;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    VerticalLayout {
        spacing: KitLayoutMetrics.space(root.theme, root.gap);
        alignment: stretch;
        @children
    }
}
