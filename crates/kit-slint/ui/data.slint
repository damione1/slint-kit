import { ListView } from "scroll.slint";
import { KitTheme, KitThemes, KitMetrics, ControlSize, ButtonIntent, ButtonRecipe, ControlWidth, KitThemeContext, TypographyRole, SurfaceLevel, SurfaceRecipe, ColumnHandleRecipe } from "theme.slint";
import { KitPressable, KitButton } from "button.slint";
import { KitIcon, KitGlyphs, TurningIcon } from "icons.slint";
import { KitTextField } from "input.slint";
import { FocusOutline } from "focus.slint";
import { NavigationStep, FieldAccess } from "contracts.slint";
export enum DataSortDirection { unsorted, ascending, descending }
export enum DataAlignment { leading, center, trailing }
export enum TextViewAccess { read-only, edit-line }
// How a data-table column takes its width. `fill` (the default) starts at
// its basis, never below the table's `minimum-column-width` or its own
// minimum, and shares the space left over with the other fill columns.
// `fixed` is exactly its basis, clamped to its own bounds, and never grows.
export enum ColumnSizing { fill, fixed }
// Whether a column has a ceiling. Slint struct fields default to zero, so an
// absent ceiling is named here instead of being read from a zero maximum.
export enum ColumnCeiling { unbounded, bounded }
// The width policy of one column, carried by the column so it follows the
// column's stable token through reordering. Lengths are logical pixels and
// are not scaled by the theme; the table's own default minimum is. A
// resizable column shows a handle at its trailing edge; pointer drags and
// keyboard steps are clamped to [minimum, maximum] and reported through
// `resize-requested(token, width)`, which the application applies by
// changing this policy (usually to `fixed` at the reported basis).
export struct ColumnWidth { sizing: ColumnSizing, basis: length, minimum: length, ceiling: ColumnCeiling, maximum: length, resizable: bool }
export struct TableColumn { token: int, label: string, sortable: bool, sort: DataSortDirection, alignment: DataAlignment, width: ColumnWidth }
export struct TableRow { token: int, cells: [string], selected: bool, disabled: bool }
export struct ContentItem { token: int, title: string, excerpt: string, metadata: string, link-label: string, thumbnail: image, selected: bool, disabled: bool }
export struct TextLine { token: int, number: int, text: string, selected: bool }

component DataKeyboard inherits FocusScope {
    in property <bool> disabled;
    callback navigate(NavigationStep);
    callback activate();
    enabled: !root.disabled;
    key-pressed(event) => {
        if (event.text == Key.DownArrow) {root.navigate(NavigationStep.next);return accept;}
        if (event.text == Key.UpArrow) {root.navigate(NavigationStep.previous);return accept;}
        if (event.text == Key.Home) {root.navigate(NavigationStep.first);return accept;}
        if (event.text == Key.End) {root.navigate(NavigationStep.last);return accept;}
        if (event.text == Key.PageDown) {root.navigate(NavigationStep.page-next);return accept;}
        if (event.text == Key.PageUp) {root.navigate(NavigationStep.page-previous);return accept;}
        if (event.text == Key.Return || event.text == Key.Space) {root.activate();return accept;}
        return reject;
    }
    @children
}
component DataAction inherits KitPressable {
    in property <int> token;
    in property <int> generation;
    callback requested(int,int);
    private property <int> armed-token;
    private property <int> armed-generation;
    activation-started => {root.armed-token = root.token;root.armed-generation = root.generation;}
    changed token => {root.cancel-press();}
    changed generation => {root.cancel-press();}
    activated => {root.requested(root.armed-token,root.armed-generation);}
    control-width: ControlWidth.fill;
    tab-stop: false;
    @children
}

// The label and sort indicator of one header cell, shared by the sortable
// pressable and the static text header.
component TableHeaderContent inherits HorizontalLayout {
    in property <KitTheme> theme;
    in property <ControlSize> control-size;
    in property <TableColumn> column;
    in property <length> inset;
    padding-left: root.inset; padding-right: root.inset; spacing: root.theme.spacing.unit * 1.5;
    alignment: root.column.alignment == DataAlignment.trailing ? end : root.column.alignment == DataAlignment.center ? center : start;
    Text {horizontal-stretch: 0; max-width: self.preferred-width; text:root.column.label;color:root.theme.text-primary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);font-weight:root.theme.typography.weight-medium;overflow:elide;vertical-alignment:center;}
    if root.column.sort != DataSortDirection.unsorted: Rectangle {
        width: KitMetrics.icon-size(root.theme, root.control-size); height: parent.height;
        TurningIcon {theme: root.theme; control-size: root.control-size; y: (parent.height - self.height) / 2; turned: root.column.sort == DataSortDirection.descending; rest-glyph: root.theme.icons.chevron-up; turned-glyph: root.theme.icons.chevron-down;ink:root.theme.text-secondary;}
    }
}

// The resize handle of one column: the pointer target at the trailing edge
// of its header cell, a tab stop that steps the width with the arrow keys,
// and an accessible spinbox whose value is the width in logical pixels. It
// never stores a width: a drag previews through `preview`, then `commit`
// hands the clamped width to the table, which reports it to the host.
component ColumnResizeHandle inherits Rectangle {
    in property <KitTheme> theme;
    in property <ColumnHandleRecipe> recipe;
    in property <string> accessible-name;
    in property <bool> disabled;
    // The width the column is painted at now, from the header cell.
    in property <length> current-width;
    in property <length> minimum;
    in property <ColumnCeiling> ceiling;
    in property <length> maximum;
    callback preview(length);
    callback commit(length);
    callback cancel();
    out property <bool> dragging;
    out property <bool> active: root.dragging || keys.has-focus;
    private property <bool> keyboard-focus;
    private property <length> start-pointer;
    private property <length> start-width;
    pure function clamped(width: length) -> length {
        return root.ceiling == ColumnCeiling.bounded ? clamp(width, root.minimum, max(root.minimum, root.maximum)) : max(root.minimum, width);
    }
    function widen() { root.commit(root.clamped(root.current-width + root.recipe.step)); }
    function narrow() { root.commit(root.clamped(root.current-width - root.recipe.step)); }
    width: root.recipe.width;
    background: transparent;
    accessible-role: spinbox;
    accessible-label: root.accessible-name;
    accessible-value: "" + Math.round(root.current-width / 1px);
    accessible-value-minimum: root.minimum / 1px;
    accessible-value-step: root.recipe.step / 1px;
    accessible-enabled: !root.disabled;
    accessible-action-increment => { if (!root.disabled) { root.widen(); } }
    accessible-action-decrement => { if (!root.disabled) { root.narrow(); } }
    forward-focus: keys;
    divider := Rectangle {
        x: parent.width - self.width;
        width: root.active ? root.recipe.active-thickness : root.recipe.thickness;
        height: parent.height;
        background: root.disabled ? root.recipe.ink : root.active ? root.recipe.active-ink : pointer.has-hover ? root.recipe.hover-ink : root.recipe.ink;
    }
    pointer := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.dragging = true;
                root.start-width = root.current-width;
                root.start-pointer = root.absolute-position.x + self.mouse-x;
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragging) {
                root.dragging = false;
                root.commit(root.clamped(root.start-width + root.absolute-position.x + self.mouse-x - root.start-pointer));
            }
            if (event.kind == PointerEventKind.cancel && root.dragging) {
                root.dragging = false;
                root.cancel();
            }
        }
        moved => {
            if (root.dragging) {
                // The pointer's window position is frame independent, so the
                // handle moving with its column does not feed back into the drag.
                root.preview(root.clamped(root.start-width + root.absolute-position.x + self.mouse-x - root.start-pointer));
            }
        }
    }
    keys := FocusScope {
        enabled: !root.disabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation || reason == FocusReason.programmatic;
        }
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) { root.widen(); return accept; }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) { root.narrow(); return accept; }
            if (event.text == Key.Home) { root.commit(root.clamped(root.minimum)); return accept; }
            if (event.text == Key.End && root.ceiling == ColumnCeiling.bounded) { root.commit(root.clamped(root.maximum)); return accept; }
            return reject;
        }
    }
    if keys.has-focus && root.keyboard-focus: FocusOutline {
        ring: root.recipe.focus; radius: 0px; host-width: root.width; host-height: root.height;
    }
}

export component KitDataTable inherits Rectangle {
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <int> generation;
    in property <int> active-index: -1;
    in property <string> label: "Data table";
    in property <string> empty-label: "No matching records";
    // Accessible words the application localizes. The kit joins them to the
    // column label with ", " and never builds a sentence from them.
    in property <string> sort-ascending-label: "ascending";
    in property <string> sort-descending-label: "descending";
    in property <string> unnamed-row-label: "Row";
    // The accessible word of a column's resize handle, joined to the column
    // label with ", ".
    in property <string> resize-label: "width";
    // The floor of every `fill` column. A `fixed` column is exactly its
    // basis within its own bounds.
    in property <length> minimum-column-width: 140px * root.theme.text-scale;
    callback activate(int,int);
    callback navigate(NavigationStep);
    callback sort-requested(int);
    // A clamped width the user asked for, by column token. The table paints
    // nothing from it: the host changes the column's `width` policy.
    callback resize-requested(int,length);
    public function take-focus() {if(root.interactive){keys.focus();}}
    out property <length> scroll-y: list.content-y;
    out property <length> scroll-x: list.content-x;
    private property <ButtonRecipe> row-recipe: KitThemes.table-row-recipe(root.theme, root.control-size);
    private property <SurfaceRecipe> surface: KitThemes.surface-recipe(root.theme, SurfaceLevel.flat);
    private property <ColumnHandleRecipe> handle-recipe: KitThemes.column-handle-recipe(root.theme);
    private property <length> row-height: root.row-recipe.height;
    private property <length> cell-inset: root.theme.spacing.unit * 4;
    // The ceiling of an unbounded column: a layout bound, not a width the
    // grid can reach, so the constraints never depend on the grid width.
    private property <length> unbounded: 100000px;
    // The grid is as wide as the viewport, or as the sum of the column
    // minimums when they do not fit; the header layout adds them up.
    private property <length> grid-width: max(list.visible-width, header-cells.min-width);
    // A pointer drag paints the dragged column at `preview-width` until it
    // is released; the host then receives one `resize-requested`.
    private property <bool> previewing;
    private property <int> preview-token;
    private property <length> preview-width;
    private property <bool> has-active-row: root.active-index >= 0 && root.active-index < root.rows.length;
    pure function row-name(row: TableRow) -> string { return row.cells.length > 0 ? row.cells[0] : root.unnamed-row-label; }
    pure function header-name(column: TableColumn) -> string {
        return column.label + (column.sort == DataSortDirection.ascending ? ", " + root.sort-ascending-label : column.sort == DataSortDirection.descending ? ", " + root.sort-descending-label : "");
    }
    pure function handle-name(column: TableColumn) -> string { return column.label + ", " + root.resize-label; }
    // Width policy, resolved once here for header and row cells alike. The
    // layout solver then gives both grids the same answer for the same
    // constraints and total width, which keeps them aligned.
    pure function column-floor(column: TableColumn) -> length {
        return column.width.sizing == ColumnSizing.fill ? max(root.minimum-column-width, column.width.minimum) : max(0px, column.width.minimum);
    }
    pure function column-ceiling(column: TableColumn) -> length {
        return column.width.ceiling == ColumnCeiling.bounded ? max(root.column-floor(column), column.width.maximum) : root.unbounded;
    }
    pure function column-basis(column: TableColumn) -> length { return clamp(column.width.basis, root.column-floor(column), root.column-ceiling(column)); }
    pure function previewed(column: TableColumn) -> bool { return root.previewing && root.preview-token == column.token; }
    // A fixed or previewed column pins min, max and preferred together, so
    // the solver never grows it, even when no column stretches.
    pure function cell-min(column: TableColumn) -> length {
        return root.previewed(column) ? root.preview-width : column.width.sizing == ColumnSizing.fixed ? root.column-basis(column) : root.column-floor(column);
    }
    pure function cell-max(column: TableColumn) -> length {
        return root.previewed(column) ? root.preview-width : column.width.sizing == ColumnSizing.fixed ? root.column-basis(column) : root.column-ceiling(column);
    }
    pure function cell-preferred(column: TableColumn) -> length { return root.previewed(column) ? root.preview-width : root.column-basis(column); }
    pure function cell-stretch(column: TableColumn) -> float { return !root.previewed(column) && column.width.sizing == ColumnSizing.fill ? 1 : 0; }
    changed active-index => {root.reveal-active();}
    public function reveal-active() {
        if (root.active-index >= 0) {
            if (root.active-index * root.row-height + list.content-y < 0px) {list.content-y = -root.active-index * root.row-height;}
            if ((root.active-index + 1) * root.row-height + list.content-y > list.visible-height) {list.content-y = list.visible-height - (root.active-index + 1) * root.row-height;}
        }
    }
    min-width: 0px; preferred-width: 700px;
    min-height: 160px; preferred-height: 320px;
    background: root.surface.fill; border-width: root.surface.border-width; border-color: root.surface.border; border-radius: root.surface.radius;
    drop-shadow-offset-y: root.surface.shadow.offset-y; drop-shadow-blur: root.surface.shadow.blur; drop-shadow-color: root.surface.shadow.color;
    // Slint 1.18.1 has no row, cell or column-header roles, and delegated
    // accessible focus addresses mounted descendants, which virtualized rows
    // do not number stably. Like KitCalendar, the composite keeps focus on its
    // key scope and names its active row here; selection stays on each row's
    // `accessible-item-selected`, so focus, active row and selection are
    // three separate facts in the accessible tree.
    clip: true; accessible-role: table; forward-focus: keys;
    accessible-label: root.label + (root.has-active-row ? ": " + root.row-name(root.rows[root.active-index]) : "");
    keys := DataKeyboard {
        disabled: !root.interactive;
        navigate(step) => {root.navigate(step);}
        activate => {if (root.active-index >= 0 && root.active-index < root.rows.length && !root.rows[root.active-index].disabled) {root.activate(root.rows[root.active-index].token,root.generation);}}
    }
    header := Rectangle {
        y: 0px;
        width: root.width; height: root.row-height; background: root.theme.canvas; clip: true;
        header-cells := HorizontalLayout {
            x: list.content-x; width: root.grid-width; height: root.row-height; spacing: 0px; padding: 0px;
            // Header cells share the flat, square row recipe so a fill never
            // draws its own corners inside the table's clip. A column that
            // cannot sort is static text, not a disabled control: it keeps
            // the header tone instead of the disabled fill and the accessible
            // tree reports it as text, never as a button. Slint fixes
            // `accessible-role` at compile time, so each kind is its own
            // element. Keyboard, pointer and the accessible default action of
            // a sortable header all go through one pressable, so one
            // `disabled` rule decides all three.
            for column in root.columns: header-cell := Rectangle {
                min-width: root.cell-min(column); max-width: root.cell-max(column); preferred-width: root.cell-preferred(column);
                horizontal-stretch: root.cell-stretch(column);
                height: root.row-height; clip: true;
                if column.sortable: KitPressable {
                    theme: root.theme; control-width: ControlWidth.fill;
                    width: parent.width; min-height: root.row-height; preferred-height: root.row-height;
                    recipe: root.row-recipe; disabled: !root.interactive;
                    background: self.pressed ? self.recipe.pressed-fill : self.hovered ? self.recipe.hover-fill : self.recipe.fill;
                    accessible-name: root.header-name(column);
                    activated => {root.sort-requested(column.token);}
                    TableHeaderContent {theme: root.theme; control-size: root.control-size; column: column; inset: root.cell-inset;}
                }
                if !column.sortable: Rectangle {
                    width: parent.width; height: parent.height; background: root.row-recipe.fill;
                    accessible-role: text; accessible-label: root.header-name(column);
                    TableHeaderContent {theme: root.theme; control-size: root.control-size; column: column; inset: root.cell-inset;}
                }
                // The handle sits inside its own cell, after the header, so it
                // wins the pointer over the sortable header beneath it. A
                // bounded ceiling is an accessible maximum; an unbounded one
                // reports none rather than a number the column can exceed.
                if column.width.resizable && column.width.ceiling == ColumnCeiling.bounded: ColumnResizeHandle {
                    x: parent.width - self.width; height: parent.height;
                    theme: root.theme; recipe: root.handle-recipe; disabled: !root.interactive;
                    accessible-name: root.handle-name(column);
                    accessible-value-maximum: root.column-ceiling(column) / 1px;
                    current-width: parent.width; minimum: root.column-floor(column); ceiling: ColumnCeiling.bounded; maximum: root.column-ceiling(column);
                    preview(width) => { root.preview-token = column.token; root.preview-width = width; root.previewing = true; }
                    commit(width) => { root.previewing = false; root.resize-requested(column.token, width); }
                    cancel => { root.previewing = false; }
                }
                if column.width.resizable && column.width.ceiling == ColumnCeiling.unbounded: ColumnResizeHandle {
                    x: parent.width - self.width; height: parent.height;
                    theme: root.theme; recipe: root.handle-recipe; disabled: !root.interactive;
                    accessible-name: root.handle-name(column);
                    current-width: parent.width; minimum: root.column-floor(column); ceiling: ColumnCeiling.unbounded; maximum: root.unbounded;
                    preview(width) => { root.preview-token = column.token; root.preview-width = width; root.previewing = true; }
                    commit(width) => { root.previewing = false; root.resize-requested(column.token, width); }
                    cancel => { root.previewing = false; }
                }
            }
        }
    }
    list := ListView {
        theme: root.theme;
        y:root.row-height; height:max(0px,root.height - root.row-height);
        content-width: root.grid-width;
        for row[index] in root.rows: DataAction {
            token:row.token;generation:root.generation;theme:root.theme;
            width:root.grid-width;height:root.row-height;min-height:root.row-height;preferred-height:root.row-height;
            intent:ButtonIntent.quiet;disabled:!root.interactive || row.disabled;
            accessible-name:root.row-name(row);
            accessible-role:AccessibleRole.list-item;accessible-item-index:index;accessible-item-count:root.rows.length;accessible-item-selectable:true;accessible-item-selected:row.selected;
            background:self.disabled ? root.theme.disabled-fill : row.selected ? root.theme.selection : self.pressed ? root.row-recipe.pressed-fill : self.hovered ? root.row-recipe.hover-fill : Math.mod(index,2) == 1 ? root.theme.canvas : root.theme.surface;
            focus-indicated:keys.has-focus && index == root.active-index;focus-ring:KitThemes.inset-focus(root.theme);
            recipe:root.row-recipe;
            requested(token,generation) => {keys.focus();root.activate(token,generation);}
            HorizontalLayout {spacing:0px; padding: 0px;
                // Row cells take the constraints of their column, so the
                // solver lays them out exactly as the header above.
                for cell[column-index] in row.cells: row-cell := Rectangle {
                    min-width: root.cell-min(root.columns[column-index]); max-width: root.cell-max(root.columns[column-index]); preferred-width: root.cell-preferred(root.columns[column-index]);
                    horizontal-stretch: root.cell-stretch(root.columns[column-index]);
                    clip: true;
                    Text {x:root.cell-inset;width:max(0px,parent.width - 2 * root.cell-inset);text:cell;color:row.disabled ? root.theme.disabled-text : row.selected ? root.theme.on-selection : root.theme.text-primary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);overflow:elide;vertical-alignment:center;horizontal-alignment:root.columns[column-index].alignment == DataAlignment.trailing ? right : root.columns[column-index].alignment == DataAlignment.center ? center : left;}
                }
            }
        }
    }
    if root.rows.length == 0: Text {y:root.row-height;text:root.empty-label;color:root.theme.text-secondary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);horizontal-alignment:center;vertical-alignment:center;}
}

export component KitContentList inherits Rectangle {
    in property <KitTheme> theme:KitThemeContext.current;
    in property <[ContentItem]> items;
    in property <int> generation;
    in property <int> active-index:-1;
    in property <string> label:"Articles";
    in property <string> empty-label:"No articles found";
    callback activate(int,int);callback navigate(NavigationStep);
    public function take-focus(){keys.focus();}
    out property <length> scroll-y:list.content-y;
    private property <length> row-height:max(132px,116px * root.theme.text-scale);
    changed active-index => {
        if (root.active-index >= 0) {
            if (root.active-index * root.row-height + list.content-y < 0px) {list.content-y = -root.active-index * root.row-height;}
            if ((root.active-index + 1) * root.row-height + list.content-y > list.visible-height) {list.content-y = list.visible-height - (root.active-index + 1) * root.row-height;}
        }
    }
    min-width:0px;preferred-width:700px;min-height:160px;preferred-height:420px;
    accessible-role:AccessibleRole.list;accessible-label:root.label;forward-focus:keys;
    keys := DataKeyboard {navigate(step)=>{root.navigate(step);}activate=>{if(root.active-index>=0&&root.active-index<root.items.length&&!root.items[root.active-index].disabled){root.activate(root.items[root.active-index].token,root.generation);}}}
    list := ListView {
        theme: root.theme;
        vertical-scrollbar-policy: ScrollBarPolicy.always-on;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        y: 0px;
        content-width:self.visible-width;
        for item[index] in root.items: DataAction {
            width:list.visible-width;height:root.row-height;min-height:root.row-height;preferred-height:root.row-height;
            theme:root.theme;token:item.token;generation:root.generation;disabled:item.disabled;intent:ButtonIntent.quiet;
            accessible-name:item.title + ", " + item.metadata;accessible-role:AccessibleRole.list-item;
            accessible-item-index:index;accessible-item-count:root.items.length;accessible-item-selectable:true;accessible-item-selected:item.selected;
            focus-indicated:keys.has-focus && root.active-index==index;focus-ring:KitThemes.inset-focus(root.theme);
            background:item.disabled ? root.theme.disabled-fill : item.selected ? root.theme.selection : self.pressed ? self.recipe.pressed-fill : self.hovered ? self.recipe.hover-fill : root.theme.surface;
            requested(token,generation)=>{keys.focus();root.activate(token,generation);}
            HorizontalLayout {spacing:root.theme.spacing.unit * 4; alignment: start;
                Rectangle {width:72px; horizontal-stretch:0;
                    Rectangle {y:(parent.height - self.height) / 2;width:72px;height:72px;clip:true;border-radius:root.theme.shape.radius-container;background:root.theme.accent-subtle;
                    if item.thumbnail.width > 0 && item.thumbnail.height > 0: Image {width:parent.width;height:parent.height;source:item.thumbnail;image-fit:cover;}
                    if item.thumbnail.width <= 0 || item.thumbnail.height <= 0: KitIcon {theme: root.theme; x:(parent.width - self.width) / 2;y:(parent.height - self.height) / 2;width:24px;height:24px;glyph:root.theme.icons.article;ink:root.theme.accent;}
                }
                }
                VerticalLayout {spacing:root.theme.spacing.unit;alignment:center;
                    Text {text:item.title;color:item.disabled ? root.theme.disabled-text : item.selected ? root.theme.on-selection : root.theme.text-primary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.body);font-weight:root.theme.typography.weight-semibold;overflow:elide;}
                    Text {text:item.excerpt;color:item.disabled ? root.theme.disabled-text : item.selected ? root.theme.on-selection : root.theme.text-secondary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);wrap:word-wrap;max-height:2 * root.theme.typography.line-height-control * root.theme.text-scale;overflow:elide;}
                    Text {text:item.metadata;color:item.disabled ? root.theme.disabled-text : item.selected ? root.theme.on-selection : root.theme.text-secondary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);overflow:elide;}
                    Text {text:item.link-label;color:item.disabled ? root.theme.disabled-text : item.selected ? root.theme.on-selection : root.theme.accent;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);overflow:elide;}
                }
            }
        }
    }
    if root.items.length==0: Text {text:root.empty-label;color:root.theme.text-secondary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);horizontal-alignment:center;vertical-alignment:center;}
}

export component KitVirtualTextView inherits Rectangle {
    in property <KitTheme> theme:KitThemeContext.current;
    in property <[TextLine]> lines;
    in property <int> generation;
    in property <int> active-index:-1;
    in property <TextViewAccess> access:TextViewAccess.read-only;
    in-out property <string> line-draft;
    in property <string> error;
    in property <string> label:"Text document";
    callback navigate(NavigationStep);callback select-line(int,int);callback commit-line(int,int,string);callback copy-requested(int,int);
    public function take-focus(){keys.focus();}
    out property <length> scroll-y:list.content-y;
    private property <length> line-height:max(32px,24px * root.theme.text-scale + 8px);
    private property <length> edit-height:root.access==TextViewAccess.edit-line ? editor-panel.preferred-height : 0px;
    private property <bool> footer-stacked: root.width < KitMetrics.font-size(root.theme, TypographyRole.control) * 32;
    changed active-index=>{if(root.active-index>=0){if(root.active-index*root.line-height+list.content-y<0px){list.content-y=-root.active-index*root.line-height;}if((root.active-index+1)*root.line-height+list.content-y>list.visible-height){list.content-y=list.visible-height - (root.active-index+1)*root.line-height;}}}
    min-width:0px;preferred-width:700px;min-height:max(root.theme.spacing.unit * 45,root.edit-height + root.line-height);preferred-height:360px;background:root.theme.canvas;
    accessible-role:AccessibleRole.list;accessible-label:root.label;forward-focus:keys;
    keys := DataKeyboard {navigate(step)=>{root.navigate(step);}activate=>{if(root.active-index>=0&&root.active-index<root.lines.length){root.select-line(root.lines[root.active-index].token,root.generation);}}}
    list := ListView {
        theme: root.theme;
        y: 0px;
        height:max(0px,root.height - root.edit-height);content-width:self.visible-width;
        for line[index] in root.lines: DataAction {
            width:list.visible-width;height:root.line-height;min-height:root.line-height;preferred-height:root.line-height;token:line.token;generation:root.generation;theme:root.theme;intent:ButtonIntent.quiet;
            recipe:KitThemes.table-row-recipe(root.theme,ControlSize.medium);
            background:line.selected?root.theme.accent-subtle:self.pressed?self.recipe.pressed-fill:self.hovered?self.recipe.hover-fill:root.theme.surface;
            focus-indicated:keys.has-focus && index == root.active-index;focus-ring:KitThemes.inset-focus(root.theme);
            accessible-name:line.number + ": " + line.text;
            accessible-role:AccessibleRole.list-item;accessible-item-index:index;accessible-item-count:root.lines.length;accessible-item-selectable:true;accessible-item-selected:line.selected;
            requested(token,generation)=>{keys.focus();root.select-line(token,generation);}
            HorizontalLayout {spacing:root.theme.spacing.unit * 3;
                Text {width:64px;text:line.number;color:line.selected?root.theme.accent:root.theme.text-secondary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);horizontal-alignment:right;vertical-alignment:center;}
                Text {text:line.text;color:root.theme.text-primary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);overflow:elide;vertical-alignment:center;}
            }
        }
    }
    editor-panel := Rectangle {
        visible: root.access==TextViewAccess.edit-line;
        x:0px;y:root.height - root.edit-height;width:root.width;height:root.edit-height;
        preferred-height: editor-content.preferred-height;
        editor-content := VerticalLayout {
            x:0px;y:0px;width:root.width;height:self.preferred-height;vertical-stretch:0;spacing:root.theme.spacing.unit;
            FlexboxLayout {
                width: root.width;
                flex-direction: root.footer-stacked ? column : row;
                flex-wrap: no-wrap; cross-axis-alignment: stretch;
                spacing:KitMetrics.inline-gap(root.theme);
                // Resolve the editor width before measuring its wrapped label
                // and help. Its height must not feed back into flexbox width.
                line-editor:=KitTextField {width:root.footer-stacked ? root.width : max(0px, root.width - save-line.preferred-width - copy-line.preferred-width - 2 * KitMetrics.inline-gap(root.theme));theme:root.theme;text<=>root.line-draft;accessible-name:"Edit selected line";placeholder:"Select a line to edit";access:root.active-index>=0?FieldAccess.editable:FieldAccess.disabled;commit-requested(text)=>{if(root.active-index>=0){root.commit-line(root.lines[root.active-index].token,root.generation,text);}}}
                HorizontalLayout {
                    width:save-line.preferred-width + copy-line.preferred-width + KitMetrics.inline-gap(root.theme);
                    spacing:KitMetrics.inline-gap(root.theme);alignment:start;vertical-stretch:0;
                    save-line := KitButton {theme:root.theme;text:"Save line";disabled:root.active-index<0;activated=>{root.commit-line(root.lines[root.active-index].token,root.generation,root.line-draft);}}
                    copy-line := KitButton {theme:root.theme;text:"Copy";disabled:root.active-index<0;activated=>{line-editor.take-focus();line-editor.select-all();line-editor.copy-selection();root.copy-requested(root.lines[root.active-index].token,root.generation);}}
                }
            }
            if root.error!="": Text {text:root.error;color:root.theme.danger;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);wrap:word-wrap;}
        }
    }
}
