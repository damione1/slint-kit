import { KitKeyResult } from "keyboard.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { ListView } from "scroll.slint";
import { KitTheme, KitThemes, KitMetrics, ControlSize, ButtonIntent, ButtonRecipe, ControlWidth, KitThemeContext, TypographyRole, SurfaceLevel, SurfaceRecipe, ColumnHandleRecipe, KitFocusRing } from "theme.slint";
import { KitPressable, KitButton } from "button.slint";
import { KitIcon, KitGlyphs, TurningIcon } from "icons.slint";
import { KitTextField } from "input.slint";
import { FieldCommit, KitFieldService } from "field-service.slint";
import { FocusOutline } from "focus.slint";
import { NavigationStep, FieldAccess } from "contracts.slint";
import { CheckState, TextPurpose, HtmlInputKind, Ownership } from "shared-contracts.slint";
import { KitInputConstraints } from "validation.slint";
import { Tone, KitBadge } from "display.slint";
import { CheckMark } from "choice.slint";
export enum DataSortDirection { unsorted, ascending, descending }
export enum DataAlignment { leading, center, trailing }
export enum TextViewAccess { read-only, edit-line }
export enum TableHeaderFocus { individual, roving }
enum TableCursorRegion { body, header }
// How a data-table column takes its width. `fill` (the default) starts at
// its basis, never below the table's `minimum-column-width` or its own
// minimum, and shares the space left over with the other fill columns.
// `fixed` is exactly its basis, clamped to its own bounds, and never grows.
export enum ColumnSizing { fill, fixed }
// Whether a column has a ceiling. Slint struct fields default to zero, so an
// absent ceiling is named here instead of being read from a zero maximum.
export enum ColumnCeiling { unbounded, bounded }
// The width policy of one column, carried by the column so it follows the
// column's stable token through reordering. Lengths are logical pixels and
// are not scaled by the theme; the table's own default minimum is. A
// resizable column shows a handle at its trailing edge; pointer drags and
// keyboard steps are clamped to [minimum, maximum] and reported through
// `resize-requested(token, width)`, which the application applies by
// changing this policy (usually to `fixed` at the reported basis).
export struct ColumnWidth { sizing: ColumnSizing, basis: length, minimum: length, ceiling: ColumnCeiling, maximum: length, resizable: bool }
export struct TableColumn { token: int, label: string, sortable: bool, sort: DataSortDirection, alignment: DataAlignment, width: ColumnWidth }
// What one typed table cell shows. The set is closed and painted by the
// kit inside the virtualized row, because Slint 1.18.1 rejects `@children`
// and slot placeholders inside a repeated element and keeps dynamic
// components experimental. The Rust `CellContent` enum is the sum type;
// `TableCell` is its flat projection, written once by `From`, so only the
// fields of `kind` are meaningful: `text` for every kind (it is also the
// accessible label of a badge or check mark), `tone` for a badge, `check`
// for a check mark, `access` and `spec` for a field. A `field` is a text
// value the user may edit in place: `text` is its accepted value in the
// canonical draft form of its codec, `spec` the key of the installed
// `FieldSpec` that parses, validates and displays it ("" for plain text)
// and `access` whether Enter opens the editor.
export enum TableCellKind { text, badge, check, field }
export struct TableCell { kind: TableCellKind, text: string, tone: Tone, check: CheckState, access: FieldAccess, spec: string, constrained: bool, constraints: KitInputConstraints }
// Where the cell cursor moves inside the active row.
enum ColumnStep { previous, next }
// A row is either plain strings (`cells`) or typed cells (`content`), one
// per column in column order. When a row carries both, `content` is
// rendered and `cells` is ignored; the row's accessible name is its first
// cell's text in either form.
export struct TableRow { token: int, cells: [string], content: [TableCell], selected: bool, disabled: bool }
export struct ContentItem { token: int, title: string, excerpt: string, metadata: string, link-label: string, thumbnail: image, selected: bool, disabled: bool }
export struct TextLine { token: int, number: int, text: string, selected: bool }

// The key scope of a data composite. Return and Space are reported apart:
// a table confirms the active cell with Return (edit or activate) while
// Space always activates the row; lists bind both to activation.
component DataKeyboard inherits FocusScope {
    in property <bool> disabled;
    // Left/Right move a cell cursor inside the active row; off, they are
    // rejected like any unknown key.
    in property <bool> column-navigation;
    callback navigate(NavigationStep);
    callback navigate-column(ColumnStep);
    callback activate();
    callback confirm();
    callback edit-requested();
    callback key-event(KeyEvent) -> KitKeyResult;
    enabled: !root.disabled;
    focus-on-click: false;
    key-pressed(event) => {
        if (root.key-event(event) == KitKeyResult.accept) { return accept; }
        if (event.text == Key.F2) { root.edit-requested(); return accept; }
        if (event.text == Key.DownArrow) {root.navigate(NavigationStep.next);return accept;}
        if (event.text == Key.UpArrow) {root.navigate(NavigationStep.previous);return accept;}
        if (event.text == Key.Home) {root.navigate(NavigationStep.first);return accept;}
        if (event.text == Key.End) {root.navigate(NavigationStep.last);return accept;}
        if (event.text == Key.PageDown) {root.navigate(NavigationStep.page-next);return accept;}
        if (event.text == Key.PageUp) {root.navigate(NavigationStep.page-previous);return accept;}
        if (root.column-navigation && event.text == Key.LeftArrow) {root.navigate-column(ColumnStep.previous);return accept;}
        if (root.column-navigation && event.text == Key.RightArrow) {root.navigate-column(ColumnStep.next);return accept;}
        if (event.text == Key.Return) {root.confirm();return accept;}
        if (event.text == Key.Space) {root.activate();return accept;}
        return reject;
    }
    @children
}
component DataAction inherits KitPressable {
    in property <int> token;
    in property <int> generation;
    callback requested(int,int);
    callback focus-requested();
    private property <int> armed-token;
    private property <int> armed-generation;
    activation-started => {root.armed-token = root.token;root.armed-generation = root.generation;root.focus-requested();}
    changed token => {root.cancel-press();}
    changed generation => {root.cancel-press();}
    activated => {root.requested(root.armed-token,root.armed-generation);}
    control-width: ControlWidth.fill;
    tab-stop: false;
    focus-on-pointer: false;
    @children
}

// The label and sort indicator of one header cell, shared by the sortable
// pressable and the static text header.
component TableHeaderContent inherits HorizontalLayout {
    in property <KitTheme> theme;
    in property <ControlSize> control-size;
    in property <TableColumn> column;
    in property <length> inset;
    padding-left: root.inset; padding-right: root.inset; spacing: root.theme.spacing.unit * 1.5;
    alignment: root.column.alignment == DataAlignment.trailing ? end : root.column.alignment == DataAlignment.center ? center : start;
    Text {accessible-role: none; horizontal-stretch: 0; max-width: self.preferred-width; text:root.column.label;color:root.theme.text-primary;font-family: root.theme.typography.family; font-size:KitMetrics.font-size(root.theme, TypographyRole.control);font-weight:root.theme.typography.weight-medium;overflow:elide;vertical-alignment:center;}
    if root.column.sort != DataSortDirection.unsorted: Rectangle {
        width: KitMetrics.icon-size(root.theme, root.control-size); height: parent.height;
        TurningIcon {theme: root.theme; control-size: root.control-size; y: (parent.height - self.height) / 2; turned: root.column.sort == DataSortDirection.descending; rest-glyph: root.theme.icons.chevron-up; turned-glyph: root.theme.icons.chevron-down;ink:root.theme.text-secondary;}
    }
}

// The resize handle of one column: the pointer target at the trailing edge
// of its header cell, a tab stop that steps the width with the arrow keys,
// and an accessible spinbox whose value is the width in logical pixels. It
// never stores a width: a drag previews through `preview`, then `commit`
// hands the clamped width to the table, which reports it to the host.
component ColumnResizeHandle inherits Rectangle {
    in property <KitTheme> theme;
    in property <ColumnHandleRecipe> recipe;
    in property <string> accessible-name;
    in property <bool> disabled;
    in property <bool> tab-stop: true;
    // The width the column is painted at now, from the header cell.
    in property <length> current-width;
    in property <length> minimum;
    in property <ColumnCeiling> ceiling;
    in property <length> maximum;
    callback preview(length);
    callback commit(length);
    callback cancel();
    callback autosize();
    out property <bool> dragging;
    out property <bool> active: root.dragging || keys.has-focus;
    private property <bool> keyboard-focus;
    private property <length> start-pointer;
    private property <length> start-width;
    pure function clamped(width: length) -> length {
        return root.ceiling == ColumnCeiling.bounded ? clamp(width, root.minimum, max(root.minimum, root.maximum)) : max(root.minimum, width);
    }
    function widen() { root.commit(root.clamped(root.current-width + root.recipe.step)); }
    function narrow() { root.commit(root.clamped(root.current-width - root.recipe.step)); }
    width: root.recipe.width;
    background: transparent;
    accessible-role: spinbox;
    accessible-label: root.accessible-name;
    accessible-value: "" + Math.round(root.current-width / 1px);
    accessible-value-minimum: root.minimum / 1px;
    accessible-value-step: root.recipe.step / 1px;
    accessible-enabled: !root.disabled;
    accessible-action-increment => { if (!root.disabled) { root.widen(); } }
    accessible-action-decrement => { if (!root.disabled) { root.narrow(); } }
    forward-focus: keys;
    divider := Rectangle {
        x: parent.width - self.width;
        width: root.active ? root.recipe.active-thickness : root.recipe.thickness;
        height: parent.height;
        background: root.disabled ? root.recipe.ink : root.active ? root.recipe.active-ink : pointer.has-hover ? root.recipe.hover-ink : root.recipe.ink;
    }
    pointer := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                keys.focus();
                root.dragging = true;
                root.start-width = root.current-width;
                root.start-pointer = root.absolute-position.x + self.mouse-x;
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragging) {
                root.dragging = false;
                if (root.clamped(root.start-width + root.absolute-position.x + self.mouse-x - root.start-pointer) != root.start-width) {
                    root.commit(root.clamped(root.start-width + root.absolute-position.x + self.mouse-x - root.start-pointer));
                } else { root.cancel(); }
            }
            if ((event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.down && event.button == PointerEventButton.right)) && root.dragging) {
                root.dragging = false;
                root.cancel();
            }
        }
        double-clicked => { if (!root.disabled) { root.autosize(); } }
        moved => {
            if (root.dragging) {
                // The pointer's window position is frame independent, so the
                // handle moving with its column does not feed back into the drag.
                root.preview(root.clamped(root.start-width + root.absolute-position.x + self.mouse-x - root.start-pointer));
            }
        }
    }
    keys := FocusScope {
        enabled: !root.disabled;
        focus-on-tab-navigation: root.tab-stop;
        focus-on-click: false;
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation || reason == FocusReason.programmatic;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.dragging) { root.dragging = false; root.cancel(); return accept; }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) { root.widen(); return accept; }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) { root.narrow(); return accept; }
            if (event.text == Key.Home) { root.commit(root.clamped(root.minimum)); return accept; }
            if (event.text == Key.End && root.ceiling == ColumnCeiling.bounded) { root.commit(root.clamped(root.maximum)); return accept; }
            return reject;
        }
    }
    if keys.has-focus && root.keyboard-focus: FocusOutline {
        ring: root.recipe.focus; radius: 0px; host-width: root.width; host-height: root.height;
    }
}

// One row cell, painted by its kind inside the column's constraints. Slint
// fixes element kinds at compile time, so each kind is its own element; the
// text of every kind is the cell's accessible label, so a badge or a check
// mark reads as the words the host chose. A disabled row dims its text and
// its check mark; a badge keeps its tone, which is data, not a state. A
// field at rest paints its codec's display projection like a text cell, a
// disabled field in the disabled ink; while it is edited it hosts the one
// `KitTextField` of the table, whose native editor owns caret, selection,
// undo and IME. The editor reports its outcomes upward and never decides
// the editing session itself.
component TableCellView inherits Rectangle {
    in property <KitTheme> theme;
    in property <ControlSize> control-size;
    in property <TableCell> cell;
    in property <DataAlignment> alignment;
    in property <length> inset;
    in property <bool> row-selected;
    in property <bool> row-disabled;
    // The cell cursor of the table rests here.
    in property <bool> focus-indicated;
    in property <KitFocusRing> focus-ring;
    // The editing session of the table is on this cell.
    in property <bool> editing;
    in property <string> editor-name;
    in property <string> rejection;
    in property <int> commit-request;
    in property <bool> pointed;
    callback point-requested();
    callback reveal-requested(length, length);
    changed pointed => { if (root.pointed) { root.point-requested(); } }
    private property <length> reveal-x: root.absolute-position.x;
    changed reveal-x => { if (root.focus-indicated || root.editing) { root.reveal-requested(root.absolute-position.x, root.width); } }
    changed width => { if (root.focus-indicated || root.editing) { root.reveal-requested(root.absolute-position.x, root.width); } }
    changed focus-indicated => { if (root.focus-indicated) { root.reveal-requested(root.absolute-position.x, root.width); } }
    changed editing => { if (root.editing) { root.reveal-requested(root.absolute-position.x, root.width); } }
    // The draft of the session, kept by the table so a cell that the
    // viewport recreates shows the same text.
    in-out property <string> draft;
    callback committed(FieldCommit, bool);
    callback editor-focus-changed(bool);
    callback cancel-requested();
    callback step-requested(ColumnStep);
    callback blurred();
    callback error-changed(string);
    pure function aligned-x(extent: length) -> length {
        return root.alignment == DataAlignment.trailing ? root.width - root.inset - extent : root.alignment == DataAlignment.center ? (root.width - extent) / 2 : root.inset;
    }
    pure function text-alignment() -> TextHorizontalAlignment {
        return root.alignment == DataAlignment.trailing ? TextHorizontalAlignment.right : root.alignment == DataAlignment.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
    clip: true;
    if root.cell.kind == TableCellKind.text: Text {
        x: root.inset; width: max(0px, parent.width - 2 * root.inset);
        text: root.cell.text;
        color: root.row-disabled ? root.theme.disabled-text : root.row-selected ? root.theme.on-selection : root.theme.text-primary;
        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
        overflow: elide; vertical-alignment: center;
        horizontal-alignment: root.text-alignment();
    }
    if root.cell.kind == TableCellKind.field && !root.editing: Text {
        x: root.inset; width: max(0px, parent.width - 2 * root.inset);
        text: KitFieldService.ready ? KitFieldService.display(root.cell.spec, root.cell.text) : root.cell.text;
        color: root.row-disabled || root.cell.access == FieldAccess.disabled ? root.theme.disabled-text : root.row-selected ? root.theme.on-selection : root.theme.text-primary;
        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
        overflow: elide; vertical-alignment: center;
        horizontal-alignment: root.text-alignment();
    }
    if root.cell.kind == TableCellKind.field && root.editing: FocusScope {
        // Not a focus target itself: it only receives the keys the native
        // editor leaves, after the IME and the editor had them.
        x: 0px; width: parent.width; height: parent.height;
        focus-on-click: false; focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel-requested(); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                root.error-changed("");
                editor.commit();
                root.step-requested(event.modifiers.shift || event.text == Key.Backtab ? ColumnStep.previous : ColumnStep.next);
                return accept;
            }
            return reject;
        }
        editor := KitTextField {
            x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: self.preferred-height;
            theme: root.theme; control-size: root.control-size;
            accessible-name: root.editor-name;
            text <=> root.draft;
            // The table owns acceptance until its host verdict succeeds.
            ownership: Ownership.controlled;
            spec-key: root.cell.spec;
            input-type: root.cell.constrained && root.cell.constraints.kind == HtmlInputKind.number ? InputType.decimal : InputType.text;
            input-kind: root.cell.constrained ? root.cell.constraints.kind : HtmlInputKind.text;
            purpose: root.cell.constrained && root.cell.constraints.kind == HtmlInputKind.email ? TextPurpose.email : root.cell.constrained && root.cell.constraints.kind == HtmlInputKind.url ? TextPurpose.url : TextPurpose.plain;
            required: root.cell.constrained && root.cell.constraints.required;
            min-length: root.cell.constrained ? root.cell.constraints.min-length : -1;
            max-length: root.cell.constrained ? root.cell.constraints.max-length : -1;
            min: root.cell.constrained ? root.cell.constraints.min : "";
            max: root.cell.constrained ? root.cell.constraints.max : "";
            step: root.cell.constrained ? root.cell.constraints.step : "";
            default-value: root.cell.constrained ? root.cell.constraints.default-value : "";
            pattern: root.cell.constrained ? root.cell.constraints.pattern : "";
            pattern-enabled: root.cell.constrained && root.cell.constraints.pattern-enabled;
            multiple: root.cell.constrained && root.cell.constraints.multiple;
            number-format: root.cell.constraints.number-format;
            validation-twelve-hour: root.cell.constraints.twelve-hour;
            custom-validity: root.rejection != "" ? root.rejection : root.cell.constrained ? root.cell.constraints.custom-error : "";
            key-pressed(event) => {
                // A prior host rejection is a result, not a permanent rule.
                // Recheck the unchanged draft when the host allows a retry.
                if (event.text == Key.Return) { root.error-changed(""); }
                return KitKeyResult.reject;
            }
            text-alignment: root.text-alignment();
            // The row has no room under the editor: the host reads the
            // error from the table instead.
            show-validation-message: false;
            init => { self.take-focus(); self.select-all(); }
            private property <int> request: root.commit-request;
            changed request => { if (root.editing) { root.error-changed(""); self.commit(); } }
            committed(commit) => { root.committed(commit, self.has-focus); }
            edited(text) => { root.error-changed(""); }
            invalid => { root.error-changed(self.field-state.error != "" ? self.field-state.error : self.validation-message); }
            focus-observed(focused) => { root.editor-focus-changed(focused); if (!focused) { root.blurred(); } }
        }
    }
    if root.focus-indicated: FocusOutline {
        ring: root.focus-ring; radius: 0px; host-width: root.width; host-height: root.height;
    }
    if root.cell.kind == TableCellKind.badge: KitBadge {
        theme: root.theme;
        x: root.aligned-x(self.width); y: (parent.height - self.height) / 2;
        text: root.cell.text; tone: root.cell.tone;
    }
    if root.cell.kind == TableCellKind.check: CheckMark {
        theme: root.theme; control-size: root.control-size;
        x: root.aligned-x(self.width); y: (parent.height - self.height) / 2;
        state: root.cell.check;
        access: root.row-disabled ? FieldAccess.disabled : FieldAccess.read-only;
        accessible-role: text; accessible-label: root.cell.text;
    }
}

export component KitDataTable inherits Rectangle {
    in property <bool> interactive: true;
    in property <TableHeaderFocus> header-focus: TableHeaderFocus.individual;
    in property <string> header-label: "Column headers";
    private property <TableCursorRegion> cursor-region: TableCursorRegion.body;
    private property <int> keyboard-resize-request;
    private property <length> keyboard-resize-delta;
    private property <int> header-column-count: root.columns.length;
    changed header-column-count => {
        if (root.cursor-region == TableCursorRegion.header) {
            if (root.header-column-count == 0) { root.cursor-region = TableCursorRegion.body; }
            else { root.active-column = clamp(root.active-column, 0, root.header-column-count - 1); }
        }
    }
    changed header-focus => { root.cursor-region = TableCursorRegion.body; }
    public function sort-active-column() { if (root.interactive && root.has-active-column() && root.columns[root.active-column].sortable) { root.sort-requested(root.columns[root.active-column].token); } }
    public function resize-active-column(delta: length) { if (root.interactive && root.has-active-column() && root.columns[root.active-column].width.resizable) { root.keyboard-resize-delta = delta; root.keyboard-resize-request += 1; } }
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <int> generation;
    in property <int> active-index: -1;
    in property <string> label: "Data table";
    in property <string> empty-label: "No matching records";
    // Accessible words the application localizes. The kit joins them to the
    // column label with ", " and never builds a sentence from them.
    in property <string> sort-ascending-label: "ascending";
    in property <string> sort-descending-label: "descending";
    in property <string> unnamed-row-label: "Row";
    // The accessible word of a column's resize handle, joined to the column
    // label with ", ".
    in property <string> resize-label: "width";
    in property <string> editable-label: "editable";
    in property <string> read-only-label: "read only";
    // The floor of every `fill` column. A `fixed` column is exactly its
    // basis within its own bounds.
    in property <length> minimum-column-width: 140px * root.theme.text-scale;
    // The cell cursor inside the active row: -1 is the whole row, otherwise
    // a column position. Left/Right move it; the table owns it because it
    // is a view cursor, not application identity.
    in-out property <int> active-column: -1;
    callback cursor-requested(int, int);
    callback key-event(KeyEvent) -> KitKeyResult;
    callback activate(int,int);
    callback navigate(NavigationStep);
    callback sort-requested(int);
    // A clamped width the user asked for, by column token. The table paints
    // nothing from it: the host changes the column's `width` policy.
    callback resize-requested(int,length);
    callback autosize-requested(int);
    // A committed cell edit: row token, column token and the generation
    // armed when editing began, then the field commit to run through the
    // column's `FieldSpec::accept`. The host fences it with the generation
    // and republishes the row; the table paints nothing from it.
    callback cell-committed(int,int,int,FieldCommit);
    callback validate-edit(int,int,int,FieldCommit) -> string;
    validate-edit(row, column, generation, commit) => { return ""; }
    public function take-focus() {if(root.interactive){keys.focus();}}
    public function edit-active() { if (!root.edit-open && KitFieldService.ready && root.active-cell-editable()) { root.begin-edit(); } }
    public function commit-edit() { if (root.edit-open) { root.edit-commit-request += 1; } }
    public function cancel-edit() { if (root.edit-open) { root.end-edit(root.edit-focused); } }
    private property <int> edit-commit-request;
    out property <length> scroll-y: list.content-y;
    out property <length> scroll-x: list.content-x;
    // Whether a cell editor is open, and the error of its last rejected
    // commit ("" while the draft is acceptable or untried). The row has no
    // room for the message, so the host shows it where it fits.
    out property <bool> editing: root.edit-open;
    out property <string> edit-error;
    // The editing session: the identity armed when it began, never the
    // positions, so a commit names the cell the user opened even after the
    // viewport moved. A new generation ends it: the projection changed and
    // the kit cannot know what the row now means.
    private property <bool> edit-open;
    private property <bool> edit-focused;
    private property <int> edit-row-token;
    private property <int> edit-column-token;
    private property <int> edit-generation;
    private property <string> edit-draft;
    pure function has-active-column() -> bool { return root.active-column >= 0 && root.active-column < root.columns.length; }
    pure function has-active-cell() -> bool { return root.has-active-row && root.has-active-column(); }
    pure function active-cell-editable() -> bool {
        return root.interactive && root.has-active-cell() && !root.rows[root.active-index].disabled
            && root.active-column < root.rows[root.active-index].content.length
            && root.rows[root.active-index].content[root.active-column].kind == TableCellKind.field
            && root.rows[root.active-index].content[root.active-column].access == FieldAccess.editable;
    }
    function begin-edit() {
        root.cursor-region = TableCursorRegion.body;
        root.reveal-active();
        root.edit-row-token = root.rows[root.active-index].token;
