        theme: root.theme; control-size: root.control-size;
        glyph: root.cell.glyph;
        purpose: root.cell.text == "" ? IconPurpose.decorative : IconPurpose.informative;
        label: root.cell.text;
        ink: root.cell-ink;
        x: root.aligned-x(self.width); y: (parent.height - self.height) / 2;
    }
    if root.cell.kind == TableCellKind.progress: Rectangle {
