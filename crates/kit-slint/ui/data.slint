                line-editor:=KitTextField { modal-layer: root.modal-layer;
                    implicit-form-submit: false;width:root.footer-stacked ? root.width : max(0px, root.width - save-line.preferred-width - copy-line.preferred-width - 2 * KitMetrics.inline-gap(root.theme));theme:root.theme;text<=>root.line-draft;accessible-name:root.editor-label;placeholder:root.editor-placeholder;access:root.can-edit-line?FieldAccess.editable:FieldAccess.disabled;commit-requested(text)=>{let source = root.current-line(); let generation = root.generation; root.commit-current(source,generation,text);}}
                HorizontalLayout {
                    width:save-line.preferred-width + copy-line.preferred-width + KitMetrics.inline-gap(root.theme);
                    spacing:KitMetrics.inline-gap(root.theme);alignment:start;vertical-stretch:0;
                    save-line := DocumentLineAction { modal-layer: root.modal-layer;theme:root.theme;text:root.save-label;line-source:root.current-line();generation:root.generation;disabled:!root.can-edit-line;requested(source,generation)=>{root.commit-current(source,generation,root.line-draft);}}
                    copy-line := DocumentLineAction { modal-layer: root.modal-layer;theme:root.theme;text:root.copy-label;line-source:root.current-line();generation:root.generation;disabled:!root.can-edit-line;requested(source,generation)=>{root.copy-current(source,generation);}}
