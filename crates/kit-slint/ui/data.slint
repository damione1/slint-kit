                if root.show-line-numbers: Text {width:root.gutter-width;text:line.number;color:line.selected?root.theme.accent:root.theme.text-secondary;font-family: root.line-family; font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);horizontal-alignment:right;vertical-alignment:center;}
