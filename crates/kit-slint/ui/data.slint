}

// The centered message of a data collection without rows. `ready` shows the
// empty label or the application's children, `loading` a spinner and `failed`
// the error with a retry action. Rows, when present, are never covered.
component DataStatePanel inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert, like every kit control.
    in property <int> modal-layer;
    in property <KitTheme> theme;
    in property <DataState> state;
    in property <bool> rowless;
    in property <DataEmptyContent> empty-content;
    in property <string> empty-label;
    in property <string> loading-label;
    in property <string> error-label;
    in property <string> retry-label;
    callback retry-requested();
    if root.rowless && root.state == DataState.loading: VerticalLayout {
        alignment: center; spacing: root.theme.spacing.unit * 2;
        KitSpinner { theme: root.theme; label: root.loading-label; horizontal-stretch: 0; }
        Text {text: root.loading-label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); horizontal-alignment: center;}
    }
    if root.rowless && root.state == DataState.failed: VerticalLayout {
        alignment: center; spacing: root.theme.spacing.unit * 2;
        Text {text: root.error-label; color: root.theme.danger; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); horizontal-alignment: center; wrap: word-wrap; accessible-role: AccessibleRole.text;}
        if root.retry-label != "": HorizontalLayout { alignment: center; KitButton { theme: root.theme; modal-layer: root.modal-layer; text: root.retry-label; activated => { root.retry-requested(); } } }
    }
    if root.rowless && root.state == DataState.ready && root.empty-content == DataEmptyContent.label: Text {text: root.empty-label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); horizontal-alignment: center; vertical-alignment: center;}
    // Slint cannot place `@children` inside a conditional element, so the
    // custom content is always built and hidden when it does not apply.
    Rectangle { visible: root.rowless && root.state == DataState.ready && root.empty-content == DataEmptyContent.custom; @children }
}

