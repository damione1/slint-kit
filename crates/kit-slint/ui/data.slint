// The footer uses the same press identity fence as DataAction, with the
// normal button presentation and Tab behavior retained.
component DocumentLineAction inherits KitButton {
    in property <SelectionRef> line-source;
    in property <int> generation;
    private property <SelectionRef> armed-source;
    private property <int> armed-generation;
    callback requested(SelectionRef, int);
    activation-started => { root.armed-source = root.line-source; root.armed-generation = root.generation; }
    changed line-source => { root.cancel-press(); }
    changed generation => { root.cancel-press(); }
    activated => { root.requested(root.armed-source, root.armed-generation); }
}

export component KitVirtualTextView inherits Rectangle {
