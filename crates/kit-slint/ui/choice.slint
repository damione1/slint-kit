        if lower.has-focus: FocusOutline { ring: KitThemes.inset-focus(root.theme); radius: parent.border-radius; host-width: parent.width; host-height: parent.height; }
    }
    Rectangle { x: root.choice.thumb-inset + (parent.width - 2 * root.edge) * clamp(root.upper-position,0,1); y: (parent.height - self.height) / 2; width: root.choice.slider-thumb-size; height: self.width; border-radius: min(root.theme.shape.radius-pill, self.width / 2); background: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.accent;
        if upper.has-focus: FocusOutline { ring: KitThemes.inset-focus(root.theme); radius: parent.border-radius; host-width: parent.width; host-height: parent.height; }
    }
    pointer := TouchArea {
        enabled: root.access == FieldAccess.editable;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                let position = clamp((self.mouse-x - root.edge) / max(1px,root.width - 2 * root.edge),0,1);
                let lower-distance = abs(position - root.lower-position);
                let upper-distance = abs(position - root.upper-position);
                if (lower-distance < upper-distance) { root.active-thumb = RangeThumb.lower; }
                if (upper-distance < lower-distance) { root.active-thumb = RangeThumb.upper; }
                if (root.active-thumb == RangeThumb.lower) { lower.focus(); } else { upper.focus(); }
                root.gesture-active = true; root.gesture-started(root.active-thumb); root.update-position();
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.gesture-active) { root.gesture-active = false; root.committed(root.active-thumb); }
            if (event.kind == PointerEventKind.cancel && root.gesture-active) { root.gesture-active = false; root.cancelled(root.active-thumb); }
        }
        moved => { if (self.pressed && root.gesture-active) { root.update-position(); } }
    }
}

export component KitRating inherits Rectangle {
    min-width: 0px; preferred-width: 280px; max-width: 100000px; horizontal-stretch: 1;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[ChoiceRow]> scores;
    in property <int> generation;
    in property <int> active-token;
    in property <string> label;
    callback navigate(NavigationStep);
    callback choose(int,int);
    callback clear-requested();
    vertical-stretch: 0;
    preferred-height: content.preferred-height;
    content := HorizontalLayout {
        spacing: KitMetrics.inline-gap(root.theme);
        KitSegmentedControl { theme: root.theme; control-size: root.control-size; access: root.access; rows: root.scores; generation: root.generation; active-token: root.active-token; label: root.label; navigate(step) => { root.navigate(step); } activate(token,generation) => { root.choose(token,generation); } }
        KitButton { theme: root.theme; control-size: root.control-size; text: "Clear rating"; intent: ButtonIntent.quiet; disabled: root.access != FieldAccess.editable; activated => { root.clear-requested(); } }
    }
}
