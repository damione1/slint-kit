        if (event.text == Key.End) { root.navigate(NavigationStep.last); return accept; }
        if (event.text == Key.RightArrow || event.text == Key.UpArrow) { root.navigate(NavigationStep.next); return accept; }
        if (event.text == Key.LeftArrow || event.text == Key.DownArrow) { root.navigate(NavigationStep.previous); return accept; }
        if (event.text == Key.PageUp) { root.navigate(NavigationStep.page-next); return accept; }
        if (event.text == Key.PageDown) { root.navigate(NavigationStep.page-previous); return accept; }
        if (event.text == Key.Return) { root.committed(); return accept; }
        return reject;
    }
}
