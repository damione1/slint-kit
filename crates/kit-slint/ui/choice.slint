import { FormConstraintState, KitFormValidation, KitValidityState, HtmlInputKind } from "validation.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { ValidationPresentation } from "shared-contracts.slint";
import { KitTheme, KitThemes, KitMetrics, ButtonIntent, ControlSize, ControlWidth, KitThemeContext, ChoiceRecipe, IconRecipe, TypographyRole } from "theme.slint";
import { KitButton, KitPressable } from "button.slint";
import { FocusOutline } from "focus.slint";
import { KitFieldLabel, KitFieldError } from "field.slint";
import { KitTextField } from "input.slint";
import { KitSelect, KitSelectTrigger, KitSelectSurface, KitOption } from "select.slint";
import { KitIcon, KitGlyphs, TurningIcon } from "icons.slint";
import { FieldAccess, NavigationStep, CloseReason, SelectState, OptionRow, SelectionAvailability } from "contracts.slint";
import { ListView } from "scroll.slint";

import { CheckState, RangeThumb } from "shared-contracts.slint";
export { CheckState, RangeThumb } from "shared-contracts.slint";
export enum ChoiceDirection { horizontal, vertical }
export enum ChoiceFlow { left-to-right, right-to-left }
export enum SearchPresentation { idle, loading, ready, failed }
export { ChoiceRow } from "contracts.slint";
import { ChoiceRow } from "contracts.slint";
export struct ChipRow { token: int, label: string, removable: bool }

component ChoiceOption inherits KitPressable {
    in property <ChoiceRow> option-data;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <length> content-reserve;
    in property <int> generation;
    callback activate(int,int);
    private property <int> press-token;
    private property <int> press-generation;
    tab-stop: false;
    activation-started => { root.press-token = root.option-data.token; root.press-generation = root.generation; }
    changed option-data => { root.cancel-press(); }
    changed generation => { root.cancel-press(); }
    changed access => { root.cancel-press(); }
    activated => { if (root.access == FieldAccess.editable) { root.activate(root.press-token,root.press-generation); } }
    // Read-only keeps the value legible and focusable without press affordance.
    background: root.access == FieldAccess.read-only ? root.recipe.fill : root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    min-width: 0px;
    min-height: max(max(root.recipe.height,root.recipe.font-size * 1.4 + 2 * root.recipe.padding-block),measure.preferred-height + 2 * root.recipe.padding-block);
    measure := Text {
        visible: false; width: max(1px,root.width - 2 * root.recipe.padding-inline - root.content-reserve);
        text: root.option-data.label; font-family: root.theme.typography.family; font-size: root.recipe.font-size; wrap: word-wrap;
    }
    @children
}

// The radio indicator, shared by both group orientations.
component RadioMark inherits Rectangle {
    in property <KitTheme> theme;
    in property <bool> selected;
    in property <bool> invalid;
    in property <bool> disabled;
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    width: root.choice.box-size; height: root.choice.box-size;
    border-radius: min(root.theme.shape.radius-pill, self.width / 2);
    border-width: root.theme.shape.border-width;
    border-color: root.invalid ? root.theme.danger : root.selected && !root.disabled ? root.theme.accent : root.disabled ? root.theme.border-subtle : root.theme.border-strong;
    if root.selected: Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.choice.radio-dot-size; height: root.choice.radio-dot-size;
        border-radius: min(root.theme.shape.radius-pill, self.width / 2);
        background: root.disabled ? root.theme.disabled-text : root.theme.accent;
    }
}

// All boolean skins use the same Pressable activation and cancellation machine.
// The state is controlled: mixed is a real third value and never coerced to false.
export component KitCheckbox inherits KitPressable {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.checkbox; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        checked: root.state == CheckState.checked;
        invalid => { root.invalid(); }
    }

    in property <CheckState> state: CheckState.unchecked;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <string> label;
    callback toggled(CheckState);
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    intent: ButtonIntent.quiet;
    control-width: ControlWidth.fill;
    disabled: root.access == FieldAccess.disabled;
    background: root.access == FieldAccess.read-only ? root.recipe.fill : root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    changed has-focus => { if (!root.has-focus && root.access == FieldAccess.editable) { checks.note-blur(); } }
    changed access => { root.cancel-press(); }
    min-height: max(max(root.recipe.height,root.recipe.font-size * 1.4 + 2 * root.recipe.padding-block),measure.preferred-height + 2 * root.recipe.padding-block);
    measure := Text { visible: false; width: max(1px,root.width - 2 * root.recipe.padding-inline - root.choice.box-size - root.choice.label-gap); text: root.label; font-family: root.theme.typography.family; font-size: root.recipe.font-size; wrap: word-wrap; }
    accessible-role: checkbox;
    accessible-name: root.label;
    accessible-checked: root.state == CheckState.checked;
    accessible-description: checks.show-error ? checks.validation-message : root.state == CheckState.mixed ? "Partially selected" : root.access == FieldAccess.read-only ? "Read only" : "";
    activated => { if (root.access == FieldAccess.editable) { checks.note-edit(); root.toggled(root.state == CheckState.checked ? CheckState.unchecked : CheckState.checked); } }
    HorizontalLayout {
        spacing: root.choice.label-gap;
        Rectangle {
            width: root.choice.box-size; height: root.choice.box-size;
            border-radius: root.choice.box-radius;
            border-width: root.theme.shape.border-width;
            border-color: checks.show-error ? root.theme.danger : root.disabled ? root.theme.border-subtle : root.state == CheckState.unchecked ? root.theme.border-strong : root.theme.accent;
            background: root.disabled ? root.theme.disabled-fill : root.state != CheckState.unchecked ? root.theme.accent
                : root.access == FieldAccess.read-only ? root.theme.canvas : root.theme.surface;
            if root.state == CheckState.checked: Path {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: root.choice.check-size; height: root.choice.check-size;
                commands: "M 2 7 L 5 10 L 12 3";
                stroke: root.disabled ? root.theme.disabled-text : root.theme.on-accent;
                stroke-width: root.choice.mark-stroke; fill: transparent;
            }
            if root.state == CheckState.mixed: Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: root.choice.mixed-width; height: root.choice.mark-stroke;
                background: root.disabled ? root.theme.disabled-text : root.theme.on-accent;
            }
        }
        Text { text: root.label; color: root.disabled ? root.theme.disabled-text : root.theme.text-primary; font-family: root.theme.typography.family; font-size: root.recipe.font-size; wrap: word-wrap; vertical-alignment: center; }
    }
}

export component KitSwitch inherits KitPressable {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.checkbox; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        checked: root.checked;
        invalid => { root.invalid(); }
    }

    in property <bool> checked;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <string> label;
    callback toggled(bool);
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    intent: ButtonIntent.quiet;
    control-width: ControlWidth.fill;
    disabled: root.access == FieldAccess.disabled;
    background: root.access == FieldAccess.read-only ? root.recipe.fill : root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    changed has-focus => { if (!root.has-focus && root.access == FieldAccess.editable) { checks.note-blur(); } }
    changed access => { root.cancel-press(); }
    min-height: max(max(root.recipe.height,root.recipe.font-size * 1.4 + 2 * root.recipe.padding-block),measure.preferred-height + 2 * root.recipe.padding-block);
    measure := Text { visible: false; width: max(1px,root.width - 2 * root.recipe.padding-inline - root.choice.track-width - root.choice.label-gap); text: root.label; font-family: root.theme.typography.family; font-size: root.recipe.font-size; wrap: word-wrap; }
    accessible-role: switch;
    accessible-name: root.label;
    accessible-checked: root.checked;
    accessible-description: checks.show-error ? checks.validation-message : root.access == FieldAccess.read-only ? "Read only" : "";
    activated => { if (root.access == FieldAccess.editable) { checks.note-edit(); root.toggled(!root.checked); } }
    HorizontalLayout {
        spacing: root.choice.label-gap;
        Rectangle {
            width: root.choice.track-width; height: root.choice.track-height; border-radius: root.choice.track-radius;
            background: checks.show-error ? root.theme.danger : root.disabled ? root.theme.disabled-fill : root.checked ? root.theme.accent : root.theme.border-strong;
            Rectangle {
                x: root.checked ? parent.width - self.width - root.choice.thumb-inset : root.choice.thumb-inset;
                y: root.choice.thumb-inset;
                width: root.choice.thumb-size; height: root.choice.thumb-size;
                border-radius: min(root.theme.shape.radius-pill, self.width / 2);
                background: root.checked ? root.theme.on-accent : root.theme.surface;
                animate x { duration: root.choice.transition; easing: ease-in-out; }
            }
        }
        Text { text: root.label; color: root.disabled ? root.theme.disabled-text : root.theme.text-primary; font-family: root.theme.typography.family; font-size: root.recipe.font-size; wrap: word-wrap; vertical-alignment: center; }
    }
}

// One tab target. Rust owns stable keys, skip-disabled and reconciliation;
// the translator is reused by radio, segmented, toggle and rating surfaces.
component ChoiceKeyboard inherits FocusScope {
    min-width: 0px; preferred-width: 0px; max-width: 100000px; horizontal-stretch: 1;
    in property <ChoiceDirection> direction: ChoiceDirection.horizontal;
    in property <ChoiceFlow> flow: ChoiceFlow.left-to-right;
    in property <FieldAccess> access: FieldAccess.editable;
    callback navigate(NavigationStep);
    callback activate();
    private property <bool> held;
    changed access => { root.held = false; }
    enabled: root.access != FieldAccess.disabled;
    key-pressed(event) => {
        if (root.access != FieldAccess.editable) { return reject; }
        if (event.text == Key.Home) { root.navigate(NavigationStep.first); return accept; }
        if (event.text == Key.End) { root.navigate(NavigationStep.last); return accept; }
        if (event.text == Key.RightArrow && root.direction == ChoiceDirection.horizontal) { root.navigate(root.flow == ChoiceFlow.right-to-left ? NavigationStep.previous : NavigationStep.next); return accept; }
        if (event.text == Key.LeftArrow && root.direction == ChoiceDirection.horizontal) { root.navigate(root.flow == ChoiceFlow.right-to-left ? NavigationStep.next : NavigationStep.previous); return accept; }
        if (event.text == Key.DownArrow && root.direction == ChoiceDirection.vertical) { root.navigate(NavigationStep.next); return accept; }
        if (event.text == Key.UpArrow && root.direction == ChoiceDirection.vertical) { root.navigate(NavigationStep.previous); return accept; }
        if (event.text == Key.Space || event.text == Key.Return) { if (!root.held) { root.held = true; root.activate(); } return accept; }
        return reject;
    }
    key-released(event) => { if (event.text == Key.Space || event.text == Key.Return) { root.held = false; return accept; } return reject; }
    focus-lost(reason) => { root.held = false; }
}

export component KitRadioGroup inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.radio; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        checked: KitFormValidation.ready && KitFormValidation.count-selected(root.rows) > 0;
        invalid => { root.invalid(); }
    }

    min-width: 0px; preferred-width: 280px; max-width: 100000px; horizontal-stretch: 1;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[ChoiceRow]> rows;
    in property <int> generation;
    in property <int> active-token;
    in property <ChoiceDirection> direction: ChoiceDirection.vertical;
    in property <ChoiceFlow> flow: ChoiceFlow.left-to-right;
    in property <string> label;
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    callback navigate(NavigationStep);
    callback activate(int, int);
    out property <bool> has-focus: keyboard.has-focus;
    changed has-focus => { if (!root.has-focus && root.access == FieldAccess.editable) { checks.note-blur(); } }
    public function take-focus() { keyboard.focus(); }
    accessible-role: radio-group;
    accessible-label: root.label;
    accessible-description: checks.show-error ? checks.validation-message : "";
    forward-focus: keyboard;
    vertical-stretch: 0;
    keyboard := ChoiceKeyboard {
        direction: root.direction; flow: root.flow; access: root.access;
        navigate(step) => { root.navigate(step); }
        activate => { root.activate(root.active-token, root.generation); }
        // Box layouts measure horizontal and vertical constraints separately,
        // so wrapping labels do not feed Flexbox height back into window width.
        vertical := VerticalLayout {
            width: root.width; height: self.preferred-height;
            visible: root.direction == ChoiceDirection.vertical;
            spacing: 0px;
        for row in root.rows: option := ChoiceOption {
            option-data: row; generation: root.generation; access: root.access; content-reserve: root.choice.box-size + root.choice.label-gap;
            control-width: ControlWidth.fill; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            theme: root.theme; control-size: root.control-size; intent: ButtonIntent.quiet;
            disabled: row.disabled || root.access == FieldAccess.disabled;
            tab-stop: false; accessible-name: row.label;
            accessible-role: radio-button; accessible-checked: row.selected;
            focus-indicated: keyboard.has-focus && root.active-token == row.token;
            focus-ring: KitThemes.inset-focus(root.theme);
            activate(token,generation) => { keyboard.focus(); if (root.access == FieldAccess.editable) { root.activate(token,generation); } }
            HorizontalLayout {
                spacing: root.choice.label-gap;
                RadioMark { theme: root.theme; selected: row.selected; invalid: checks.show-error; disabled: option.disabled; }
                Text { text: row.label; font-family: option.theme.typography.family; font-size: option.recipe.font-size; color: option.disabled ? option.recipe.disabled-foreground : option.recipe.foreground; wrap: word-wrap; vertical-alignment: center; }
            }
        }
        }
        horizontal := HorizontalLayout {
            width: root.width; height: self.preferred-height;
            visible: root.direction == ChoiceDirection.horizontal;
            spacing: 0px;
        for source-display-choice[index] in root.rows: flow-option := ChoiceOption {
            in property <ChoiceRow> display-choice: root.flow == ChoiceFlow.right-to-left ? root.rows[root.rows.length - 1 - index] : source-display-choice;
            option-data: display-choice; generation: root.generation; access: root.access; content-reserve: root.choice.box-size + root.choice.label-gap;
            control-width: ControlWidth.fill; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            theme: root.theme; control-size: root.control-size; intent: ButtonIntent.quiet;
            disabled: display-choice.disabled || root.access == FieldAccess.disabled;
            tab-stop: false; accessible-name: display-choice.label;
            accessible-role: radio-button; accessible-checked: display-choice.selected;
            focus-indicated: keyboard.has-focus && root.active-token == display-choice.token;
            focus-ring: KitThemes.inset-focus(root.theme);
            activate(token,generation) => { keyboard.focus(); if (root.access == FieldAccess.editable) { root.activate(token,generation); } }
            HorizontalLayout {
                spacing: root.choice.label-gap;
                RadioMark { theme: root.theme; selected: flow-option.display-choice.selected; invalid: checks.show-error; disabled: flow-option.disabled; }
                Text { text: flow-option.display-choice.label; font-family: flow-option.theme.typography.family; font-size: flow-option.recipe.font-size; color: flow-option.disabled ? flow-option.recipe.disabled-foreground : flow-option.recipe.foreground; wrap: word-wrap; vertical-alignment: center; }
            }
        }
        }
    }
    preferred-height: root.direction == ChoiceDirection.vertical ? vertical.preferred-height : horizontal.preferred-height;
}

export component KitSegmentedControl inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.radio; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        checked: KitFormValidation.ready && KitFormValidation.count-selected(root.rows) > 0;
        invalid => { root.invalid(); }
    }

    min-width: 0px; preferred-width: 280px; max-width: 100000px; horizontal-stretch: 1;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[ChoiceRow]> rows;
    in property <int> generation;
    in property <int> active-token;
    in property <ChoiceFlow> flow: ChoiceFlow.left-to-right;
    in property <string> label;
    callback navigate(NavigationStep);
    callback activate(int, int);
    out property <bool> has-focus: keyboard.has-focus;
    changed has-focus => { if (!root.has-focus && root.access == FieldAccess.editable) { checks.note-blur(); } }
    public function take-focus() { keyboard.focus(); }
    accessible-role: radio-group; accessible-label: root.label;
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    border-radius: root.choice.group-radius; background: root.theme.canvas;
    border-width: root.theme.shape.border-width; border-color: checks.show-error ? root.theme.danger : root.theme.border-subtle;
    preferred-height: max(choices.min-height,choices.preferred-height);
    vertical-stretch: 0;
    accessible-description: checks.show-error ? checks.validation-message : "";
    forward-focus: keyboard;
    keyboard := ChoiceKeyboard {
        flow: root.flow; access: root.access;
        navigate(step) => { root.navigate(step); }
        activate => { root.activate(root.active-token, root.generation); }
        choices := HorizontalLayout {
            width: root.width; height: self.preferred-height;
            padding: root.choice.group-padding; spacing: root.choice.group-padding;
            for row in root.rows: option := ChoiceOption {
                option-data: row; generation: root.generation; access: root.access;

                theme: root.theme; control-size: root.control-size;
                control-width: ControlWidth.fill;
                accessible-name: row.label;
                disabled: row.disabled || root.access == FieldAccess.disabled;
                intent: row.selected ? ButtonIntent.primary : ButtonIntent.quiet;
                accessible-role: radio-button; accessible-checked: row.selected;
                focus-indicated: keyboard.has-focus && root.active-token == row.token;
                focus-ring: KitThemes.inset-focus(root.theme);
                activate(token,generation) => { keyboard.focus(); if (root.access == FieldAccess.editable) { root.activate(token,generation); } }
                Text { text: row.label; color: option.disabled ? option.recipe.disabled-foreground : option.recipe.foreground; font-family: option.theme.typography.family; font-size: option.recipe.font-size; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
            }
        }
    }
}

// Multiple selection has a distinct API; it never changes RadioGroup's value type.
export component KitToggleGroup inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.select; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        selected-count: KitFormValidation.ready ? KitFormValidation.count-selected(root.rows) : 0;
        invalid => { root.invalid(); }
    }

    min-width: 0px; preferred-width: 280px; max-width: 100000px; horizontal-stretch: 1;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[ChoiceRow]> rows;
    in property <int> generation;
    in property <int> active-token;
    in property <string> label;
    callback navigate(NavigationStep);
    callback toggled(int, int);
    private property <ChoiceRecipe> choice: KitThemes.choice-recipe(root.theme);
    preferred-height: max(choices.min-height,choices.preferred-height);
    vertical-stretch: 0;
    accessible-role: groupbox; accessible-label: root.label;
    out property <bool> has-focus: keyboard.has-focus;
    changed has-focus => { if (!root.has-focus && root.access == FieldAccess.editable) { checks.note-blur(); } }
    public function take-focus() { keyboard.focus(); }
    accessible-description: checks.show-error ? checks.validation-message : "";
    forward-focus: keyboard;
    keyboard := ChoiceKeyboard {
        access: root.access;
        navigate(step) => { root.navigate(step); }
        activate => { checks.note-edit(); root.toggled(root.active-token, root.generation); }
        choices := HorizontalLayout {
            width: root.width; height: self.preferred-height;
            spacing: root.choice.group-gap;
            for row in root.rows: option := ChoiceOption {
                option-data: row; generation: root.generation; access: root.access;

                theme: root.theme; control-size: root.control-size; accessible-name: row.label;
                control-width: ControlWidth.fill;
                intent: row.selected ? ButtonIntent.primary : ButtonIntent.secondary;
                disabled: row.disabled || root.access == FieldAccess.disabled;
                accessible-checked: row.selected;
                border-width: root.theme.shape.border-width;
                border-color: checks.show-error ? root.theme.danger : root.theme.border-subtle;
                focus-indicated: keyboard.has-focus && root.active-token == row.token;
