        }
        content := VerticalLayout {
            x: 0px; y: 0px; width: root.width; height: self.preferred-height; alignment: start;
            padding: root.inset; spacing: root.theme.spacing.unit * 3;
            if root.rows.length == 0: Text { text: root.empty-label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
            if root.display-index >= 0 && root.display-index < root.rows.length: VerticalLayout {
                width: max(0px,root.width - 2 * root.inset); height: self.preferred-height; vertical-stretch: 0;
                spacing: root.theme.spacing.unit * 2;
                alignment: start;
                Text { width: max(0px,root.width - 2 * root.inset); height: self.preferred-height; text: root.rows[root.display-index].label; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
                Text { width: max(0px,root.width - 2 * root.inset); height: self.preferred-height; text: root.rows[root.display-index].description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
            }
            @children
            if root.action-label != "" && root.display-index >= 0 && root.display-index < root.rows.length: KitNavigationAction {
                theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer; tab-stop: true; accessible-role: button;
                option-data: {token: root.rows[root.display-index].token, generation: root.rows[root.display-index].generation, label: root.action-label, description: "", disabled: !root.interactive || root.rows[root.display-index].disabled};
                key-event(event) => {
                    if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End) { root.take-focus(); return root.handle-key(event); }
                    return KitKeyResult.reject;
                }
                activate(token, generation) => { root.handle-activate(token, generation); }
            }
            HorizontalLayout {
                spacing: root.theme.spacing.unit * 2; alignment: space-between;
                KitButton {
                    theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer; text: root.previous-label;
                    disabled: !root.interactive || root.rows.length == 0 || (!root.wrap && root.display-index <= 0);
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End) { root.take-focus(); return root.handle-key(event); }
                        return KitKeyResult.reject;
                    }
                    activated => { root.handle-navigate(NavigationStep.previous); }
                }
                Text { text: root.position-label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); vertical-alignment: center; }
                KitButton {
                    theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer; text: root.next-label;
                    disabled: !root.interactive || root.rows.length == 0 || (!root.wrap && root.display-index >= root.rows.length - 1);
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End) { root.take-focus(); return root.handle-key(event); }
                        return KitKeyResult.reject;
                    }
                    activated => { root.handle-navigate(NavigationStep.next); }
                }
            }
        }
    }

