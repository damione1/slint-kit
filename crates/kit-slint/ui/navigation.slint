        }
        Rectangle {
            height: section.disclosure.expanded ? answer.preferred-height + 2 * root.inset-y : 0px;
            clip: true; vertical-stretch: 0;
            animate height { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.base; easing: ease-in-out; }
            answer := Text {
                x: root.inset-x; y: root.inset-y; width: max(0px,parent.width - 2 * root.inset-x);
                text: section.disclosure.item.description; color: root.theme.text-secondary;
                font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap;
            }
        }
