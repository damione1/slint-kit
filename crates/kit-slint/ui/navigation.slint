    preferred-width: root.active ? content.preferred-width : 0px;
    max-width: root.active ? content.max-width : 0px;
    min-height: root.active ? content.min-height : 0px;
    preferred-height: root.active ? content.preferred-height : 0px;
    max-height: root.active ? content.max-height : 0px;
    vertical-stretch: 0;
    accessible-role: tab-panel;
    accessible-label: root.accessible-name;
