            changed active-row => { if (root.live && self.active-row && root.focus-requested) { self.take-focus(); root.focus-requested = false; } }
            activate(token, generation) => { root.handle-expansion(token, generation, !section.disclosure.expanded, root.mode); }
            // Children of a pressable sit in its padded content box, while
            // `parent` names the pressable itself: place from its own metrics.
