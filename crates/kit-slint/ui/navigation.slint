        }
    }
}

// The panel of a popover: the popover surface, a keyboard scope that turns
// Escape into `escape` and takes focus when the panel is presented, and the
// padded body that carries the panel's children.
component PopoverPanel inherits Rectangle {
    in property <SurfaceRecipe> recipe;
    in property <length> inset;
    in property <bool> presented;
    callback escape();
    preferred-height: body.preferred-height;
    // The panel may be created after `presented` turned true: focus on both.
    init => { if (root.presented) { scope.focus(); } }
    changed presented => { if (root.presented) { scope.focus(); } }
    ElevatedSurface { recipe: root.recipe; }
    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.escape(); return accept; }
            return reject;
        }
        body := VerticalLayout {
            padding: root.inset;
            @children
        }
    }
}

// A trigger button that opens an anchored panel holding its children. The
