        alignment: start;
        trigger := KitNavigationAction {
            trailing-space: KitMetrics.icon-size(root.theme, root.control-size) + root.theme.spacing.unit * 2;
            theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
