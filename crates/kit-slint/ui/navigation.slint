export component KitAccordion inherits VerticalLayout {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[DisclosureRow]> rows: KitSelectionService.ready ? KitSelectionService.disclosures(selection.rows, root.expanded) : [];
    in property <SelectState> state: selection.state;
    in property <ExpansionMode> mode: ExpansionMode.single;
    callback expansion-requested(int, int, bool, ExpansionMode);
    callback navigate(NavigationStep);
    private property <bool> focus-requested;
    changed live => { if (!root.live) { root.focus-requested = false; } }
    private property <length> inset-x: root.theme.spacing.unit * 4;
    private property <length> inset-y: root.theme.spacing.unit * 2;
    spacing: root.theme.spacing.unit * 2;
    alignment: start;
    vertical-stretch: 0;
    // Expanding a section changes its value, not the source repeater. Keep
    // its native button/focus mounted while projecting the disclosure state.
    private property <int> render-count: root.options.length > 0 ? selection.rows.length : root.rows.length;
    for index in root.render-count: section := VerticalLayout {
        private property <OptionRow> source: selection.rows[index];
        private property <DisclosureRow> disclosure: root.options.length > 0
            ? KitSelectionService.ready ? KitSelectionService.disclosure(self.source, root.expanded) : {item: self.source, expanded: false}
            : root.rows[index];
