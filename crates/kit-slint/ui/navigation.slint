// Integers are a projection boundary; a Rust pagination controller validates
// the page index/count. This view never mutates a remote collection itself.
export component KitPagination inherits HorizontalLayout {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> accessible-name: KitStrings.pagination-label;
    in property <ControlSize> control-size: ControlSize.medium;
    in-out property <int> page-index;
    in property <Ownership> ownership: Ownership.local;
    callback page-changed(int);
    function change-page(value: int) {
        if (!root.live || root.page-count <= 0) { return; }
        let next = min(max(0, value), root.page-count - 1);
        if (next == root.page-index) { return; }
        if (root.ownership == Ownership.local) { root.page-index = next; }
        root.page-changed(next);
    }
    in property <int> page-count;
    in property <string> position-label: KitStrings.pagination-position-template
        .replace-all("{current}", "" + (root.page-count <= 0 ? 0 : min(max(0, root.page-index), root.page-count - 1) + 1))
        .replace-all("{total}", "" + max(0, root.page-count));
    in property <string> previous-label: "Previous";
    in property <string> next-label: "Next";
    callback navigate(NavigationStep);
    spacing: root.theme.spacing.unit * 2;
    alignment: start;
    vertical-stretch: 0;
    accessible-role: navigation;
    accessible-label: root.accessible-name;
    KitButton { theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer; text: root.previous-label; disabled: !root.interactive || root.page-index <= 0 || root.page-count <= 0; activated => { root.change-page(root.page-index - 1); root.navigate(NavigationStep.previous); } }
    Text { text: root.position-label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); vertical-alignment: center; }
    KitButton { theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer; text: root.next-label; disabled: !root.interactive || root.page-count <= 0 || root.page-index >= root.page-count - 1; activated => { root.change-page(root.page-index + 1); root.navigate(NavigationStep.next); } }
}

export component KitNotificationButton inherits KitPressable {
