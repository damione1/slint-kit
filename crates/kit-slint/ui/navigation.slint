    preferred-height: root.rows.length == 0 ? 100px : root.rows.length <= 32 ? min(600px,bounded-content.preferred-height) : 400px;
    if root.rows.length == 0: VerticalLayout {
        alignment: center; spacing: root.theme.spacing.unit * 2;
        Text { text: root.empty-label; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); font-weight: root.theme.typography.weight-semibold; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: root.empty-description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); horizontal-alignment: center; wrap: word-wrap; }
    }
