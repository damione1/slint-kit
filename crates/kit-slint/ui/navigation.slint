        if (!root.live) { return; }
        if (KitSelectionService.ready) {
            if (root.ownership == Ownership.local) { root.expanded = KitSelectionService.disclose(root.options, root.expanded, token, generation, selection.state.generation, expanded, mode); }
            root.requested-expanded = expanded;
            selection.activate(token, generation);
        }
        root.expansion-requested(token, generation, expanded, mode);
    }

    out property <string> selected-label: selection.selected-label;
}

// Manual carousel: application chooses the active slide through stable identity.
export component KitCarousel inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <string> label: "Carousel";
    accessible-role: groupbox; accessible-label: root.label;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows: selection.rows;
    in property <SelectState> state: selection.state;
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <bool> wrap: true;
    // The editor has source slides but no Rust active-row projection yet.
    private property <int> display-index: !KitSelectionService.ready && root.state.active-index < 0 && root.options.length > 0 ? 0 : root.state.active-index;
    in property <string> previous-label: "Previous slide";
    in property <string> next-label: "Next slide";
    in property <string> empty-label: "No slides";
    in property <string> position-label: KitStrings.carousel-position-template
        .replace-all("{current}", "" + (root.rows.length == 0 ? 0 : root.display-index + 1))
        .replace-all("{total}", "" + root.rows.length);
    callback navigate(NavigationStep);
    callback activate(int, int);
    in property <string> action-label;
    out property <bool> has-focus: root.live && keyboard.has-focus;
    public function take-focus() { if (root.live) { keyboard.focus(); } }
    public function handle-key(event: KeyEvent) -> KitKeyResult {
        if (!root.live) { return KitKeyResult.reject; }
        if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
            let forward = root.flow == ChoiceFlow.right-to-left
                ? event.text == Key.LeftArrow
                : event.text == Key.RightArrow;
            root.handle-navigate(forward ? NavigationStep.next : NavigationStep.previous);
            return KitKeyResult.accept;
        }
        if (event.text == Key.Home || event.text == Key.End) {
            root.handle-navigate(event.text == Key.Home ? NavigationStep.first : NavigationStep.last);
            return KitKeyResult.accept;
        }
        return KitKeyResult.reject;
    }
    min-height: self.preferred-height;
    preferred-height: max(160px,content.preferred-height);
    vertical-stretch: 0;
    forward-focus: keyboard;
    private property <SurfaceRecipe> surface: KitThemes.surface-recipe(root.theme, SurfaceLevel.flat);
    private property <length> inset: root.theme.spacing.unit * 4;
    background: root.surface.fill;
    border-radius: root.surface.radius;
    border-width: root.surface.border-width;
    border-color: root.surface.border;
    drop-shadow-offset-y: root.surface.shadow.offset-y;
    drop-shadow-blur: root.surface.shadow.blur;
    drop-shadow-color: root.surface.shadow.color;
    keyboard := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.live;
        focus-on-tab-navigation: true;
