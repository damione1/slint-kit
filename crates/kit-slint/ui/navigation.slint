import { ListView, ScrollView } from "std-widgets.slint";
import { KitTheme, KitThemes, ControlWidth, ControlSize, KitMetrics, ButtonIntent } from "theme.slint";
import { KitPressable, KitButton, KitIconButton } from "button.slint";
import { KitOption, KitSelectKeyboard } from "select.slint";
import { KitIcon, IconKind } from "icons.slint";
import { KitDialogSurface, KitDialogPanel } from "dialog.slint";
import { OptionRow, SelectState, NavigationStep, CloseReason, DialogState } from "contracts.slint";
export { OptionRow, SelectState, NavigationStep, CloseReason, DialogState } from "contracts.slint";
export enum ExpansionMode { single, multiple }
export struct DisclosureRow { item: OptionRow, expanded: bool }
export struct NotificationRow { item: OptionRow, read: bool }

// One row owns activation and snapshots its identity through KitOption.
export component KitNavigationAction inherits KitOption {
    in property <length> trailing-space;
    accessible-role: list-item;
    min-width: root.control-width == ControlWidth.fill ? 0px : max(root.preferred-height, label.preferred-width + 2 * root.recipe.padding-inline);
    preferred-width: self.min-width;
    border-width: root.active || root.selected ? 1px : 0px;
    border-color: root.active ? root.theme.focus-ring : root.theme.accent;
    label := Text {
        x: 0px; y: 0px;
        width: max(0px,root.width - 2 * root.recipe.padding-inline - root.trailing-space);
        height: max(0px,root.height - 2 * root.recipe.padding-block);
        horizontal-alignment: root.control-width == ControlWidth.fill ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
        text: root.option-data.label;
        color: root.disabled ? root.theme.disabled-text : root.selected ? root.theme.accent : root.theme.text-primary;
        font-size: 14px * root.theme.text-scale;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Identity, skip-disabled navigation, and typeahead live in SelectController.
// The composite retains a single tab stop; the model is the source of truth.
export component KitMenu inherits Rectangle {
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows;
    in property <SelectState> state;
    in property <string> accessible-name: "Menu";
    in property <length> row-height: max(KitMetrics.control-height(root.control-size, root.theme.text-scale), 20px * root.theme.text-scale + 16px);
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    // Includes a row focused on pointer-down, before its activation is committed.
    // Keep that focus in place: transferring it here would cancel the press.
    out property <bool> has-focus: root.interactive && (keyboard.has-focus || (root.focused-row-token >= 0 && root.focused-row-generation == root.state.generation));
    callback focus-observed(bool);
    private property <int> focused-row-token: -1;
    private property <int> focused-row-generation: -1;
    changed has-focus => { root.focus-observed(root.has-focus); }
    changed interactive => {
        if (!root.interactive) { root.focused-row-token = -1; root.focused-row-generation = -1; }
    }
    public function take-focus() { if (root.interactive) { keyboard.focus(); } }
    public function ensure-active-visible() {
        if (root.state.active-index < 0) { return; }
        let top = root.state.active-index * root.row-height;
        if (top + list.content-y < 0px) { list.content-y = -top; }
        else if (top + root.row-height + list.content-y > list.visible-height) {
            list.content-y = min(0px, list.visible-height - top - root.row-height);
        }
    }
    changed state => { root.ensure-active-visible(); }
    accessible-role: AccessibleRole.list;
    accessible-label: root.accessible-name;
    preferred-height: min(320px, root.rows.length * root.row-height);
    min-width: 100px;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        enabled: root.interactive;
        dismiss-on-system-back: false;
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        navigate(step) => { root.navigate(step); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.dismiss(reason); } }
        typeahead(text) => { root.typeahead(text); }
        list := ListView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            for row in root.rows: KitNavigationAction {
                disabled: !root.interactive || row.disabled;
                theme: root.theme; control-size: root.control-size;
                option-data: row;
                active: root.state.active.present && root.state.active.token == row.token;
                selected: root.state.selected.present && root.state.selected.token == row.token;
                height: root.row-height;
                private property <OptionRow> focus-identity: row;
                changed focus-identity => {
                    // A reconciled delegate can retain its actual FocusScope.
                    if (self.has-focus) {
                        root.focused-row-token = row.token;
                        root.focused-row-generation = row.generation;
                    }
                }
                focus-observed(focused) => {
                    if (focused) {
                        root.focused-row-token = row.token;
                        root.focused-row-generation = row.generation;
                    } else if (root.focused-row-token == row.token && root.focused-row-generation == row.generation) {
                        root.focused-row-token = -1;
                        root.focused-row-generation = -1;
                    }
                }
                key-event(event) => {
                    if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.PageDown || event.text == Key.PageUp || event.text == Key.Escape) { root.take-focus(); return keyboard.handle-key(event); }
                    return reject;
                }
                activate(token, generation) => { root.take-focus(); root.activate(token, generation); }
            }
        }
    }
}

export component KitMenuBar inherits Rectangle {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows;
    in property <SelectState> state;
    in property <string> accessible-name: "Actions";
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    public function take-focus() { keyboard.focus(); }
    public function reveal(left: length, right: length) {
        if (left + viewport.content-x < 0px) { viewport.content-x = -left; }
        else if (right + viewport.content-x > viewport.visible-width) { viewport.content-x = min(0px, viewport.visible-width - right); }
    }
    public function handle-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
            root.navigate(event.text == Key.RightArrow ? NavigationStep.next : NavigationStep.previous);
            return accept;
        }
        return keyboard.handle-key(event);
    }
    accessible-role: navigation;
    accessible-label: root.accessible-name;
    min-height: max(KitMetrics.control-height(root.control-size, root.theme.text-scale), 20px * root.theme.text-scale + 16px);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        dismiss-on-system-back: false;
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        key-pressed(event) => { return root.handle-key(event); }
        navigate(step) => { root.navigate(step); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.dismiss(reason); } }
        typeahead(text) => { root.typeahead(text); }
        viewport := ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(self.visible-width, strip.preferred-width);
            content-height: self.visible-height;
            strip := HorizontalLayout {
                width: viewport.content-width;
                height: viewport.visible-height;
                spacing: 4px;
                alignment: start;
                for row in root.rows: KitNavigationAction {
                    theme: root.theme; control-size: root.control-size;
                    option-data: row;
                    control-width: ControlWidth.intrinsic;
                    active: root.state.active.present && root.state.active.token == row.token;
                    selected: root.state.selected.present && root.state.selected.token == row.token;
                    changed active => { if (self.active) { root.reveal(self.x, self.x + self.width); } }
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.Escape) { root.take-focus(); return root.handle-key(event); }
                        return reject;
                    }
                    activate(token, generation) => { root.take-focus(); root.activate(token, generation); }
                }
            }
        }
    }
}

export component KitTabs inherits Rectangle {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows;
    in property <SelectState> state;
    in property <string> accessible-name: "Tabs";
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    public function take-focus() { keyboard.focus(); }
    public function reveal(left: length, right: length) {
        if (left + viewport.content-x < 0px) { viewport.content-x = -left; }
        else if (right + viewport.content-x > viewport.visible-width) { viewport.content-x = min(0px, viewport.visible-width - right); }
    }
    public function handle-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
            root.navigate(event.text == Key.RightArrow ? NavigationStep.next : NavigationStep.previous);
            return accept;
        }
        return keyboard.handle-key(event);
    }
    accessible-role: tab-list;
    accessible-label: root.accessible-name;
    min-height: max(KitMetrics.control-height(root.control-size, root.theme.text-scale), 20px * root.theme.text-scale + 16px);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        dismiss-on-system-back: false;
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        key-pressed(event) => { return root.handle-key(event); }
        navigate(step) => { root.navigate(step); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.dismiss(reason); } }
        typeahead(text) => { root.typeahead(text); }
        viewport := ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(self.visible-width, strip.preferred-width);
            content-height: self.visible-height;
            strip := HorizontalLayout {
                width: viewport.content-width;
                height: viewport.visible-height;
                spacing: 4px;
                alignment: start;
                for row in root.rows: KitNavigationAction {
                    theme: root.theme; control-size: root.control-size;
                    option-data: row;
                    accessible-role: tab;
                    control-width: ControlWidth.intrinsic;
                    active: root.state.active.present && root.state.active.token == row.token;
                    selected: root.state.selected.present && root.state.selected.token == row.token;
                    changed active => { if (self.active) { root.reveal(self.x, self.x + self.width); } }
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.Escape) { root.take-focus(); return root.handle-key(event); }
                        return reject;
                    }
                    activate(token, generation) => { root.take-focus(); root.activate(token, generation); }
                }
            }
        }
    }
}

export component KitCollapse inherits VerticalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <string> title;
    in property <bool> expanded;
    in property <bool> disabled;
    callback expansion-requested(bool);
    public function take-focus() { trigger.take-focus(); }
    alignment: start;
    spacing: 0px;
    vertical-stretch: 0;
    trigger := KitPressable {
        theme: root.theme; control-size: root.control-size;
        disabled: root.disabled;
        control-width: ControlWidth.fill;
        accessible-name: root.title;
        accessible-expanded: root.expanded;
        activated => { root.expansion-requested(!root.expanded); }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.title; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; overflow: elide; vertical-alignment: center; }
            Rectangle { width: 16px; horizontal-stretch: 0;
                KitIcon { y: (parent.height - self.height) / 2; kind: root.expanded ? IconKind.chevron-down : IconKind.chevron-right; ink: root.theme.text-secondary; }
            }
        }
    }
    Rectangle {
        clip: true; visible: root.expanded || self.height > 0px;
        height: root.expanded ? body.preferred-height + 16px : 0px;
        animate height { duration: root.theme.reduced-motion ? 0ms : 180ms; easing: ease-in-out; }
        vertical-stretch: 0;
        body := VerticalLayout { x: 16px; y: 8px; width: max(0px,root.width - 32px); height: self.preferred-height; spacing: 8px; alignment: start; @children }
    }
}

export component KitAccordion inherits VerticalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[DisclosureRow]> rows;
    in property <SelectState> state;
    in property <ExpansionMode> mode: ExpansionMode.single;
    callback expansion-requested(int, int, bool, ExpansionMode);
    callback navigate(NavigationStep);
    private property <bool> focus-requested;
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    for row in root.rows: VerticalLayout {
        spacing: 0px;
        alignment: start;
        trigger := KitNavigationAction {
            trailing-space: 24px;
            theme: root.theme; control-size: root.control-size;
            option-data: row.item;
            active: false;
            tab-stop: root.state.active.present ? root.state.active.token == row.item.token : true;
            accessible-role: button;
            accessible-expanded: row.expanded;
            key-event(event) => {
                if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End) {
                    let previous = root.state.active.token;
                    root.focus-requested = true;
                    root.navigate(event.text == Key.DownArrow ? NavigationStep.next : event.text == Key.UpArrow ? NavigationStep.previous : event.text == Key.Home ? NavigationStep.first : NavigationStep.last);
                    if (!root.state.active.present || root.state.active.token == previous) { root.focus-requested = false; }
                    return accept;
                }
                return reject;
            }
            private property <bool> active-row: root.state.active.present && root.state.active.token == row.item.token;
            changed active-row => { if (self.active-row && root.focus-requested) { self.take-focus(); root.focus-requested = false; } }
            activate(token, generation) => { root.expansion-requested(token, generation, !row.expanded, root.mode); }
            KitIcon { x: max(0px,trigger.width - 48px); y: 6px; kind: row.expanded ? IconKind.chevron-down : IconKind.chevron-right; ink: root.theme.text-secondary; }
        }
        Rectangle {
            height: row.expanded ? answer.preferred-height + 16px : 0px;
            clip: true; vertical-stretch: 0;
            animate height { duration: root.theme.reduced-motion ? 0ms : 180ms; easing: ease-in-out; }
            answer := Text {
                x: 16px; y: 8px; width: max(0px,parent.width - 32px);
                text: row.item.description; color: root.theme.text-secondary;
                font-size: 14px * root.theme.text-scale; wrap: word-wrap;
            }
        }
        Rectangle { height: 1px; background: root.theme.border-subtle; }
    }
}

// Manual carousel: application chooses the active slide through stable identity.
export component KitCarousel inherits Rectangle {
    in property <string> label: "Carousel";
    accessible-role: groupbox; accessible-label: root.label;
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows;
    in property <SelectState> state;
    in property <string> previous-label: "Previous slide";
    in property <string> next-label: "Next slide";
    in property <string> empty-label: "No slides";
    callback navigate(NavigationStep);
    callback activate(int, int);
    in property <string> action-label;
    min-height: self.preferred-height;
    preferred-height: max(160px,content.preferred-height);
    vertical-stretch: 0;
    background: root.theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.theme.border-subtle;
    content := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height; alignment: start;
        padding: 16px; spacing: 12px;
        if root.rows.length == 0: Text { text: root.empty-label; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
        if root.state.active-index >= 0 && root.state.active-index < root.rows.length: VerticalLayout {
            width: max(0px,root.width - 32px); height: self.preferred-height; vertical-stretch: 0;
            spacing: 8px;
            alignment: start;
            Text { width: max(0px,root.width - 32px); height: self.preferred-height; text: root.rows[root.state.active-index].label; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
            Text { width: max(0px,root.width - 32px); height: self.preferred-height; text: root.rows[root.state.active-index].description; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
        }
        @children
        if root.action-label != "" && root.state.active-index >= 0 && root.state.active-index < root.rows.length: KitNavigationAction {
            theme: root.theme; control-size: root.control-size; tab-stop: true; accessible-role: button;
            option-data: {token: root.rows[root.state.active-index].token, generation: root.rows[root.state.active-index].generation, label: root.action-label, description: "", disabled: root.rows[root.state.active-index].disabled};
            activate(token, generation) => { root.activate(token, generation); }
        }
        HorizontalLayout {
            spacing: 8px; alignment: space-between;
            KitButton { theme: root.theme; control-size: root.control-size; text: root.previous-label; disabled: root.state.active-index <= 0; activated => { root.navigate(NavigationStep.previous); } }
            Text { text: root.rows.length == 0 ? "0 / 0" : (root.state.active-index + 1) + " / " + root.rows.length; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; vertical-alignment: center; }
            KitButton { theme: root.theme; control-size: root.control-size; text: root.next-label; disabled: root.rows.length == 0 || root.state.active-index >= root.rows.length - 1; activated => { root.navigate(NavigationStep.next); } }
        }
    }
}

export component KitBreadcrumbs inherits Rectangle {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows;
    callback activate(int, int);
    min-height: max(KitMetrics.control-height(root.control-size, root.theme.text-scale), 20px * root.theme.text-scale + 16px);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    accessible-role: navigation;
    accessible-label: "Breadcrumbs";
    viewport := ScrollView {
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: max(self.visible-width, strip.preferred-width);
        content-height: self.visible-height;
        strip := HorizontalLayout {
            width: viewport.content-width; height: viewport.visible-height;
            spacing: 4px; alignment: start;
            for row[index] in root.rows: HorizontalLayout {
                spacing: 4px;
                if index > 0: Rectangle { width: 16px; horizontal-stretch: 0;
                    KitIcon { y: (parent.height - self.height) / 2; kind: IconKind.chevron-right; ink: root.theme.text-secondary; }
                }
                if index < root.rows.length - 1: KitNavigationAction {
                    theme: root.theme; control-size: root.control-size;
                    option-data: row;
                    control-width: ControlWidth.intrinsic;
                    tab-stop: true;
                    accessible-role: button;
                    activate(token, generation) => { root.activate(token, generation); }
                }
                if index == root.rows.length - 1: Text {
                    text: row.label; color: root.theme.text-primary;
                    font-size: 14px * root.theme.text-scale;
                    vertical-alignment: center; overflow: elide;
                }
            }
        }
    }
}

// Integers are a projection boundary; a Rust pagination controller validates
// the page index/count. This view never mutates a remote collection itself.
export component KitPagination inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <int> page-index;
    in property <int> page-count;
    in property <string> previous-label: "Previous";
    in property <string> next-label: "Next";
    callback navigate(NavigationStep);
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    accessible-role: navigation;
    accessible-label: "Pagination";
    KitButton { theme: root.theme; control-size: root.control-size; text: root.previous-label; disabled: root.page-index <= 0 || root.page-count <= 0; activated => { root.navigate(NavigationStep.previous); } }
    Text { text: root.page-count <= 0 ? "0 / 0" : (min(max(0, root.page-index), root.page-count - 1) + 1) + " / " + root.page-count; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; vertical-alignment: center; }
    KitButton { theme: root.theme; control-size: root.control-size; text: root.next-label; disabled: root.page-count <= 0 || root.page-index >= root.page-count - 1; activated => { root.navigate(NavigationStep.next); } }
}

export component KitNotificationButton inherits KitPressable {
    in property <int> unread-count;
    in property <string> label: "Notifications";
    out property <string> text: root.label + (root.unread-count > 0 ? " (" + root.unread-count + ")" : "");
    accessible-name: root.text;
    min-width: label-text.preferred-width + 24px + 2 * root.recipe.padding-inline;
    preferred-width: self.min-width;
    HorizontalLayout {
        spacing: 8px;
        Rectangle { width: 16px; horizontal-stretch: 0;
            KitIcon { y: (parent.height - self.height) / 2; kind: IconKind.bell; ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground; }
        }
        label-text := Text {
            text: root.text;
            color: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
            font-size: root.recipe.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Keep the identity snapshot from KitOption while presenting ordinary button
// recipes rather than a menu row's transparent selection treatment.
component NotificationAction inherits KitOption {
    in property <string> alternate-label;
    control-width: ControlWidth.intrinsic;
    tab-stop: true;
    accessible-role: button;
    min-width: max(label.preferred-width,alternate.preferred-width) + 2 * root.recipe.padding-inline;
    preferred-width: self.min-width;
    background: root.disabled ? root.recipe.disabled-fill : root.pressed ? root.recipe.pressed-fill : root.hovered ? root.recipe.hover-fill : root.recipe.fill;
    border-width: root.recipe.border-width;
    border-color: root.recipe.border;
    label := Text {
        x: 0px; y: 0px; width: max(0px,root.width - 2 * root.recipe.padding-inline); height: max(0px,root.height - 2 * root.recipe.padding-block);
        text: root.option-data.label; color: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground;
        font-size: root.recipe.font-size; horizontal-alignment: center; vertical-alignment: center;
    }
    alternate := Text { visible: false; text: root.alternate-label; font-size: root.recipe.font-size; }
}
enum NotificationItemPhase { visible, dismissing }
component NotificationItem inherits Rectangle {
    accessible-role: list-item;
    accessible-label: root.notice.item.label;
    in property <KitTheme> theme;
    in property <ControlSize> control-size;
    in property <NotificationRow> notice;
    in property <int> focus-token;
    in property <int> focus-request;
    in property <string> open-label;
    in property <string> mark-read-label;
    in property <string> read-label;
    in property <string> dismiss-label;
    in property <bool> disabled;
    callback activate(int,int);
    callback mark-read(int,int);
    callback dismiss-row(int,int);
    preferred-height: notice-content.preferred-height + 1px;
    private property <NotificationItemPhase> phase;
    private property <int> dismiss-token;
    private property <int> dismiss-generation;
    private property <bool> inactive: root.disabled || root.phase == NotificationItemPhase.dismissing;
    private property <int> identity-token: root.notice.item.token;
    private property <int> identity-generation: root.notice.item.generation;
    changed identity-token => { root.phase = NotificationItemPhase.visible; }
    changed identity-generation => { root.phase = NotificationItemPhase.visible; }
    opacity: root.phase == NotificationItemPhase.dismissing ? 0 : 1;
    animate opacity { duration: root.theme.reduced-motion ? 0ms : 150ms; }
    Timer {
        running: root.phase == NotificationItemPhase.dismissing;
        interval: root.theme.reduced-motion ? 0ms : 150ms;
        triggered => {
            root.phase = NotificationItemPhase.visible;
            root.dismiss-row(root.dismiss-token,root.dismiss-generation);
        }
    }

            private property <int> request: root.focus-request;
            changed request => { if (root.focus-token == root.notice.item.token) { open-preview.take-focus(); } }
            height: notice-content.preferred-height + 1px;
            background: root.theme.surface-raised;
            notice-content := VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: self.preferred-height;
                padding: 16px; spacing: 8px; alignment: start;
                HorizontalLayout { spacing: 8px; alignment: start;
                    Text { text: root.notice.item.label; horizontal-stretch: 1; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; }
                    Text { text: "•"; color: root.theme.accent; font-size: 16px; opacity: root.notice.read ? 0 : 1; horizontal-stretch: 0; }
                }
                Text { text: root.notice.item.description; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                FlexboxLayout {
                    spacing: 8px; alignment: start;
                    open-preview := NotificationAction { theme: root.theme; control-size: root.control-size; intent: ButtonIntent.secondary; option-data: {token:root.notice.item.token,generation:root.notice.item.generation,label:root.open-label,description:"",disabled:root.notice.item.disabled || root.inactive}; activate(token,generation) => {root.activate(token,generation);} }
                    NotificationAction { theme: root.theme; control-size: root.control-size; intent: ButtonIntent.quiet; alternate-label: root.notice.read ? root.mark-read-label : root.read-label; option-data: {token:root.notice.item.token,generation:root.notice.item.generation,label:root.notice.read ? root.read-label : root.mark-read-label,description:"",disabled:root.notice.read || root.inactive}; activate(token,generation) => {root.mark-read(token,generation);} }
                    NotificationAction { theme: root.theme; control-size: root.control-size; intent: ButtonIntent.quiet; option-data: {token:root.notice.item.token,generation:root.notice.item.generation,label:root.dismiss-label,description:"",disabled:root.inactive}; activate(token,generation) => {root.dismiss-token = token; root.dismiss-generation = generation; root.phase = NotificationItemPhase.dismissing;} }
                }
            }
            Rectangle { x: 16px; y: parent.height - 1px; width: max(0px,parent.width - 32px); height: 1px; background: root.theme.border-subtle; }

}

export component KitNotificationCenter inherits Rectangle {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[NotificationRow]> rows;
    in property <int> focus-token: -1;
    in property <int> focus-request;
    in property <string> empty-label: "No notifications";
    in property <string> empty-description: "You are all caught up.";
    in property <string> open-label: "Open preview";
    in property <string> mark-read-label: "Mark read";
    in property <string> read-label: "Read";
    in property <string> dismiss-label: "Dismiss";
    in property <bool> disabled;
    callback activate(int, int);
    callback mark-read(int, int);
    callback dismiss-row(int, int);
    accessible-role: AccessibleRole.list;
    accessible-label: "Notifications";
    min-height: 100px;
    // Measure a bounded inbox exactly. Unbounded message collections retain a
    // finite virtual viewport and never create every native action delegate.
    out property <length> content-height: root.rows.length <= 32 ? bounded-content.preferred-height : virtual-list.content-height;
    preferred-height: root.rows.length == 0 ? 100px : root.rows.length <= 32 ? min(600px,bounded-content.preferred-height) : 400px;
    if root.rows.length == 0: VerticalLayout {
        alignment: center; spacing: 8px;
        Text { text: root.empty-label; color: root.theme.text-primary; font-size: 16px * root.theme.text-scale; font-weight: 600; horizontal-alignment: center; }
        Text { text: root.empty-description; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; horizontal-alignment: center; }
    }
    ScrollView {
        visible: root.rows.length > 0 && root.rows.length <= 32;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-on;
        content-width: self.visible-width;
        content-height: max(self.visible-height,bounded-content.preferred-height);
        bounded-content := VerticalLayout {
            x: 0px; y: 0px; width: parent.visible-width; height: self.preferred-height; alignment: start; spacing: 0px;
            for row in root.rows.length <= 32 ? root.rows : []: NotificationItem {
                theme: root.theme; control-size: root.control-size; notice: row;
                focus-token: root.focus-token; focus-request: root.focus-request;
                open-label: root.open-label; mark-read-label: root.mark-read-label; read-label: root.read-label; dismiss-label: root.dismiss-label; disabled: root.disabled;
                activate(token,generation) => { root.activate(token,generation); }
                mark-read(token,generation) => { root.mark-read(token,generation); }
                dismiss-row(token,generation) => { root.dismiss-row(token,generation); }
            }
        }
    }
    virtual-list := ListView {
        visible: root.rows.length > 32;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-on;
        for row in root.rows.length > 32 ? root.rows : []: NotificationItem {
            theme: root.theme; control-size: root.control-size; notice: row;
                focus-token: root.focus-token; focus-request: root.focus-request;
                open-label: root.open-label; mark-read-label: root.mark-read-label; read-label: root.read-label; dismiss-label: root.dismiss-label; disabled: root.disabled;
                activate(token,generation) => { root.activate(token,generation); }
                mark-read(token,generation) => { root.mark-read(token,generation); }
                dismiss-row(token,generation) => { root.dismiss-row(token,generation); }
        }
    }
}

// OverlayStack and the focus registry remain the authority for modal ownership.
// Render last; host connects dismiss, focus-next and restore-focus callbacks.
export component KitDrawer inherits KitDialogSurface {
    in property <ControlSize> control-size: ControlSize.medium;
    in property <string> title;
    in property <string> close-label: "Close panel";
    in property <length> panel-width: 380px;
    callback restore-focus();
    callback close-focus-observed(bool);
    public function take-focus() { close-button.take-focus(); }
    private property <bool> opened: root.state.open;
    init => { if (root.state.open) { close-button.take-focus(); } }
    changed opened => {
        if (root.opened) { close-button.take-focus(); }
        else { root.restore-focus(); }
    }
    KitDialogPanel {
        theme: root.theme;
        accessible-name: root.title;
        x: root.width - self.width; y: 0px;
        width: min(root.width, max(0px, root.panel-width));
        height: root.height;
        border-radius: 0px;
        VerticalLayout {
            padding: 16px; spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                Text { horizontal-stretch: 1; text: root.title; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
                close-button := KitIconButton {
                    theme: root.theme; control-size: root.control-size; icon: IconKind.close;
                    accessible-name: root.close-label;
                    disabled: root.state.busy || !root.state.topmost;
                    focus-observed(focused) => { root.close-focus-observed(focused); }
                    activated => { root.dismiss(CloseReason.programmatic); }
                }
            }
            @children
        }
    }
}
