            Rectangle { width: KitMetrics.icon-size(root.theme, root.control-size); horizontal-stretch: 0;
                TurningIcon { theme: root.theme; control-size: root.control-size; y: (parent.height - self.height) / 2; turned: root.expanded; rest-glyph: root.theme.icons.chevron-right; turned-glyph: root.theme.icons.chevron-down; turn: 90deg; ink: root.disabled ? trigger.recipe.disabled-foreground : trigger.recipe.foreground; }
