// OverlayStack and the focus registry remain the authority for modal ownership.
// Render last; host connects dismiss, focus-next and restore-focus callbacks.
export enum DrawerSide { start, end, top, bottom }
export component KitDrawer inherits KitDialogSurface {
    in property <ControlSize> control-size: ControlSize.medium;
    in property <string> title;
    in property <string> close-label: "Close panel";
    // Edge the panel attaches to. `start` and `end` follow the theme direction,
    // so `end` is the right edge in left-to-right and the left edge in right-to-left.
    in property <DrawerSide> side: DrawerSide.end;
    // Panel extent across `start` and `end`; ignored for `top` and `bottom`.
    in property <length> panel-width: 380px;
    // Panel extent for `top` and `bottom`; ignored for `start` and `end`.
    in property <length> panel-height: 320px;
    private property <bool> horizontal-edge: root.side == DrawerSide.top || root.side == DrawerSide.bottom;
    private property <bool> at-right: (root.side == DrawerSide.end) != (root.theme.direction == ChoiceFlow.right-to-left);
    callback restore-focus();
    callback close-focus-observed(bool);
    public function take-focus() { close-button.take-focus(); }
    private property <bool> opened: root.state.open;
    init => { if (root.state.open) { close-button.take-focus(); } }
    changed opened => {
        if (root.opened) { close-button.take-focus(); }
        else { root.restore-focus(); }
    }
    KitDialogPanel {
        theme: root.theme;
        accessible-name: root.title;
