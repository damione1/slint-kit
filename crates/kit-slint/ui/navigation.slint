        content-height: max(self.visible-height,bounded-content.preferred-height);
        bounded-content := VerticalLayout {
            x: 0px; y: 0px; width: parent.visible-width; height: self.preferred-height; alignment: start; spacing: 0px;
            for row in root.rows.length <= 32 ? root.rows : []: NotificationItem {
                theme: root.theme; control-size: root.control-size; notice: row;
                focus-token: root.focus-token; focus-request: root.reveal-serial; focus-pending: root.focus-pending; unread-label: root.unread-label;
                focus-taken => { root.focus-pending = false; }
                open-label: root.open-label; mark-read-label: root.mark-read-label; read-label: root.read-label; dismiss-label: root.dismiss-label; disabled: root.disabled;
                activate(token,generation) => { root.activate(token,generation); }
                mark-read(token,generation) => { root.mark-read(token,generation); }
                dismiss-row(token,generation) => { root.dismiss-row(token,generation); }
