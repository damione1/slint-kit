    preferred-width: self.min-width;
    HorizontalLayout {
        spacing: KitMetrics.inline-gap(root.theme);
        Rectangle { width: root.icon-size; horizontal-stretch: 0;
            KitIcon { theme: root.theme; control-size: root.control-size; y: (parent.height - self.height) / 2; glyph: root.theme.icons.bell; ink: root.disabled ? root.recipe.disabled-foreground : root.recipe.foreground; }
        }
        label-text := Text {
