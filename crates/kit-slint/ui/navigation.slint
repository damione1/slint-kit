import { KitStrings } from "strings.slint";
import { KitKeyResult } from "keyboard.slint";
import { FocusOutline } from "focus.slint";
import { KitSelection, KitSelectionService } from "selection-service.slint";
import { Ownership } from "shared-contracts.slint";
import { SelectionRef, SelectionAvailability } from "contracts.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { ListView, ScrollFrame } from "scroll.slint";
import { KitStack, LayoutSpace } from "layout.slint";
import { KitTheme, KitThemes, ControlWidth, ControlSize, KitMetrics, ButtonIntent, KitThemeContext, TypographyRole, SurfaceLevel, SurfaceRecipe, OptionRecipe, ChoiceFlow, ChoiceDirection } from "theme.slint";
import { KitPressable, KitButton, KitIconButton } from "button.slint";
import { KitOption, KitSelectKeyboard } from "select.slint";
import { KitIcon, KitGlyphs, TurningIcon, IconGlyph } from "icons.slint";
import { KitFieldService, PopupViewport, PopupGeometry } from "field-service.slint";
import { ElevatedSurface } from "elevation.slint";
import { KitDialogSurface, KitDialogPanel } from "dialog.slint";
import { KitModalContext } from "modal.slint";
import { OptionRow, SelectState, NavigationStep, CloseReason, DialogState } from "contracts.slint";
export { OptionRow, SelectState, NavigationStep, CloseReason, DialogState } from "contracts.slint";
import { ExpansionMode, DisclosureRow } from "contracts.slint";
export { ExpansionMode, DisclosureRow } from "contracts.slint";
export enum TabActivation { manual, automatic }
export struct NotificationRow { item: OptionRow, read: bool }

// What a menu row is. Separator and group rows are decoration: they take no
// pointer, focus or activation, and the model must mark them `disabled` so the
// shared navigation skips them.
export enum MenuItemKind { action, checkbox, radio, separator, group }
// The presentation of the menu row at the same index of `options`. Identity,
// label and activation stay in the `OptionRow`; a missing entry is a plain action.
export struct MenuItem { kind: MenuItemKind, leading-icon: IconGlyph, shortcut: string, destructive: bool, checked: bool }

// One row owns activation and snapshots its identity through KitOption, and
// shares its option recipe: a tint for the active and selected rows and the
// inset ring on the active one.
export component KitNavigationAction inherits KitOption {
    in property <length> trailing-space;
    in property <TextHorizontalAlignment> label-alignment: root.control-width == ControlWidth.fill ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
    // Menu presentation; the default entry is a plain labelled action.
    in property <MenuItem> item;
    // Keeps the label of an action, checkbox or radio row aligned with its siblings.
    in property <bool> reserve-leading;
    private property <OptionRecipe> label-recipe: KitThemes.option-recipe(root.theme, root.control-size);
    private property <bool> decoration: root.item.kind == MenuItemKind.separator || root.item.kind == MenuItemKind.group;
    private property <bool> marked: root.item.kind == MenuItemKind.checkbox || root.item.kind == MenuItemKind.radio;
    private property <bool> has-icon: root.item.leading-icon.stroke != "" || root.item.leading-icon.fill != "";
    private property <length> slot: KitMetrics.icon-size(root.theme, root.control-size);
    private property <length> leading-space: root.reserve-leading && !root.decoration ? root.slot + root.theme.spacing.unit * 2 : 0px;
    private property <length> shortcut-space: root.item.shortcut != "" && !root.decoration ? shortcut-label.preferred-width + root.theme.spacing.unit * 3 : 0px;
    private property <color> ink: root.disabled ? root.label-recipe.disabled-foreground : root.item.destructive ? root.theme.danger
        : root.item.kind == MenuItemKind.group ? root.theme.text-secondary : root.selected ? root.label-recipe.selected-foreground : root.label-recipe.foreground;
    accessible-role: list-item;
    accessible-checkable: root.marked;
    accessible-checked: root.marked && root.item.checked;
    accessible-description: root.item.shortcut == "" ? root.option-data.description
        : root.option-data.description == "" ? root.item.shortcut : root.option-data.description + " " + root.item.shortcut;
    min-width: root.control-width == ControlWidth.fill ? 0px : max(root.preferred-height, label.preferred-width + 2 * root.padding-inline);
    preferred-width: self.min-width;
    if root.marked && root.item.checked: Rectangle {
        x: 0px; y: (root.height - 2 * root.padding-block - self.height) / 2;
        width: root.slot; height: root.slot;
        if root.item.kind == MenuItemKind.checkbox: KitIcon { theme: root.theme; control-size: root.control-size; glyph: root.theme.icons.check; ink: root.ink; }
        if root.item.kind == MenuItemKind.radio: Rectangle {
            width: parent.width / 2; height: self.width;
            border-radius: self.width / 2;
            background: root.ink;
        }
    }
    if !root.marked && root.has-icon && !root.decoration: KitIcon {
        x: 0px; y: (root.height - 2 * root.padding-block - self.height) / 2;
        theme: root.theme; control-size: root.control-size; glyph: root.item.leading-icon; ink: root.ink;
    }
    if root.item.kind == MenuItemKind.separator: Rectangle {
        x: -root.padding-inline; y: (root.height - 2 * root.padding-block - self.height) / 2;
        width: root.width; height: root.theme.shape.border-width;
        background: root.theme.border-subtle;
    }
    label := Text {
        x: root.leading-space; y: 0px;
        width: max(0px, root.width - 2 * root.padding-inline - root.trailing-space - root.leading-space - root.shortcut-space);
        height: max(0px,root.height - 2 * root.padding-block);
        horizontal-alignment: root.label-alignment;
        text: root.item.kind == MenuItemKind.separator ? "" : root.option-data.label;
        color: root.ink;
        font-family: root.theme.typography.family; font-size: root.text-size; font-weight: root.text-weight;
        vertical-alignment: center;
        overflow: elide;
    }
    shortcut-label := Text {
        x: root.width - 2 * root.padding-inline - root.trailing-space - self.preferred-width;
        y: 0px; height: max(0px,root.height - 2 * root.padding-block);
        text: root.decoration ? "" : root.item.shortcut;
        color: root.disabled ? root.label-recipe.disabled-foreground : root.theme.text-secondary;
        font-family: root.theme.typography.family; font-size: root.text-size; font-weight: root.text-weight;
        vertical-alignment: center;
    }
}

// Identity, skip-disabled navigation, and typeahead live in SelectController.
// The composite retains a single tab stop; the model is the source of truth.
export component KitMenu inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows: selection.rows;
    in property <SelectState> state: selection.state;
    in property <string> accessible-name: "Menu";
    in property <length> row-height: KitMetrics.row-height(root.theme, root.control-size);
    in property <bool> wrap: true;
    in property <int> typeahead-timeout-ms: 700;
    // Presentation of the rows, one `MenuItem` per option in the same order.
    in property <[MenuItem]> items;
    // Reserve a leading slot for icons and check marks so labels line up.
    in property <bool> reserve-leading: root.items.length > 0;
    // The tallest natural height before the rows scroll.
    in property <length> max-natural-height: 320px;
    out property <int> page-rows: list.visible-height > 0px && root.row-height > 0px ? max(1, Math.floor(list.visible-height / root.row-height)) : 0;
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    // Includes a row focused on pointer-down, before its activation is committed.
    // Keep that focus in place: transferring it here would cancel the press.
    out property <bool> has-focus: root.live && (keyboard.has-focus || (root.focused-row-token >= 0 && root.focused-row-generation == root.state.generation));
    callback focus-observed(bool);
    private property <int> focused-row-token: -1;
    private property <int> focused-row-generation: -1;
    changed has-focus => { root.focus-observed(root.has-focus); }
    changed live => {
        if (!root.live) { root.focused-row-token = -1; root.focused-row-generation = -1; }
    }
    public function take-focus() { if (root.live) { keyboard.focus(); } }
    public function ensure-active-visible() {
        if (root.state.active-index < 0) { return; }
        let top = root.state.active-index * root.row-height;
        if (top + list.content-y < 0px) { list.content-y = -top; }
        else if (top + root.row-height + list.content-y > list.visible-height) {
            list.content-y = min(0px, list.visible-height - top - root.row-height);
        }
    }
    changed state => { root.ensure-active-visible(); }
    changed row-height => { root.ensure-active-visible(); }
    accessible-role: AccessibleRole.list;
    accessible-label: root.accessible-name;
    accessible-item-count: root.rows.length;
    accessible-orientation: Orientation.vertical;
    preferred-height: min(root.max-natural-height, root.rows.length * root.row-height);
    min-width: 100px;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        enabled: root.live;
        dismiss-on-system-back: false;
        wrap: root.wrap;
        page-rows: root.page-rows;
        typeahead-timeout-ms: root.typeahead-timeout-ms;
        check-typeahead-active => { return selection.is-typeahead-active(); }
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        navigate(step) => { root.handle-navigate(step); }
        activate(token, generation) => { root.handle-activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.handle-dismiss(reason); } }
        typeahead(text) => { root.handle-typeahead(text); }
        list := ListView {
            theme: root.theme;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            for row[index] in root.rows: KitNavigationAction {
                private property <MenuItem> entry: root.items[index];
                disabled: !root.interactive || row.disabled || self.entry.kind == MenuItemKind.separator || self.entry.kind == MenuItemKind.group;
                theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
                option-data: row;
                item: self.entry; reserve-leading: root.reserve-leading;
                accessible-item-index: index; accessible-item-count: root.rows.length;
                active: root.state.active.present && root.state.active.token == row.token;
                selected: root.state.selected.present && root.state.selected.token == row.token;
                focus-indicated: root.has-focus && self.active;
                height: root.row-height;
                private property <OptionRow> focus-identity: row;
                changed focus-identity => {
                    // A reconciled delegate can retain its actual FocusScope.
                    if (self.has-focus) {
                        root.focused-row-token = row.token;
                        root.focused-row-generation = row.generation;
                    }
                }
                focus-observed(focused) => {
                    if (focused) {
                        root.focused-row-token = row.token;
                        root.focused-row-generation = row.generation;
                    } else if (root.focused-row-token == row.token && root.focused-row-generation == row.generation) {
                        root.focused-row-token = -1;
                        root.focused-row-generation = -1;
                    }
                }
                key-event(event) => {
                    if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.PageDown || event.text == Key.PageUp || event.text == Key.Escape) { root.take-focus(); return keyboard.handle-key(event); }
                    return KitKeyResult.reject;
                }
                activate(token, generation) => { root.take-focus(); root.handle-activate(token, generation); }
            }
        }
    }

    in-out property <string> query <=> selection.query;

    in property <[OptionRow]> options;
    in property <Ownership> ownership: Ownership.local;
    in-out property <SelectionRef> selected <=> selection.selected;
    callback chosen(OptionRow);
    selection := KitSelection {
        options: root.options; ownership: root.ownership; persistent: true;
        wrap: root.wrap; page-rows: root.page-rows; typeahead-timeout-ms: root.typeahead-timeout-ms;
        chosen(row) => { root.chosen(row); }
    }
    function handle-navigate(step: NavigationStep) { selection.navigate(step); root.navigate(step); }
    function handle-activate(token: int, generation: int) { selection.activate(token, generation); root.activate(token, generation); }
    function handle-dismiss(reason: CloseReason) { selection.dismiss(reason); root.dismiss(reason); }
    function handle-typeahead(text: string) { selection.typeahead(text); root.typeahead(text); }

    out property <string> selected-label: selection.selected-label;
}

export component KitMenuBar inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows: selection.rows;
    in property <SelectState> state: selection.state;
    in property <string> accessible-name: "Actions";
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <bool> wrap: true;
    in property <int> typeahead-timeout-ms: 700;
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    out property <bool> has-focus: root.live && keyboard.has-focus;
    public function take-focus() { if (root.live) { keyboard.focus(); } }
    public function reveal(left: length, right: length) {
        if (left + viewport.content-x < 0px) { viewport.content-x = -left; }
        else if (right + viewport.content-x > viewport.visible-width) { viewport.content-x = min(0px, viewport.visible-width - right); }
    }
    public function handle-key(event: KeyEvent) -> KitKeyResult {
        if (!root.live) { return KitKeyResult.reject; }
        return keyboard.handle-key(event);
    }
    accessible-role: navigation;
    accessible-label: root.accessible-name;
    accessible-orientation: Orientation.horizontal;
    accessible-item-count: root.rows.length;
    // The single nonvirtualized strip is the entire direct accessible-child
    // sequence. ScrollFrame and its bars are roleless; RTL reverses this loop.
    accessible-delegate-focus: root.state.active-index >= 0 && root.state.active-index < root.rows.length
        ? (root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - root.state.active-index : root.state.active-index) : -1;
    min-height: KitMetrics.row-height(root.theme, root.control-size);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        enabled: root.live;
        dismiss-on-system-back: false;
        navigation-direction: ChoiceDirection.horizontal;
        flow: root.flow;
        wrap: root.wrap;
        typeahead-timeout-ms: root.typeahead-timeout-ms;
        check-typeahead-active => { return selection.is-typeahead-active(); }
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        key-pressed(event) => { return root.handle-key(event) == KitKeyResult.accept ? accept : reject; }
        navigate(step) => { root.handle-navigate(step); }
        activate(token, generation) => { root.handle-activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.handle-dismiss(reason); } }
        typeahead(text) => { root.handle-typeahead(text); }
        viewport := ScrollFrame {
            theme: root.theme;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(self.visible-width, strip.preferred-width);
            content-height: self.visible-height;
            strip := HorizontalLayout {
                width: viewport.content-width;
                height: viewport.visible-height;
                spacing: root.theme.spacing.unit;
                alignment: root.flow == ChoiceFlow.right-to-left ? LayoutAlignment.end : LayoutAlignment.start;
                for index in root.rows.length: KitNavigationAction {
                    private property <OptionRow> entry: root.rows[root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - index : index];
                    theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
                    option-data: self.entry;
                    accessible-item-index: root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - index : index;
                    accessible-item-count: root.rows.length;
                    disabled: !root.interactive || self.entry.disabled;
                    control-width: ControlWidth.intrinsic;
                    active: root.state.active.present && root.state.active.token == self.entry.token;
                    selected: root.state.selected.present && root.state.selected.token == self.entry.token;
                    focus-indicated: root.live && self.active && (keyboard.has-focus || self.has-focus);
                    changed active => { if (self.active) { root.reveal(self.x, self.x + self.width); } }
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.Escape) { root.take-focus(); return root.handle-key(event); }
                        return KitKeyResult.reject;
                    }
                    activate(token, generation) => { root.take-focus(); root.handle-activate(token, generation); }
                }
            }
        }
    }

    in-out property <string> query <=> selection.query;

    in property <[OptionRow]> options;
    in property <Ownership> ownership: Ownership.local;
    in-out property <SelectionRef> selected <=> selection.selected;
    callback chosen(OptionRow);
    selection := KitSelection {
        options: root.options; ownership: root.ownership; persistent: true;
        wrap: root.wrap; typeahead-timeout-ms: root.typeahead-timeout-ms;
        chosen(row) => { root.chosen(row); }
    }
    function handle-navigate(step: NavigationStep) { selection.navigate(step); root.navigate(step); }
    function handle-activate(token: int, generation: int) { selection.activate(token, generation); root.activate(token, generation); }
    function handle-dismiss(reason: CloseReason) { selection.dismiss(reason); root.dismiss(reason); }
    function handle-typeahead(text: string) { selection.typeahead(text); root.typeahead(text); }

    out property <string> selected-label: selection.selected-label;
}

export component KitTabs inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert and its rows ignore pointer and keys.
    in property <int> modal-layer;
    private property <bool> live: root.interactive && !KitModalContext.inert(root.modal-layer);
    in property <bool> interactive: true;
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <[OptionRow]> rows: selection.rows;
    in property <SelectState> state: selection.state;
    in property <string> accessible-name: "Tabs";
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <TabActivation> activation: TabActivation.manual;
    // intrinsic sizes each tab to its label and scrolls on overflow; fill gives
    // every tab an equal share of the strip and elides labels that do not fit.
    in property <ControlWidth> tab-width: ControlWidth.intrinsic;
    in property <bool> typeahead-enabled: false;
    in property <bool> wrap: true;
    in property <int> typeahead-timeout-ms: 700;
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    out property <bool> has-focus: root.live && keyboard.has-focus;
    public function take-focus() { if (root.live) { keyboard.focus(); } }
    public function reveal(left: length, right: length) {
        if (left + viewport.content-x < 0px) { viewport.content-x = -left; }
        else if (right + viewport.content-x > viewport.visible-width) { viewport.content-x = min(0px, viewport.visible-width - right); }
    }
    public function handle-key(event: KeyEvent) -> KitKeyResult {
        if (!root.live) { return KitKeyResult.reject; }
        return keyboard.handle-key(event);
    }
    private property <OptionRecipe> tab-recipe: KitThemes.option-recipe(root.theme, root.control-size);
    accessible-role: tab-list;
    accessible-label: root.accessible-name;
    accessible-orientation: Orientation.horizontal;
    accessible-item-count: root.rows.length;
    // The single nonvirtualized strip is the entire direct accessible-child
    // sequence. ScrollFrame and its bars are roleless; RTL reverses this loop.
    accessible-delegate-focus: root.state.active-index >= 0 && root.state.active-index < root.rows.length
        ? (root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - root.state.active-index : root.state.active-index) : -1;
    // Reserve the horizontal gutter without clipping the tab row.
    min-height: KitMetrics.row-height(root.theme, root.control-size) + KitThemes.scroll-bar-recipe(root.theme).thickness;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    forward-focus: keyboard;
    keyboard := KitSelectKeyboard {
        enabled: root.live;
        dismiss-on-system-back: false;
        dismiss-on-escape: false;
        typeahead-enabled: root.typeahead-enabled;
        navigation-direction: ChoiceDirection.horizontal;
        flow: root.flow;
        wrap: root.wrap;
        typeahead-timeout-ms: root.typeahead-timeout-ms;
        // Space always activates a tab, including after optional typeahead.
        check-typeahead-active => { return false; }
        state: { open: true, active: root.state.active, active-index: root.state.active-index, selected: root.state.selected, selection-availability: root.state.selection-availability, generation: root.state.generation };
        focus-on-tab-navigation: true;
        key-pressed(event) => { return root.handle-key(event) == KitKeyResult.accept ? accept : reject; }
        navigate(step) => { root.handle-navigate(step); }
        activate(token, generation) => { root.handle-activate(token, generation); }
        dismiss(reason) => { if (reason != CloseReason.programmatic) { root.handle-dismiss(reason); } }
        typeahead(text) => { root.handle-typeahead(text); }
        viewport := ScrollFrame {
            theme: root.theme;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(self.visible-width, strip.preferred-width);
            content-height: self.visible-height;
            strip := HorizontalLayout {
                width: viewport.content-width;
                height: viewport.visible-height;
                spacing: root.theme.spacing.unit;
                alignment: root.tab-width == ControlWidth.fill ? LayoutAlignment.stretch
                    : root.flow == ChoiceFlow.right-to-left ? LayoutAlignment.end : LayoutAlignment.start;
                for index in root.rows.length: tab-action := KitNavigationAction {
                    private property <OptionRow> entry: root.rows[root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - index : index];
                    theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
                    option-data: self.entry;
                    accessible-item-index: root.flow == ChoiceFlow.right-to-left ? root.rows.length - 1 - index : index;
                    accessible-item-count: root.rows.length;
                    disabled: !root.interactive || self.entry.disabled;
                    accessible-role: tab;
                    control-width: root.tab-width;
                    label-alignment: TextHorizontalAlignment.center;
                    active: root.state.active.present && root.state.active.token == self.entry.token;
                    selected: root.state.selected.present && root.state.selected.token == self.entry.token;
                    focus-indicated: root.live && self.active && (keyboard.has-focus || self.has-focus);
                    // The selected tab carries an underline instead of a tint;
                    // the ring is left to the active (keyboard) tab only.
                    background: self.pressed ? root.tab-recipe.pressed-fill : self.active ? root.tab-recipe.active-fill
                        : self.hovered ? root.tab-recipe.hover-fill : root.tab-recipe.fill;
                    indicator := Rectangle {
                        x: -tab-action.recipe.padding-inline; y: tab-action.height - tab-action.recipe.padding-block - self.height;
                        width: tab-action.width; height: root.theme.shape.border-width-strong;
                        background: root.theme.accent;
                        opacity: tab-action.selected ? 1 : 0;
                        animate opacity { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.fast; }
                    }
                    changed active => { if (self.active) { root.reveal(self.x, self.x + self.width); } }
                    key-event(event) => {
                        if (event.text == Key.RightArrow || event.text == Key.LeftArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.Escape) { root.take-focus(); return root.handle-key(event); }
                        return KitKeyResult.reject;
                    }
                    activate(token, generation) => { root.take-focus(); root.handle-activate(token, generation); }
                }
            }
        }
    }

    in-out property <string> query <=> selection.query;

    in property <[OptionRow]> options;
    in property <Ownership> ownership: Ownership.local;
    in-out property <SelectionRef> selected <=> selection.selected;
    callback chosen(OptionRow);
    selection := KitSelection {
        options: root.options; ownership: root.ownership; persistent: true;
        wrap: root.wrap; typeahead-timeout-ms: root.typeahead-timeout-ms;
        chosen(row) => { root.chosen(row); }
    }
