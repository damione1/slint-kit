        y: root.side == DrawerSide.bottom ? root.height - self.height : 0px;
        width: root.horizontal-edge ? root.width : min(root.width, max(0px, root.panel-width));
        height: root.horizontal-edge ? min(root.height, max(0px, root.panel-height)) : root.height;
        border-radius: 0px;
        VerticalLayout {
            padding: root.theme.spacing.unit * 4; spacing: root.theme.spacing.unit * 4;
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: root.theme.spacing.unit * 3;
                Text { horizontal-stretch: 1; text: root.title; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; vertical-alignment: center; }
                close-button := KitIconButton {
                    theme: root.theme; control-size: root.control-size; glyph: root.theme.icons.close;
                    accessible-name: root.close-label;
                    modal-layer: root.modal-layer;
                    disabled: root.state.busy || !root.state.topmost;
