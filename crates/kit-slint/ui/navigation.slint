    min-width: layout.min-width;
    preferred-width: layout.preferred-width;
    min-height: layout.min-height;
    preferred-height: layout.preferred-height;
    vertical-stretch: 0;
    layout := VerticalLayout {
        trigger := KitButton {
            theme: root.theme; control-size: root.control-size; intent: root.intent; modal-layer: root.modal-layer;
            text: root.text; leading-icon: root.leading-icon; trailing-icon: root.trailing-icon;
            accessible-name: root.accessible-name;
            disabled: root.disabled;
