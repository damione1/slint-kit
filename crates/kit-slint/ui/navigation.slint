}

// Keep native child editors mounted while collapsing the inactive panel's
// layout contribution. The tab reference comes from the same Choices model as
// the tab strip state; view positions never identify a panel.
export component KitTabPanel inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <LayoutSpace> inset: LayoutSpace.none;
    in property <SelectState> state;
    in property <SelectionRef> tab;
    in property <string> accessible-name;
    in property <bool> tab-stop: false;
