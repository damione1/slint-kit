import { FormConstraintState, KitFormValidation, KitValidityState, HtmlInputKind } from "validation.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitFieldError } from "field.slint";
import { KitTheme, KitThemes, ButtonIntent, ControlSize, KitThemeContext, KitMetrics, TypographyRole } from "theme.slint";
import { KitButton } from "button.slint";
import { FieldAccess } from "contracts.slint";
import { FileSelectionMode } from "shared-contracts.slint";
export { FileSelectionMode } from "shared-contracts.slint";

export enum HostRequestPresentation { idle, pending, cancelled, failed, unsupported }
export enum DropCapability { unsupported, available }
export struct FileViewEntry { token: int, generation: int, name: string, detail: string, removable: bool }

component FileRemoveButton inherits KitButton {
    in property <FileViewEntry> entry;
    callback remove-requested(int,int);
    private property <int> press-token;
    private property <int> press-generation;
    text: "Remove";
    accessible-name: "Remove " + root.entry.name;
    intent: ButtonIntent.quiet;
    activation-started => { root.press-token = root.entry.token; root.press-generation = root.entry.generation; }
    changed entry => { root.cancel-press(); }
    activated => { root.remove-requested(root.press-token,root.press-generation); }
}

export component KitFileList inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[FileViewEntry]> entries;
    callback remove-requested(int,int);
    accessible-role: list;
    accessible-label: "Selected files";
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        for entry in root.entries: Rectangle {
            border-radius: root.theme.shape.radius-control; background: root.theme.canvas;
            HorizontalLayout {
                padding: root.theme.spacing.unit * 2.5; spacing: root.theme.spacing.unit * 3;
                VerticalLayout {
                    spacing: root.theme.spacing.unit;
                    Text { text: entry.name; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
                    if entry.detail != "": Text { text: entry.detail; color: root.theme.text-secondary; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
                }
                FileRemoveButton {
                    theme: root.theme; control-size:root.control-size; entry: entry;
                    disabled: root.access != FieldAccess.editable || !entry.removable;
                    remove-requested(token,generation) => { root.remove-requested(token,generation); }
                }
            }
        }
    }
}

export component KitFilePicker inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.file; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        selected-count: root.entries.length;
        invalid => { root.invalid(); }
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <FileSelectionMode> mode: FileSelectionMode.single;
    in property <HostRequestPresentation> request-state: HostRequestPresentation.idle;
    in property <[FileViewEntry]> entries;
    in property <string> label: "Attachments";
    in property <string> description;
    in property <string> error;
    // Shown when the host reports a failed request without a specific error.
    in property <string> failed-label: "File selection failed.";
    callback browse-requested(FileSelectionMode);
    callback remove-requested(int,int);
    public function take-focus() { browse.take-focus(); }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        Text { text: root.label; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        browse := KitButton {
            theme: root.theme; control-size:root.control-size; text: root.mode == FileSelectionMode.single ? "Choose file…" : "Choose files…";
            accessible-name: self.text + " " + root.label;
            disabled: root.access != FieldAccess.editable || root.request-state == HostRequestPresentation.unsupported;
            busy: root.request-state == HostRequestPresentation.pending;
            activated => { root.browse-requested(root.mode); }
        }
        if root.description != "": Text { text: root.description; color: root.theme.text-secondary; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
        if root.request-state == HostRequestPresentation.unsupported: Text { text: "File selection is unavailable on this platform."; color: root.theme.text-secondary; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
        if root.request-state == HostRequestPresentation.cancelled: Text {text:"Selection cancelled.";color:root.theme.text-secondary;font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);wrap:word-wrap;accessible-live-region:polite;}
        if root.request-state == HostRequestPresentation.failed && root.error == "": KitFieldError { theme: root.theme; text: root.failed-label; }
        if root.error == "" && checks.show-error: KitFieldError { theme: root.theme; text: checks.validation-message; }
        if root.error != "": KitFieldError { theme: root.theme; text: root.error; }
        KitFileList { theme: root.theme; control-size:root.control-size; access: root.access; entries: root.entries; remove-requested(token,generation) => { root.remove-requested(token,generation); } }
    }
}

export component KitDirectoryPicker inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.file; access: root.access; required: root.required;
        custom-validity <=> root.custom-validity; required-message: root.required-message;
        selected-count: root.selected-name != "" ? 1 : 0;
        invalid => { root.invalid(); }
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <HostRequestPresentation> request-state: HostRequestPresentation.idle;
    in property <string> label: "Folder";
    in property <string> selected-name;
    in property <string> error;
    // Shown when the host reports a failed request without a specific error.
    in property <string> failed-label: "Folder selection failed.";
    callback browse-requested();
    callback clear-requested();
    public function take-focus() { browse.take-focus(); }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        Text { text: root.label; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        browse := KitButton { theme: root.theme; control-size:root.control-size; text: "Choose folder…"; disabled: root.access != FieldAccess.editable || root.request-state == HostRequestPresentation.unsupported; busy: root.request-state == HostRequestPresentation.pending; activated => { root.browse-requested(); } }
        if root.selected-name != "": HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            Text { text: root.selected-name; color: root.theme.text-primary; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; vertical-alignment: center; }
            KitButton { theme: root.theme; control-size:root.control-size; text: "Clear folder"; intent: ButtonIntent.quiet; disabled: root.access != FieldAccess.editable; activated => { root.clear-requested(); } }
        }
        if root.request-state == HostRequestPresentation.unsupported: Text { text: "Folder selection is unavailable on this platform."; color: root.theme.text-secondary; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
        if root.request-state == HostRequestPresentation.cancelled: Text {text:"Selection cancelled.";color:root.theme.text-secondary;font-size:KitMetrics.font-size(root.theme, TypographyRole.caption);wrap:word-wrap;accessible-live-region:polite;}
        if root.request-state == HostRequestPresentation.failed && root.error == "": KitFieldError { theme: root.theme; text: root.failed-label; }
        if root.error == "" && checks.show-error: KitFieldError { theme: root.theme; text: checks.validation-message; }
        if root.error != "": KitFieldError { theme: root.theme; text: root.error; }
    }
}

// DropEvent.data is the public native data-transfer handle; the application
// checks MIME/types in can-drop and resolves handles asynchronously in dropped.
// The available flag is a host capability, never guessed from pointer events.
export component KitFileDropZone inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <DropCapability> capability: DropCapability.unsupported;
    in property <string> label: "Drop files here";
    in property <string> unsupported-label: "Drag and drop is unavailable; use Choose files.";
    in property <string> error;
    callback can-drop(DropEvent) -> DragAction;
    callback dropped(DropEvent) -> DragAction;
    in property <bool> host-drag-hovered;
    out property <bool> drag-hovered: drop.has-drag || root.host-drag-hovered;
    min-height: max(100px, 64px * root.theme.text-scale);
    vertical-stretch: 0;
    border-radius: root.theme.shape.radius-container;
    border-width: root.drag-hovered ? root.theme.shape.border-width-strong : root.theme.shape.border-width;
    border-color: root.error != "" ? root.theme.danger : root.drag-hovered ? root.theme.accent : root.theme.border-subtle;
    background: root.access == FieldAccess.disabled ? root.theme.disabled-fill : root.drag-hovered ? root.theme.hover : root.theme.canvas;
    accessible-role: groupbox;
    accessible-label: root.capability == DropCapability.available ? root.label : root.unsupported-label;
    VerticalLayout {
        padding: root.theme.spacing.unit * 4; spacing: root.theme.spacing.unit * 2;
        Text { text: root.capability == DropCapability.available ? root.label : root.unsupported-label; color: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-secondary; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        if root.error != "": KitFieldError { theme: root.theme; text: root.error; }
    }
    drop := DropArea {
        enabled: root.capability == DropCapability.available && root.access == FieldAccess.editable;
        can-drop(event) => { return root.can-drop(event); }
        dropped(event) => { return root.dropped(event); }
    }
}
