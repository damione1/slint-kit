// View projection. Core adapters validate every token and generation.
import { SelectionAvailability } from "shared-contracts.slint";
export { NavigationStep, CloseReason, SelectionAvailability, FieldAccess, CommitPolicy, ValidationPresentation, TextPurpose, SecretVisibility, StepDirection } from "shared-contracts.slint";
export struct OptionRow { token: int, generation: int, label: string, description: string, disabled: bool }
export struct SelectionRef { present: bool, token: int }
export struct SelectState { selection-availability: SelectionAvailability, selected: SelectionRef, active: SelectionRef, open: bool, active-index: int, generation: int }
export struct FocusRequest { present: bool, token: int, generation: int, request: int }
export struct DialogState { open: bool, topmost: bool, busy: bool }

export struct ChoiceRow { token: int, label: string, disabled: bool, selected: bool }
