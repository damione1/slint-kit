import { KitTheme, KitThemes, KitMetrics, TypographyRole, ControlSize, FieldRecipe, KitThemeContext } from "theme.slint";
import { FocusOutline } from "focus.slint";
import { KitPressable } from "button.slint";
import { ButtonIntent, ControlWidth } from "theme.slint";
import { FocusRequest } from "contracts.slint";
import { FieldAccess, ValidationPresentation } from "shared-contracts.slint";
export { FieldAccess, ValidationPresentation } from "shared-contracts.slint";

export component KitField inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.help-gap(root.theme);
    alignment: start;
    vertical-stretch: 0;
    @children
}
export component KitFieldLabel inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> text;
    in property <FieldAccess> access: FieldAccess.editable;
    callback focus-requested();
    vertical-stretch: 0;
    // Let the layout propagate height-for-width constraints. Reading a child's
    // preferred-height back into this rectangle recurses when a wrapping parent
    // measures the field before assigning its final width.
    VerticalLayout {
        padding-bottom: KitMetrics.label-gap(root.theme) - KitMetrics.help-gap(root.theme);
        label := Text {
            horizontal-alignment: left;
            text: root.text;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
            font-weight: root.theme.typography.weight-semibold;
            color: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-primary;
            wrap: word-wrap;
        }
    }
    TouchArea { enabled: root.access != FieldAccess.disabled; clicked => { root.focus-requested(); } }
}
export component KitFieldDescription inherits Text {
    in property <KitTheme> theme: KitThemeContext.current;
    horizontal-alignment: left;
    color: root.theme.text-secondary;
    font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
    wrap: word-wrap;
    vertical-stretch: 0;
}
export component KitFieldError inherits KitFieldDescription {
    color: root.theme.danger;
    accessible-role: text;
    accessible-live-region: polite;
}
export component KitFieldGroup inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.field-gap(root.theme);
    alignment: start;
    vertical-stretch: 0;
    @children
}
export component KitFieldSet inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> legend;
    accessible-role: groupbox;
    accessible-label: root.legend;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout {
        alignment: start;
        spacing: KitMetrics.field-gap(root.theme);
        if root.legend != "": Text {
            text: root.legend;
            color: root.theme.text-primary;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
            font-weight: root.theme.typography.weight-semibold;
            wrap: word-wrap;
        }
        @children
    }
}
export component KitInputGroup inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <bool> focused;
    out property <bool> hovered: hover.has-hover;
    private property <FieldRecipe> recipe: KitThemes.field-recipe(root.theme, root.control-size, root.access, root.validation);
    in property <length> padding-inline: root.recipe.padding-inline;
    in property <length> padding-block: root.recipe.padding-block;
    min-height: root.recipe.height;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    background: root.recipe.fill;
    border-radius: root.recipe.radius;
    border-width: root.recipe.border-width;
    border-color: root.hovered && !root.focused ? root.recipe.hover-border : root.recipe.border;
    // A parent TouchArea observes hover before its children see the event,
    // so the native editor and actions keep every press, caret and selection.
    hover := TouchArea {
        Rectangle {
            x: root.padding-inline; y: root.padding-block;
            width: max(0px, parent.width - 2 * root.padding-inline);
            height: max(0px, parent.height - 2 * root.padding-block);
            @children
        }
    }
    if root.focused: FocusOutline {
        ring: root.recipe.focus; radius: root.recipe.radius;
        host-width: root.width; host-height: root.height;
    }
}
export component KitFieldSeparator inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    height: root.theme.shape.border-width;
    background: root.theme.border-subtle;
    vertical-stretch: 0;
}

// Place these parts alongside a native editor inside an InputGroup's single
// children surface. They do not add padding, borders or another focus target.
export component KitInputGroupStart inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.label-gap(root.theme);
    alignment: start;
    horizontal-stretch: 0;
    @children
}
export component KitInputGroupEnd inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.label-gap(root.theme);
    alignment: end;
    horizontal-stretch: 0;
    @children
}
export component KitInputGroupText inherits Text {
    in property <KitTheme> theme: KitThemeContext.current;
    font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
    color: root.theme.text-secondary;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

export struct FormErrorRow { target: FocusRequest, message: string }
export component KitFormErrorSummary inherits KitFieldGroup {
    in property <string> title: "Please check these fields";
    in property <[FormErrorRow]> errors;
    callback error-activated(FocusRequest);
    spacing: KitMetrics.help-gap(root.theme);
    if root.errors.length > 0: KitFieldError { theme: root.theme; text: root.title + " (" + root.errors.length + ")"; font-weight: root.theme.typography.weight-semibold; }
    for error in root.errors: error-action := KitPressable {
        theme: root.theme; intent: ButtonIntent.quiet; control-width: ControlWidth.fill;
        accessible-name: error.message;
        preferred-height: max(KitMetrics.density(root.theme, ControlSize.compact).height, message.preferred-height + 2 * error-action.recipe.padding-block);
        min-height: self.preferred-height;
        activated => { root.error-activated(error.target); }
        message := Text {
            x: 0px; y: 0px;
            width: max(0px, error-action.width - 2 * error-action.recipe.padding-inline);
            height: max(0px, error-action.height - 2 * error-action.recipe.padding-block);
            text: error.message;
            color: root.theme.danger;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
            wrap: word-wrap;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
}
