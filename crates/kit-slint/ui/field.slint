import { KitStrings } from "strings.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitTheme, KitThemes, KitMetrics, TypographyRole, ControlSize, FieldRecipe, KitThemeContext, ChoiceFlow, SurfaceLevel, SurfaceRecipe } from "theme.slint";
import { KitIcon } from "icons.slint";
import { KitModalContext } from "modal.slint";
import { FocusOutline } from "focus.slint";
import { KitFieldService } from "field-service.slint";
import { KitKeyResult } from "keyboard.slint";
import { KitButton, KitIconButton, KitPressable } from "button.slint";
import { ButtonIntent, ControlWidth } from "theme.slint";
import { FocusRequest } from "contracts.slint";
import { FieldAccess, ValidationPresentation } from "shared-contracts.slint";
export { FieldAccess, ValidationPresentation } from "shared-contracts.slint";

// `bare` draws neither fill nor edge and keeps the focus ring, for an editor that
// sits inside a surface of its own such as a toolbar.
export enum FieldDecoration { boxed, underlined, cells, bare }
// `card` groups the rows on one elevated surface under a tracked overline legend.
export enum FieldSetAppearance { plain, card }
// `inset` pads the row below a full-width divider, for rows inside a card.
export enum FieldRowAppearance { plain, inset }

export component KitField inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    // The modal layer this control belongs to; 0 is the window. A control is inert
    // while another layer is open and topmost.
    in property <int> modal-layer;
    spacing: KitMetrics.help-gap(root.theme);
    alignment: start;
    vertical-stretch: 0;
    // Stretch layouts otherwise distribute spare space even when every child
    // has a zero stretch factor. Keep the complete label/editor/help group
    // intrinsic; multiline editors still grow through their preferred height.
    max-height: self.preferred-height;
    @children
}
export component KitFieldLabel inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> text;
    in property <bool> required;
    in property <bool> show-required-indicator: true;
    in property <string> required-label: KitStrings.required-label;
    in property <FieldAccess> access: FieldAccess.editable;
    callback focus-requested();
    vertical-stretch: 0;
    // Let the layout propagate height-for-width constraints. Reading a child's
    // preferred-height back into this rectangle recurses when a wrapping parent
    // measures the field before assigning its final width.
    VerticalLayout {
        padding-bottom: KitMetrics.label-gap(root.theme) - KitMetrics.help-gap(root.theme);
        label := Text {
            horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left;
            text: root.text + (root.required && root.show-required-indicator ? " (" + root.required-label + ")" : "");
            font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
            font-weight: root.theme.typography.weight-medium;
            color: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-primary;
            wrap: word-wrap;
        }
    }
    TouchArea { enabled: root.access != FieldAccess.disabled; clicked => { root.focus-requested(); } }
}
export component KitFieldDescription inherits Text {
    in property <KitTheme> theme: KitThemeContext.current;
    horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left;
    color: root.theme.text-secondary;
    font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
    wrap: word-wrap;
    vertical-stretch: 0;
}
export component KitFieldError inherits KitFieldDescription {
    color: root.theme.danger;
    accessible-role: text;
    accessible-live-region: polite;
}
export component KitFieldGroup inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.field-gap(root.theme);
    alignment: start;
    vertical-stretch: 0;
    @children
}
export component KitFieldSet inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> legend;
    in property <FieldSetAppearance> appearance: FieldSetAppearance.plain;
    private property <bool> card: root.appearance == FieldSetAppearance.card;
    private property <SurfaceRecipe> surface: KitThemes.surface-recipe(root.theme, SurfaceLevel.flat);
    accessible-role: groupbox;
    accessible-label: root.legend;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    background: root.card ? root.surface.fill : transparent;
    border-width: root.card ? root.surface.border-width : 0px;
    border-color: root.surface.border;
    border-radius: root.card ? root.surface.radius : 0px;
    drop-shadow-offset-y: root.card ? root.surface.shadow.offset-y : 0px;
    drop-shadow-blur: root.card ? root.surface.shadow.blur : 0px;
    drop-shadow-color: root.card ? root.surface.shadow.color : transparent;
    content := VerticalLayout {
        alignment: start;
        spacing: root.card ? 0px : KitMetrics.field-gap(root.theme);
        if root.legend != "" && !root.card: Text {
            text: root.legend; horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left;
            color: root.theme.text-primary;
            font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
            font-weight: root.theme.typography.weight-semibold;
            wrap: word-wrap;
        }
        if root.legend != "" && root.card: VerticalLayout {
            padding-left: root.theme.spacing.unit * 5; padding-right: root.theme.spacing.unit * 5;
            padding-top: root.theme.spacing.unit * 4; padding-bottom: root.theme.spacing.unit * 2.5;
            Text {
                text: root.legend.to-uppercase(); horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left;
                color: root.theme.text-secondary;
                font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
                font-weight: root.theme.typography.weight-semibold;
                letter-spacing: KitMetrics.font-size(root.theme, TypographyRole.caption) * root.theme.typography.tracking-overline;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        @children
    }
}
export component KitInputGroup inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <bool> focused;
    in property <FieldDecoration> decoration: FieldDecoration.boxed;
    in property <int> underline-segments: 1;
    // Decorative group boundaries; one native editor still owns all text.
    in property <int> group-size;
    // Leave room for a native editor's final caret after fixed decorative cells.
    in property <length> cell-trailing-space: 0px;
    out property <bool> hovered: hover.has-hover;
    private property <FieldRecipe> recipe: KitThemes.field-recipe(root.theme, root.control-size, root.access, root.validation);
    in property <length> corner-radius: root.recipe.radius;
    in property <length> padding-inline: root.recipe.padding-inline;
    in property <length> padding-block: root.recipe.padding-block;
    // An explicit resting fill and edge of an editable boxed field; `transparent`
    // defers to the theme.
    in property <color> field-fill: transparent;
    in property <color> field-border: transparent;
    min-height: root.recipe.height;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    background: root.decoration != FieldDecoration.boxed ? transparent : root.field-fill != transparent && root.access == FieldAccess.editable ? root.field-fill : root.recipe.fill;
    border-radius: root.corner-radius;
    border-width: root.decoration == FieldDecoration.boxed ? root.recipe.border-width : 0px;
    border-color: root.hovered && !root.focused ? root.recipe.hover-border
        : root.field-border != transparent && root.access == FieldAccess.editable && root.validation != ValidationPresentation.invalid ? root.field-border : root.recipe.border;
    if root.decoration == FieldDecoration.cells: Rectangle {
        x: root.padding-inline; y: 0px;
        width: max(0px, root.width - 2 * root.padding-inline - root.cell-trailing-space); height: root.height;
        for index in max(1, root.underline-segments): Rectangle {
            private property <length> cell-width: parent.width / max(1, root.underline-segments);
            private property <length> gap: root.theme.spacing.unit * 2 * root.theme.text-scale;
            x: index * self.cell-width + self.gap / 2; y: 0px;
            width: max(0px, self.cell-width - self.gap); height: parent.height;
            background: root.recipe.fill;
            border-radius: root.corner-radius;
            border-width: root.recipe.border-width;
            border-color: root.access == FieldAccess.disabled ? root.recipe.border : root.validation == ValidationPresentation.invalid ? root.theme.danger : root.focused ? root.theme.focus.color : root.hovered ? root.recipe.hover-border : root.recipe.border;
            if root.focused && root.access != FieldAccess.disabled: FocusOutline {
                ring: root.recipe.focus; radius: root.corner-radius;
                host-width: parent.width; host-height: parent.height;
            }
            if root.group-size > 0 && index + 1 < max(1, root.underline-segments) && Math.mod(index + 1, root.group-size) == 0: Rectangle {
                x: parent.width + parent.gap / 2 - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: root.theme.shape.border-width-strong;
                height: root.theme.spacing.unit * 2 * root.theme.text-scale;
                background: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-secondary;
            }
        }
    }
    // A parent TouchArea observes hover before its children see the event,
    // so the native editor and actions keep every press, caret and selection.
    hover := TouchArea {
        Rectangle {
            x: root.padding-inline; y: root.padding-block;
            width: max(0px, parent.width - 2 * root.padding-inline);
            height: max(0px, parent.height - 2 * root.padding-block);
            @children
        }
    }
    if root.decoration == FieldDecoration.underlined: Rectangle {
        x: root.padding-inline; y: root.height - root.theme.shape.border-width-strong;
        width: max(0px, root.width - 2 * root.padding-inline);
        height: root.theme.shape.border-width-strong;
        for index in max(1, root.underline-segments): Rectangle {
            private property <length> cell-width: parent.width / max(1, root.underline-segments);
            private property <length> gap: root.underline-segments > 1 ? root.theme.spacing.unit * 2 : 0px;
            x: index * self.cell-width + self.gap / 2; y: 0px;
            width: max(0px,self.cell-width - self.gap); height: parent.height;
            background: root.validation == ValidationPresentation.invalid ? root.theme.danger : root.focused ? root.theme.focus.color : root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.border-strong;
        }
    }
    if root.focused && (root.decoration == FieldDecoration.boxed || root.decoration == FieldDecoration.bare): FocusOutline {
        ring: root.recipe.focus; radius: root.corner-radius;
        host-width: root.width; host-height: root.height;
    }
}
export component KitFieldSeparator inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    height: root.theme.shape.border-width;
    background: root.theme.border-subtle;
    vertical-stretch: 0;
}

// A single retained slot lets hosts switch orientation without recreating an editor.
export component KitFieldRow inherits KitField {
    in property <Orientation> orientation: Orientation.horizontal;
    in property <string> label;
    in property <string> description;
    in property <string> error-message;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <bool> show-divider;
    in property <FieldRowAppearance> appearance: FieldRowAppearance.plain;
    private property <bool> inset-row: root.appearance == FieldRowAppearance.inset;
    callback focus-requested();
    spacing: root.inset-row ? 0px : KitMetrics.label-gap(root.theme);

    if root.show-divider: KitFieldSeparator { theme: root.theme; }
    VerticalLayout {
        padding-top: root.inset-row ? root.theme.spacing.unit * 3.5 : 0px;
        padding-bottom: self.padding-top;
        padding-left: root.inset-row ? root.theme.spacing.unit * 5 : 0px;
        padding-right: self.padding-left;
        Rectangle {
            private property <bool> stacked: root.orientation == Orientation.vertical;
            private property <bool> rtl: root.theme.direction == ChoiceFlow.right-to-left;
            private property <bool> has-caption: root.label != "" || root.description != "" || root.error-message != "";
            private property <length> gap: !self.has-caption ? 0px : root.inset-row ? root.theme.spacing.unit * 6 : KitMetrics.field-gap(root.theme);
            preferred-width: self.stacked ? max(caption.preferred-width, slot.preferred-width)
                : caption.preferred-width + self.gap + slot.preferred-width;
            height: self.stacked ? caption.height + self.gap + slot.height : max(caption.height, slot.height);
            // A label with nothing under it still carries its gap to the help
            // text, which must not count when centring it.
            private property <length> trailing-gap: root.label != "" && root.description == "" && root.error-message == ""
                ? KitMetrics.label-gap(root.theme) - KitMetrics.help-gap(root.theme) : 0px;
            caption := VerticalLayout {
                x: parent.stacked || !parent.rtl ? 0px : slot.width + parent.gap;
                y: parent.stacked ? 0px : (parent.height - self.height + parent.trailing-gap) / 2;
                width: parent.stacked ? parent.width : max(0px, parent.width - slot.width - parent.gap);
                height: self.preferred-height;
                spacing: KitMetrics.help-gap(root.theme);
                if root.label != "": KitFieldLabel {
                    theme: root.theme; text: root.label; access: root.access;
                    focus-requested => { if (!KitModalContext.inert(root.modal-layer)) { root.focus-requested(); } }
                }
                if root.description != "": KitFieldDescription { theme: root.theme; text: root.description; }
                if root.error-message != "": KitFieldError { theme: root.theme; text: root.error-message; }
            }
            slot := VerticalLayout {
                x: parent.stacked || parent.rtl ? 0px : parent.width - self.width;
                y: parent.stacked ? caption.height + parent.gap : (parent.height - self.height) / 2;
                width: parent.stacked ? parent.width : min(parent.width, self.preferred-width);
                height: self.preferred-height;
                alignment: start;
                @children
            }
        }
    }
}

// Place these parts alongside a native editor inside an InputGroup's single
// children surface. They do not add padding, borders or another focus target.
export component KitInputGroupStart inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.label-gap(root.theme);
    alignment: start;
    horizontal-stretch: 0;
    @children
}
export component KitInputGroupEnd inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: KitMetrics.label-gap(root.theme);
    alignment: end;
    horizontal-stretch: 0;
    @children
}
export component KitInputGroupText inherits Text {
    in property <KitTheme> theme: KitThemeContext.current;
    horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left;
    font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
    color: root.theme.text-secondary;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

export struct FormErrorRow { target: FocusRequest, message: string }
export component KitFormErrorSummary inherits KitFieldGroup {
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <string> title: KitStrings.form-error-title;
    in property <[FormErrorRow]> errors;
    in property <int> modal-layer;
    callback error-activated(FocusRequest);
    spacing: KitMetrics.help-gap(root.theme);
    if root.errors.length > 0: Rectangle {
        background: root.theme.danger-subtle;
        border-width: root.theme.shape.border-width;
        border-color: root.theme.danger;
        border-radius: root.theme.shape.radius-container;
        preferred-height: content.preferred-height; min-height: self.preferred-height;
        accessible-role: groupbox; accessible-label: root.title;
        content := VerticalLayout {
            width: parent.width; height: self.preferred-height;
            padding: root.theme.spacing.unit * 4;
            spacing: KitMetrics.help-gap(root.theme); alignment: start;
            HorizontalLayout { spacing: root.theme.spacing.unit * 2;
                Rectangle { layout-order: root.flow == ChoiceFlow.right-to-left ? 1 : 0; width: KitMetrics.icon-size(root.theme, ControlSize.medium); horizontal-stretch: 0;
                    KitIcon { theme: root.theme; glyph: root.theme.icons.warning; ink: root.theme.danger; y: (parent.height - self.height) / 2; }
                }
                KitFieldError { layout-order: root.flow == ChoiceFlow.right-to-left ? 0 : 1; theme: root.theme; text: root.title + " (" + root.errors.length + ")"; font-weight: root.theme.typography.weight-semibold; }
            }
            for error in root.errors: error-action := KitPressable {
                theme: root.theme; modal-layer: root.modal-layer; intent: ButtonIntent.quiet; control-width: ControlWidth.fill;
                accessible-name: error.message;
                padding-inline: root.theme.spacing.unit * 2;
                preferred-height: max(KitMetrics.density(root.theme, ControlSize.compact).height, message.preferred-height + 2 * self.padding-block);
                min-height: self.preferred-height;
                activated => { root.error-activated(error.target); }
                message := Text {
                    x: 0px; y: 0px;
                    width: max(0px,error-action.width - 2 * error-action.padding-inline);
                    height: max(0px,error-action.height - 2 * error-action.padding-block);
                    text: error.message; color: root.theme.danger;
                    font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                    wrap: word-wrap; horizontal-alignment: root.theme.direction == ChoiceFlow.right-to-left ? right : left; vertical-alignment: center;
                }
            }
        }
    }
}

// A ticket names one proposal in its window, even across delegate replacement.
export struct ShortcutTicket { sequence: int, generation: int }
enum ShortcutPhase { idle, recording, pending }

export component KitShortcutField inherits FocusScope {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <int> modal-layer;
    in property <int> generation;
    in property <string> label;
    in property <string> description;
    in property <string> value-label;
    in property <string> empty-label: KitStrings.shortcut-empty-label;
    in property <string> recording-label: KitStrings.shortcut-recording-label;
    in property <string> clear-label: KitStrings.shortcut-clear-template.replace-all("{label}", root.label);
    in property <bool> allow-modifier-only;
    out property <bool> recording: root.phase == ShortcutPhase.recording && root.current;
    out property <bool> recorder-focused: record.has-focus;
    callback captured(ShortcutTicket, KeyEvent);
    callback modifier-released(ShortcutTicket, KeyEvent);
    callback clear-requested(ShortcutTicket);
    callback cancelled();

    private property <ShortcutPhase> phase;
    private property <ShortcutTicket> ticket;
    private property <int> activation-generation;
    private property <string> activation-value;
    function arm-action() {
        root.activation-generation = root.generation;
        root.activation-value = root.value-label;
    }
    pure function action-current() -> bool {
        return root.editable && root.generation == root.activation-generation && root.activation-value == root.value-label;
    }
    private property <string> original-value;
    private property <string> modifier;
    private property <bool> editable: root.enabled && root.visible && root.access == FieldAccess.editable && !record.inert;
    private property <bool> current: root.editable && record.has-focus
        && root.ticket.sequence == KitFieldService.shortcut-session
        && root.ticket.generation == root.generation && root.original-value == root.value-label;
    changed current => { if (!root.current) { root.cancel(); } }
    public function take-focus() { if (root.enabled && root.visible && KitFieldService.window-visible()) { record.take-focus(); } }
    public function cancel() {
        if (root.phase != ShortcutPhase.idle) {
            root.phase = ShortcutPhase.idle;
            root.modifier = "";
            root.cancelled();
        }
    }
    // The host consumes this result once, immediately before publishing its value.
    public function finish(proposal: ShortcutTicket) -> bool {
        if (!KitFieldService.window-visible()) { root.cancel(); return false; }
        if (root.phase != ShortcutPhase.pending || !root.current || proposal != root.ticket) { return false; }
        root.phase = ShortcutPhase.idle;
        return true;
    }
    public function retry(proposal: ShortcutTicket) -> bool {
        if (!root.finish(proposal)) { return false; }
        return root.start(ShortcutPhase.recording);
    }
    function start(phase: ShortcutPhase) -> bool {
        if (!root.editable || !KitFieldService.window-visible()) { return false; }
        record.take-focus();
        if (!record.has-focus || !root.editable) { return false; }
        root.modifier = "";
        root.original-value = root.value-label;
        root.ticket = { sequence: KitFieldService.begin-shortcut-session(), generation: root.generation };
        root.phase = root.ticket.sequence > 0 ? phase : ShortcutPhase.idle;
        return root.phase == phase;
    }
    pure function modifier-key(text: string) -> bool {
        return text == Key.Shift || text == Key.ShiftR || text == Key.Control || text == Key.ControlR
            || text == Key.Meta || text == Key.MetaR || text == Key.Alt || text == Key.AltGr;
    }
    pure function multiple-modifiers(m: KeyboardModifiers) -> bool {
        return (m.shift && (m.control || m.meta || m.alt))
            || (m.control && (m.meta || m.alt)) || (m.meta && m.alt);
    }
    forward-focus: record;
    focus-on-tab-navigation: false;
    focus-on-click: false;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    preferred-width: actions.preferred-width;
    max-width: actions.preferred-width;
    preferred-height: actions.preferred-height;
    max-height: actions.preferred-height;
    key-released(event) => {
        if (!root.recording || !KitFieldService.window-visible()) { return reject; }
        if (root.allow-modifier-only && root.modifier != "" && event.text == root.modifier) {
            root.modifier = "";
            root.phase = ShortcutPhase.pending;
            root.modifier-released(root.ticket, event);
        }
        return accept;
    }
    actions := FlexboxLayout {
        flex-wrap: no-wrap; cross-axis-alignment: center;
        spacing: KitMetrics.inline-gap(root.theme);
        record := KitButton {
            theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
            disabled: !root.enabled || root.access == FieldAccess.disabled;
            intent: root.recording ? ButtonIntent.primary : root.access == FieldAccess.read-only ? ButtonIntent.quiet : ButtonIntent.secondary;
            text: root.recording ? root.recording-label : root.value-label != "" ? root.value-label : root.empty-label;
            text-wrap: word-wrap;
            accessible-name: root.label; description: root.description;
            accessible-value: self.text;
            accessible-read-only: root.access == FieldAccess.read-only;
            focus-observed(focused) => { if (!focused) { root.cancel(); } }
            activation-started => { root.arm-action(); }
            activation-allowed => { return root.action-current(); }
            activated => {
                if (root.recording) { root.cancel(); }
                else { root.start(ShortcutPhase.recording); }
            }
            key-event(event) => {
                if (event.repeat && (root.recording || event.text == Key.Return || event.text == Key.Space)) {
                    return KitKeyResult.accept;
                }
                if (event.text == Key.Escape && root.phase != ShortcutPhase.idle && root.current) {
                    root.cancel();
                    return KitKeyResult.accept;
                }
                if (!root.recording || !KitFieldService.window-visible()) { return KitKeyResult.reject; }
                if (root.modifier-key(event.text)) {
                    root.modifier = root.modifier == "" && !root.multiple-modifiers(event.modifiers) ? event.text : "";
                } else if (event.text != "") {
                    root.modifier = "";
                    root.phase = ShortcutPhase.pending;
                    root.captured(root.ticket, event);
                }
                return KitKeyResult.accept;
            }
        }
        if root.value-label != "": KitIconButton {
            theme: root.theme; control-size: root.control-size; modal-layer: root.modal-layer;
            disabled: !root.enabled || root.access != FieldAccess.editable;
            glyph: root.theme.icons.delete; accessible-name: root.clear-label;
            activation-started => { root.arm-action(); }
            activation-allowed => { return root.action-current(); }
            activated => {
                if (root.value-label != "" && root.start(ShortcutPhase.pending)) { root.clear-requested(root.ticket); }
            }
        }
    }
}
