import { LayoutSpace, KitLayoutMetrics } from "layout.slint";
import { ElevationLevel, KitTheme, KitThemes, KitThemeContext, KitMetrics, TypographyRole, ControlSize, AvatarSize, SurfaceLevel, SurfaceRecipe, ChoiceFlow } from "theme.slint";
import { KitIcon, KitGlyphs, IconGlyph } from "icons.slint";
import { KitPressable } from "button.slint";
import { ButtonIntent } from "theme.slint";
import { KitStrings } from "strings.slint";

export enum Tone { neutral, accent, success, warning, danger, information }
export { AvatarSize } from "theme.slint";
export enum AvatarShape { circle, rounded, square }
export enum AvatarInteraction { static, action }
export enum ChatSide { start, end }
export enum StepState { pending, current, complete, error }
export struct TimelineEntry { title: string, description: string, metadata: string, tone: Tone, glyph: IconGlyph }
export struct StepEntry { token: int, generation: int, label: string, description: string, state: StepState, enabled: bool }

export component KitBadge inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <IconGlyph> leading-icon;
    private property <bool> has-icon: root.leading-icon.stroke != "" || root.leading-icon.fill != "";
    private property <length> icon-extent: KitMetrics.icon-size(root.theme, ControlSize.compact);
    private property <length> icon-space: root.has-icon ? root.icon-extent + root.theme.spacing.unit : 0px;
    private property <length> inset-x: root.theme.spacing.unit * 2;
    private property <length> inset-y: root.theme.spacing.unit;
    preferred-width: label.preferred-width + root.icon-space + 2 * root.inset-x;
    min-width: self.preferred-width; max-width: self.preferred-width;
    preferred-height: max(label.preferred-height,root.has-icon ? root.icon-extent : 0px) + 2 * root.inset-y;
    min-height: self.preferred-height; max-height: self.preferred-height;
    vertical-stretch: 0; horizontal-stretch: 0;
    border-radius: root.theme.shape.radius-control;
    background: root.tone == Tone.accent ? root.theme.accent : root.tone == Tone.success ? root.theme.success-subtle : root.tone == Tone.warning ? root.theme.warning-subtle : root.tone == Tone.danger ? root.theme.danger-subtle : root.tone == Tone.information ? root.theme.information-subtle : root.theme.surface;
    border-width: root.theme.shape.border-width;
    border-color: root.tone == Tone.success ? root.theme.success : root.tone == Tone.warning ? root.theme.warning : root.tone == Tone.danger ? root.theme.danger : root.tone == Tone.accent ? root.theme.accent : root.tone == Tone.information ? root.theme.information : root.theme.border-subtle;
    accessible-role: AccessibleRole.text; accessible-label: root.text;
    if root.has-icon: KitIcon { theme: root.theme; control-size: ControlSize.compact; glyph: root.leading-icon; x: root.theme.direction == ChoiceFlow.right-to-left ? root.width - root.inset-x - self.width : root.inset-x; y: (parent.height - self.height) / 2; ink: root.tone == Tone.accent ? root.theme.on-accent : root.tone == Tone.danger ? root.theme.danger : root.theme.text-primary; }
    label := Text { x: root.theme.direction == ChoiceFlow.right-to-left ? root.inset-x : root.inset-x + root.icon-space; y: (root.height - self.preferred-height) / 2; text: root.text;
        color: root.tone == Tone.accent ? root.theme.on-accent : root.tone == Tone.danger ? root.theme.danger : root.theme.text-primary;
        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); font-weight: root.theme.typography.weight-semibold;
    }
}

export component KitAvatar inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <image> source;
    in property <string> initials;
    in property <string> accessible-name;
    in property <Tone> tone: Tone.accent;
    private property <color> avatar-ink: root.tone == Tone.accent ? root.theme.accent : root.tone == Tone.danger ? root.theme.danger : root.theme.text-primary;
    in property <AvatarShape> shape: AvatarShape.circle;
    in property <AvatarInteraction> interaction: AvatarInteraction.static;
    in property <bool> disabled;
    callback activated();
    callback activation-started();
    public function cancel-press() { action.cancel-press(); }
    out property <bool> has-focus: root.interaction == AvatarInteraction.action && action.has-focus;
    public function take-focus() { if (root.interaction == AvatarInteraction.action) { action.take-focus(); } }
    in property <AvatarSize> avatar-size: AvatarSize.medium;
    in property <length> size: KitMetrics.avatar-size(root.theme, root.avatar-size);
    in property <IconGlyph> fallback-icon: root.theme.icons.avatar;
    in property <string> fallback-label: KitStrings.avatar-label;
    private property <string> effective-name: root.accessible-name != "" ? root.accessible-name : root.initials != "" ? root.initials : root.fallback-label;
    width: max(0px, root.size);
    height: self.width;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: root.shape == AvatarShape.circle ? self.width / 2 : root.shape == AvatarShape.rounded ? root.theme.shape.radius-control : 0px;
    background: root.tone == Tone.accent ? root.theme.accent-subtle : root.tone == Tone.success ? root.theme.success-subtle : root.tone == Tone.warning ? root.theme.warning-subtle : root.tone == Tone.danger ? root.theme.danger-subtle : root.tone == Tone.information ? root.theme.information-subtle : root.theme.surface;
    border-width: root.theme.shape.border-width; border-color: root.theme.border-strong;
    accessible-role: AccessibleRole.none;
    if root.interaction == AvatarInteraction.static: Rectangle { accessible-role: image; accessible-label: root.effective-name; }
    Rectangle {
        clip: true; border-radius: root.border-radius;
        opacity: root.disabled ? 0.45 : 1;
        if root.source.width > 0: Image { accessible-role: none; width: parent.width; height: parent.height; source: root.source; image-fit: cover; }
        if root.source.width == 0 && root.initials != "": Text { accessible-role: none; text: root.initials; color: root.avatar-ink; font-family: root.theme.typography.family; font-size: root.width * root.theme.geometry.avatar-initials-ratio; overflow: elide; font-weight: root.theme.typography.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
        if root.source.width == 0 && root.initials == "": KitIcon {
            theme: root.theme; glyph: root.fallback-icon; ink: root.avatar-ink;
            width: root.width * root.theme.geometry.avatar-initials-ratio * 1.5; height: self.width;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        }
    }
    action := KitPressable {
        visible: root.interaction == AvatarInteraction.action;
        tab-stop: root.interaction == AvatarInteraction.action;
        disabled: root.disabled;
        theme: root.theme; intent: ButtonIntent.quiet;
        width: root.width; height: root.height;
        corner-radius: root.border-radius;
        accessible-name: root.effective-name;
        background: self.pressed ? root.avatar-ink.transparentize(0.75) : self.hovered ? root.avatar-ink.transparentize(0.88) : transparent;
        activation-started => { root.activation-started(); }
        activated => { root.activated(); }
    }
    @children
}

export struct AvatarEntry { token: int, generation: int, label: string, initials: string, source: image, shape: AvatarShape, tone: Tone, disabled: bool }
component AvatarGroupItem inherits KitAvatar {
    in property <AvatarEntry> entry;
    in property <bool> group-disabled;
    source: root.entry.source;
    initials: root.entry.initials;
    accessible-name: root.entry.label;
    shape: root.entry.shape; tone: root.entry.tone;
    disabled: root.group-disabled || root.entry.disabled;
    private property <int> press-token;
    private property <int> press-generation;
    callback member-requested(int, int);
    activation-started => { root.press-token = root.entry.token; root.press-generation = root.entry.generation; }
    changed entry => { root.cancel-press(); }
    activated => { root.member-requested(root.press-token, root.press-generation); }
}
// A bounded presentation of keyed members; the host resolves their identities.
export component KitAvatarGroup inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <[AvatarEntry]> entries;
    in property <AvatarInteraction> interaction: AvatarInteraction.static;
    in property <AvatarInteraction> overflow-interaction: root.interaction;
    in property <AvatarSize> avatar-size: AvatarSize.medium;
    in property <length> size: KitMetrics.avatar-size(root.theme, root.avatar-size);
    in property <length> overlap: root.theme.spacing.unit * 2 * root.theme.text-scale;
    in property <int> max-visible: 5;
    in property <bool> disabled;
    in property <string> accessible-name: KitStrings.avatar-group-label;
    in property <string> overflow-text: "+" + root.overflow-count;
    in property <string> overflow-accessible-name: root.overflow-count == 1 ? KitStrings.avatar-more-singular : KitStrings.avatar-more-template.replace-all("{count}", "" + root.overflow-count);
    out property <int> overflow-count: max(0, root.entries.length - root.visible-count);
    private property <int> visible-count: min(root.entries.length, max(0, root.max-visible));
    private property <int> slot-count: root.visible-count + (root.overflow-count > 0 ? 1 : 0);
    private property <length> extent: max(0px, root.size);
    private property <length> step: max(0px, root.extent - max(0px, root.overlap));
    callback activated(int, int);
    callback overflow-activated();
    accessible-role: groupbox; accessible-label: root.accessible-name;
    preferred-width: root.slot-count == 0 ? 0px : root.extent + (root.slot-count - 1) * root.step;
    preferred-height: root.slot-count == 0 ? 0px : root.extent;
    width: root.preferred-width; height: root.preferred-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    for index in root.visible-count: AvatarGroupItem {
        x: root.theme.direction == ChoiceFlow.right-to-left ? root.width - root.extent - index * root.step : index * root.step; y: 0px;
        theme: root.theme; entry: root.entries[index]; size: root.extent;
        interaction: root.interaction; group-disabled: root.disabled;
        member-requested(token, generation) => { root.activated(token, generation); }
    }
    if root.overflow-count > 0: KitAvatar {
        x: root.theme.direction == ChoiceFlow.right-to-left ? 0px : root.visible-count * root.step; y: 0px;
        theme: root.theme; size: root.extent; initials: root.overflow-text;
        accessible-name: root.overflow-accessible-name;
        interaction: root.overflow-interaction; disabled: root.disabled;
        tone: Tone.neutral;
        activated => { root.overflow-activated(); }
    }
}

export component KitCard inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <SurfaceLevel> level: SurfaceLevel.flat;
    in property <LayoutSpace> inset: LayoutSpace.roomy;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    in property <length> corner-radius: root.recipe.radius;
    in property <ElevationLevel> elevation: root.recipe.elevation;
    in property <SurfaceRecipe> recipe: KitThemes.surface-recipe(root.theme, root.level);
    background: root.recipe.fill;
    border-color: root.recipe.border; border-width: root.recipe.border-width; border-radius: root.corner-radius;
    drop-shadow-offset-y: root.elevation == root.recipe.elevation ? root.recipe.shadow.offset-y : KitThemes.shadow(root.theme, root.elevation).offset-y; drop-shadow-blur: root.elevation == root.recipe.elevation ? root.recipe.shadow.blur : KitThemes.shadow(root.theme, root.elevation).blur; drop-shadow-color: root.elevation == root.recipe.elevation ? root.recipe.shadow.color : KitThemes.shadow(root.theme, root.elevation).color;
    preferred-height: content.preferred-height; min-height: self.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout { x: 0px; y: 0px; width: root.width; height: self.preferred-height; padding: KitLayoutMetrics.space(root.theme, root.inset); spacing: KitLayoutMetrics.space(root.theme, root.gap); alignment: start; @children }
}
export component KitCardHeader inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> title;
    in property <string> description;
    spacing: root.theme.spacing.unit * 1.5; vertical-stretch: 0;
    Text { text: root.title; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
    if root.description != "": Text { text: root.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
}
export component KitCardBody inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    spacing: root.theme.spacing.unit * 3; alignment: start; vertical-stretch: 0; @children }
export component KitCardFooter inherits FlexboxLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    flex-direction: root.theme.direction == ChoiceFlow.right-to-left ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    spacing: root.theme.spacing.unit * 2; flex-wrap: wrap; vertical-stretch: 0; @children }

export component KitHero inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> title;
    in property <string> description;
    in property <LayoutSpace> inset: LayoutSpace.roomy;
    in property <LayoutSpace> gap: LayoutSpace.regular;
    background: root.theme.accent-subtle; border-width: root.theme.shape.border-width; border-color: root.theme.border-subtle; border-radius: KitThemes.surface-recipe(root.theme, SurfaceLevel.flat).radius; vertical-stretch: 0;
    VerticalLayout { padding: KitLayoutMetrics.space(root.theme, root.inset); spacing: KitLayoutMetrics.space(root.theme, root.gap); alignment: start;
        Text { text: root.title; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-bold; wrap: word-wrap; }
        if root.description != "": Text { text: root.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); wrap: word-wrap; }
        @children
    }
}
export component KitFooter inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    preferred-height: content.preferred-height; min-height: self.preferred-height;
    background: root.theme.canvas; vertical-stretch: 0; accessible-role: content-info;
    content := VerticalLayout { y: 0px; width: root.width; height: self.preferred-height; padding-top: root.theme.spacing.unit * 5; padding-bottom: root.theme.spacing.unit * 5; spacing: root.theme.spacing.unit * 3; alignment: start; @children }
}
export component KitDivider inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> label;
    spacing: root.label == "" ? 0px : root.theme.spacing.unit * 3; vertical-stretch: 0;
    VerticalLayout { alignment: center; vertical-stretch: 1; leading-rule := Rectangle { background: root.theme.border-subtle; height: root.theme.shape.border-width; vertical-stretch: 0; } }
    if root.label != "": Text { text: root.label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); horizontal-stretch: 0; }
    VerticalLayout { alignment: center; vertical-stretch: 1; trailing-rule := Rectangle { background: root.theme.border-subtle; height: root.theme.shape.border-width; vertical-stretch: 0; } }
}
export component KitStat inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> label;
    in property <string> value;
    in property <string> description;
    in property <IconGlyph> leading-icon;
    in property <Tone> tone: Tone.neutral;
    private property <color> tone-ink: root.tone == Tone.neutral ? root.theme.text-primary : root.tone == Tone.accent ? root.theme.accent : root.tone == Tone.success ? root.theme.success : root.tone == Tone.warning ? root.theme.warning : root.tone == Tone.danger ? root.theme.danger : root.theme.information;
    spacing: root.theme.spacing.unit; vertical-stretch: 0;
    HorizontalLayout { spacing: root.theme.spacing.unit * 2;
        if root.leading-icon.stroke != "" || root.leading-icon.fill != "": KitIcon { theme: root.theme; glyph: root.leading-icon; ink: root.tone-ink; }
        Text { text: root.label; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; vertical-alignment: center; }
    }
    Text { text: root.value; color: root.tone-ink; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.title); font-weight: root.theme.typography.weight-bold; wrap: word-wrap; }
    if root.description != "": Text { text: root.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
}
export component KitChatBubble inherits HorizontalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ChatSide> side: ChatSide.start;
    in property <string> author;
    in property <string> text;
    in property <string> metadata;
    vertical-stretch: 0;
    if (root.side == ChatSide.end) != (root.theme.direction == ChoiceFlow.right-to-left): Rectangle { horizontal-stretch: 1; min-width: root.theme.spacing.unit * 4; }
    VerticalLayout { spacing: root.theme.spacing.unit * 1.5; horizontal-stretch: 4;
        Text { text: root.author; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
        bubble := Rectangle {
            background: root.side == ChatSide.end ? root.theme.accent : root.theme.surface;
            border-radius: root.theme.shape.radius-container;
            // Received messages are surfaces, not hover states. Their edge
            // also keeps them visible when a conversation sits on a panel.
            border-width: root.side == ChatSide.start ? root.theme.shape.border-width : 0px;
            border-color: root.side == ChatSide.start ? root.theme.border-subtle : transparent;
            VerticalLayout { padding: root.theme.spacing.unit * 3.5;
                Text { text: root.text; color: root.side == ChatSide.end ? root.theme.on-accent : root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
            }
        }
        if root.metadata != "": Text { text: root.metadata; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
    }
    if (root.side == ChatSide.start) != (root.theme.direction == ChoiceFlow.right-to-left): Rectangle { horizontal-stretch: 1; min-width: root.theme.spacing.unit * 4; }
}
export component KitSkeleton inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <bool> running: true;
    private property <bool> pulse;
    // One line of control text, unscaled: a skeleton stands in for copy.
    preferred-height: root.theme.typography.line-height-control; min-height: root.theme.spacing.unit * 2; vertical-stretch: 0;
    background: root.theme.border-subtle; border-radius: root.theme.shape.radius-control;
    opacity: root.running && root.pulse && !root.theme.reduced-motion ? 0.5 : 1;
    animate opacity { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.slow; }
    Timer { interval: 650ms; running: root.running && !root.theme.reduced-motion; triggered => { root.pulse = !root.pulse; } }
}
export component KitEmptyState inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <string> title;
    in property <string> description;
    private property <length> inset: root.theme.spacing.unit * 6;
    preferred-height: content.preferred-height;
    min-height: self.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout { x: 0px; y: 0px; width: root.width; height: self.preferred-height; padding: root.inset; spacing: root.theme.spacing.unit * 3; alignment: start;
        Text { width: max(0px,root.width - 2 * root.inset); height: self.preferred-height; text: root.title; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        if root.description != "": Text { width: max(0px,root.width - 2 * root.inset); height: self.preferred-height; text: root.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
        @children
    }
}
export component KitTimeline inherits VerticalLayout {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <[TimelineEntry]> entries;
    spacing: root.theme.spacing.unit * 4; vertical-stretch: 0;
    for entry[index] in root.entries: HorizontalLayout { spacing: root.theme.spacing.unit * 3;
        rail := Rectangle {
            width: max(root.theme.spacing.unit * 3 * root.theme.text-scale, entry.glyph.stroke != "" || entry.glyph.fill != "" ? KitMetrics.icon-size(root.theme, ControlSize.compact) : 0px);
            horizontal-stretch: 0;
            // Measure one rendered line, even when the entry's title wraps.
            first-line := Text {
                visible: false; accessible-role: none; text: "Ag";
                font-family: root.theme.typography.family;
                font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                font-weight: root.theme.typography.weight-semibold;
            }
            marker := Rectangle {
                x: (rail.width - self.width) / 2;
                y: max(0px, (first-line.preferred-height - self.height) / 2);
                width: entry.glyph.stroke != "" || entry.glyph.fill != "" ? KitMetrics.icon-size(root.theme, ControlSize.compact) : root.theme.spacing.unit * 2 * root.theme.text-scale;
                height: self.width; border-radius: self.width / 2;
                private property <color> ink: entry.tone == Tone.neutral ? root.theme.text-secondary : entry.tone == Tone.accent ? root.theme.accent : entry.tone == Tone.success ? root.theme.success : entry.tone == Tone.warning ? root.theme.warning : entry.tone == Tone.danger ? root.theme.danger : root.theme.information;
                background: entry.glyph.stroke != "" || entry.glyph.fill != "" ? transparent : self.ink;
                if entry.glyph.stroke != "" || entry.glyph.fill != "": KitIcon { theme: root.theme; glyph: entry.glyph; ink: marker.ink; width: parent.width; height: parent.height; }
            }
            if index + 1 < root.entries.length: connector := Rectangle {
                x: (rail.width - self.width) / 2;
                y: marker.y + marker.height + root.theme.spacing.unit * root.theme.text-scale;
                width: root.theme.shape.border-width-strong;
                height: max(0px, rail.height + root.spacing + marker.y - root.theme.spacing.unit * root.theme.text-scale - self.y);
                background: root.theme.border-subtle;
            }
        }
        VerticalLayout { spacing: root.theme.spacing.unit;
            Text { text: entry.title; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
            if entry.description != "": Text { text: entry.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
            if entry.metadata != "": Text { text: entry.metadata; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); wrap: word-wrap; }
        }
    }
}
component StepItem inherits Rectangle {
    in property <KitTheme> theme;
    in property <StepEntry> entry;
    in property <int> ordinal;
    in property <int> total;
    in property <Orientation> orientation;
    in property <bool> interactive;
    in property <bool> disabled;
    in property <bool> connectors;
    in property <length> gap;
    in property <string> state-label;
    callback step-requested(int, int);
    private property <bool> horizontal: root.orientation == Orientation.horizontal;
    private property <bool> rtl: root.theme.direction == ChoiceFlow.right-to-left;
    private property <bool> unavailable: root.disabled || (root.interactive && !root.entry.enabled);
    private property <int> press-token;
    private property <int> press-generation;
    private property <string> name: root.entry.label + (root.state-label == "" ? "" : ", " + root.state-label);
    private property <length> marker-size: max(root.theme.geometry.step-marker-minimum, root.theme.geometry.step-marker-scaled * root.theme.text-scale);
    preferred-width: root.horizontal ? max(root.marker-size, labels.preferred-width) : root.marker-size + root.gap + labels.preferred-width;
    min-width: root.marker-size;
