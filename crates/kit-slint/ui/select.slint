import { FormConstraintState, KitFormValidation, KitValidityState, HtmlInputKind } from "validation.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { FieldAccess, ValidationPresentation } from "shared-contracts.slint";
import { KitIcon, KitGlyphs } from "icons.slint";
import { ListView } from "scroll.slint";
import { ElevatedSurface } from "elevation.slint";
import { KitPressable } from "button.slint";
import { KitTheme, KitThemes, ButtonIntent, ControlSize, ControlWidth, KitMetrics, KitThemeContext, TypographyRole, FieldRecipe, SurfaceRecipe, SurfaceLevel, OptionRecipe, IconRecipe } from "theme.slint";
import { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability } from "contracts.slint";
export { OptionRow, SelectState, NavigationStep, CloseReason, SelectionAvailability } from "contracts.slint";

// One key translator is shared by both the standard and composed surfaces.
// Selection, skip-disabled, search and identity reconciliation stay in kit-core.
export component KitSelectKeyboard inherits FocusScope {
    in property <SelectState> state;
    in property <bool> dismiss-on-system-back: true;
    callback open-requested();
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    callback tab-navigation(bool) -> EventResult;
    private property <bool> activation-held;
    focus-on-tab-navigation: false;
    changed state => { if (!root.state.open) { root.activation-held = false; } }
    public function handle-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
            if (!root.state.open) { root.open-requested(); }
            else { root.navigate(event.text == Key.DownArrow ? NavigationStep.next : NavigationStep.previous); }
            return accept;
        }
        if (!root.state.open) { return reject; }
        if (event.text == Key.Home) { root.navigate(NavigationStep.first); return accept; }
        if (event.text == Key.End) { root.navigate(NavigationStep.last); return accept; }
        if (event.text == Key.PageDown) { root.navigate(NavigationStep.page-next); return accept; }
        if (event.text == Key.PageUp) { root.navigate(NavigationStep.page-previous); return accept; }
        if (event.text == Key.Escape) { root.dismiss(CloseReason.escape); return accept; }
        if (event.text == Key.Back && root.dismiss-on-system-back) { root.dismiss(CloseReason.system-back); return accept; }
        if (event.text == Key.Tab || event.text == Key.Backtab) {
            root.dismiss(CloseReason.programmatic);
            return root.tab-navigation(event.modifiers.shift || event.text == Key.Backtab);
        }
        if (event.text == Key.Return || event.text == Key.Space) {
            if (!root.activation-held) {
                root.activation-held = true;
                if (root.state.active.present) { root.activate(root.state.active.token, root.state.generation); }
            }
            return accept;
        }
        if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.text != "" && event.text >= " " && event.text < "\u{f700}") {
            root.typeahead(event.text); return accept;
        }
        return reject;
    }
    key-pressed(event) => { return root.handle-key(event); }
    key-released(event) => {
        if (event.text == Key.Return || event.text == Key.Space) { root.activation-held = false; return accept; }
        return reject;
    }
    focus-lost(reason) => { root.activation-held = false; }
}

// The trigger is the field surface of a popover. Read-only keeps it focusable
// and announced, but it neither opens nor answers hover and press.
export component KitSelectTrigger inherits KitPressable {
    control-width: ControlWidth.fill;
    in property <SelectState> state;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    callback open-requested();
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    callback tab-navigation(bool) -> EventResult;
    private property <FieldRecipe> field: KitThemes.field-recipe(root.theme, root.control-size, root.access, root.validation);
    recipe: KitThemes.trigger-recipe(root.theme, root.field, root.access);
    disabled: root.access == FieldAccess.disabled;
    border-color: root.hovered && !root.state.open ? root.field.hover-border : root.recipe.border;
    accessible-role: combobox;
    accessible-expanded: root.state.open;
    accessible-read-only: root.access == FieldAccess.read-only;
    function request-open() { if (root.access == FieldAccess.editable) { root.open-requested(); } }
    activated => {
        if (root.state.open) { root.dismiss(CloseReason.trigger-toggle); }
        else { root.request-open(); }
    }
    key-event(event) => { return translator.handle-key(event); }
    translator := KitSelectKeyboard {
        width: 0px; height: 0px;
        enabled: false;
        state: root.state;
        open-requested => { root.request-open(); }
        navigate(step) => { root.navigate(step); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { root.dismiss(reason); }
        typeahead(text) => { root.typeahead(text); }
        tab-navigation(reverse) => { return root.tab-navigation(reverse); }
    }
    @children
}

export component KitSelectSurface inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <SelectState> state;
    in property <length> row-height: 48px;
    in property <length> viewport-height: content-box.height;
    in property <bool> searchable: true;
    in property <bool> focus-search-on-open: false;
    in property <bool> empty;
    in property <string> empty-label: "No matching options";
    in property <string> search-label: "Search options";
    in-out property <string> query;
    in-out property <length> scroll-y;
    out property <length> active-scroll-y: root.scroll-y;
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    callback tab-navigation(bool) -> EventResult;
    callback query-edited(string);
    public function take-focus() {
        if (root.searchable && root.focus-search-on-open) { search.focus(); }
        else { keyboard.focus(); }
    }
    public function ensure-active-visible() {
        if (!root.state.open || root.state.active-index < 0 || root.viewport-height <= 0px) { return; }
        let top = root.state.active-index * root.row-height;
        if (top + root.scroll-y < 0px) { root.scroll-y = -top; }
        else if (top + root.row-height + root.scroll-y > root.viewport-height) {
            root.scroll-y = min(0px, root.viewport-height - top - root.row-height);
        }
    }
    changed state => { root.ensure-active-visible(); }
    changed row-height => { root.ensure-active-visible(); }
    changed viewport-height => { root.ensure-active-visible(); }
    private property <bool> opened: root.state.open;
    changed opened => { if (root.opened) { root.take-focus(); root.ensure-active-visible(); } }
    init => { if (root.state.open) { root.take-focus(); root.ensure-active-visible(); } }
    private property <SurfaceRecipe> recipe: KitThemes.surface-recipe(root.theme, SurfaceLevel.popover);
    // Content inset; nested corners follow the outer radius minus this inset.
    private property <length> inset: root.theme.spacing.unit * 1.5;
    // The surface and its two-layer shadow paint under the list.
    ElevatedSurface { recipe: root.recipe; }
    keyboard := KitSelectKeyboard {
        state: root.state;
        navigate(step) => { root.navigate(step); root.ensure-active-visible(); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { root.dismiss(reason); }
        typeahead(text) => { root.typeahead(text); root.ensure-active-visible(); }
        tab-navigation(reverse) => { return root.tab-navigation(reverse); }
        VerticalLayout {
            padding: root.inset;
            spacing: root.inset;
            Rectangle {
                visible: root.searchable;
                height: root.searchable ? max(36px, search.preferred-height + 12px) : 0px;
                border-radius: max(0px, root.recipe.radius - root.inset);
                background: root.theme.canvas;
                border-width: root.theme.shape.border-width;
                border-color: search.has-focus ? root.theme.focus.color : root.theme.border-subtle;
                search-viewport := Rectangle {
                    x: 10px; y: 6px;
                    width: parent.width - 20px; height: parent.height - 12px;
                    clip: true;
                    if root.query == "": Text {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        text: root.search-label; color: root.theme.placeholder;
                        font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                        vertical-alignment: center; overflow: elide;
                    }
                    search-scroll := Flickable {
                        interactive: false;
                        content-width: max(self.width, search.preferred-width + 2px);
                        content-height: self.height;
                        search := TextInput {
                            width: search-scroll.content-width; height: search-scroll.height;
                            text <=> root.query;
                            color: root.theme.text-primary;
                            selection-background-color: root.theme.selection;
                            selection-foreground-color: root.theme.on-selection;
                            font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                            single-line: true;
                            accessible-label: root.search-label;
                            edited => { root.query-edited(self.text); root.ensure-active-visible(); }
                            cursor-position-changed(position) => {
                                if (position.x + search-scroll.content-x < 0px) { search-scroll.content-x = -position.x; }
                                else if (position.x + 2px + search-scroll.content-x > search-scroll.width) {
                                    search-scroll.content-x = search-scroll.width - position.x - 2px;
                                }
                            }
                            key-pressed(event) => {
                                if (event.text == Key.Escape || event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Return || event.text == Key.PageDown || event.text == Key.PageUp) {
                                    return keyboard.handle-key(event);
                                }
                                return reject;
                            }
                        }
                    }
                }
            }
            content-box := Rectangle {
                min-height: 0px;
                vertical-stretch: 1;
                clip: true;
                @children
                if root.empty: Text {
                    text: root.empty-label;
                    color: root.theme.text-secondary;
                    font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Non-focusable row: the composite remains the single keyboard focus target.
export component KitOption inherits KitPressable {
    control-width: ControlWidth.fill;
    in property <OptionRow> option-data;
    in property <bool> active;
    in property <bool> selected;
    callback activate(int, int);
    disabled: root.option-data.disabled;
    tab-stop: false;
    accessible-role: list-item;
    accessible-name: root.option-data.label;
    accessible-description: root.option-data.description;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    private property <OptionRecipe> row-recipe: KitThemes.option-recipe(root.theme, root.control-size);
    // A pressed row shows the active tone. A disabled row answers neither
    // hover nor press, but keeps the active indicator for keyboard users.
    background: root.active || root.pressed ? root.row-recipe.active-fill : root.hovered ? root.row-recipe.hover-fill : root.row-recipe.fill;
    border-radius: root.row-recipe.radius;
    border-width: root.active ? root.row-recipe.border-width : 0px;
    border-color: root.row-recipe.active-border;
    private property <int> press-token;
    private property <int> press-generation;
    activation-started => {
        root.press-token = root.option-data.token;
        root.press-generation = root.option-data.generation;
    }
    changed option-data => { root.cancel-press(); }
    activated => { root.activate(root.press-token, root.press-generation); }
    @children
}

export component KitSelect inherits Rectangle {
    in property <bool> required;
    in property <string> required-message: "Please make a selection.";
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <string> validation-message: checks.validation-message;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    checks := FormConstraintState {
        kind: HtmlInputKind.select; access: root.access; required: root.required;
        custom-validity: root.custom-validity != "" ? root.custom-validity : root.state.selection-availability == SelectionAvailability.unavailable ? root.unavailable-label : ""; required-message: root.required-message;
        selected-count: root.state.selected.present && root.state.selection-availability != SelectionAvailability.unavailable ? 1 : 0;
        invalid => { root.invalid(); }
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <[OptionRow]> rows;
    in property <SelectState> state;
    in property <string> placeholder: "Choose an option";
    in property <string> unavailable-label: "Selected option is unavailable";
    in property <FieldAccess> access: FieldAccess.editable;
    // A composite (multi-select) reports its own constraint through this.
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <length> popup-height: 320px;
    in property <length> row-height: max(48px, 32px * root.theme.text-scale);
    callback open-requested();
    callback navigate(NavigationStep);
    callback activate(int, int);
    callback dismiss(CloseReason);
    callback typeahead(string);
    callback tab-navigation(bool) -> EventResult;
    callback query-edited(string);
    out property <bool> popup-visible: popup.is-open;
    out property <bool> has-focus: trigger.has-focus;
    changed has-focus => { if (!root.has-focus && !root.state.open && root.access != FieldAccess.disabled) { checks.note-blur(); } }
    changed access => {
        trigger.cancel-press();
        // The controller's closed state then closes the presentation once.
        if (root.access != FieldAccess.editable && root.state.open) { root.dismiss(CloseReason.programmatic); }
    }
    private property <ValidationPresentation> presented-validation: checks.show-error || root.state.selection-availability == SelectionAvailability.unavailable ? ValidationPresentation.invalid : root.validation;
    private property <IconRecipe> icon: KitThemes.icon-recipe(root.theme, ControlSize.medium);
    public function take-focus() { trigger.take-focus(); }
    public function cancel-press() {trigger.cancel-press();}
    min-height: KitMetrics.control-height(root.theme, root.control-size);
    preferred-height: root.min-height;
    max-height: root.preferred-height;
    vertical-stretch: 0;
    min-width: 160px;
    private property <bool> tab-restore-complete;
    function advance-tab(reverse: bool) -> EventResult {
        // Close native presentation before the host advances focus. The deferred
        // state change must not restore over the host's next focus request.
        popup.close();
        trigger.take-focus();
        root.tab-restore-complete = true;
        return root.tab-navigation(reverse);
    }
    private property <bool> opened: root.state.open;
    changed opened => {
        if (root.state.open) { popup.show(); }
        else {
            popup.close();
            if (!root.tab-restore-complete && root.access != FieldAccess.disabled) { trigger.take-focus(); }
            root.tab-restore-complete = false;
        }
    }
    changed popup-visible => {
        // Native presentation closure does not expose its precise cause.
        if (!root.popup-visible && root.state.open) { root.dismiss(CloseReason.host-closed); }
    }
    trigger := KitSelectTrigger {
        theme: root.theme;
        control-size: root.control-size;
        state: root.state;
        access: root.access;
        validation: root.presented-validation;
        accessible-name: root.placeholder;
        accessible-description: checks.show-error ? checks.validation-message : root.state.selection-availability == SelectionAvailability.unavailable ? root.unavailable-label : "";
        open-requested => { root.open-requested(); }
        navigate(step) => { root.navigate(step); }
        activate(token, generation) => { root.activate(token, generation); }
        dismiss(reason) => { root.dismiss(reason); }
        typeahead(text) => { root.typeahead(text); }
        tab-navigation(reverse) => { return root.advance-tab(reverse); }
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            Text { text: root.placeholder; color: trigger.disabled ? trigger.recipe.disabled-foreground : trigger.recipe.foreground; font-family: trigger.theme.typography.family; font-size: trigger.recipe.font-size; overflow: elide; vertical-alignment: center; }
            Rectangle {
                width: root.icon.size;
                if root.state.selection-availability == SelectionAvailability.unavailable: Text {
                    text: "!"; color: root.theme.danger; font-family: root.theme.typography.family; vertical-alignment: center; horizontal-alignment: center;
                }
                // Points up while the list is presented below the trigger.
                if root.state.selection-availability != SelectionAvailability.unavailable: KitIcon {
                    theme: root.theme;
                    y: (parent.height - self.height) / 2;
                    glyph: root.state.open ? KitGlyphs.chevron-up() : KitGlyphs.chevron-down();
                    ink: trigger.disabled ? root.icon.disabled-color : root.icon.color;
                }
            }
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + root.theme.spacing.unit;
        width: max(root.width, 240px);
        height: min(root.popup-height, max(1, root.rows.length) * root.row-height + max(36px, 20px * root.theme.text-scale + 12px) + 18px);
        close-policy: close-on-click-outside;
        surface := KitSelectSurface {
            theme: root.theme;
            state: root.state;
            row-height: root.row-height;
            viewport-height: options.visible-height;
            scroll-y <=> options.content-y;
            empty: root.rows.length == 0;
            navigate(step) => { root.navigate(step); }
            activate(token, generation) => { root.activate(token, generation); }
            dismiss(reason) => { root.dismiss(reason); }
            typeahead(text) => { root.typeahead(text); }
            tab-navigation(reverse) => { return root.advance-tab(reverse); }
            query-edited(text) => { root.query-edited(text); }
            options := ListView {
                theme: root.theme;
                for row in root.rows: KitOption {
                    theme: root.theme;
                    option-data: row;
                    height: root.row-height;
                    active: root.state.active.present && root.state.active.token == row.token;
                    selected: root.state.selected.present && root.state.selected.token == row.token;
                    activate(token, generation) => { root.activate(token, generation); }
                    HorizontalLayout {
                        spacing: KitMetrics.inline-gap(root.theme);
                        VerticalLayout {
                            spacing: root.theme.spacing.unit * 0.5;
                            Text { text: row.label; color: row.disabled ? root.theme.disabled-text : root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); overflow: elide; vertical-alignment: center; }
                            if row.description != "": Text { text: row.description; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); overflow: elide; }
                        }
                        Rectangle { width: root.icon.size; horizontal-stretch: 0;
                            if root.state.selected.present && root.state.selected.token == row.token: KitIcon { theme: root.theme; glyph: KitGlyphs.check(); ink: root.theme.accent; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }
        }
    }
}
