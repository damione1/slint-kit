                Text { text: root.period-label(index); font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); font-weight: root.period-selected(index) || root.period-today(index) ? root.theme.typography.weight-semibold : root.theme.typography.weight-regular; color: !root.period-enabled(index) ? root.theme.disabled-text : root.period-selected(index) ? root.theme.on-accent : root.theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
