import { ValidationPresentation } from "shared-contracts.slint";
import { KitTheme, KitThemes, KitMetrics, ButtonIntent, ControlSize, ControlWidth, KitThemeContext, TypographyRole, SurfaceLevel, SurfaceRecipe, ChoiceFlow } from "theme.slint";
import { ElevatedSurface } from "elevation.slint";
import { KitPressable, KitButton } from "button.slint";
import { KitModalContext } from "modal.slint";
import { KitFormValidation, ValidationTiming } from "validation.slint";
import { KitValidityState } from "validation.slint";
import { HtmlInputKind } from "validation.slint";
import { KitTextField } from "input.slint";
import { TemporalField } from "temporal-field.slint";
import { KitTimeService } from "datetime-service.slint";
import { KitFieldService } from "field-service.slint";
import { KitStrings } from "strings.slint";
import { KitFieldLabel, KitFieldDescription, KitFieldError } from "field.slint";
import { KitStrings } from "strings.slint";
import { KitIcon, KitGlyphs } from "icons.slint";
import { LucideIcons } from "icons/lucide/all.slint";
import { FieldAccess } from "contracts.slint";
import { KitKeyResult } from "keyboard.slint";
import { CalendarNavigation } from "shared-contracts.slint";
export { CalendarNavigation } from "shared-contracts.slint";

import { CivilDateView, CalendarDay, DateRangeView, CalendarView, CalendarText, CalendarProjection, CalendarConfigurationState, CalendarWeekRows, CalendarOutsideDays, KitCalendarService, DateDisplay, CalendarDayMark, CalendarMarker } from "calendar-service.slint";
export { CivilDateView, CalendarDay, DateRangeView, CalendarView, CalendarText, CalendarProjection, CalendarConfigurationState, CalendarWeekRows, CalendarOutsideDays, KitCalendarService, DateDisplay, CalendarDayMark, CalendarMarker } from "calendar-service.slint";
import { WeekStart, Ownership, CommitPolicy, EarlierEndPolicy } from "shared-contracts.slint";
import { FieldCommit, FieldState, FieldValue } from "field-service.slint";
import { DateRangePhase, DateRangeDraft, DateRangeRejection } from "calendar-service.slint";
export { DateRangePhase, DateRangeRejection } from "calendar-service.slint";

component CalendarOption inherits KitPressable {
    in property <CalendarDay> day;
    in property <FieldAccess> access: FieldAccess.editable;
    callback choose(CalendarDay);
    private property <CalendarDay> press-day;
    tab-stop: false;
    activation-started => { root.press-day = root.day; }
    changed day => { root.cancel-press(); }
    changed access => { root.cancel-press(); }
    activated => { if (root.access == FieldAccess.editable) { root.choose(root.press-day); } }
    @children
}

// What the calendar body shows: the day grid, or a grid of the twelve months
// of one year, or a grid of twelve consecutive years.
export enum CalendarViewMode { days, months, years }

// A month or year cell. `value` is its zero-based slot in the twelve-cell grid.
component CalendarPeriodOption inherits KitPressable {
    in property <int> value;
    callback choose(int);
    private property <int> press-value;
    tab-stop: false;
    activation-started => { root.press-value = root.value; }
    changed value => { root.cancel-press(); }
    activated => { root.choose(root.press-value); }
    @children
}

// One persistent keyboard scope delegates accessible focus to the materialized
// active day, without adding a Tab stop for each calendar cell.
export component KitCalendar inherits Rectangle {
    // The modal layer this control belongs to; 0 is the window. While another layer
    // is open and topmost the control is inert, like every kit control.
    in property <int> modal-layer;
    in property <Ownership> ownership: Ownership.local;
    // Interaction belongs to each calendar instance. Services only compute values.
    in-out property <CivilDateView> selected;
    in property <CivilDateView> today: KitCalendarService.today;
    private property <CalendarView> reference-view: {selected: root.selected, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges};
    in-out property <CivilDateView> focused: KitCalendarService.ready ? KitCalendarService.initial-focus(root.reference-view) : root.selected.year > 0 ? root.selected : root.today.year > 0 ? root.today : {year: 2000, month: 1, day: 1};
    in property <WeekStart> week-start: WeekStart.monday;
    in property <CalendarOutsideDays> outside-days: CalendarOutsideDays.dim;
    in property <CalendarWeekRows> week-rows: CalendarWeekRows.fixed;
    // Names always remain Monday-first; the grid's first column follows week-start.
    private property <int> weekday-offset: root.week-start == WeekStart.monday ? 0
        : root.week-start == WeekStart.tuesday ? 1 : root.week-start == WeekStart.wednesday ? 2
        : root.week-start == WeekStart.thursday ? 3 : root.week-start == WeekStart.friday ? 4
        : root.week-start == WeekStart.saturday ? 5 : 6;
    in property <[WeekStart]> unavailable-weekdays;
    in property <[DateRangeView]> unavailable-ranges;
    // Per-date decorations: marker, secondary caption and accessible description.
    in property <[CalendarDayMark]> day-marks;
    in property <[string]> month-names: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    in property <[string]> month-short-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    in property <[string]> weekday-short-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <[string]> weekday-names: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    in property <string> accessible-date-pattern: "%A %-d %B %Y";
    in property <string> title-pattern: "%B %Y";
    in property <string> today-label: "Today";
    in property <string> range-start-label: "Range start";
    in property <string> range-end-label: "Range end";
    in property <string> in-range-label: "In selected range";
    private property <CalendarText> calendar-text: {
        months: root.month-names, short-months: root.month-short-names,
        weekdays: root.weekday-names, short-weekdays: root.weekday-short-names,
        date-pattern: root.accessible-date-pattern, title-pattern: root.title-pattern,
        today: root.today-label, range-start: root.range-start-label,
        range-end: root.range-end-label, in-range: root.in-range-label,
    };
    private property <CalendarView> view: {week-rows: root.week-rows, selected: root.selected, focused: root.focused, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges, marks: root.day-marks };
    private property <CalendarProjection> projection: KitCalendarService.ready ? KitCalendarService.project(root.view, root.calendar-text) : {active-index: -1};
    out property <CalendarConfigurationState> configuration-state: root.projection.configuration-state;
    in property <string> configuration-message: KitStrings.calendar-configuration-error;
    callback chosen(CivilDateView);
    // While a range end is pending, the host passes the chosen start here (year 0 means none)
    // and the calendar previews the days from it to the hovered or keyboard-focused day.
    in property <CivilDateView> range-anchor;
    // True when a day before the anchor would become the start of the range, not restart it.
    in property <bool> preview-before-anchor;
    private property <CivilDateView> hover-date;
    changed days => { root.hover-date = {year: 0, month: 0, day: 0}; }
    out property <CivilDateView> preview-end: root.hover-date.year > 0 ? root.hover-date : keyboard.has-focus && root.view-mode == CalendarViewMode.days ? root.focused : {year: 0, month: 0, day: 0};
    pure function date-key(date: CivilDateView) -> int { return date.year * 10000 + date.month * 100 + date.day; }
    // Visual only: the day lies between the anchor (excluded) and the preview end (included).
    public pure function previewed(day: CalendarDay) -> bool {
        if (root.range-anchor.year <= 0 || root.preview-end.year <= 0 || day.year <= 0 || !day.enabled) { return false; }
        let key = root.date-key({year: day.year, month: day.month, day: day.day});
        let anchor = root.date-key(root.range-anchor);
        let end = root.date-key(root.preview-end);
        return end >= anchor ? key > anchor && key <= end : root.preview-before-anchor && key >= end && key < anchor;
    }
    public function move(direction: CalendarNavigation) {
        if (root.access == FieldAccess.disabled) { return; }
        if (KitCalendarService.ready) { root.focused = KitCalendarService.navigate(root.view, direction); }
        root.navigate(direction);
    }
    function accept-day(day: CalendarDay) {
        if (root.access != FieldAccess.editable || !root.day-allowed(day)) { return; }
        let date = {year: day.year, month: day.month, day: day.day};
        if (KitCalendarService.ready && !KitCalendarService.allowed(root.view, date)) { return; }
        if (root.ownership == Ownership.local) { root.selected = date; }
        root.focused = date;
        root.chosen(date);
        root.choose(day);
    }

    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    pure function day-allowed(day: CalendarDay) -> bool {
        if (!day.enabled || (day.outside-month && root.outside-days == CalendarOutsideDays.hide)) { return false; }
        if (!KitFormValidation.ready) { return true; }
        let year = (day.year < 10 ? "000" : day.year < 100 ? "00" : day.year < 1000 ? "0" : "") + day.year;
        let value = year + "-" + (day.month < 10 ? "0" : "") + day.month + "-" + (day.day < 10 ? "0" : "") + day.day;
        return KitFormValidation.evaluate({kind: HtmlInputKind.date, min: root.min, max: root.max,
            step: root.step, default-value: root.default-value, min-length: -1, max-length: -1}, value, true, false, 0).validity.valid;
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[CalendarDay]> days: root.projection.days;
    in property <[string]> weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <int> active-index: root.projection.active-index;
    in property <string> title: root.projection.title;
    in property <string> label: "Choose a date";
    in property <string> previous-month-label: "Previous month";
    in property <string> next-month-label: "Next month";
    in property <string> previous-year-label: "Previous year";
    in property <string> next-year-label: "Next year";
    in property <string> previous-years-label: "Previous years";
    in property <string> next-years-label: "Next years";
    // Read by assistive technology after the heading, which opens the month and year grids.
    in property <string> view-switch-label: "Choose month and year";
    in property <bool> previous-enabled: root.projection.previous-enabled;
    in property <bool> next-enabled: root.projection.next-enabled;
    in property <string> unavailable-label: KitStrings.calendar-unavailable-label;
    in property <string> navigation-help: KitStrings.calendar-navigation-help;
    in property <bool> request-focus;
    // A calendar embedded in a dialog leaves Escape to the dialog when false.
    in property <bool> escape-cancels: true;
    callback navigate(CalendarNavigation);
    callback choose(CalendarDay);
    callback cancelled();
    // The heading cycles days, months and years; a chosen month or year returns
    // toward the days. Hosts may set it to open on the months or years grid.
    in-out property <CalendarViewMode> view-mode: CalendarViewMode.days;
    private property <int> browse-year;
    private property <int> years-start;
    private property <int> period-active;
    private property <[CalendarDay]> shown-days: root.view-mode == CalendarViewMode.days ? root.days : [];
    private property <string> heading: root.view-mode == CalendarViewMode.days ? root.title
        : root.view-mode == CalendarViewMode.months ? "" + root.browse-year
        : "" + root.years-start + " - " + (root.years-start + 11);
    public function take-focus() { keyboard.focus(); }
    changed request-focus => { if (root.request-focus) { root.view-mode = CalendarViewMode.days; keyboard.focus(); } }
    init => { if (root.request-focus) { keyboard.focus(); } }
    pure function year-reachable(year: int) -> bool {
        if (!KitCalendarService.ready) { return year >= 1 && year <= 9999; }
        return KitCalendarService.show-month(root.view, year, 1).year == year;
    }
    // A month the bounds exclude comes back as another month and stays disabled.
    pure function month-reachable(year: int, month: int) -> bool {
        if (!KitCalendarService.ready) { return year >= 1 && year <= 9999; }
        let target = KitCalendarService.show-month(root.view, year, month);
        return target.year == year && target.month == month;
    }
    pure function period-enabled(index: int) -> bool {
        if (root.access == FieldAccess.disabled) { return false; }
        return root.view-mode == CalendarViewMode.months ? root.month-reachable(root.browse-year, index + 1)
            : root.year-reachable(root.years-start + index);
    }
    pure function period-selected(index: int) -> bool {
        return root.view-mode == CalendarViewMode.months
            ? root.selected.year == root.browse-year && root.selected.month == index + 1
            : root.selected.year == root.years-start + index;
    }
    pure function period-today(index: int) -> bool {
        return root.view-mode == CalendarViewMode.months
            ? root.today.year == root.browse-year && root.today.month == index + 1
            : root.today.year == root.years-start + index;
    }
    pure function period-label(index: int) -> string {
        return root.view-mode == CalendarViewMode.months ? root.month-short-names[index] : "" + (root.years-start + index);
    }
    pure function period-accessible-label(index: int) -> string {
        return root.view-mode == CalendarViewMode.months ? root.month-names[index] + " " + root.browse-year : "" + (root.years-start + index);
    }
    pure function page-enabled(forward: bool) -> bool {
        if (root.access == FieldAccess.disabled) { return false; }
        if (root.view-mode == CalendarViewMode.days) { return forward ? root.next-enabled : root.previous-enabled; }
        if (root.view-mode == CalendarViewMode.months) { return root.year-reachable(root.browse-year + (forward ? 1 : -1)); }
        return root.year-reachable(forward ? root.years-start + 12 : root.years-start - 1);
    }
    pure function page-label(forward: bool) -> string {
        if (root.view-mode == CalendarViewMode.days) { return forward ? root.next-month-label : root.previous-month-label; }
        if (root.view-mode == CalendarViewMode.months) { return forward ? root.next-year-label : root.previous-year-label; }
        return forward ? root.next-years-label : root.previous-years-label;
    }
    function page(forward: bool) {
        if (!root.page-enabled(forward)) { return; }
        if (root.view-mode == CalendarViewMode.days) { root.move(forward ? CalendarNavigation.next-month : CalendarNavigation.previous-month); }
        else if (root.view-mode == CalendarViewMode.months) { root.browse-year += forward ? 1 : -1; }
        else { root.years-start += forward ? 12 : -12; }
    }
    function show-months() {
        root.browse-year = root.focused.year;
        root.period-active = Math.max(0, Math.min(11, root.focused.month - 1));
        root.view-mode = CalendarViewMode.months;
    }
    function show-years() {
        root.years-start = Math.max(1, Math.min(9988, root.browse-year - Math.mod(root.browse-year, 12)));
        root.period-active = Math.max(0, Math.min(11, root.browse-year - root.years-start));
        root.view-mode = CalendarViewMode.years;
    }
    function cycle-view() {
        if (root.access == FieldAccess.disabled) { return; }
        if (root.view-mode == CalendarViewMode.days) { root.show-months(); }
        else if (root.view-mode == CalendarViewMode.months) { root.show-years(); }
        else { root.view-mode = CalendarViewMode.days; }
        keyboard.focus();
    }
    // Choosing browses; it never accepts a date, so read-only calendars may do it.
    function choose-period(index: int) {
        if (!root.period-enabled(index)) { return; }
        if (root.view-mode == CalendarViewMode.months) {
            if (KitCalendarService.ready) { root.focused = KitCalendarService.show-month(root.view, root.browse-year, index + 1); }
            root.view-mode = CalendarViewMode.days;
        } else {
            root.browse-year = root.years-start + index;
            root.period-active = Math.max(0, Math.min(11, root.focused.month - 1));
            root.view-mode = CalendarViewMode.months;
        }
    }
    function move-period(delta: int) {
        let target = root.period-active + delta;
        if (target >= 0 && target <= 11) { root.period-active = target; return; }
        let forward = target > 11;
        if (!root.page-enabled(forward)) { return; }
        root.page(forward);
        root.period-active = Math.mod(target + 12, 12);
    }
    // True when the key was handled by the month or year grid.
    function period-key(event: KeyEvent) -> bool {
        let across = root.right-to-left ? -1 : 1;
        if (event.text == Key.Escape) { root.view-mode = CalendarViewMode.days; return true; }
        if (event.text == Key.LeftArrow) { root.move-period(-across); return true; }
        if (event.text == Key.RightArrow) { root.move-period(across); return true; }
        if (event.text == Key.UpArrow) { root.move-period(-3); return true; }
        if (event.text == Key.DownArrow) { root.move-period(3); return true; }
        if (event.text == Key.Home) { root.period-active = 0; return true; }
        if (event.text == Key.End) { root.period-active = 11; return true; }
        if (event.text == Key.PageUp) { root.page(false); return true; }
        if (event.text == Key.PageDown) { root.page(true); return true; }
        if (event.text == Key.Return || event.text == Key.Space) {
            if (!root.activation-held) { root.activation-held = true; root.choose-period(root.period-active); }
            return true;
        }
        return false;
    }
    out property <bool> has-focus: keyboard.has-focus;
    private property <bool> right-to-left: root.flow == ChoiceFlow.right-to-left;
    private property <length> cell-height: KitMetrics.control-height(root.theme, root.control-size);
    private property <bool> activation-held;
    changed access => { root.activation-held = false; }
    min-width: 7 * root.cell-height;
    preferred-width: 448px;
    max-width: Math.max(448px,7 * root.cell-height);
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    accessible-role: groupbox;
    accessible-label: root.label + ": " + (root.view-mode != CalendarViewMode.days ? root.heading : root.active-index >= 0 && root.active-index < root.days.length ? root.days[root.active-index].accessible-label : root.title);
    accessible-description: root.view-mode != CalendarViewMode.days ? "" : root.navigation-help + (root.active-index >= 0 && root.active-index < root.days.length && !root.day-allowed(root.days[root.active-index]) ? " " + root.unavailable-label : "");
    forward-focus: keyboard;
    content := VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 2;
            KitPressable { modal-layer: root.modal-layer; theme: root.theme; recipe: KitThemes.icon-button-recipe(root.theme,root.control-size); min-width: root.cell-height; preferred-width: root.cell-height; accessible-name: root.page-label(root.right-to-left); intent: ButtonIntent.quiet; disabled: !root.page-enabled(root.right-to-left); activated => { root.page(root.right-to-left); } HorizontalLayout { alignment: center; KitIcon { theme: root.theme; glyph: root.theme.icons.chevron-left; ink: root.theme.text-primary; } } }
            // Without the installed service no month or year can be computed, so the heading stays plain text.
            if !KitCalendarService.ready: Text { text: root.heading; wrap: word-wrap; accessible-live-region: polite; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); font-weight: root.theme.typography.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
            if KitCalendarService.ready: KitPressable { modal-layer: root.modal-layer;
                theme: root.theme; control-size: root.control-size; control-width: ControlWidth.fill; intent: ButtonIntent.quiet;
                accessible-name: root.heading; description: root.view-switch-label;
                accessible-expandable: true; accessible-expanded: root.view-mode != CalendarViewMode.days;
                disabled: root.access == FieldAccess.disabled;
                activated => { root.cycle-view(); }
                Text { text: root.heading; wrap: word-wrap; accessible-live-region: polite; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); font-weight: root.theme.typography.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
            }
            KitPressable { modal-layer: root.modal-layer; theme: root.theme; recipe: KitThemes.icon-button-recipe(root.theme,root.control-size); min-width: root.cell-height; preferred-width: root.cell-height; accessible-name: root.page-label(!root.right-to-left); intent: ButtonIntent.quiet; disabled: !root.page-enabled(!root.right-to-left); activated => { root.page(!root.right-to-left); } HorizontalLayout { alignment: center; KitIcon { theme: root.theme; glyph: root.theme.icons.chevron-right; ink: root.theme.text-primary; } } }
        }
        keyboard := FocusScope {
            accessible-role: list;
            accessible-label: root.label;
            accessible-description: root.navigation-help;
            accessible-enabled: root.access != FieldAccess.disabled && !KitModalContext.inert(root.modal-layer);
            // Seven weekday headers precede the materialized cells in Slint's
            // accessible-child sequence, including hidden adjacent-month slots.
            // RTL changes geometry, not that sequence or the logical day index.
            accessible-delegate-focus: root.view-mode != CalendarViewMode.days ? root.period-active : root.active-index >= 0 && root.active-index < root.days.length
                && root.days[root.active-index].year > 0
                && (root.outside-days != CalendarOutsideDays.hide || !root.days[root.active-index].outside-month)
                ? 7 + root.active-index : -1;
            min-height: root.cell-height * (1 + (root.week-rows == CalendarWeekRows.variable && root.days.length > 0 ? ceil(root.days.length / 7) : 6));
            enabled: root.access != FieldAccess.disabled && !KitModalContext.inert(root.modal-layer);
            key-pressed(event) => {
                if (event.text == Key.Escape && root.view-mode == CalendarViewMode.days) { if (!root.escape-cancels) { return reject; } root.cancelled(); return accept; }
                if (root.access == FieldAccess.disabled) { return reject; }
                if (root.view-mode != CalendarViewMode.days) { return root.period-key(event) ? accept : reject; }
                if (event.text == Key.LeftArrow) { root.move(root.right-to-left ? CalendarNavigation.next-day : CalendarNavigation.previous-day); return accept; }
                if (event.text == Key.RightArrow) { root.move(root.right-to-left ? CalendarNavigation.previous-day : CalendarNavigation.next-day); return accept; }
                if (event.text == Key.UpArrow) { root.move(CalendarNavigation.previous-week); return accept; }
                if (event.text == Key.DownArrow) { root.move(CalendarNavigation.next-week); return accept; }
                if (event.text == Key.Home) { root.move(CalendarNavigation.week-start); return accept; }
                if (event.text == Key.End) { root.move(CalendarNavigation.week-end); return accept; }
                if (event.text == Key.PageUp) { root.move(event.modifiers.shift ? CalendarNavigation.previous-year : CalendarNavigation.previous-month); return accept; }
                if (event.text == Key.PageDown) { root.move(event.modifiers.shift ? CalendarNavigation.next-year : CalendarNavigation.next-month); return accept; }
                if (event.text == Key.Return || event.text == Key.Space) {
                    if (root.access == FieldAccess.editable && !root.activation-held && root.active-index >= 0 && root.active-index < root.days.length && root.day-allowed(root.days[root.active-index])) { root.activation-held = true; root.accept-day(root.days[root.active-index]); }
                    return accept;
                }
                return reject;
            }
            key-released(event) => { if (event.text == Key.Return || event.text == Key.Space) { root.activation-held = false; return accept; } return reject; }
            focus-lost(reason) => { root.activation-held = false; }
            for index in root.view-mode == CalendarViewMode.days ? 7 : 0: weekday-header := Text {
                x: (root.right-to-left ? 6 - mod(index,7) : mod(index,7)) * parent.width / 7; y: 0px;
                width: parent.width / 7; height: root.cell-height;
                accessible-role: text; accessible-label: root.weekday-names[mod(index + root.weekday-offset, 7)];
                text: root.weekdays[mod(index + root.weekday-offset, 7)]; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
                horizontal-alignment: center; vertical-alignment: center;
            }
            for day[index] in root.shown-days: CalendarOption { modal-layer: root.modal-layer;
                day: day; access: root.access;
                visible: day.year > 0 && (root.outside-days != CalendarOutsideDays.hide || !day.outside-month);
                x: (root.right-to-left ? 6 - mod(index,7) : mod(index,7)) * parent.width / 7;
                y: (1 + floor(index / 7)) * root.cell-height;
                width: parent.width / 7; height: root.cell-height;
                theme: root.theme; padding-inline: 0px; padding-block: 0px; intent: day.selected ? ButtonIntent.primary : ButtonIntent.quiet;
                disabled: !root.day-allowed(day) || root.access == FieldAccess.disabled; tab-stop: false;
                accessible-role: list-item; accessible-name: day.accessible-label;
