                    if day.caption != "": Text { text: day.caption; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption); color: !root.day-allowed(day) ? root.theme.disabled-text : day.selected ? root.theme.on-accent : root.theme.text-secondary; horizontal-alignment: center; overflow: elide; }
