import { ValidationPresentation } from "shared-contracts.slint";
import { KitTheme, KitThemes, KitMetrics, ButtonIntent, ControlSize, KitThemeContext, TypographyRole, SurfaceLevel, SurfaceRecipe, ChoiceFlow } from "theme.slint";
import { ElevatedSurface } from "elevation.slint";
import { KitPressable, KitButton } from "button.slint";
import { KitFormValidation } from "validation.slint";
import { KitValidityState } from "validation.slint";
import { HtmlInputKind } from "validation.slint";
import { KitTextField } from "input.slint";
import { TemporalField } from "temporal-field.slint";
import { KitTimeService } from "datetime-service.slint";
import { KitStrings } from "strings.slint";
import { KitFieldLabel, KitFieldDescription, KitFieldError } from "field.slint";
import { KitStrings } from "strings.slint";
import { KitIcon, KitGlyphs } from "icons.slint";
import { FieldAccess } from "contracts.slint";
import { CalendarNavigation } from "shared-contracts.slint";
export { CalendarNavigation } from "shared-contracts.slint";

import { CivilDateView, CalendarDay, DateRangeView, CalendarView, CalendarText, CalendarProjection, CalendarConfigurationState, CalendarWeekRows, CalendarOutsideDays, KitCalendarService } from "calendar-service.slint";
export { CivilDateView, CalendarDay, DateRangeView, CalendarView, CalendarText, CalendarProjection, CalendarConfigurationState, CalendarWeekRows, CalendarOutsideDays, KitCalendarService } from "calendar-service.slint";
import { WeekStart, Ownership, CommitPolicy } from "shared-contracts.slint";
import { FieldCommit } from "field-service.slint";
import { DateRangePhase, DateRangeDraft } from "calendar-service.slint";
export { DateRangePhase } from "calendar-service.slint";

component CalendarOption inherits KitPressable {
    in property <CalendarDay> day;
    in property <FieldAccess> access: FieldAccess.editable;
    callback choose(CalendarDay);
    private property <CalendarDay> press-day;
    tab-stop: false;
    activation-started => { root.press-day = root.day; }
    changed day => { root.cancel-press(); }
    changed access => { root.cancel-press(); }
    activated => { if (root.access == FieldAccess.editable) { root.choose(root.press-day); } }
    @children
}

// One persistent keyboard scope delegates accessible focus to the materialized
// active day, without adding a Tab stop for each calendar cell.
export component KitCalendar inherits Rectangle {
    in property <Ownership> ownership: Ownership.local;
    // Interaction belongs to each calendar instance. Services only compute values.
    in-out property <CivilDateView> selected;
    in property <CivilDateView> today: KitCalendarService.today;
    private property <CalendarView> reference-view: {selected: root.selected, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges};
    in-out property <CivilDateView> focused: KitCalendarService.ready ? KitCalendarService.initial-focus(root.reference-view) : root.selected.year > 0 ? root.selected : root.today.year > 0 ? root.today : {year: 2000, month: 1, day: 1};
    in property <WeekStart> week-start: WeekStart.monday;
    in property <CalendarOutsideDays> outside-days: CalendarOutsideDays.dim;
    in property <CalendarWeekRows> week-rows: CalendarWeekRows.fixed;
    // Names always remain Monday-first; the grid's first column follows week-start.
    private property <int> weekday-offset: root.week-start == WeekStart.monday ? 0
        : root.week-start == WeekStart.tuesday ? 1 : root.week-start == WeekStart.wednesday ? 2
        : root.week-start == WeekStart.thursday ? 3 : root.week-start == WeekStart.friday ? 4
        : root.week-start == WeekStart.saturday ? 5 : 6;
    in property <[WeekStart]> unavailable-weekdays;
    in property <[DateRangeView]> unavailable-ranges;
    in property <[string]> month-names: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    in property <[string]> month-short-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    in property <[string]> weekday-short-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <[string]> weekday-names: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    in property <string> accessible-date-pattern: "%A %-d %B %Y";
    in property <string> title-pattern: "%B %Y";
    in property <string> today-label: "Today";
    in property <string> range-start-label: "Range start";
    in property <string> range-end-label: "Range end";
    in property <string> in-range-label: "In selected range";
    private property <CalendarText> calendar-text: {
        months: root.month-names, short-months: root.month-short-names,
        weekdays: root.weekday-names, short-weekdays: root.weekday-short-names,
        date-pattern: root.accessible-date-pattern, title-pattern: root.title-pattern,
        today: root.today-label, range-start: root.range-start-label,
        range-end: root.range-end-label, in-range: root.in-range-label,
    };
    private property <CalendarView> view: {week-rows: root.week-rows, selected: root.selected, focused: root.focused, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges };
    private property <CalendarProjection> projection: KitCalendarService.ready ? KitCalendarService.project(root.view, root.calendar-text) : {active-index: -1};
    out property <CalendarConfigurationState> configuration-state: root.projection.configuration-state;
    in property <string> configuration-message: KitStrings.calendar-configuration-error;
    callback chosen(CivilDateView);
    public function move(direction: CalendarNavigation) {
        if (root.access == FieldAccess.disabled) { return; }
        if (KitCalendarService.ready) { root.focused = KitCalendarService.navigate(root.view, direction); }
        root.navigate(direction);
    }
    function accept-day(day: CalendarDay) {
        if (root.access != FieldAccess.editable || !root.day-allowed(day)) { return; }
        let date = {year: day.year, month: day.month, day: day.day};
        if (KitCalendarService.ready && !KitCalendarService.allowed(root.view, date)) { return; }
        if (root.ownership == Ownership.local) { root.selected = date; }
        root.focused = date;
        root.chosen(date);
        root.choose(day);
    }

    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    pure function day-allowed(day: CalendarDay) -> bool {
        if (!day.enabled || (day.outside-month && root.outside-days == CalendarOutsideDays.hide)) { return false; }
        if (!KitFormValidation.ready) { return true; }
        let year = (day.year < 10 ? "000" : day.year < 100 ? "00" : day.year < 1000 ? "0" : "") + day.year;
        let value = year + "-" + (day.month < 10 ? "0" : "") + day.month + "-" + (day.day < 10 ? "0" : "") + day.day;
        return KitFormValidation.evaluate({kind: HtmlInputKind.date, min: root.min, max: root.max,
            step: root.step, default-value: root.default-value, min-length: -1, max-length: -1}, value, true, false, 0).validity.valid;
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <[CalendarDay]> days: root.projection.days;
    in property <[string]> weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <int> active-index: root.projection.active-index;
    in property <string> title: root.projection.title;
    in property <string> label: "Choose a date";
    in property <string> previous-month-label: "Previous month";
    in property <string> next-month-label: "Next month";
    in property <bool> previous-enabled: root.projection.previous-enabled;
    in property <bool> next-enabled: root.projection.next-enabled;
    in property <string> unavailable-label: "Unavailable";
    in property <string> navigation-help: "Arrow keys move by day or week. Home and End move within the week. Page Up and Page Down change month; hold Shift to change year.";
    in property <bool> request-focus;
    callback navigate(CalendarNavigation);
    callback choose(CalendarDay);
    callback cancelled();
    public function take-focus() { keyboard.focus(); }
    changed request-focus => { if (root.request-focus) { keyboard.focus(); } }
    init => { if (root.request-focus) { keyboard.focus(); } }
    out property <bool> has-focus: keyboard.has-focus;
    private property <bool> right-to-left: root.flow == ChoiceFlow.right-to-left;
    private property <length> cell-height: KitMetrics.control-height(root.theme, root.control-size);
    private property <bool> activation-held;
    changed access => { root.activation-held = false; }
    min-width: 7 * root.cell-height;
    preferred-width: 448px;
    max-width: Math.max(448px,7 * root.cell-height);
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    accessible-role: groupbox;
    accessible-label: root.label + ": " + (root.active-index >= 0 && root.active-index < root.days.length ? root.days[root.active-index].accessible-label : root.title);
    accessible-description: root.navigation-help + (root.active-index >= 0 && root.active-index < root.days.length && !root.day-allowed(root.days[root.active-index]) ? " " + root.unavailable-label : "");
    forward-focus: keyboard;
    content := VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 2;
            KitPressable { theme: root.theme; recipe: KitThemes.icon-button-recipe(root.theme,root.control-size); min-width: root.cell-height; preferred-width: root.cell-height; accessible-name: root.right-to-left ? root.next-month-label : root.previous-month-label; intent: ButtonIntent.quiet; disabled: root.access == FieldAccess.disabled || !(root.right-to-left ? root.next-enabled : root.previous-enabled); activated => { root.move(root.right-to-left ? CalendarNavigation.next-month : CalendarNavigation.previous-month); } HorizontalLayout { alignment: center; KitIcon { theme: root.theme; glyph: root.theme.icons.chevron-left; ink: root.theme.text-primary; } } }
            Text { text: root.title; wrap: word-wrap; accessible-live-region: polite; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.body); font-weight: root.theme.typography.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
            KitPressable { theme: root.theme; recipe: KitThemes.icon-button-recipe(root.theme,root.control-size); min-width: root.cell-height; preferred-width: root.cell-height; accessible-name: root.right-to-left ? root.previous-month-label : root.next-month-label; intent: ButtonIntent.quiet; disabled: root.access == FieldAccess.disabled || !(root.right-to-left ? root.previous-enabled : root.next-enabled); activated => { root.move(root.right-to-left ? CalendarNavigation.previous-month : CalendarNavigation.next-month); } HorizontalLayout { alignment: center; KitIcon { theme: root.theme; glyph: root.theme.icons.chevron-right; ink: root.theme.text-primary; } } }
        }
        keyboard := FocusScope {
            accessible-role: list;
            accessible-label: root.label;
            accessible-description: root.navigation-help;
            accessible-enabled: root.access != FieldAccess.disabled;
            // Seven weekday headers precede the materialized cells in Slint's
            // accessible-child sequence, including hidden adjacent-month slots.
            // RTL changes geometry, not that sequence or the logical day index.
            accessible-delegate-focus: root.active-index >= 0 && root.active-index < root.days.length
                && root.days[root.active-index].year > 0
                && (root.outside-days != CalendarOutsideDays.hide || !root.days[root.active-index].outside-month)
                ? 7 + root.active-index : -1;
            min-height: root.cell-height * (1 + (root.week-rows == CalendarWeekRows.variable && root.days.length > 0 ? ceil(root.days.length / 7) : 6));
            enabled: root.access != FieldAccess.disabled;
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.cancelled(); return accept; }
                if (root.access == FieldAccess.disabled) { return reject; }
                if (event.text == Key.LeftArrow) { root.move(root.right-to-left ? CalendarNavigation.next-day : CalendarNavigation.previous-day); return accept; }
                if (event.text == Key.RightArrow) { root.move(root.right-to-left ? CalendarNavigation.previous-day : CalendarNavigation.next-day); return accept; }
                if (event.text == Key.UpArrow) { root.move(CalendarNavigation.previous-week); return accept; }
                if (event.text == Key.DownArrow) { root.move(CalendarNavigation.next-week); return accept; }
                if (event.text == Key.Home) { root.move(CalendarNavigation.week-start); return accept; }
                if (event.text == Key.End) { root.move(CalendarNavigation.week-end); return accept; }
                if (event.text == Key.PageUp) { root.move(event.modifiers.shift ? CalendarNavigation.previous-year : CalendarNavigation.previous-month); return accept; }
                if (event.text == Key.PageDown) { root.move(event.modifiers.shift ? CalendarNavigation.next-year : CalendarNavigation.next-month); return accept; }
                if (event.text == Key.Return || event.text == Key.Space) {
                    if (root.access == FieldAccess.editable && !root.activation-held && root.active-index >= 0 && root.active-index < root.days.length && root.day-allowed(root.days[root.active-index])) { root.activation-held = true; root.accept-day(root.days[root.active-index]); }
                    return accept;
                }
                return reject;
            }
            key-released(event) => { if (event.text == Key.Return || event.text == Key.Space) { root.activation-held = false; return accept; } return reject; }
            focus-lost(reason) => { root.activation-held = false; }
            for index in 7: weekday-header := Text {
                x: (root.right-to-left ? 6 - mod(index,7) : mod(index,7)) * parent.width / 7; y: 0px;
                width: parent.width / 7; height: root.cell-height;
                accessible-role: text; accessible-label: root.weekday-names[mod(index + root.weekday-offset, 7)];
                text: root.weekdays[mod(index + root.weekday-offset, 7)]; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
                horizontal-alignment: center; vertical-alignment: center;
            }
            for day[index] in root.days: CalendarOption {
                day: day; access: root.access;
                visible: day.year > 0 && (root.outside-days != CalendarOutsideDays.hide || !day.outside-month);
                x: (root.right-to-left ? 6 - mod(index,7) : mod(index,7)) * parent.width / 7;
                y: (1 + floor(index / 7)) * root.cell-height;
                width: parent.width / 7; height: root.cell-height;
                theme: root.theme; padding-inline: 0px; padding-block: 0px; intent: day.selected ? ButtonIntent.primary : ButtonIntent.quiet;
                disabled: !root.day-allowed(day) || root.access == FieldAccess.disabled; tab-stop: false;
                accessible-role: list-item; accessible-name: day.accessible-label;
                accessible-item-selectable: true; accessible-item-selected: day.selected;
                accessible-item-index: index; accessible-item-count: root.days.length;
                accessible-read-only: root.access == FieldAccess.read-only;
                background: day.selected ? root.theme.accent : day.in-range ? root.theme.accent-subtle : self.hovered ? root.theme.hover : transparent;
                border-width: day.today ? root.theme.shape.border-width : 0px;
                border-color: root.theme.accent;
                focus-indicated: keyboard.has-focus && root.active-index == index;
                focus-ring: KitThemes.inset-focus(root.theme);
                choose(chosen) => { keyboard.focus(); if (root.access == FieldAccess.editable) { root.accept-day(chosen); } }
                Text { text: day.label; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); font-weight: day.selected || day.today ? root.theme.typography.weight-semibold : root.theme.typography.weight-regular; color: !root.day-allowed(day) ? root.theme.disabled-text : day.selected ? root.theme.on-accent : day.outside-month && root.outside-days == CalendarOutsideDays.dim ? root.theme.text-secondary : root.theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if root.configuration-state == CalendarConfigurationState.invalid: KitFieldError {
            theme: root.theme; text: root.configuration-message;
        }
    }
}

export component KitDateField inherits TemporalField {
    input-kind: HtmlInputKind.date;
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in-out property <CivilDateView> accepted-date;
    model: KitTimeService.project-date(root.accepted-date);
    typed-accepted(value) => {
        if (!value.present) { root.accepted-date = {}; }
        else if (KitCalendarService.ready) {
            let date = KitCalendarService.parse-date(value.text);
            if (date != {}) { root.accepted-date = date; }
        }
    }
    placeholder: "YYYY-MM-DD";
    description: "Civil date; no time zone";
}

// TextInput stays mounted when the calendar opens. Host parsing, bounds and
// selection apply atomically; opening an overlay never rewrites the draft.
export component KitDatePicker inherits Rectangle {
    in property <Ownership> ownership: Ownership.local;
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    in property <bool> required;
    in property <bool> clearable;
    in property <string> clear-label: KitStrings.clear-label;
    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    in-out property <string> custom-validity;
    out property <KitValidityState> validity: editor.validity;
    out property <bool> will-validate: editor.will-validate;
    out property <string> validation-message: editor.validation-message;
    callback invalid();
    public function check-validity() -> bool { return editor.check-validity(); }
    public function report-validity() -> bool { return editor.report-validity(); }
    public function focus-if-invalid() -> bool { return editor.focus-if-invalid(); }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { editor.reset-validation(); }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in-out property <CivilDateView> accepted-date;
    // The shared native temporal field owns model projection and baseline seeding.
    in property <CivilDateView> today: KitCalendarService.today;
    private property <CalendarView> reference-view: {selected: root.accepted-date, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges};
    in-out property <CivilDateView> focused: KitCalendarService.ready ? KitCalendarService.initial-focus(root.reference-view) : root.accepted-date.year > 0 ? root.accepted-date : root.today.year > 0 ? root.today : {year: 2000, month: 1, day: 1};
    in property <WeekStart> week-start: WeekStart.monday;
    in property <CalendarOutsideDays> outside-days: CalendarOutsideDays.dim;
    in property <CalendarWeekRows> week-rows: CalendarWeekRows.fixed;
    in property <[WeekStart]> unavailable-weekdays;
    in property <[DateRangeView]> unavailable-ranges;
    in property <[string]> month-names: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    in property <[string]> month-short-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    in property <[string]> weekday-short-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <[string]> weekday-names: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    in property <string> accessible-date-pattern: "%A %-d %B %Y";
    in property <string> title-pattern: "%B %Y";
    in property <string> today-label: "Today";
    in property <string> range-start-label: "Range start";
    in property <string> range-end-label: "Range end";
    in property <string> in-range-label: "In selected range";
    private property <CalendarText> calendar-text: {
        months: root.month-names, short-months: root.month-short-names,
        weekdays: root.weekday-names, short-weekdays: root.weekday-short-names,
        date-pattern: root.accessible-date-pattern, title-pattern: root.title-pattern,
        today: root.today-label, range-start: root.range-start-label,
        range-end: root.range-end-label, in-range: root.in-range-label,
    };
    private property <CalendarView> view: {week-rows: root.week-rows,selected: root.accepted-date, today: root.today, focused: root.focused, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges};
    private property <CalendarProjection> projection: KitCalendarService.ready ? KitCalendarService.project(root.view, root.calendar-text) : {active-index: -1};
    out property <CalendarConfigurationState> configuration-state: root.projection.configuration-state;
    in property <string> configuration-message: KitStrings.calendar-configuration-error;
    callback chosen(CivilDateView);
    callback cleared();
    public function accept-date(date: CivilDateView) {
        if (root.access != FieldAccess.editable || !KitCalendarService.ready || !KitCalendarService.allowed(root.view, date)) { return; }
        if (root.ownership == Ownership.local) { root.accepted-date = date; root.text = KitCalendarService.format-date(date); }
        root.focused = date;
        root.chosen(date);
    }
    // Enter and blur both reach this path through the editor's field contract,
    // which already applied the commit policy and the HTML date constraints.
    // Re-accepting the current date would repeat `chosen` without a change.
    function accept-typed(commit: FieldCommit) {
        if (root.access != FieldAccess.editable || !KitCalendarService.ready) { return; }
        // Absence is a distinct accepted result, never a year-zero chosen date.
        // The shared field engine already rejected required/custom-invalid empties.
        if (!commit.value.present) {
            if (root.accepted-date != {}) {
                if (root.ownership == Ownership.local) { root.accepted-date = {}; }
                root.cleared();
            }
            return;
        }
        let date = KitCalendarService.parse-date(commit.value.text);
        if (date == root.accepted-date) { return; }
        root.accept-date(date);
    }
    in property <[CalendarDay]> days: root.projection.days;
    in property <[string]> weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <int> active-index: root.projection.active-index;
    in property <string> title: root.projection.title;
    in property <string> label;
    in property <string> placeholder: "YYYY-MM-DD";
    in property <string> description: "Civil date; no time zone";
    in property <string> calendar-button-label: "Calendar";
    in property <string> calendar-accessible-name: "Open calendar for " + root.label;
    in property <string> previous-month-label: "Previous month";
    in property <string> next-month-label: "Next month";
    in property <bool> previous-enabled: root.projection.previous-enabled;
    in property <bool> next-enabled: root.projection.next-enabled;
    in property <string> error;
    in-out property <string> text <=> editor.text;
    in-out property <bool> open;
    callback edited(string);
    callback commit-requested(string);
    callback navigate(CalendarNavigation);
    callback choose(CalendarDay);
    callback cancelled();
    callback opened();
    public function take-focus() { editor.take-focus(); }
    // Clear the native draft; acceptance still follows commit-policy.
    public function clear() { editor.clear(); }
    public function commit() { editor.commit(); }
    vertical-stretch: 0;
    changed open => { if (root.open) { popup.show(); root.opened(); } else { popup.close(); editor.take-focus(); } }
    private property <bool> presented: popup.is-open;
    private property <SurfaceRecipe> popup-surface: KitThemes.surface-recipe(root.theme, SurfaceLevel.popover);
    private property <length> popup-inset: root.theme.spacing.unit * 3;
    changed presented => { if (!root.presented && root.open) { root.open = false; } }
    VerticalLayout {
        spacing: root.theme.spacing.unit;
        if root.label != "": KitFieldLabel { theme: root.theme; text: root.label; access: root.access; focus-requested => { editor.take-focus(); } }
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 2;
            editor := KitDateField {
                show-validation-message: false;
                clearable: root.clearable; clear-label: root.clear-label;
                required: root.required; min: root.min; max: root.max; step: root.step; default-value: root.default-value;
                custom-validity <=> root.custom-validity;
                error: root.error;
                invalid => { root.invalid(); }

                theme: root.theme; control-size: root.control-size; access: root.access; ownership: root.ownership; commit-policy: root.commit-policy; accepted-date <=> root.accepted-date;
                label: ""; description: root.description; show-description: false; placeholder: root.placeholder; accessible-name: root.label;
                validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
                edited(text) => { root.edited(text); }
                committed(commit) => { root.accept-typed(commit); }
                commit-requested(text) => { root.commit-requested(text); }
                cancelled => { root.cancelled(); }
            }
            KitButton { theme: root.theme; control-size: root.control-size; text: root.calendar-button-label; accessible-name: root.calendar-accessible-name;
                accessible-expandable: true; accessible-expanded: root.open;
                accessible-action-expand => { if (root.access == FieldAccess.editable) { root.open = true; } }
                disabled: root.access != FieldAccess.editable; activated => { root.open = !root.open; } }
        }
        if root.error == "" && editor.validation-visible && editor.validation-message != "": KitFieldError { theme: root.theme; text: editor.validation-message; }
        if root.error != "": KitFieldError { theme: root.theme; text: root.error; }
        if !root.open && root.configuration-state == CalendarConfigurationState.invalid: KitFieldError { theme: root.theme; text: root.configuration-message; }
        if root.description != "": KitFieldDescription { theme: root.theme; text: root.description; }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + root.theme.spacing.unit; width: Math.max(root.theme.spacing.unit * 80, calendar.min-width + 2 * root.popup-inset); height: calendar.preferred-height + 2 * root.popup-inset;
        close-policy: close-on-click-outside;
        Rectangle {
            ElevatedSurface { recipe: root.popup-surface; }
            calendar := KitCalendar { week-rows: root.week-rows; outside-days: root.outside-days; month-names: root.month-names; month-short-names: root.month-short-names; weekday-names: root.weekday-names; weekday-short-names: root.weekday-short-names; accessible-date-pattern: root.accessible-date-pattern; title-pattern: root.title-pattern; today-label: root.today-label; range-start-label: root.range-start-label; range-end-label: root.range-end-label; in-range-label: root.in-range-label; flow: root.flow; today: root.today; configuration-message: root.configuration-message; ownership: Ownership.controlled; selected: root.accepted-date; focused <=> root.focused; week-start: root.week-start; unavailable-weekdays: root.unavailable-weekdays; unavailable-ranges: root.unavailable-ranges; min: root.min; max: root.max; step: root.step; default-value: root.default-value; x: root.popup-inset; y: root.popup-inset; width: parent.width - 2 * root.popup-inset; height: self.preferred-height; theme: root.theme; control-size: root.control-size; access: root.access; days: root.days; weekdays: root.weekdays; active-index: root.active-index; title: root.title; label: root.label; previous-month-label: root.previous-month-label; next-month-label: root.next-month-label; previous-enabled: root.previous-enabled; next-enabled: root.next-enabled; request-focus: root.open;
                navigate(step) => { root.navigate(step); }
                chosen(date) => { root.accept-date(date); }
                choose(day) => { root.choose(day); root.open = false; }
                cancelled => { root.cancelled(); root.open = false; }
            }
        }
    }
}

// Selecting a start/end is provisional until Apply. The Rust DateRange model
// rejects reversed dates or forbidden periods; it never normalizes them silently.
export component KitDateRangePicker inherits Rectangle {
    in property <Ownership> ownership: Ownership.local;
    in-out property <DateRangeView> selected;
    in property <CivilDateView> today: KitCalendarService.today;
    private property <CalendarView> reference-view: {selected: root.selected.start, today: root.today, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges};
    in-out property <CivilDateView> focused: KitCalendarService.ready ? KitCalendarService.initial-focus(root.reference-view) : root.selected.start.year > 0 ? root.selected.start : root.today.year > 0 ? root.today : {year: 2000, month: 1, day: 1};
    in property <string> min;
    in property <string> max;
    in property <string> min-nights;
    in property <string> max-nights;
    in property <WeekStart> week-start: WeekStart.monday;
    in property <CalendarOutsideDays> outside-days: CalendarOutsideDays.dim;
    in property <CalendarWeekRows> week-rows: CalendarWeekRows.fixed;
    in property <[WeekStart]> unavailable-weekdays;
    in property <[DateRangeView]> unavailable-ranges;
    in property <[string]> month-names: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    in property <[string]> month-short-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    in property <[string]> weekday-short-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <[string]> weekday-names: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    in property <string> accessible-date-pattern: "%A %-d %B %Y";
    in property <string> title-pattern: "%B %Y";
    in property <string> today-label: "Today";
    in property <string> range-start-label: "Range start";
    in property <string> range-end-label: "Range end";
    in property <string> in-range-label: "In selected range";
    private property <CalendarText> calendar-text: {
        months: root.month-names, short-months: root.month-short-names,
        weekdays: root.weekday-names, short-weekdays: root.weekday-short-names,
        date-pattern: root.accessible-date-pattern, title-pattern: root.title-pattern,
        today: root.today-label, range-start: root.range-start-label,
        range-end: root.range-end-label, in-range: root.in-range-label,
    };
    in property <string> rejected-message: "Choose an available end date on or after the start.";
    private property <DateRangeDraft> draft;
    init => { root.reset-draft(); }
    changed selected => { root.reset-draft(); }
    function reset-draft() { root.draft = root.selected.start.year > 0 ? {phase: DateRangePhase.complete, start: root.selected.start, end: root.selected.end} : {phase: DateRangePhase.choosing-start}; }
    private property <DateRangeView> candidate-range: {start: root.draft.start, end: root.draft.end};
    private property <bool> rejected;
    private property <CalendarView> view: {week-rows: root.week-rows, today: root.today, focused: root.focused, min: root.min, max: root.max, week-start: root.week-start, unavailable-weekdays: root.unavailable-weekdays, unavailable-ranges: root.unavailable-ranges };
    private property <CalendarProjection> projection: KitCalendarService.ready ? KitCalendarService.range-project(root.view, root.draft, root.calendar-text) : {active-index: -1};
    out property <CalendarConfigurationState> configuration-state: root.projection.configuration-state;
    in property <string> configuration-message: KitStrings.calendar-configuration-error;
    callback chosen(DateRangeView);
    function choose-date(date: CivilDateView) {
        if (root.access != FieldAccess.editable || !KitCalendarService.ready) { return; }
        let update = KitCalendarService.range-choose(root.view, root.draft, date, root.min-nights, root.max-nights);
        root.draft = update.draft;
        root.rejected = update.rejected;
    }
    public function apply() {
        if (root.access != FieldAccess.editable || root.draft.phase != DateRangePhase.complete || !KitCalendarService.range-valid(root.view, root.candidate-range, root.min-nights, root.max-nights)) { return; }
        if (root.ownership == Ownership.local) { root.selected = root.candidate-range; }
        root.chosen(root.candidate-range);
        root.apply-requested();
    }
    public function cancel() {
        root.reset-draft();
        root.rejected = false;
        root.cancelled();
    }

    in property <KitTheme> theme: KitThemeContext.current;
    in property <ChoiceFlow> flow: root.theme.direction;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <DateRangePhase> phase: root.draft.phase;
    in property <[CalendarDay]> days: root.projection.days;
    in property <[string]> weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <int> active-index: root.projection.active-index;
    in property <string> title: root.projection.title;
    in property <string> summary;
    in property <string> error: root.rejected ? root.rejected-message : "";
    in property <string> label: "Choose a date range";
    in property <string> previous-month-label: "Previous month";
    in property <string> next-month-label: "Next month";
    in property <bool> previous-enabled: root.projection.previous-enabled;
    in property <bool> next-enabled: root.projection.next-enabled;
    in property <string> choose-start-label: "Choose the start date";
    in property <string> choose-end-label: "Choose the end date";
    in property <string> ready-label: "Date range ready";
    in property <string> cancel-label: "Cancel";
    in property <string> apply-label: "Apply range";
    callback navigate(CalendarNavigation);
    callback choose(CalendarDay);
    callback apply-requested();
    callback cancelled();
    public function take-focus() { calendar.take-focus(); }
    vertical-stretch: 0;
    VerticalLayout {
        spacing: root.theme.spacing.unit * 2;
        Text { text: root.summary == "" ? (root.phase == DateRangePhase.choosing-start ? root.choose-start-label : root.phase == DateRangePhase.choosing-end ? root.choose-end-label : root.ready-label) : root.summary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); color: root.theme.text-primary; wrap: word-wrap; accessible-live-region: polite; }
        calendar := KitCalendar { week-rows: root.week-rows; outside-days: root.outside-days; month-names: root.month-names; month-short-names: root.month-short-names; weekday-names: root.weekday-names; weekday-short-names: root.weekday-short-names; accessible-date-pattern: root.accessible-date-pattern; title-pattern: root.title-pattern; today-label: root.today-label; range-start-label: root.range-start-label; range-end-label: root.range-end-label; in-range-label: root.in-range-label; flow: root.flow; today: root.today; configuration-message: root.configuration-message; focused <=> root.focused; min: root.min; max: root.max; week-start: root.week-start; unavailable-weekdays: root.unavailable-weekdays; unavailable-ranges: root.unavailable-ranges; chosen(date) => { root.choose-date(date); } label: root.label; previous-month-label: root.previous-month-label; next-month-label: root.next-month-label; previous-enabled: root.previous-enabled; next-enabled: root.next-enabled; theme: root.theme; control-size: root.control-size; access: root.access; days: root.days; weekdays: root.weekdays; active-index: root.active-index; title: root.title; navigate(step) => { root.navigate(step); } choose(day) => { root.choose(day); } cancelled => { root.cancel(); } }
        if root.error != "": KitFieldError { theme: root.theme; text: root.error; }
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            KitButton { theme: root.theme; control-size: root.control-size; text: root.cancel-label; disabled: root.access == FieldAccess.disabled; intent: ButtonIntent.quiet; activated => { root.cancel(); } }
            KitButton { theme: root.theme; control-size: root.control-size; text: root.apply-label; intent: ButtonIntent.primary; disabled: root.access != FieldAccess.editable || root.phase != DateRangePhase.complete || root.error != "" || root.configuration-state == CalendarConfigurationState.invalid; activated => { root.apply(); } }
        }
    }
}

export component KitMonthField inherits TemporalField {
    input-kind: HtmlInputKind.month;
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in-out property <int> accepted-year;
    in-out property <int> accepted-month;
    model: KitTimeService.project-month(root.accepted-year, root.accepted-month);
    typed-accepted(value) => {
        let parsed = KitTimeService.parse-month(value.text);
        if (parsed.valid) { root.accepted-year = parsed.year; root.accepted-month = parsed.month; }
    }
    placeholder: "YYYY-MM";
}
export component KitYearField inherits TemporalField {
    input-type: InputType.decimal; min: "1"; max: "9999"; step: "1";
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in-out property <int> accepted-year;
    model: KitTimeService.project-year(root.accepted-year);
    typed-accepted(value) => {
        let parsed = KitTimeService.parse-year(value.text);
        if (parsed.valid) { root.accepted-year = parsed.year; }
    }
    placeholder: "YYYY";
}
export component KitIsoWeekField inherits TemporalField {
    input-kind: HtmlInputKind.week;
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in-out property <int> accepted-week-year;
    in-out property <int> accepted-week;
    model: KitTimeService.project-week(root.accepted-week-year, root.accepted-week);
    typed-accepted(value) => {
        let parsed = KitTimeService.parse-week(value.text);
        if (parsed.valid) { root.accepted-week-year = parsed.year; root.accepted-week = parsed.week; }
    }
    placeholder: "YYYY-Www";
}
