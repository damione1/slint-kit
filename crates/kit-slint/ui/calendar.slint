export component KitDateField inherits TemporalField {
    input-kind: HtmlInputKind.date;
    validation: root.error != "" ? ValidationPresentation.invalid : ValidationPresentation.pristine;
    in-out property <CivilDateView> accepted-date;
    model: KitTimeService.project-date(root.accepted-date);
    typed-accepted(value) => {
        if (!value.present) { root.accepted-date = {}; }
        else if (KitCalendarService.ready) {
            let date = KitCalendarService.parse-date(value.text);
            if (date != {}) { root.accepted-date = date; }
        }
    }
    placeholder: "YYYY-MM-DD";
    description: KitStrings.date-description;
    // Display-at-rest format. Editing, constraints and the accepted value stay
    // ISO; an empty pattern (or an invalid one) keeps the ISO text.
    in property <DateDisplay> display-format;
    display-text: !KitFieldService.ready || root.accepted-text != root.text ? root.text
        : root.display-format.pattern != "" && KitCalendarService.ready ? KitCalendarService.display-date(root.text, root.display-format)
        : KitFieldService.display(root.spec-key, root.text);
    // Alt+ArrowDown and F4 ask the host to open its calendar, as on the web.
    callback open-requested();
    private property <CivilDateView> draft-date: KitCalendarService.ready ? KitCalendarService.parse-date(root.text) : {};
    private property <CalendarView> step-view: {selected: root.draft-date, focused: root.draft-date, today: KitCalendarService.today, min: root.min, max: root.max, unavailable-weekdays: [], unavailable-ranges: []};
    private property <CalendarView> empty-view: {today: KitCalendarService.today, min: root.min, max: root.max, unavailable-weekdays: [], unavailable-ranges: []};
    // ArrowUp/ArrowDown step the draft by a day and PageUp/PageDown by a month
    // (Shift: year). An empty draft starts at the nearest allowed day to today;
    // a draft that is not a date stays with the native editor. A step clamped
    // at a bound edits nothing but is still consumed.
    function step-date(direction: CalendarNavigation) -> KitKeyResult {
        if (!KitCalendarService.ready || root.access != FieldAccess.editable) { return KitKeyResult.reject; }
        if (root.text == "") {
            root.replace-draft(KitCalendarService.format-date(KitCalendarService.initial-focus(root.empty-view)));
            return KitKeyResult.accept;
        }
        if (root.draft-date.year <= 0) { return KitKeyResult.reject; }
        let next = KitCalendarService.format-date(KitCalendarService.navigate(root.step-view, direction));
        if (next != "" && next != root.text) { root.replace-draft(next); }
        return KitKeyResult.accept;
    }
    key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta) { return KitKeyResult.reject; }
        if (event.text == Key.F4 || (event.text == Key.DownArrow && event.modifiers.alt)) {
            if (root.access != FieldAccess.editable) { return KitKeyResult.reject; }
            root.open-requested();
            return KitKeyResult.accept;
        }
        if (event.modifiers.alt) { return KitKeyResult.reject; }
        if (event.text == Key.UpArrow && !event.modifiers.shift) { return root.step-date(CalendarNavigation.next-day); }
        if (event.text == Key.DownArrow && !event.modifiers.shift) { return root.step-date(CalendarNavigation.previous-day); }
        if (event.text == Key.PageUp) { return root.step-date(event.modifiers.shift ? CalendarNavigation.next-year : CalendarNavigation.next-month); }
        if (event.text == Key.PageDown) { return root.step-date(event.modifiers.shift ? CalendarNavigation.previous-year : CalendarNavigation.previous-month); }
        return KitKeyResult.reject;
    }
}

// TextInput stays mounted when the calendar opens. Host parsing, bounds and
// selection apply atomically; opening an overlay never rewrites the draft.
// How the picker offers its calendar: a labelled text button, a compact icon
// button, or no button (F4, Alt+ArrowDown and `open` still open it).
export enum DatePickerTrigger { text-button, icon-button, none }

