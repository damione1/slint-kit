export enum TextEditCommand { undo, redo, cut, copy, paste, select-all }
export struct TextEditLabels { undo: string, redo: string, cut: string, copy: string, paste: string, select-all: string }
export struct TextEditAvailability { editable: bool, selection: bool, hidden-password: bool, has-text: bool }
export struct TextEditCommandResult { valid: bool, command: TextEditCommand }
export struct TextMenuPlacement { origin-x: length, origin-y: length, anchor-x: length, anchor-y: length, width: length, height: length }
export struct TextMenuGeometry { valid: bool, x: length, y: length, width: length, height: length }
