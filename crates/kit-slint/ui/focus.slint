import { FocusRequest } from "contracts.slint";
import { KitFocusRing, KitThemes, FocusRingStyle } from "theme.slint";
export { FocusRequest } from "contracts.slint";

// The host registers logical targets after window creation. A recycled target
// must have a new generation. No registration callback is emitted from init.
export component KitFocusTarget inherits FocusScope {
    in property <int> token;
    in property <int> generation;
    in property <bool> eligible: true;
    in property <FocusRequest> request;
    callback focus-requested();
    callback focus-applied(int, int, int);
    callback focus-observed(int, bool);
    private property <int> applied-request: -1;
    enabled: root.eligible;
    focus-on-tab-navigation: false;
    function apply-request() {
        if (root.eligible && root.request.present && root.request.token == root.token && root.request.generation == root.generation && root.request.request != root.applied-request) {
            root.applied-request = root.request.request;
            root.focus();
            root.focus-requested();
            root.focus-applied(root.token, root.generation, root.request.request);
        }
    }
    changed request => { root.apply-request(); }
    changed eligible => { root.apply-request(); }
    init => { root.apply-request(); }
    focus-gained(reason) => { root.focus-observed(root.token, true); }
    focus-lost(reason) => { root.focus-observed(root.token, false); }
    @children
}

// The single focus indicator of the kit. Place it as a direct child of the
// focusable host, after its content, and give it the host's size and painted
// radius; the ring supplies position, width and color. It never takes input.
export component FocusOutline inherits Rectangle {
    in property <KitFocusRing> ring;
    in property <length> radius;
    in property <length> host-width;
    in property <length> host-height;
    x: -KitThemes.focus-outset(root.ring);
    y: -KitThemes.focus-outset(root.ring);
    width: root.host-width - 2 * self.x;
    height: root.host-height - 2 * self.y;
    border-radius: root.ring.style == FocusRingStyle.outside ? root.radius + root.ring.offset : root.radius;
    border-width: root.ring.width;
    border-color: root.ring.color;
    background: transparent;
}
