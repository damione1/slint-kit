import { KitInputConstraints } from "validation.slint";
import { FieldValue } from "field-service.slint";
import { CivilDateView } from "calendar-service.slint";
import { TimePrecision, ClockFormat } from "shared-contracts.slint";
import { KitDayPeriods, KitStrings } from "strings.slint";
import { OptionRow, SelectionRef } from "contracts.slint";
export enum TimeSegment { hour, minute, second }
export enum TimeAdjustment { increment, decrement }
export enum ZonedTimePresentation { unresolved, unique, ambiguous, nonexistent, invalid-zone }
export enum AmbiguousTimeChoice { earlier, later }
export enum ZonedOccurrenceSelection { unselected, earlier, later }
export enum ZonedAcceptance { unique, earlier, later }
export struct LocalTimeView { hour: int, minute: int, second: int }
export struct LocalTimeValue { present: bool, time: LocalTimeView }
export struct TemporalProjection { valid: bool, value: FieldValue }
export struct LocalTimeResult { valid: bool, value: LocalTimeValue }
// Typed parse results of the simple temporal fields. Absence is valid and all zero.
export struct YearResult { valid: bool, year: int }
export struct YearMonthResult { valid: bool, year: int, month: int }
export struct IsoWeekResult { valid: bool, year: int, week: int }
export struct LocalDateTimeView { date: CivilDateView, time: LocalTimeView }
export struct LocalDateTimeDraft { date: string, time: string }
export struct ZonedDateTimeDraft { date: string, time: string, zone: string }
// Offsets are seconds east of UTC. `utc-offset-seconds` is the unique (or earlier) occurrence,
// `later-utc-offset-seconds` the later one of an overlap; both are 0 unless the state is unique or ambiguous.
export struct ZonedDateTimeResult { state: ZonedTimePresentation, local: LocalDateTimeView, utc-offset-seconds: int, later-utc-offset-seconds: int }
export struct ZonedDateTimeCommit { local: LocalDateTimeView, zone: string, acceptance: ZonedAcceptance, utc-offset-seconds: int }
export global KitTimeService {
    in-out property <bool> ready;
    // The twelve-hour markers the callbacks below parse and print, read from the window's strings.
    in property <KitDayPeriods> day-periods: KitStrings.day-periods;
    pure callback project-date(CivilDateView) -> TemporalProjection;
    pure callback project-year(int) -> TemporalProjection;
    pure callback project-month(int, int) -> TemporalProjection;
    pure callback project-week(int, int) -> TemporalProjection;
    pure callback project-time(LocalTimeValue, TimePrecision, ClockFormat) -> TemporalProjection;
    pure callback parse-year(string) -> YearResult;
    pure callback parse-month(string) -> YearMonthResult;
    pure callback parse-week(string) -> IsoWeekResult;
    pure callback parse-time(string, TimePrecision, ClockFormat) -> LocalTimeResult;
    pure callback adjust(string, KitInputConstraints, TimePrecision, ClockFormat, TimeSegment, TimeAdjustment) -> string;
    pure callback parse-local(LocalDateTimeDraft, TimePrecision, ClockFormat) -> LocalDateTimeView;
    // Splits a `datetime-local` value ("2026-10-01T09:30") into its date and time drafts.
    pure callback split-local-text(string) -> LocalDateTimeDraft;
    pure callback resolve(ZonedDateTimeDraft, TimePrecision, ClockFormat) -> ZonedDateTimeResult;
    // The whole IANA catalogue as options: the label is the zone name, the
    // description its current UTC offset and a readable place name.
    pure callback zone-options() -> [OptionRow];
    // The option of `options` whose label is exactly the zone name, if any.
    pure callback zone-selection([OptionRow], string) -> SelectionRef;
}
