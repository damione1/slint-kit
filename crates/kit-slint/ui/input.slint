import { TextEditCommand, TextMenuGeometry } from "text-edit.slint";
import { TextEditMenu } from "text-edit-menu.slint";
import { OptionRow } from "contracts.slint";
import { KitKeyResult } from "keyboard.slint";
import { KitStrings } from "strings.slint";
import { FieldState, FieldValue, FieldCommit, KitFieldService, NumberStepResult, NumberRangeView } from "field-service.slint";
import { FieldAction, CommitPolicy, Ownership, StepDirection, NumberStepStatus } from "shared-contracts.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { KitTheme, KitThemes, KitMetrics, TypographyRole, OptionRecipe, ControlSize, ButtonIntent, ControlWidth, KitThemeContext, FieldRecipe, IconRecipe, ChoiceFlow } from "theme.slint";
import { KitScrollBar } from "scroll.slint";
import { KitSpinner } from "feedback.slint";
import { KitField, KitFieldLabel, KitFieldDescription, KitFieldError, KitInputGroup, FieldDecoration } from "field.slint";
import { KitPressable } from "button.slint";
import { KitIcon, KitGlyphs, IconGlyph } from "icons.slint";
import { FieldAccess, ValidationPresentation, TextPurpose, SecretVisibility } from "shared-contracts.slint";
export { TextPurpose, SecretVisibility } from "shared-contracts.slint";
import { NumberInputFormat, PhoneNumberMode } from "shared-contracts.slint";
export { PhoneNumberMode } from "shared-contracts.slint";
import { KitFormValidation, FormConstraintState, FormEditorFocus, KitInputConstraints, KitMaskRules, KitValidityState, HtmlInputKind, ValidationTiming } from "validation.slint";

export { FieldDecoration } from "field.slint";

export enum ResizePolicy { fixed, auto-grow }
export enum TextLineMode { single-line, multiline }
export enum CharacterCountFormat { count, of-max, remaining }
export enum TextEscapeBehavior { bubble, cancel, clear }
export enum TextContextMenu { standard, disabled }
export enum TextLengthPolicy { validate, limit }
export enum SecretToggleVisibility { shown, hidden }

// An action shares the field's compact icon recipe and keeps pointer activation
// on the native editor; keyboard users can still tab to the button normally.
component InputFieldAction inherits Rectangle {
    in property <KitTheme> theme: KitThemeContext.current;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <length> editor-height;
    in property <IconGlyph> glyph;
    in property <string> label;
    in property <bool> disabled;
    callback activated();
    private property <IconRecipe> icon: KitThemes.icon-recipe(root.theme, root.control-size);
    private property <length> action-extent: root.icon.size + root.theme.spacing.unit * 3;
    width: root.control-size == ControlSize.comfortable ? KitMetrics.control-height(root.theme, root.control-size) : root.action-extent;
    height: root.editor-height;
    action := KitPressable {
        x: 0px; y: (parent.height - self.height) / 2;
        theme: root.theme; intent: ButtonIntent.quiet; control-size: ControlSize.compact;
        recipe: KitThemes.icon-button-recipe(root.theme, ControlSize.compact);
        width: parent.width;
        height: root.control-size == ControlSize.comfortable ? KitMetrics.control-height(root.theme, root.control-size) : Math.min(root.action-extent, root.editor-height);
        disabled: root.disabled;
        focus-on-pointer: false;
        accessible-name: root.label;
        activated => { root.activated(); }
        KitIcon {
            theme: root.theme; control-size: root.control-size;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            glyph: root.glyph;
            ink: action.disabled ? root.icon.disabled-color : root.icon.color;
        }
    }
}

// All variants retain this one native TextInput throughout theme, validation,
// placeholder and reveal changes. Parsing and grapheme counting belong to Rust.
export component KitTextField inherits KitField {
    in property <bool> implicit-form-submit: true;
    in property <CommitPolicy> commit-policy: CommitPolicy.on-blur;
    in property <Ownership> ownership: Ownership.local;
    in property <string> spec-key;
    out property <FieldState> field-state;
    out property <string> accepted-text: root.field-state.accepted.text;
    callback committed(FieldCommit);
    init => { root.field-state = {accepted: {present: root.text != "", text: root.text}, draft: root.text}; }
    function reduce-field(action: FieldAction) {
        if (!KitFieldService.ready || root.access != FieldAccess.editable) { return; }
        root.field-state = KitFieldService.reduce(root.field-state, action, root.text, checks.constraints, root.commit-policy, root.ownership, root.spec-key, checks.dirty, KitStrings.fields);
        if (action == FieldAction.cancel) { root.text = root.field-state.draft; }
        if (root.field-state.committed) { root.committed({value: root.field-state.value, constraints: checks.constraints, spec: root.spec-key}); }
        else if (action == FieldAction.submit && root.field-state.error != "" && !(root.implicit-form-submit && KitFormValidation.implicit-submit-active(KitFormValidation.focus-generation))) { root.invalid(); }
    }
    // Pointer stepping (the KitNumberStepper buttons) rewrites the draft and
    // commits at once; the editor need not have focus. An unavailable or
    // unchanged step commits the current draft, as before.
    public function step-number(direction: StepDirection) {
        if (KitFieldService.ready && root.access == FieldAccess.editable) {
            let result = KitFieldService.step-number(root.text, checks.constraints, direction, 1);
            if (result.status == NumberStepStatus.stepped) { root.text = result.text; }
            root.reduce-field(FieldAction.submit);
        }
    }
    // Keyboard, wheel and accessible stepping share one exact step in Rust and
    // the native edit path here: the result replaces the selection like typed
    // text, so `edited`, `value-edited`, dirty tracking, the commit policy and
    // native undo all apply. A step clamped at a bound edits nothing.
    private property <bool> number-stepping: root.input-kind == HtmlInputKind.number && root.step != "any" && !root.multiline;
    // PageUp/PageDown move this many steps; a count below one steps nothing.
    in property <int> page-steps: 10;
    // Wheel stepping while the editor has focus; off by default, as on the web.
    in property <bool> wheel-stepping;
    // Accessible range of a number field; other kinds project to no bounds.
    out property <NumberRangeView> number-range: KitFieldService.ready ? KitFieldService.number-range(checks.constraints) : { minimum: 0, maximum: 0, step: 0 };
    function apply-step(result: NumberStepResult) -> bool {
        if (result.status == NumberStepStatus.unavailable) { return false; }
        if (result.status == NumberStepStatus.unchanged) { return true; }
        if (result.status == NumberStepStatus.stepped && editor.preedit-text == "") {
            root.take-focus();
            editor.select-all();
            KitFieldService.edit-selection(result.text);
        }
        return true;
    }
    // Returns whether stepping applied to this field (even when clamped), so a
    // key that did not step stays with the native editor.
    public function step-by(direction: StepDirection, count: int) -> bool {
        if (!KitFieldService.ready || !root.number-stepping || root.access != FieldAccess.editable) { return false; }
        return root.apply-step(KitFieldService.step-number(root.text, checks.constraints, direction, count));
    }
    public function step-to-bound(direction: StepDirection) -> bool {
        if (!KitFieldService.ready || !root.number-stepping || root.access != FieldAccess.editable) { return false; }
        return root.apply-step(KitFieldService.step-number-to-bound(root.text, checks.constraints, direction));
    }
    public function commit() { if (root.report-validity()) { root.reduce-field(FieldAction.submit); } }
    public function acknowledge(value: FieldValue) { root.field-state.accepted = value; }

    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <TextPurpose> purpose: TextPurpose.plain;
    // Native filtering applies to typing and paste without rewriting the draft.
    in property <InputType> input-type: InputType.text;
    // Semantic constraints are shared by built-in and custom field skins.
    in property <HtmlInputKind> input-kind: root.multiline ? HtmlInputKind.text-area
        : root.input-type == InputType.decimal ? HtmlInputKind.number
        : root.purpose == TextPurpose.email ? HtmlInputKind.email
        : root.purpose == TextPurpose.url ? HtmlInputKind.url
        : root.purpose == TextPurpose.telephone ? HtmlInputKind.telephone
        : root.purpose == TextPurpose.password ? HtmlInputKind.password
        : root.purpose == TextPurpose.search ? HtmlInputKind.search : HtmlInputKind.text;
    in property <bool> validation-twelve-hour;
    in property <string> validation-mask;
    private property <bool> mask-ready: root.validation-mask == "" || KitFormValidation.ready;
    in property <NumberInputFormat> number-format: NumberInputFormat.canonical;
    // Custom skins may normalize validation independently of the native draft.
    in property <string> validation-text: root.text;
    in property <string> display-text: KitFieldService.ready && root.accepted-text == root.text ? KitFieldService.display(root.spec-key, root.text) : root.text;
    in property <string> intrinsic-error;
    private property <bool> formatted-at-rest: !root.has-focus && root.text != "" && root.display-text != root.text;
    in property <bool> required;
    in property <bool> show-required-indicator: true;
    in property <string> required-label: KitStrings.required-label;
    in property <bool> multiple;
    in property <int> min-length: -1;
    in property <int> max-length: -1;
    // Strict edits need the shared UTF-16 bridge installed before input begins.
    in property <TextLengthPolicy> length-policy: TextLengthPolicy.validate;
    private property <string> previous-edit-text;
    private property <bool> limiting-edit;
    private property <bool> length-limit-ready: KitFormValidation.ready;
    function synchronize-length-limit() {
        if (root.length-policy == TextLengthPolicy.limit && root.max-length >= 0 && root.length-limit-ready) {
            let limited = KitFormValidation.limit-text-edit(root.text, root.text, root.max-length);
            if (limited.text != root.text) { root.text = limited.text; }
        }
        root.previous-edit-text = root.text;
    }
    changed text => { root.field-state.error = ""; root.synchronize-length-limit(); }
    changed max-length => { root.synchronize-length-limit(); }
    changed length-policy => { root.synchronize-length-limit(); }
    changed length-limit-ready => { root.synchronize-length-limit(); }
    in property <string> pattern;
    in property <bool> pattern-enabled: root.pattern != "";
    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    in property <ValidationTiming> validation-timing: ValidationTiming.on-blur;
    in-out property <string> custom-validity;
    in property <string> required-message: KitStrings.required-message;
    in property <string> email-message: KitStrings.email-message;
    in property <string> url-message: KitStrings.url-message;
    in property <string> pattern-message: KitStrings.pattern-message;
    in property <string> too-short-message: KitStrings.too-short-template.replace-all("{count}", "" + root.min-length);
    in property <string> too-long-message: KitStrings.too-long-template.replace-all("{count}", "" + root.max-length);
    in property <string> underflow-message: KitStrings.underflow-template.replace-all("{value}", root.min);
    in property <string> overflow-message: KitStrings.overflow-template.replace-all("{value}", root.max);
    in property <string> step-message: KitStrings.step-message;
    in property <string> bad-input-message: KitStrings.bad-input-message;
    out property <KitInputConstraints> constraints: checks.constraints;
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <bool> validation-ready: checks.validation-ready;
    out property <string> validation-message: checks.validation-message;
    out property <bool> error-visible: checks.show-error;
    out property <string> pattern-error: checks.pattern-error;
    out property <string> value: checks.value;
    out property <bool> dirty: checks.dirty;
    out property <bool> touched: checks.touched;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { return checks.report-validity(); }
    public function focus-if-invalid() -> bool { if (root.will-validate && !root.validity.valid) { root.take-focus(); return true; } return false; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    public function reset-field() { root.text = root.default-value; root.field-state = {accepted: {present: root.default-value != "", text: root.default-value}, draft: root.default-value}; root.synchronize-length-limit(); checks.reset-validation(); root.edited(root.text); root.synchronize-length-limit(); }
    private property <ValidationPresentation> effective-validation: root.validation == ValidationPresentation.invalid || checks.show-error ? ValidationPresentation.invalid : root.validation;
    private property <string> effective-error: !checks.validity.valid ? checks.validation-message : root.field-state.error != "" ? root.field-state.error : root.intrinsic-error != "" ? checks.validation-message : root.validation == ValidationPresentation.invalid && root.error != "" ? root.error : checks.validation-message;
    in-out property <SecretVisibility> secret-visibility: SecretVisibility.hidden;
    in property <SecretToggleVisibility> reveal-toggle: SecretToggleVisibility.shown;
    in property <bool> clearable: root.purpose == TextPurpose.search;
    in property <bool> busy;
    in property <string> busy-label: KitStrings.busy-label;
    private property <string> activity-label: KitStrings.join-description(root.busy ? root.busy-label : "", root.validation == ValidationPresentation.checking ? root.checking-label : "");
    in property <ChoiceFlow> flow: root.theme.direction;
    private property <int> flow-sign: root.flow == ChoiceFlow.right-to-left ? -1 : 1;
    out property <int> leading-adornment-order: -root.flow-sign;
    out property <int> trailing-adornment-order: root.flow-sign;
    callback cleared();
    callback secret-visibility-changed(SecretVisibility);
    changed secret-visibility => { root.secret-visibility-changed(root.secret-visibility); }
    in property <TextLineMode> line-mode: TextLineMode.single-line;
    in property <ResizePolicy> resize-policy: ResizePolicy.fixed;
    in property <int> min-lines: 3;
    in property <int> max-lines: 8;
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <InputMethodHints> input-method-hints: { capitalization: root.purpose == TextPurpose.plain ? CapitalizationMode.sentences : CapitalizationMode.none, auto-correct: root.purpose == TextPurpose.plain, auto-complete: root.purpose == TextPurpose.plain };
    in property <bool> show-validation-message: true;
    out property <bool> validation-visible: root.effective-validation == ValidationPresentation.invalid;
    in property <string> description;
    in property <string> error;
    in property <string> placeholder;
    in property <FieldDecoration> decoration: FieldDecoration.boxed;
    in property <int> underline-segments: 1;
    in property <string> text-font-family: root.theme.typography.family;
    in property <length> text-inset: 0px;
    out property <length> text-cell-width: glyph-measure.preferred-width;
    in property <length> text-letter-spacing: 0px;
    in property <TextHorizontalAlignment> text-alignment: TextHorizontalAlignment.start;
    // Logical edges follow the explicit kit direction. Slint 1.18.1's software
    // text layout aliases Start/End to Left/Right, so project physical edges
    // while preserving explicit Left/Center/Right and the native editor.
    private property <TextHorizontalAlignment> effective-text-alignment: root.text-alignment == TextHorizontalAlignment.start
        ? (root.theme.direction == ChoiceFlow.right-to-left ? TextHorizontalAlignment.right : TextHorizontalAlignment.left)
        : root.text-alignment == TextHorizontalAlignment.end
            ? (root.theme.direction == ChoiceFlow.right-to-left ? TextHorizontalAlignment.left : TextHorizontalAlignment.right)
            : root.text-alignment;
    in property <IconGlyph> leading-icon: root.purpose == TextPurpose.search ? root.theme.icons.search : { stroke: "", fill: "", viewbox: 24 };
    in property <IconGlyph> trailing-icon;
    in property <length> corner-radius: root.recipe.radius;
    in property <length> padding-inline: root.recipe.padding-inline;
    in property <length> padding-block: root.recipe.padding-block;
    in property <length> text-size: root.recipe.font-size;
    in property <string> prefix;
    in property <string> suffix;
    in-out property <string> text;
    in property <bool> show-character-count;
    in property <int> character-count: KitFormValidation.ready ? KitFormValidation.grapheme-count(root.text) : 0;
    in property <CharacterCountFormat> character-count-format: CharacterCountFormat.count;
    in property <int> character-count-warning-threshold;
    private property <int> used-length: KitFormValidation.ready ? KitFormValidation.utf16-count(root.text) : 0;
    out property <bool> character-count-warning: root.max-length >= 0 && root.used-length >= root.max-length - Math.max(0, root.character-count-warning-threshold);
    in property <string> character-count-text: root.character-count-format == CharacterCountFormat.count || root.max-length < 0 ? root.character-count + " " + root.character-count-label
        : root.character-count-format == CharacterCountFormat.of-max ? KitStrings.counter-of-max-template.replace-all("{used}", "" + root.used-length).replace-all("{max}", "" + root.max-length)
        : KitStrings.counter-remaining-template.replace-all("{remaining}", "" + Math.max(0, root.max-length - root.used-length));
    in property <string> reveal-label: KitStrings.reveal-label;
    in property <string> hide-label: KitStrings.hide-label;
    in property <string> clear-label: root.purpose == TextPurpose.search ? KitStrings.clear-search-label : KitStrings.clear-label;
    in property <string> character-count-label: root.character-count == 1 ? KitStrings.character-singular : KitStrings.character-plural;
    in property <string> checking-label: KitStrings.checking-label;
    private property <bool> menu-opened: text-menu.is-open;
    out property <bool> has-focus: editor.has-focus || root.menu-opened;
    in property <TextEscapeBehavior> escape-behavior: root.purpose == TextPurpose.search ? TextEscapeBehavior.clear : TextEscapeBehavior.bubble;
    in property <bool> submit-on-modified-enter;
    callback key-pressed(KeyEvent) -> KitKeyResult;
    callback edited(string);
    // Semantic value, separate from the native draft callback above.
    callback value-edited(string);
    callback commit-requested(string);
    callback cancelled();
    callback focus-observed(bool);
    public function take-focus() { if (root.access != FieldAccess.disabled) { if (root.menu-opened) { text-menu.close(); } editor.focus(); } }
    public function select-all() { editor.select-all(); }
    public function copy-selection() { if (!root.hidden-password) { editor.copy(); } }
    public function cut-selection() { if (root.access == FieldAccess.editable && root.mask-ready && !root.hidden-password) { editor.cut(); } }
    public function paste() { if (root.access == FieldAccess.editable && root.paste-allowed()) { editor.paste(); } }
    public function undo() { if (root.access == FieldAccess.editable && root.mask-ready) { editor.undo(); } }
    public function redo() { if (root.access == FieldAccess.editable && root.mask-ready) { editor.redo(); } }
    public function clear() {
        if (root.access == FieldAccess.editable && KitFieldService.ready && editor.preedit-text == "") {
            root.take-focus();
            if (root.text != "") {
                editor.select-all(); KitFieldService.edit-selection("");
                if (root.text == "") { root.cleared(); }
            }
        }
    }
    public function blur() { text-menu.close(); editor.clear-focus(); }
    public function set-selection(anchor: int, cursor: int) { editor.set-selection-offsets(anchor, cursor); }
    public function insert-at-cursor(text: string) { if (root.access == FieldAccess.editable && KitFieldService.ready && editor.preedit-text == "") { root.take-focus(); KitFieldService.edit-selection(text); } }
    out property <int> cursor-position: editor.cursor-position-byte-offset;
    out property <int> selection-anchor: editor.anchor-position-byte-offset;
    in property <TextContextMenu> context-menu: TextContextMenu.standard;
    in property <string> undo-label: KitStrings.undo-label;
    in property <string> redo-label: KitStrings.redo-label;
    in property <string> cut-label: KitStrings.cut-label;
    in property <string> copy-label: KitStrings.copy-label;
    in property <string> paste-label: KitStrings.paste-label;
    in property <string> select-all-label: KitStrings.select-all-label;
    private property <bool> hidden-password: root.input-type == InputType.password || (root.purpose == TextPurpose.password && root.secret-visibility == SecretVisibility.hidden);
    private property <Point> menu-caret;
    private property <[OptionRow]> menu-options;
    private property <TextMenuGeometry> menu-geometry;
    private property <OptionRecipe> menu-recipe: KitThemes.option-recipe(root.theme, root.control-size);
    private property <length> menu-width: Math.max(undo-measure.preferred-width, redo-measure.preferred-width, cut-measure.preferred-width, copy-measure.preferred-width, paste-measure.preferred-width, select-all-measure.preferred-width) + 2 * root.menu-recipe.padding-inline + 2 * KitMetrics.popover-inset(root.theme) + KitThemes.scroll-bar-recipe(root.theme).thickness;
    private property <length> menu-height: root.menu-options.length * KitMetrics.row-height(root.theme, root.control-size) + 2 * KitMetrics.popover-inset(root.theme);
    changed access => { if (root.menu-opened) { root.close-text-menu(); } }
    changed context-menu => { if (root.context-menu == TextContextMenu.disabled && root.menu-opened) { root.close-text-menu(); } }
    changed hidden-password => { if (root.menu-opened) { root.close-text-menu(); } }
    function paste-allowed() -> bool {
        if (!root.mask-ready) { return false; }
        clipboard-probe.text = ""; clipboard-probe.paste();
        if (root.validation-mask != "" && KitFormValidation.ready && !KitFormValidation.mask-paste(root.validation-mask, root.text, root.selection-anchor, root.cursor-position, clipboard-probe.text)) { return false; }
        if (root.purpose == TextPurpose.telephone && KitFormValidation.ready && !KitFormValidation.phone-paste(clipboard-probe.text)) { return false; }
        if (root.input-type == InputType.decimal) {
            if (root.non-finite-number(clipboard-probe.text)) { return false; }
            if (KitFormValidation.ready && !KitFormValidation.numeric-insertion(clipboard-probe.text)) { return false; }
            if (!KitFormValidation.ready && clipboard-probe.text != "" && clipboard-probe.text != "-" && clipboard-probe.text != "." && clipboard-probe.text != "," && !clipboard-probe.text.is-float()) { return false; }
        }
        return true;
    }
    function open-text-menu(anchor: Point) {
        if (root.context-menu != TextContextMenu.standard || root.access == FieldAccess.disabled || !KitFieldService.ready || editor.preedit-text != "") { return; }
        root.menu-options = KitFieldService.text-menu-options(
            {undo: root.undo-label, redo: root.redo-label, cut: root.cut-label, copy: root.copy-label, paste: root.paste-label, select-all: root.select-all-label},
            {editable: root.access == FieldAccess.editable, selection: root.cursor-position != root.selection-anchor, hidden-password: root.hidden-password, has-text: root.text != ""});
        root.menu-geometry = KitFieldService.text-menu-placement({origin-x: context-area.absolute-position.x, origin-y: context-area.absolute-position.y, anchor-x: anchor.x, anchor-y: anchor.y, width: root.menu-width, height: root.menu-height});
        if (root.menu-geometry.valid) { text-menu.show(); }
    }
    function close-text-menu() { text-menu.close(); root.take-focus(); }
    function run-text-command(row: OptionRow) {
        if (root.access == FieldAccess.disabled || root.context-menu != TextContextMenu.standard) { text-menu.close(); return; }
        let result = KitFieldService.text-menu-command(row);
        if (!result.valid) { return; }
        root.close-text-menu();
        if (result.command == TextEditCommand.undo) { root.undo(); }
        else if (result.command == TextEditCommand.redo) { root.redo(); }
        else if (result.command == TextEditCommand.cut) { root.cut-selection(); }
        else if (result.command == TextEditCommand.copy) { root.copy-selection(); }
        else if (result.command == TextEditCommand.paste) { root.paste(); }
        else if (result.command == TextEditCommand.select-all) { root.select-all(); }
    }
    public function cancel-edit() { root.reduce-field(FieldAction.cancel); root.cancelled(); }
    pure function non-finite-number(text: string) -> bool {
        let normalized = text.to-lowercase().replace-all("+", "").replace-all("-", "");
        return normalized == "nan" || normalized == "inf" || normalized == "infinity";
    }
    private property <FormEditorFocus> form-editor-focus: root.access == FieldAccess.disabled ? FormEditorFocus.disabled
        : !root.implicit-form-submit ? FormEditorFocus.auxiliary
        : root.multiline ? FormEditorFocus.multiline
        : root.access == FieldAccess.read-only ? FormEditorFocus.read-only-single-line : FormEditorFocus.single-line;
    changed form-editor-focus => { if (root.has-focus) { KitFormValidation.focused-editor = root.form-editor-focus; } }
    private property <int> focus-generation;
    changed has-focus => {
        if (root.has-focus) {
            KitFormValidation.focus-generation += 1;
            root.focus-generation = KitFormValidation.focus-generation;
            KitFormValidation.phone-focused = root.purpose == TextPurpose.telephone;
            KitFormValidation.focused-editor = root.form-editor-focus;
        } else {
            if (root.focus-generation == KitFormValidation.focus-generation) { KitFormValidation.phone-focused = false; KitFormValidation.focused-editor = FormEditorFocus.other; }
            checks.note-blur();
            root.reduce-field(FieldAction.blur);
            if (root.purpose == TextPurpose.telephone) { viewport.content-x = 0px; }
        }
        root.focus-observed(root.has-focus);
    }
    changed purpose => { if (root.has-focus) { KitFormValidation.phone-focused = root.purpose == TextPurpose.telephone; } }
    private property <FieldRecipe> recipe: KitThemes.field-recipe(root.theme, root.control-size, root.access, root.effective-validation);
    private property <IconRecipe> icon: KitThemes.icon-recipe(root.theme, root.control-size);
