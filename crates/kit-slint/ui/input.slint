    text-inset: Math.max(0px,(root.cell-width - root.text-cell-width) / 2);
    text-letter-spacing: max(0px, root.cell-width - root.text-cell-width);
    text-alignment: TextHorizontalAlignment.left;
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
