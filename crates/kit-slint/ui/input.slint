export component KitTextArea inherits KitTextField {
    line-mode: TextLineMode.multiline;
    resize-policy: ResizePolicy.auto-grow;
}

// One real editor handles the whole code, including paste, selection and undo.
// The shared HTML engine validates syntax/length; the Rust parser guards acceptance.
// Strict overflow rejection uses public undo/text/selection APIs. Rejected
// edits can discard native history; ordinary edits retain the same editor.
export component KitOtpField inherits KitTextField {
    in property <int> slots: 6;
    min-length: max(1, root.slots);
    max-length: max(1, root.slots);
    length-policy: TextLengthPolicy.limit;
    pattern: "[0-9]*";
