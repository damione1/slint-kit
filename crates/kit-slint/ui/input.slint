// A compiled core mask validates the complete draft without rewriting the native
// editor during composition. Separators remain ordinary selectable characters.
export component KitMaskedField inherits KitTextField {
    in property <string> mask;
    private property <KitMaskRules> mask-rules: KitFormValidation.ready ? KitFormValidation.compile-mask(root.mask, KitStrings.mask-format-message) : { length: -1 };
    out property <string> format-error: root.mask-rules.error;
    validation-mask: root.mask;
    min-length: root.mask-rules.length;
    max-length: root.mask-rules.length;
    // Do not rewrite host values or native deletion/undo transactions. The
    // derived HTML bounds validate paths that cannot be filtered beforehand.
    length-policy: TextLengthPolicy.validate;
    intrinsic-error: root.format-error;
    pattern: root.mask-rules.pattern;
    placeholder: root.mask-rules.placeholder;
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
}
