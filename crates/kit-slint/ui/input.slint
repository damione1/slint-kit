import { KitTheme, KitThemes, KitMetrics, TypographyRole, ControlSize, ButtonIntent, ControlWidth } from "theme.slint";
import { KitField, KitFieldLabel, KitFieldDescription, KitFieldError, KitInputGroup } from "field.slint";
import { KitPressable } from "button.slint";
import { KitIcon, IconKind } from "icons.slint";
import { FieldAccess, ValidationPresentation, TextPurpose, SecretVisibility } from "shared-contracts.slint";
export { TextPurpose, SecretVisibility } from "shared-contracts.slint";
import { NumberInputFormat, PhoneNumberMode } from "shared-contracts.slint";
export { PhoneNumberMode } from "shared-contracts.slint";
import { KitFormValidation, FormConstraintState, KitValidityState, HtmlInputKind, ValidationTiming } from "validation.slint";

export enum ResizePolicy { fixed, auto-grow }
export enum TextLineMode { single-line, multiline }

// All variants retain this one native TextInput throughout theme, validation,
// placeholder and reveal changes. Parsing and grapheme counting belong to Rust.
export component KitTextField inherits KitField {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <FieldAccess> access: FieldAccess.editable;
    in property <ValidationPresentation> validation: ValidationPresentation.pristine;
    in property <TextPurpose> purpose: TextPurpose.plain;
    // Native filtering applies to typing and paste without rewriting the draft.
    in property <InputType> input-type: InputType.text;
    // Semantic constraints are shared by built-in and custom field skins.
    in property <HtmlInputKind> input-kind: root.multiline ? HtmlInputKind.text-area
        : root.input-type == InputType.decimal ? HtmlInputKind.number
        : root.purpose == TextPurpose.email ? HtmlInputKind.email
        : root.purpose == TextPurpose.url ? HtmlInputKind.url
        : root.purpose == TextPurpose.telephone ? HtmlInputKind.telephone
        : root.purpose == TextPurpose.password ? HtmlInputKind.password
        : root.purpose == TextPurpose.search ? HtmlInputKind.search : HtmlInputKind.text;
    in property <bool> validation-twelve-hour;
    in property <NumberInputFormat> number-format: NumberInputFormat.canonical;
    // Custom skins may normalize validation independently of the native draft.
    in property <string> validation-text: root.text;
    in property <string> display-text: root.text;
    in property <string> intrinsic-error;
    private property <bool> formatted-at-rest: !root.has-focus && root.text != "" && root.display-text != root.text;
    in property <bool> required;
    in property <bool> multiple;
    in property <int> min-length: -1;
    in property <int> max-length: -1;
    in property <string> pattern;
    in property <bool> pattern-enabled: root.pattern != "";
    in property <string> min;
    in property <string> max;
    in property <string> step;
    in property <string> default-value;
    in property <ValidationTiming> validation-timing: ValidationTiming.on-blur;
    in-out property <string> custom-validity;
    in property <string> required-message: "Please fill out this field.";
    in property <string> email-message: "Please enter a valid email address.";
    in property <string> url-message: "Please enter a valid absolute URL.";
    in property <string> pattern-message: "Please match the requested format.";
    in property <string> too-short-message: "Please enter at least " + root.min-length + " characters.";
    in property <string> too-long-message: "Please enter no more than " + root.max-length + " characters.";
    in property <string> underflow-message: "The minimum value is " + root.min + ".";
    in property <string> overflow-message: "The maximum value is " + root.max + ".";
    in property <string> step-message: "Please enter a value matching the requested step.";
    in property <string> bad-input-message: "Please enter a valid value.";
    out property <KitValidityState> validity: checks.validity;
    out property <bool> will-validate: checks.will-validate;
    out property <bool> validation-ready: checks.validation-ready;
    out property <string> validation-message: checks.validation-message;
    out property <string> pattern-error: checks.pattern-error;
    out property <string> value: checks.value;
    out property <bool> dirty: checks.dirty;
    out property <bool> touched: checks.touched;
    callback invalid();
    public function check-validity() -> bool { return checks.check-validity(); }
    public function report-validity() -> bool { let valid = checks.report-validity(); if (!valid) { root.take-focus(); } return valid; }
    public function set-custom-validity(message: string) { root.custom-validity = message; }
    public function reset-validation() { checks.reset-validation(); }
    public function reset-field() { root.text = root.default-value; checks.reset-validation(); root.edited(root.text); }
    private property <ValidationPresentation> effective-validation: root.validation == ValidationPresentation.invalid || checks.show-error ? ValidationPresentation.invalid : root.validation;
    private property <string> effective-error: root.intrinsic-error != "" ? checks.validation-message : root.validation == ValidationPresentation.invalid && root.error != "" ? root.error : checks.validation-message;
    in-out property <SecretVisibility> secret-visibility: SecretVisibility.hidden;
    in property <TextLineMode> line-mode: TextLineMode.single-line;
    in property <ResizePolicy> resize-policy: ResizePolicy.fixed;
    in property <int> min-lines: 3;
    in property <int> max-lines: 8;
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <InputMethodHints> input-method-hints: { capitalization: root.purpose == TextPurpose.plain ? CapitalizationMode.sentences : CapitalizationMode.none, auto-correct: root.purpose == TextPurpose.plain, auto-complete: root.purpose == TextPurpose.plain };
    in property <bool> show-validation-message: true;
    out property <bool> validation-visible: root.effective-validation == ValidationPresentation.invalid;
    in property <string> description;
    in property <string> error;
    in property <string> placeholder;
    in property <length> text-letter-spacing: 0px;
    in property <TextHorizontalAlignment> text-alignment: TextHorizontalAlignment.left;
    in property <string> prefix;
    in property <string> suffix;
    in-out property <string> text;
    in property <bool> show-character-count;
    // Count is supplied by the controller using Unicode grapheme clusters.
    in property <int> character-count;
    in property <string> reveal-label: "Show password";
    in property <string> hide-label: "Hide password";
    in property <string> clear-label: "Clear search";
    in property <string> character-count-label: "characters";
    in property <string> checking-label: "Checking…";
    out property <bool> has-focus: editor.has-focus;
    callback edited(string);
    // Semantic value, separate from the native draft callback above.
    callback value-edited(string);
    callback commit-requested(string);
    callback cancelled();
    callback focus-observed(bool);
    public function take-focus() { if (root.access != FieldAccess.disabled) { editor.focus(); } }
    public function select-all() { editor.select-all(); }
    public function copy-selection() { editor.copy(); }
    public function cancel-edit() { root.cancelled(); }
    pure function non-finite-number(text: string) -> bool {
        let normalized = text.to-lowercase().replace-all("+", "").replace-all("-", "");
        return normalized == "nan" || normalized == "inf" || normalized == "infinity";
    }
    private property <int> focus-generation;
    changed has-focus => {
        if (root.has-focus) {
            KitFormValidation.focus-generation += 1;
            root.focus-generation = KitFormValidation.focus-generation;
            KitFormValidation.phone-focused = root.purpose == TextPurpose.telephone;
        } else {
            if (root.focus-generation == KitFormValidation.focus-generation) { KitFormValidation.phone-focused = false; }
            checks.note-blur();
            if (root.purpose == TextPurpose.telephone) { viewport.content-x = 0px; }
        }
        root.focus-observed(root.has-focus);
    }
    changed purpose => { if (root.has-focus) { KitFormValidation.phone-focused = root.purpose == TextPurpose.telephone; } }
    private property <length> line-height: 20px * root.theme.text-scale;
    private property <bool> multiline: root.line-mode == TextLineMode.multiline;
    private property <bool> action-visible: !root.multiline && (root.purpose == TextPurpose.password || (root.purpose == TextPurpose.search && root.text != ""));
    private property <length> editor-height: root.multiline ? Math.max(root.line-height * Math.max(1, root.min-lines), root.resize-policy == ResizePolicy.auto-grow ? Math.min(measure.preferred-height, root.line-height * Math.max(root.min-lines, root.max-lines)) : 0px) : KitMetrics.control-height(root.control-size, root.theme.text-scale) - 12px;
    if root.label != "": KitFieldLabel {
        theme: root.theme; text: root.label; access: root.access;
        focus-requested => { root.take-focus(); }
    }
    surface := KitInputGroup {
        theme: root.theme; control-size: root.control-size; access: root.access; validation: root.effective-validation;
        focused: root.has-focus;
        preferred-height: root.editor-height + 12px;
        max-height: self.preferred-height;
        checks := FormConstraintState {
            kind: root.input-kind; twelve-hour: root.validation-twelve-hour; number-format: root.number-format; access: root.access; required: root.required; multiple: root.multiple;
            min-length: root.min-length; max-length: root.max-length;
            pattern: root.pattern; pattern-enabled: root.pattern-enabled;
            min: root.min; max: root.max; step: root.step; default-value: root.default-value;
            text: root.validation-text; validation-timing: root.validation-timing;
            custom-validity: root.custom-validity != "" ? root.custom-validity : root.intrinsic-error != "" ? root.intrinsic-error : root.validation == ValidationPresentation.invalid ? root.error : "";
            required-message: root.required-message; email-message: root.email-message;
            url-message: root.url-message; pattern-message: root.pattern-message;
            too-short-message: root.too-short-message; too-long-message: root.too-long-message;
            underflow-message: root.underflow-message; overflow-message: root.overflow-message;
            step-message: root.step-message; bad-input-message: root.bad-input-message;
            invalid => { root.invalid(); }
        }
        // Slint 1.18.1 filters numeric key events but not native clipboard
        // shortcuts. Read the clipboard through its public paste API before
        // letting the real editor handle it; never rewrite its text/history.
        clipboard-probe := TextInput {
            visible: false; enabled: false;
            x: 0px; y: 0px; width: 0px; height: 0px;
        }
        // Behind the editor and action: the visual padding is part of the
        // field's focus target without intercepting native caret/selection.
        TouchArea {
            x: -surface.padding-inline; y: -surface.padding-block;
            width: surface.width; height: surface.height;
            enabled: root.access != FieldAccess.disabled;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.take-focus(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            if root.prefix != "": Text {
                text: root.prefix; color: root.theme.text-secondary;
                font-size: KitMetrics.font-size(TypographyRole.control, root.theme.text-scale);
                vertical-alignment: center; horizontal-stretch: 0;
            }
            Rectangle {
                horizontal-stretch: 1; clip: true;
                viewport := Flickable {
                    interactive: root.multiline;
                    content-width: root.multiline ? self.width : Math.max(self.width, Math.max(editor.preferred-width, formatted-measure.preferred-width) + 2px);
                    content-height: Math.max(self.height, root.multiline ? measure.preferred-height : self.height);
                    measure := Text {
                        visible: false;
                        width: viewport.width;
                        text: root.text == "" ? " " : root.text;
                        font-size: 14px * root.theme.text-scale;
                        wrap: word-wrap;
                    }
                    if root.text == "": Text {
                        width: viewport.width; height: root.multiline ? self.preferred-height : viewport.height;
                        text: root.placeholder;
                        color: root.theme.disabled-text;
                        font-size: 14px * root.theme.text-scale;
                        vertical-alignment: root.multiline ? top : center;
                        wrap: root.multiline ? word-wrap : no-wrap;
                        overflow: elide;
                    }
                    formatted-measure := Text { visible: false; text: root.formatted-at-rest ? root.display-text : ""; font-size: 14px * root.theme.text-scale; }
                    if root.formatted-at-rest: Text {
                        text: root.display-text; width: Math.max(viewport.width, formatted-measure.preferred-width + 2px); height: viewport.height;
                        font-size: 14px * root.theme.text-scale; vertical-alignment: center;
                        horizontal-alignment: root.text-alignment;
                        color: root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-primary;
                    }
                    editor := TextInput {
                        width: root.multiline ? viewport.width : Math.max(viewport.width, self.preferred-width + 2px);
                        height: viewport.content-height;
                        text <=> root.text;
                        enabled: root.access != FieldAccess.disabled;
                        read-only: root.access == FieldAccess.read-only;
                        single-line: !root.multiline;
                        wrap: root.multiline ? word-wrap : no-wrap;
                        input-type: root.purpose == TextPurpose.password && root.secret-visibility == SecretVisibility.hidden ? InputType.password : root.purpose == TextPurpose.search ? InputType.search : root.input-type == InputType.decimal && KitFormValidation.ready ? InputType.text : root.input-type;
                        input-method-hints: root.input-method-hints;
                        color: root.formatted-at-rest ? transparent : root.access == FieldAccess.disabled ? root.theme.disabled-text : root.theme.text-primary;
                        selection-background-color: root.formatted-at-rest ? transparent : root.theme.accent;
                        selection-foreground-color: root.formatted-at-rest ? transparent : root.theme.on-accent;
                        font-size: 14px * root.theme.text-scale;
                        letter-spacing: root.text-letter-spacing;
                        horizontal-alignment: root.text-alignment;
                        vertical-alignment: root.multiline ? top : center;
                        accessible-enabled: root.access != FieldAccess.disabled;
                        accessible-label: root.accessible-name;
                        accessible-value: root.formatted-at-rest ? root.display-text : root.text;
                        accessible-description: root.effective-validation == ValidationPresentation.invalid ? root.effective-error : root.description;
                        key-pressed(event) => {
                            if (root.purpose == TextPurpose.telephone && KitFormValidation.ready) {
                                if (((event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && (event.text == "v" || event.text == "V"))
                                    || (event.modifiers.shift && event.text == Key.Insert)) {
                                    clipboard-probe.text = ""; clipboard-probe.paste();
                                    if (!KitFormValidation.phone-paste(clipboard-probe.text)) { return accept; }
                                } else if (!(event.modifiers.control || event.modifiers.meta) && !KitFormValidation.phone-insertion(event.text)) { return accept; }
                            }
                            if (root.input-type == InputType.decimal && KitFormValidation.ready && !(event.modifiers.control || event.modifiers.meta)
                                && !KitFormValidation.numeric-insertion(event.text)) { return accept; }
                            if (root.input-type == InputType.decimal && root.non-finite-number(event.text)) { return accept; }
                            if (root.input-type == InputType.decimal && root.access == FieldAccess.editable
                                && (((event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && (event.text == "v" || event.text == "V"))
                                    || (event.modifiers.shift && event.text == Key.Insert))) {
                                clipboard-probe.text = "";
                                clipboard-probe.paste();
                                if (root.non-finite-number(clipboard-probe.text)) { return accept; }
                                if (KitFormValidation.ready && !KitFormValidation.numeric-insertion(clipboard-probe.text)) { return accept; }
                                if (!KitFormValidation.ready && clipboard-probe.text != "" && clipboard-probe.text != "-"
                                    && clipboard-probe.text != "." && clipboard-probe.text != ","
                                    && !clipboard-probe.text.is-float()) { return accept; }
                            }
                            return reject;
                        }
                        edited => { checks.note-edit(); root.edited(self.text); root.value-edited(root.value); }
                        accepted => { if (!root.multiline && root.access == FieldAccess.editable && root.report-validity()) { root.commit-requested(root.purpose == TextPurpose.telephone ? root.value : self.text); } }
                        // Do not intercept Enter/Escape before the native IME engine.
                        cursor-position-changed(position) => {
                            if (root.multiline) {
                                if (position.y + viewport.content-y < 0px) { viewport.content-y = -position.y; }
                                else if (position.y + root.line-height + viewport.content-y > viewport.height) { viewport.content-y = viewport.height - position.y - root.line-height; }
                            } else {
                                if (position.x + viewport.content-x < 0px) { viewport.content-x = -position.x; }
                                else if (position.x + 2px + viewport.content-x > viewport.width) { viewport.content-x = viewport.width - position.x - 2px; }
                            }
                        }
                    }
                }
            }
            if root.suffix != "": Text {
                text: root.suffix; color: root.theme.text-secondary;
                font-size: KitMetrics.font-size(TypographyRole.control, root.theme.text-scale);
                vertical-alignment: center; horizontal-stretch: 0;
            }
            if root.action-visible: Rectangle {
                // Reserve the action's width in the editor row, but let its
                // comfortable hit area also use the surface's block padding.
                width: root.control-size == ControlSize.comfortable ? KitMetrics.control-height(root.control-size, root.theme.text-scale) : 28px;
                height: root.editor-height;
                action := KitPressable {
                    x: 0px; y: (parent.height - self.height) / 2;
                    theme: root.theme; intent: ButtonIntent.quiet; control-size: ControlSize.compact;
                    recipe: KitThemes.icon-button-recipe(root.theme, ControlSize.compact);
                    width: parent.width;
                    height: root.control-size == ControlSize.comfortable ? KitMetrics.control-height(root.control-size, root.theme.text-scale) : Math.min(28px, root.editor-height);
                    disabled: root.access == FieldAccess.disabled || (root.purpose == TextPurpose.search && root.access == FieldAccess.read-only);
                    accessible-name: root.purpose == TextPurpose.search ? root.clear-label : root.secret-visibility == SecretVisibility.hidden ? root.reveal-label : root.hide-label;
                    activated => {
                        if (root.purpose == TextPurpose.search) { root.text = ""; checks.note-edit(); root.edited(""); }
                        else { root.secret-visibility = root.secret-visibility == SecretVisibility.hidden ? SecretVisibility.revealed : SecretVisibility.hidden; }
                        root.take-focus();
                    }
                    KitIcon {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        kind: root.purpose == TextPurpose.search ? IconKind.close : root.secret-visibility == SecretVisibility.hidden ? IconKind.eye : IconKind.eye-hidden;
                        ink: action.disabled ? root.theme.disabled-text : root.theme.text-secondary;
                    }
                }
            }
        }
    }
    if root.show-validation-message && root.effective-validation == ValidationPresentation.invalid && root.effective-error != "": KitFieldError { theme: root.theme; text: root.effective-error; }
    if root.validation == ValidationPresentation.checking: KitFieldDescription { theme: root.theme; text: root.checking-label; }
    if root.description != "": KitFieldDescription { theme: root.theme; text: root.description; }
    if root.show-character-count: KitFieldDescription { theme: root.theme; text: root.character-count + " " + root.character-count-label; }
}
export component KitPasswordField inherits KitTextField { purpose: TextPurpose.password; }
export component KitSearchField inherits KitTextField { purpose: TextPurpose.search; }
export component KitEmailField inherits KitTextField { purpose: TextPurpose.email; }
export component KitUrlField inherits KitTextField { purpose: TextPurpose.url; }
// A strict phone control; HTML's raw tel input-kind remains available on KitTextField.
export component KitTelephoneField inherits KitTextField {
    purpose: TextPurpose.telephone;
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
    in property <PhoneNumberMode> number-mode: PhoneNumberMode.either;
    in property <int> min-digits: 1;
    in property <int> max-digits: 15;
    in property <int> expected-digits;
    in property <string> display-mask;
    in property <string> phone-message: root.number-mode == PhoneNumberMode.national ? "Use digits without an international prefix." : root.number-mode == PhoneNumberMode.international ? "Start with + followed by digits." : "Use digits and an optional leading + for an international number.";
    in property <string> phone-length-message: root.expected-digits > 0 ? "Enter exactly " + root.expected-digits + " digits." : "Enter " + root.min-digits + " to " + root.max-digits + " digits.";
    out property <string> format-error: KitFormValidation.ready ? KitFormValidation.phone-mask-error(root.display-mask) : "";
    validation-text: KitFormValidation.ready ? KitFormValidation.phone-value(root.text) : root.text;
    display-text: KitFormValidation.ready ? KitFormValidation.phone-display(root.text, root.display-mask) : root.text;
    intrinsic-error: KitFormValidation.ready ? KitFormValidation.phone-error(root.text,
        root.number-mode != PhoneNumberMode.national, root.number-mode == PhoneNumberMode.international,
        root.expected-digits != 0 ? root.expected-digits : root.min-digits,
        root.expected-digits != 0 ? root.expected-digits : root.max-digits,
        root.phone-message, root.phone-length-message) : "";
}
export component KitTextArea inherits KitTextField {
    line-mode: TextLineMode.multiline;
    resize-policy: ResizePolicy.auto-grow;
}

// One real editor handles the whole code, including paste, selection and undo.
// The OtpLength/OtpAlphabet core parser owns bounds; spacing is presentation only.
export component KitOtpField inherits KitTextField {
    text-letter-spacing: 10px;
    text-alignment: TextHorizontalAlignment.center;
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
}
// A compiled core mask validates the complete draft without rewriting the native
// editor during composition. Separators remain ordinary selectable characters.
export component KitMaskedField inherits KitTextField {
    input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
}
