import { KitTheme, KitThemes, KitMetrics, TypographyRole, ControlSize, ButtonIntent } from "@kit/theme.slint";
import { KitCard } from "@kit/display.slint";
import { KitButton } from "@kit/button.slint";
import { FieldAccess, ValidationPresentation, StepDirection, CheckState, RangeThumb, FileSelectionMode, CalendarNavigation, TimePrecision, ColorAlphaMode } from "@kit/shared-contracts.slint";
import { NavigationStep, SelectState, OptionRow, FocusRequest } from "@kit/contracts.slint";
import { KitFieldSet, KitFieldLabel, KitFieldDescription, KitFieldError, KitFormErrorSummary, FormErrorRow } from "@kit/field.slint";
import { KitTextField, KitEmailField, KitUrlField, KitTelephoneField, KitPasswordField, KitSearchField, KitTextArea, KitOtpField, KitMaskedField, PhoneNumberMode } from "@kit/input.slint";
import { NumberInputFormat } from "@kit/shared-contracts.slint";
import { KitIntegerField, KitDecimalField, KitMoneyField, KitPercentField, KitQuantityField, KitDurationField, KitNumberStepper } from "@kit/number.slint";
import { KitCheckbox, KitSwitch, KitRadioGroup, KitSegmentedControl, KitToggleGroup, KitMultiSelect, KitTagInput, KitCombobox, KitSlider, KitRangeSlider, KitRating, ChoiceRow, ChipRow, SearchPresentation } from "@kit/choice.slint";
import { KitCalendar, KitDateField, KitDatePicker, KitDateRangePicker, KitMonthField, KitYearField, KitIsoWeekField, CalendarDay, CivilDateView, DateRangePhase } from "@kit/calendar.slint";
import { KitTimeField, KitTimePicker, KitDateTimeField, KitZonedDateTimeField, LocalTimeView, LocalDateTimeView, LocalDateTimeDraft, ZonedDateTimeDraft, ZonedTimePresentation, AmbiguousTimeChoice, TimeSegment, TimeAdjustment, ClockFormat } from "@kit/datetime.slint";
import { KitFilePicker, KitDirectoryPicker, KitFileDropZone, FileViewEntry, HostRequestPresentation, DropCapability } from "@kit/files.slint";
import { KitColorPicker, ColorChannel, SrgbColorView } from "@kit/color.slint";

export enum ShowcasePage { gallery, profile, billing, choices, schedule, files, display, navigation, data }
export enum TextExample { name, email, website, phone, password, search, biography, otp, reference }
export enum NumericExample { integer, decimal, money, percent, quantity, duration, stepper }
export enum LocaleExample { french-canada, french-france, english-canada, english-us }
export enum DateExample { date, month, year, week, time }
export enum ChoiceExample { radio, segmented, toggle, rating }
export enum SliderGesture { started, committed, cancelled }
export enum SubmissionPresentation { idle, pending, succeeded, invalid }

export global FormExamples {
    callback reveal-field(length,length);
    in-out property <[FormErrorRow]> profile-errors;
    in-out property <[FormErrorRow]> billing-errors;
    callback profile-error-activated(FocusRequest);
    callback billing-error-activated(FocusRequest);
    in-out property <int> consent-focus-sequence;
    in-out property <TextExample> text-focus-target;
    in-out property <int> text-focus-sequence;
    in-out property <NumericExample> numeric-focus-target;
    in-out property <int> numeric-focus-sequence;
    in-out property <FieldAccess> access: FieldAccess.editable;
    in-out property <LocaleExample> locale: LocaleExample.french-canada;
    in-out property <string> profile-status: "Your changes stay here until you save.";
    in-out property <SubmissionPresentation> profile-submission: SubmissionPresentation.idle;
    in-out property <string> billing-status: "Exact decimal values; no binary floating-point amounts.";
    in-out property <SubmissionPresentation> billing-submission: SubmissionPresentation.idle;
    callback text-edited(TextExample,string);
    callback text-commit(TextExample,string);
    callback text-blur(TextExample);
    callback text-cancel(TextExample);
    callback numeric-edited(NumericExample,string);
    callback numeric-commit(NumericExample,string);
    callback numeric-blur(NumericExample);
    callback numeric-cancel(NumericExample);
    callback step-requested(StepDirection);
    callback locale-changed(LocaleExample);
    callback profile-submit(); callback profile-reset();
    callback billing-submit(); callback billing-reset();
    in-out property <string> name-text;
    in-out property <ValidationPresentation> name-validation: ValidationPresentation.pristine;
    in-out property <string> name-error;
    in-out property <int> name-count;
    in-out property <string> email-text;
    in-out property <ValidationPresentation> email-validation: ValidationPresentation.pristine;
    in-out property <string> email-error;
    in-out property <int> email-count;
    in-out property <string> website-text;
    in-out property <ValidationPresentation> website-validation: ValidationPresentation.pristine;
    in-out property <string> website-error;
    in-out property <int> website-count;
    in-out property <string> phone-text;
    in-out property <ValidationPresentation> phone-validation: ValidationPresentation.pristine;
    in-out property <string> phone-error;
    in-out property <int> phone-count;
    in-out property <string> password-text;
    in-out property <ValidationPresentation> password-validation: ValidationPresentation.pristine;
    in-out property <string> password-error;
    in-out property <int> password-count;
    in-out property <string> search-text;
    in-out property <ValidationPresentation> search-validation: ValidationPresentation.pristine;
    in-out property <string> search-error;
    in-out property <int> search-count;
    in-out property <string> biography-text;
    in-out property <ValidationPresentation> biography-validation: ValidationPresentation.pristine;
    in-out property <string> biography-error;
    in-out property <int> biography-count;
    in-out property <string> otp-text;
    in-out property <ValidationPresentation> otp-validation: ValidationPresentation.pristine;
    in-out property <string> otp-error;
    in-out property <int> otp-count;
    in-out property <string> reference-text;
    in-out property <ValidationPresentation> reference-validation: ValidationPresentation.pristine;
    in-out property <string> reference-error;
    in-out property <int> reference-count;
    in-out property <string> integer-text;
    in-out property <ValidationPresentation> integer-validation: ValidationPresentation.pristine;
    in-out property <string> integer-error;
    in-out property <int> integer-count;
    in-out property <string> decimal-text;
    in-out property <ValidationPresentation> decimal-validation: ValidationPresentation.pristine;
    in-out property <string> decimal-error;
    in-out property <int> decimal-count;
    in-out property <string> money-text;
    in-out property <ValidationPresentation> money-validation: ValidationPresentation.pristine;
    in-out property <string> money-error;
    in-out property <int> money-count;
    in-out property <string> percent-text;
    in-out property <ValidationPresentation> percent-validation: ValidationPresentation.pristine;
    in-out property <string> percent-error;
    in-out property <int> percent-count;
    in-out property <string> quantity-text;
    in-out property <ValidationPresentation> quantity-validation: ValidationPresentation.pristine;
    in-out property <string> quantity-error;
    in-out property <int> quantity-count;
    in-out property <string> duration-text;
    in-out property <ValidationPresentation> duration-validation: ValidationPresentation.pristine;
    in-out property <string> duration-error;
    in-out property <int> duration-count;
    in-out property <string> stepper-text;
    in-out property <ValidationPresentation> stepper-validation: ValidationPresentation.pristine;
    in-out property <string> stepper-error;
    in-out property <int> stepper-count;

    in-out property <string> money-suffix: "CAD";
    in-out property <CheckState> consent: CheckState.unchecked;
    in-out property <bool> notifications: true;
    callback consent-toggled(CheckState); callback notifications-toggled(bool);
    in-out property <CheckState> choices-consent: CheckState.mixed;
    in-out property <bool> choices-notifications: true;
    callback choices-consent-toggled(CheckState); callback choices-notifications-toggled(bool);
    in-out property <string> slider-error;
    in-out property <string> range-error;
    in-out property <string> range-lower-error;
    in-out property <string> range-upper-error;
    in-out property <[ChoiceRow]> radio-options;
    in-out property <[ChoiceRow]> toggle-options;
    in-out property <[ChoiceRow]> rating-options;
    in-out property <int> choice-generation: 1;
    in-out property <int> radio-active: 1;
    in-out property <int> segmented-active: 1;
    in-out property <int> toggle-active: 1;
    in-out property <int> rating-active: 1;
    in-out property <[ChoiceRow]> segmented-options;
    callback choice-navigate(ChoiceExample,NavigationStep);
    callback choice-activate(ChoiceExample,int,int);
    callback rating-clear();
    in-out property <[OptionRow]> suggestion-rows;
    in-out property <SelectState> suggestion-state;
    in-out property <string> suggestion-label;
    in-out property <SearchPresentation> suggestion-search: SearchPresentation.ready;
    callback suggestion-open(); callback suggestion-navigate(NavigationStep); callback suggestion-activate(int,int); callback suggestion-dismiss(); callback suggestion-query(string); callback suggestion-typeahead(string);
    in-out property <[OptionRow]> multi-rows;
    in-out property <SelectState> multi-state;
    in-out property <[ChipRow]> multi-chips;
    callback multi-open(); callback multi-navigate(NavigationStep); callback multi-activate(int,int); callback multi-dismiss(); callback multi-query(string); callback multi-typeahead(string); callback multi-remove(int);
    in-out property <[ChipRow]> tags;
    in-out property <string> tag-text;
    in-out property <string> tag-error;
    callback tag-create(string); callback tag-remove(int);
    in-out property <float> slider-position: 0.35;
    in-out property <string> slider-text: "35";
    in-out property <string> range-lower-text: "20";
    in-out property <string> range-upper-text: "80";
    callback slider-text-commit(string);
    callback range-text-commit(RangeThumb,string);
    in-out property <string> slider-label: "35 %";
    in-out property <float> range-lower: 0.2;
    in-out property <float> range-upper: 0.8;
    in-out property <string> range-lower-label: "20";
    in-out property <string> range-upper-label: "80";
    callback slider-position-requested(float); callback slider-navigate(NavigationStep); callback slider-gesture(SliderGesture);
    callback range-position-requested(RangeThumb,float); callback range-navigate(RangeThumb,NavigationStep); callback range-gesture(SliderGesture);
    in-out property <string> choices-status;
    in-out property <string> rating-label: "Not rated";
    in-out property <string> multi-error;
    in-out property <[CalendarDay]> calendar-days;
    in-out property <int> calendar-active;
    in-out property <string> calendar-title;
    in-out property <CivilDateView> accepted-date;
    in-out property <string> date-text;
    in-out property <string> date-error;
    in-out property <string> month-text;
    in-out property <string> month-error;
    in-out property <string> year-text;
    in-out property <string> year-error;
    in-out property <string> week-text;
    in-out property <string> week-error;
    in-out property <string> time-text;
    in-out property <string> time-error;
    in-out property <LocalTimeView> accepted-time;
    callback date-edited(DateExample,string); callback date-commit(DateExample,string);
    callback calendar-navigate(CalendarNavigation); callback calendar-choose(CalendarDay);
    callback time-adjust(TimeSegment,TimeAdjustment);
    in-out property <ClockFormat> time-format: ClockFormat.twenty-four-hour;
    callback time-format-changed(ClockFormat);
    in-out property <[CalendarDay]> range-days;
    in-out property <int> range-active;
    in-out property <string> range-title;
    callback date-range-navigate(CalendarNavigation);
    in-out property <DateRangePhase> range-phase: DateRangePhase.choosing-start;
    in-out property <string> date-range-summary;
    in-out property <string> date-range-error;
    callback date-range-choose(CalendarDay); callback date-range-apply(); callback date-range-cancel();
    in-out property <string> local-date-text: "2026-10-16";
    in-out property <string> local-time-text: "09:30";
    in-out property <string> local-error;
    callback local-commit(LocalDateTimeDraft);
    in-out property <string> zone-date-text: "2026-11-01";
    in-out property <string> zone-time-text: "01:30";
    in-out property <string> zone-text: "America/Toronto";
    in-out property <ZonedTimePresentation> zone-resolution: ZonedTimePresentation.unresolved;
    in-out property <string> zone-message;
    callback zone-edited(); callback zone-resolve(ZonedDateTimeDraft); callback ambiguity-chosen(AmbiguousTimeChoice);
    in-out property <[FileViewEntry]> selected-files;
    in-out property <HostRequestPresentation> file-state: HostRequestPresentation.idle;
    in-out property <HostRequestPresentation> folder-state: HostRequestPresentation.idle;
    in-out property <string> file-error;
    in-out property <string> folder-name;
    in-out property <string> folder-error;
    in-out property <DropCapability> drop-capability: DropCapability.unsupported;
    callback file-browse(FileSelectionMode); callback file-remove(int,int); callback folder-browse(); callback folder-clear();
    callback can-drop(DropEvent)->DragAction; callback dropped(DropEvent)->DragAction;
    callback color-picked(SrgbColorView);
    in-out property <bool> host-drag-hovered;
    in-out property <string> color-hex: "#4F46E5FF";
    in-out property <string> color-red: "79";
    in-out property <string> color-green: "70";
    in-out property <string> color-blue: "229";
    in-out property <string> color-alpha: "255";
    in-out property <string> color-error;
    in-out property <string> color-red-error;
    in-out property <string> color-green-error;
    in-out property <string> color-blue-error;
    in-out property <string> color-alpha-error;

    in-out property <SrgbColorView> accepted-color: {red:79,green:70,blue:229,alpha:255};
    in-out property <color> color-swatch: #4f46e5;
    callback color-hex-edited(string); callback color-hex-commit(string); callback color-channel-edited(ColorChannel,string); callback color-channel-commit(ColorChannel,string); callback color-position(ColorChannel,float); callback color-navigate(ColorChannel,NavigationStep); callback color-gesture(ColorChannel,SliderGesture);
}

component ExamplePanel inherits KitCard { }
component SectionTitle inherits Text {
    in property <KitTheme> theme;
    color: root.theme.text-primary;
    font-size: 20px * root.theme.text-scale; font-weight: 600; wrap: word-wrap;
}

export component FormGallery inherits VerticalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <ShowcasePage> page;
    spacing: 24px; alignment: start; vertical-stretch: 0; max-width: 760px;
    if root.page == ShowcasePage.profile: ExamplePanel {
        theme: root.theme;
        SectionTitle {theme: root.theme; text: "Profile form";}
        KitFieldDescription {font-size:14px * root.theme.text-scale;theme: root.theme; text: "Native editing, clear labels, and validation that keeps your work intact.";}
        FlexboxLayout {spacing: 8px; alignment: start;
            KitButton {control-size:root.control-size;theme:root.theme; text: FormExamples.access == FieldAccess.editable ? "Editable" : FormExamples.access == FieldAccess.read-only ? "Read only" : "Disabled"; activated => {FormExamples.access = FormExamples.access == FieldAccess.editable ? FieldAccess.read-only : FormExamples.access == FieldAccess.read-only ? FieldAccess.disabled : FieldAccess.editable;}}
        }
        KitTextField {
            theme: root.theme; control-size: root.control-size; access: FormExamples.access;
            label: "Display name"; placeholder: "Your public name";
            text <=> FormExamples.name-text; validation: FormExamples.name-validation; error: FormExamples.name-error; character-count: FormExamples.name-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.name) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.name,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.name,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.name);}}
            cancelled => {FormExamples.text-cancel(TextExample.name);}
        }
        KitEmailField {
            theme: root.theme; control-size: root.control-size; access: FormExamples.access;
            label: "Email"; placeholder: "name@example.com";
            text <=> FormExamples.email-text; validation: FormExamples.email-validation; error: FormExamples.email-error; character-count: FormExamples.email-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.email) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.email,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.email,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.email);}}
            cancelled => {FormExamples.text-cancel(TextExample.email);}
        }
        KitUrlField {
            theme: root.theme; control-size: root.control-size; access: FormExamples.access;
            label: "Website"; placeholder: "https://example.com";
            text <=> FormExamples.website-text; validation: FormExamples.website-validation; error: FormExamples.website-error; character-count: FormExamples.website-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.website) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.website,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.website,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.website);}}
            cancelled => {FormExamples.text-cancel(TextExample.website);}
        }
        KitTelephoneField {
            theme: root.theme; control-size: root.control-size; access: FormExamples.access;
            label: "Phone"; placeholder: "+15145550100";
            number-mode: PhoneNumberMode.international; min-digits: 7; max-digits: 15; display-mask: "+# ### ### ####";
            text <=> FormExamples.phone-text; validation: FormExamples.phone-validation; error: FormExamples.phone-error; character-count: FormExamples.phone-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.phone) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.phone,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.phone,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.phone);}}
            cancelled => {FormExamples.text-cancel(TextExample.phone);}
        }
        KitTextArea {
            theme: root.theme; control-size: root.control-size; access: FormExamples.access;
            label: "About you"; placeholder: "A few lines about your work";
            text <=> FormExamples.biography-text; validation: FormExamples.biography-validation; error: FormExamples.biography-error; character-count: FormExamples.biography-count; min-lines: 3; max-lines: 6; show-character-count: true;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.biography) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.biography,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.biography,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.biography);}}
            cancelled => {FormExamples.text-cancel(TextExample.biography);}
        }
        KitFormErrorSummary {theme:root.theme;errors:FormExamples.profile-errors;error-activated(target)=>{FormExamples.profile-error-activated(target);}}
        KitCheckbox {control-size:root.control-size;private property <int> focus-sequence:FormExamples.consent-focus-sequence;changed focus-sequence=>{self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}theme: root.theme; label: "I agree to the project terms"; state: FormExamples.consent; access: FormExamples.access; toggled(state)=>{FormExamples.consent = state; FormExamples.consent-toggled(state);}}
        KitSwitch {control-size:root.control-size;theme:root.theme; label:"Email notifications"; checked:FormExamples.notifications; access:FormExamples.access; toggled(value)=>{FormExamples.notifications = value; FormExamples.notifications-toggled(value);}}
        KitFieldDescription {font-size:14px * root.theme.text-scale;theme:root.theme;text:FormExamples.profile-status;}
        FlexboxLayout {spacing:12px;alignment:start;
            KitButton {control-size:root.control-size;theme:root.theme;text:"Save profile";intent:ButtonIntent.primary;busy:FormExamples.profile-submission == SubmissionPresentation.pending;disabled:FormExamples.access != FieldAccess.editable;activated=>{FormExamples.profile-submit();}}
            KitButton {control-size:root.control-size;theme:root.theme;text:"Reset";intent:ButtonIntent.quiet;activated=>{FormExamples.profile-reset();}}
        }
    }
    if root.page == ShowcasePage.profile: ExamplePanel { theme: root.theme;
        SectionTitle { theme: root.theme; text: "Password & verification"; }
        KitPasswordField {
            theme: root.theme; control-size: root.control-size;
            label: "Password"; placeholder: "A secret you can reveal";
            text <=> FormExamples.password-text; validation: FormExamples.password-validation; error: FormExamples.password-error; character-count: FormExamples.password-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.password) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.password,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.password,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.password);}}
            cancelled => {FormExamples.text-cancel(TextExample.password);}
        }
        KitOtpField {
            theme: root.theme; control-size: root.control-size;
            label: "Verification code"; placeholder: "123456";
            text <=> FormExamples.otp-text; validation: FormExamples.otp-validation; error: FormExamples.otp-error; character-count: FormExamples.otp-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.otp) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.otp,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.otp,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.otp);}}
            cancelled => {FormExamples.text-cancel(TextExample.otp);}
        }
        KitMaskedField {
            theme: root.theme; control-size: root.control-size;
            label: "Project reference"; placeholder: "AB-1234";
            text <=> FormExamples.reference-text; validation: FormExamples.reference-validation; error: FormExamples.reference-error; character-count: FormExamples.reference-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.reference) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.reference,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.reference,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.reference);}}
            cancelled => {FormExamples.text-cancel(TextExample.reference);}
        }
    }
    if root.page == ShowcasePage.profile: ExamplePanel { theme: root.theme;
        SectionTitle { theme: root.theme; text: "Search input"; }
        KitFieldDescription { font-size:14px * root.theme.text-scale; theme: root.theme; text: "Native search editing with a clear action. This sample does not query a dataset."; }
        KitSearchField {
            theme: root.theme; control-size: root.control-size;
            label: "Search"; placeholder: "Type to test search editing";
            text <=> FormExamples.search-text; validation: FormExamples.search-validation; error: FormExamples.search-error; character-count: FormExamples.search-count;
            private property <int> focus-sequence: FormExamples.text-focus-sequence;
            changed focus-sequence => {if (FormExamples.text-focus-target == TextExample.search) {self.take-focus(); FormExamples.reveal-field(self.absolute-position.y,self.height);}}
            changed height => { if (self.has-focus) { FormExamples.reveal-field(self.absolute-position.y,self.height); } }
            edited(text) => {FormExamples.text-edited(TextExample.search,text);}
            commit-requested(text) => {FormExamples.text-commit(TextExample.search,text);}
            focus-observed(focused) => {if (!focused) {FormExamples.text-blur(TextExample.search);}}
            cancelled => {FormExamples.text-cancel(TextExample.search);}
        }
