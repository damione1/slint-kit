        SectionTitle { theme: root.theme; text: "Color picker"; }
        KitFieldDescription { font-size:14px * root.theme.text-scale; theme: root.theme; text: "Edit an sRGB color with exact channels and optional alpha."; }
        KitColorPicker {color-requested(color)=>{FormExamples.color-picked(color);}control-size:root.control-size;theme:root.theme;alpha-mode:ColorAlphaMode.editable;accepted-color:FormExamples.accepted-color;swatch:FormExamples.color-swatch;hex-text <=> FormExamples.color-hex;red-text <=> FormExamples.color-red;green-text <=> FormExamples.color-green;blue-text <=> FormExamples.color-blue;alpha-text <=> FormExamples.color-alpha;hex-error:FormExamples.color-error;red-error:FormExamples.color-red-error;green-error:FormExamples.color-green-error;blue-error:FormExamples.color-blue-error;alpha-error:FormExamples.color-alpha-error;hex-edited(text)=>{FormExamples.color-hex-edited(text);}hex-commit-requested(text)=>{FormExamples.color-hex-commit(text);}channel-edited(channel,text)=>{FormExamples.color-channel-edited(channel,text);}channel-commit-requested(channel,text)=>{FormExamples.color-channel-commit(channel,text);}channel-position-requested(channel,value)=>{FormExamples.color-position(channel,value);}channel-navigate(channel,step)=>{FormExamples.color-navigate(channel,step);}gesture-started(channel)=>{FormExamples.color-gesture(channel,SliderGesture.started);}committed(channel)=>{FormExamples.color-gesture(channel,SliderGesture.committed);}cancelled(channel)=>{FormExamples.color-gesture(channel,SliderGesture.cancelled);}}
    }
}
