// SPDX-License-Identifier: GPL-3.0-or-later
import { ListView, ScrollView } from "std-widgets.slint";
import { KitTheme, KitThemes, ControlWidth } from "@kit/theme.slint";
import { OptionRow, SelectState, DialogState, NavigationStep, CloseReason, FocusRequest } from "@kit/contracts.slint";
import { KitButton, KitPressable, ButtonIntent, ButtonRecipe, ControlSize } from "@kit/button.slint";
import { KitSelect, KitSelectTrigger, KitSelectSurface, KitOption } from "@kit/select.slint";
import { KitIcon, IconKind } from "@kit/icons.slint";
import { DisplayGallery, DisplayExamples, ToastExample, ProgressDemoState, ToastEntry, AlertSeverity, ToastInteraction } from "base-display.slint";
export { DisplayExamples, ToastExample, ProgressDemoState, ToastEntry, AlertSeverity, ToastInteraction } from "base-display.slint";
import { NavigationGallery, NavigationExamples, NavigationDemo, DrawerFocus, ExpansionMode, DisclosureRow, NotificationRow } from "base-navigation.slint";
export { NavigationExamples, NavigationDemo, DrawerFocus, ExpansionMode, DisclosureRow, NotificationRow } from "base-navigation.slint";
import { DataGallery, DataExamples, DataCollection } from "base-data.slint";
export { DataExamples, DataCollection } from "base-data.slint";
export { TableColumn, TableRow, ContentItem, TextLine, DataSortDirection, DataAlignment } from "@kit/data.slint";
import { KitTooltipLayer } from "@kit/feedback.slint";
import { FormGallery, FormExamples, ShowcasePage, TextExample, NumericExample, LocaleExample, SubmissionPresentation } from "forms-gallery.slint";
export { FormExamples, ShowcasePage, TextExample, NumericExample, LocaleExample, SubmissionPresentation } from "forms-gallery.slint";
import { KitDialogSurface, KitDialogPanel, KitDialogHeader, KitDialogBody, KitDialogFooter, KitFocusTarget } from "@kit/dialog.slint";

component RegisteredButton inherits KitFocusTarget {
    in property <KitTheme> theme;
    in property <string> text;
    in property <ButtonIntent> intent: ButtonIntent.primary;
    in property <bool> busy;
    callback activated();
    in property <ControlSize> control-size: ControlSize.medium;
    min-height: button.min-height;
    preferred-height: button.preferred-height;
    vertical-stretch: 0;
    min-width: button.min-width;
    preferred-width: button.preferred-width;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    focus-requested => { button.take-focus(); }
    button := KitButton {
        theme: root.theme; text: root.text; intent: root.intent; control-size: root.control-size;
        busy: root.busy; disabled: !root.eligible;
        activated => { root.activated(); }
        focus-observed(focused) => { root.focus-observed(root.token, focused); }
    }
}

export enum TextSample { standard, long-french, right-to-left }
export enum ThemeMode { light, dark }
export enum ShowcaseSkin { mineral, expressive }
export enum AccentStyle { indigo, teal }
export enum TabDisposition { host-handled, native-navigation }
export enum ValidationPhase { idle, pending, failed, succeeded }
export struct PopupRect { x: length, y: length, width: length, height: length }
export struct PopupSize { width: length, height: length }

component Label inherits Text {
    in property <KitTheme> theme;
    color: theme.text-primary;
    font-size: 14px * theme.text-scale;
}

component Avatar inherits Rectangle {
    in property <KitTheme> theme;
    in property <string> initials: "SK";
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background: theme.accent;
    Text { text: root.initials; color: root.theme.on-accent; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

// The consumer supplies layout and a recipe; KitPressable owns activation.
component ProjectTile inherits KitPressable {
    in property <string> title;
    in property <string> subtitle;
    private property <ButtonRecipe> base-recipe: KitThemes.button-recipe(root.theme, ButtonIntent.primary, root.control-size);
    recipe: {
        fill: base-recipe.fill, hover-fill: base-recipe.hover-fill,
        pressed-fill: base-recipe.pressed-fill, disabled-fill: base-recipe.disabled-fill,
        foreground: base-recipe.foreground, disabled-foreground: base-recipe.disabled-foreground,
        border: transparent, border-width: 0px, radius: 20px, padding-inline: 0px, padding-block: 0px, height: 166px,
        font-size: base-recipe.font-size, focus-color: base-recipe.focus-color,
        focus-width: base-recipe.focus-width, focus-offset: base-recipe.focus-offset,
    };
    control-width: ControlWidth.fill;
    border-width: 0px;
    min-height: max(166px, tile-content.preferred-height);
    preferred-height: self.min-height;
    max-height: self.preferred-height;
    accessible-name: title;
    tile-content := VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            KitIcon {kind:IconKind.arrow-up-right;ink:root.theme.on-accent;width:28px;height:28px;}
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 62px; height: 24px; border-radius: 12px;
                background: root.theme.on-accent.with-alpha(0.18);
                Text { text: "LIVE"; color: root.theme.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.title; color: root.theme.on-accent; font-size: 23px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
        Text { text: root.subtitle; color: root.theme.on-accent; font-size: 13px * root.theme.text-scale; wrap: word-wrap; }
    }
}

export component Showcase inherits Window {
    title: "Slint Kit · Interaction, in your own shape";
    preferred-width: 1180px;
    preferred-height: 880px;
    min-width: 960px;
    min-height: 740px;
    background: theme.canvas;
    default-font-family: "sans-serif";
    default-font-size: 14px;

    in-out property <ShowcasePage> page: ShowcasePage.gallery;
    in-out property <bool> show-lab: false;
    in-out property <ThemeMode> theme-mode: ThemeMode.light;
    in-out property <AccentStyle> accent-style: AccentStyle.indigo;
    in-out property <ControlSize> density: ControlSize.medium;
    in-out property <TextSample> text-sample: TextSample.standard;
    private property <string> sample-label: text-sample == TextSample.standard ? "A considered default" : text-sample == TextSample.long-french ? "Partager ce nouveau projet avec toutes les personnes de votre équipe et conserver les modifications" : "مشاركة هذا المشروع الجديد مع أعضاء الفريق";
    in-out property <bool> enlarged: false;
    in-out property <bool> reduced-motion: false;
    private property <KitTheme> base-theme: theme-mode == ThemeMode.dark ? KitThemes.dark : KitThemes.light;
    out property <KitTheme> theme: {
        canvas: base-theme.canvas, surface: base-theme.surface, surface-raised: base-theme.surface-raised,
        text-primary: base-theme.text-primary, text-secondary: base-theme.text-secondary,
        accent: accent-style == AccentStyle.teal ? (theme-mode == ThemeMode.dark ? #65d8c4 : #087c70) : base-theme.accent,
        on-accent: base-theme.on-accent, danger: base-theme.danger,
        border-subtle: base-theme.border-subtle, focus-ring: base-theme.focus-ring,
        hover: base-theme.hover, pressed: base-theme.pressed, disabled-fill: base-theme.disabled-fill,
        disabled-text: base-theme.disabled-text, scrim: base-theme.scrim,
        reduced-motion: root.reduced-motion, text-scale: enlarged ? 2 : 1,
    };
    in property <[OptionRow]> rows;
    in property <SelectState> select-state;
    in property <DialogState> dialog-state;
    in property <FocusRequest> focus-request;
    in property <[int]> focus-generations;
    in property <string> selected-label: "Choose a person";
    in property <string> selected-detail: "Stable identity, independent of position";
    in property <string> diagnostics: "Ready";
    in property <string> status: "Explore a shared behavior in two visual languages.";
    in-out property <string> project-name: "A new perspective";
    in-out property <ShowcaseSkin> popup-skin: ShowcaseSkin.mineral;
    in-out property <ShowcaseSkin> dialog-skin: ShowcaseSkin.mineral;
    in property <int> activation-count;
    in property <int> row-count: 10000;
    in property <bool> note-visible;
    in property <ValidationPhase> validation-phase;
    in property <string> validation-message;
    in-out property <string> project-note;
    in-out property <PopupRect> popup-anchor;
    private property <PopupRect> popup-bounds: root.place-popup(root.popup-anchor, {width: root.width, height: root.height});
    pure callback place-popup(PopupRect, PopupSize) -> PopupRect;
    private property <float> dialog-preview-scroll-position;
    private property <int> dialog-preview-scroll-request;
    public function scroll-page(position: float) {
        if (root.dialog-state.open) {root.dialog-preview-scroll-position = clamp(position,0,1);root.dialog-preview-scroll-request += 1;}
        else {page-scroll.content-y = -max(0px,page-scroll.content-height - page-scroll.visible-height) * clamp(position,0,1);}
    }
    public function show-content-lab() { root.show-lab = true; page-scroll.content-y = -max(0px, page-scroll.content-height - page-scroll.visible-height); }
    public function focus-form-consent() {FormExamples.consent-focus-sequence += 1;}
    public function focus-form-text(target: TextExample) { FormExamples.text-focus-target = target; FormExamples.text-focus-sequence += 1; }
    public function focus-form-numeric(target: NumericExample) { FormExamples.numeric-focus-target = target; FormExamples.numeric-focus-sequence += 1; }
    callback select-open();
    callback select-navigate(NavigationStep);
    callback select-activate(int, int);
    callback select-dismiss(CloseReason);
    callback select-query(string);
    callback select-typeahead(string);
    callback select-tab(bool) -> TabDisposition;
    callback select-state-changed();
    changed select-state => { root.select-state-changed(); }
    callback reverse-options();
    callback remove-selected();
    callback restore-options();
    callback activated();
    callback dialog-open();
    callback dialog-dismiss(CloseReason);
    callback dialog-submit(string);
    callback dialog-toggle-note();
    callback focus-next(bool);
    callback focus-changed(int, bool);

    page-scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(self.visible-height, page-content.preferred-height);
        page-content := VerticalLayout {
            width: page-scroll.visible-width;
            height: page-scroll.content-height;
            alignment: start;
            padding: 32px;
            spacing: 24px;
            FlexboxLayout {
                spacing: 16px; alignment: start; cross-axis-alignment: center;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle { width: 42px; height: 42px; border-radius: 12px; background: root.theme.accent;
                        Image { width: parent.width; height: parent.height; source:@image-url("../../assets/branding/slint-kit.svg");image-fit:contain;}
                    }
                    VerticalLayout { spacing: 3px;
                        Text { text: "Slint Kit"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 700; }
                        Text { text: "Native by design"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; }
                    }
                }
                KitButton { theme: root.theme; control-size: root.density; text: root.theme-mode == ThemeMode.dark ? "Light" : "Dark"; activated => { root.theme-mode = root.theme-mode == ThemeMode.dark ? ThemeMode.light : ThemeMode.dark; } }
                KitButton { theme: root.theme; control-size: root.density; text: root.accent-style == AccentStyle.teal ? "Teal" : "Indigo"; activated => { root.accent-style = root.accent-style == AccentStyle.teal ? AccentStyle.indigo : AccentStyle.teal; } }
                KitButton { theme: root.theme; control-size: root.density; text: root.enlarged ? "Text 200%" : "Text 100%"; activated => { root.enlarged = !root.enlarged; } }
                KitButton { theme: root.theme; control-size: root.density; text: root.density == ControlSize.compact ? "Compact" : root.density == ControlSize.medium ? "Standard" : "Comfortable"; activated => { root.density = root.density == ControlSize.compact ? ControlSize.medium : root.density == ControlSize.medium ? ControlSize.comfortable : ControlSize.compact; } }
                KitButton { theme: root.theme; control-size: root.density; text: "Lab"; intent: root.show-lab ? ButtonIntent.secondary : ButtonIntent.quiet; activated => { root.show-lab = !root.show-lab; } }
            }
            VerticalLayout { spacing: 8px;
                Text { text: "One behavior. Your perspective."; color: root.theme.text-primary; font-size: 28px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
                Text { text: "Considered controls, precise values, and room for your own visual language."; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
            }
            FlexboxLayout { spacing: 8px; alignment: start;
                for section in [ShowcasePage.gallery, ShowcasePage.profile, ShowcasePage.billing, ShowcasePage.choices, ShowcasePage.schedule, ShowcasePage.files, ShowcasePage.display, ShowcasePage.navigation, ShowcasePage.data]: KitButton {
                    theme: root.theme; control-size: root.density;
                    text: section == ShowcasePage.gallery ? "Gallery" : section == ShowcasePage.profile ? "Text & profile" : section == ShowcasePage.billing ? "Numbers & money" : section == ShowcasePage.choices ? "Choices" : section == ShowcasePage.schedule ? "Dates & time" : section == ShowcasePage.files ? "Files & color" : section == ShowcasePage.display ? "Display & feedback" : section == ShowcasePage.navigation ? "Navigation & layouts" : "Data views";
                    intent: root.page == section ? ButtonIntent.primary : ButtonIntent.quiet;
                    activated => { root.page = section; }
                }
            }
            if root.page == ShowcasePage.gallery: FlexboxLayout {
                flex-direction: root.enlarged || root.width < 1100px ? column : row;
                flex-wrap: no-wrap; cross-axis-alignment: stretch; spacing: 24px;
                Rectangle {
                    width: root.enlarged || root.width < 1100px ? page-scroll.visible-width - 64px : (page-scroll.visible-width - 88px) / 2; background: root.theme.surface; border-color: root.theme.border-subtle; border-width: 1px; border-radius: 16px;
                    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
                        VerticalLayout { spacing: 6px;
                            Text { text: "01 / MINERAL"; color: root.theme.accent; font-size: 12px * root.theme.text-scale; font-weight: 600; }
                            Text { text: "Clarity, by default"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
                            Text { text: "Quiet surfaces. Familiar proportions."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                        }
                        Rectangle { background: root.theme.canvas; border-radius: 12px; preferred-height: max(166px, demo.preferred-height); vertical-stretch: 0;
                            demo := VerticalLayout { padding: 20px; spacing: 16px; alignment: start;
                                Label { theme: root.theme; text: "A purposeful action"; font-weight: 600; }
                                FlexboxLayout { spacing: 12px; alignment: start;
                                    KitButton { theme: root.theme; control-size: root.density; text: "Create project"; intent: ButtonIntent.primary; activated => { root.activated(); } }
                                    KitButton { theme: root.theme; control-size: root.density; text: "Unavailable"; disabled: true; }
                                }
                                Text { text: "Mouse, keyboard, and accessible action"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                            }
                        }
                        VerticalLayout { spacing: 8px; alignment: start;
                            Label { theme: root.theme; text: "Project owner"; font-weight: 600; }
                            KitSelect {
                                theme: root.theme; control-size: root.density; rows: root.rows;
                                state: {selection-availability: root.select-state.selection-availability, selected: root.select-state.selected, active: root.select-state.active, open: root.select-state.open && root.popup-skin == ShowcaseSkin.mineral, active-index: root.select-state.active-index, generation: root.select-state.generation};
                                placeholder: root.selected-label;
                                open-requested => { root.popup-skin = ShowcaseSkin.mineral; root.select-open(); }
                                navigate(step) => { root.select-navigate(step); }
                                activate(token, generation) => { root.select-activate(token, generation); }
                                dismiss(reason) => { root.select-dismiss(reason); }
                                query-edited(query) => { root.select-query(query); }
                                typeahead(text) => { root.select-typeahead(text); }
                                tab-navigation(reverse) => { return root.select-tab(reverse) == TabDisposition.host-handled ? accept : reject; }
                            }
                            Text { text: "10,000 people, selected by stable identity"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                        }
                        Rectangle {min-height:0px;preferred-height:0px;vertical-stretch:1;background:transparent;}
                        Rectangle { height: 1px; background: root.theme.border-subtle; }
                        VerticalLayout { spacing: 12px; alignment: start;
                            VerticalLayout { spacing: 4px;
                                Label { theme: root.theme; text: "A little more room"; font-weight: 600; }
                                Text { text: "A centered dialog with real text editing."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                            }
                            RegisteredButton { theme: root.theme; control-size: root.density; text: "Open dialog"; intent: ButtonIntent.secondary; token: 1; generation: root.focus-generations[1]; request: root.focus-request; focus-observed(token,focused) => { root.focus-changed(token,focused); } activated => { root.dialog-skin = ShowcaseSkin.mineral; root.dialog-open(); } }
                        }
                    }
                }
                Rectangle {
                    width: root.enlarged || root.width < 1100px ? page-scroll.visible-width - 64px : (page-scroll.visible-width - 88px) / 2; background: root.theme.surface; border-color: root.theme.border-subtle; border-width: 1px; border-radius: 16px;
                    VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
                        VerticalLayout { spacing: 6px;
                            Text { text: "02 / EXPRESSIVE"; color: root.theme.accent; font-size: 12px * root.theme.text-scale; font-weight: 600; }
                            Text { text: "Make it your own"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
                            Text { text: "A new structure, with the same reliable parts."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                        }
                        ProjectTile { theme: root.theme; title: "Create something good"; subtitle: "Your content, your composition."; activated => { root.activated(); } }
                        VerticalLayout { spacing: 8px; alignment: start;
                            Label { theme: root.theme; text: "Collaborate with"; font-weight: 600; }
                            KitFocusTarget {
                                token: 3; generation: root.focus-generations[3]; request: root.focus-request;
                                min-height: max(64px, 44px * root.theme.text-scale); preferred-height: self.min-height; max-height: self.preferred-height; vertical-stretch: 0;
                                focus-requested => { rich-trigger.take-focus(); }
                                rich-trigger := KitSelectTrigger {
                                    theme: root.theme; control-size: root.density; state: root.select-state;
                                    min-height: max(64px, 44px * root.theme.text-scale); preferred-height: self.min-height; max-height: self.preferred-height;
                                    accessible-name: "Choose collaborator";
                                    focus-observed(focused) => { root.focus-changed(3, focused); }
                                    private property <PopupRect> anchor-geometry: {x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height};
                                    changed anchor-geometry => { if (!root.dialog-state.open) { root.popup-anchor = self.anchor-geometry; } }
                                    open-requested => { root.popup-anchor = self.anchor-geometry; root.popup-skin = ShowcaseSkin.expressive; root.select-open(); }
                                    navigate(step) => { root.select-navigate(step); }
                                    activate(token,generation) => { root.select-activate(token,generation); }
                                    dismiss(reason) => { root.select-dismiss(reason); }
                                    typeahead(text) => { root.select-typeahead(text); }
                                    tab-navigation(reverse) => { return root.select-tab(reverse) == TabDisposition.host-handled ? accept : reject; }
                                    HorizontalLayout { spacing: 12px;
                                        Avatar { theme: root.theme; initials: "P"; }
                                        VerticalLayout { spacing: 4px;
                                            Text { text: root.selected-label; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; font-weight: 600; overflow: elide; }
                                            Text { text: root.selected-detail; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; overflow: elide; }
                                        }
                                        Rectangle { width: 16px; horizontal-stretch: 0; KitIcon { kind: IconKind.chevron-down; ink: root.theme.text-secondary; y: (parent.height - self.height) / 2; } }
                                    }
                                }
                            }
                            Text { text: "Avatar and metadata, with a single shared interaction."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                        }
                        Rectangle {min-height:0px;preferred-height:0px;vertical-stretch:1;background:transparent;}
                        Rectangle { height: 1px; background: root.theme.border-subtle; }
                        VerticalLayout { spacing: 12px; alignment: start;
                            VerticalLayout { spacing: 4px;
                                Label { theme: root.theme; text: "Another point of view"; font-weight: 600; }
                                Text { text: "A side panel with a composed footer."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                            }
                            RegisteredButton { theme: root.theme; control-size: root.density; text: "Open panel"; intent: ButtonIntent.secondary; token: 2; generation: root.focus-generations[2]; request: root.focus-request; focus-observed(token,focused) => { root.focus-changed(token,focused); } activated => { root.dialog-skin = ShowcaseSkin.expressive; root.dialog-open(); } }
                        }
                    }
                }
            }
            if root.page == ShowcasePage.profile || root.page == ShowcasePage.billing || root.page == ShowcasePage.choices || root.page == ShowcasePage.schedule || root.page == ShowcasePage.files: FormGallery { theme: root.theme; control-size: root.density; page: root.page; }
            if root.page == ShowcasePage.display: DisplayGallery {theme:root.theme;control-size:root.density;viewport-width:root.width;viewport-height:root.height;}
            if root.page == ShowcasePage.navigation: NavigationGallery {theme:root.theme;control-size:root.density;viewport-width:root.width;viewport-height:root.height;}
            if root.page == ShowcasePage.data: DataGallery {theme:root.theme;control-size:root.density;}
            if root.show-lab: Rectangle {
                background: root.theme.surface; border-width: 1px; border-color: root.theme.border-subtle; border-radius: 12px;
                preferred-height: lab.preferred-height + 32px; vertical-stretch: 0;
                lab := VerticalLayout { padding: 16px; spacing: 16px; alignment: start;
                    Label { theme: root.theme; text: "Interaction lab"; font-weight: 600; }
                    Text { text: root.diagnostics; color: root.theme.text-primary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                    Text { text: root.status; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                    FlexboxLayout { spacing: 12px; alignment: start;
                        KitButton { theme: root.theme; text: "Reverse rows"; activated => { root.reverse-options(); } }
                        KitButton { theme: root.theme; text: "Remove selected"; disabled: !root.select-state.selected.present; activated => { root.remove-selected(); } }
                        KitButton { theme: root.theme; text: "Reset data"; intent: ButtonIntent.quiet; activated => { root.restore-options(); } }
                        KitButton { theme: root.theme; text: root.reduced-motion ? "Motion off" : "Motion on"; intent: ButtonIntent.quiet; activated => { root.reduced-motion = !root.reduced-motion; } }
                    }
                    FlexboxLayout { spacing: 12px; alignment: start;
                        KitButton { theme: root.theme; text: root.text-sample == TextSample.standard ? "Standard text" : root.text-sample == TextSample.long-french ? "French text" : "RTL text"; activated => { root.text-sample = root.text-sample == TextSample.standard ? TextSample.long-french : root.text-sample == TextSample.long-french ? TextSample.right-to-left : TextSample.standard; } }
                        Text { text: root.sample-label; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                    }
                }
            }
            Text { text: "Slint Kit · GPL-3.0-or-later"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; }
        }
    }

    if root.dialog-state.open: KitDialogSurface {
        theme: root.theme;
        state: root.dialog-state;
        dismiss(reason) => { root.dialog-dismiss(reason); }
        focus-next(backward) => { root.focus-next(backward); }
        KitDialogPanel {
            accessible-name: root.dialog-skin == ShowcaseSkin.expressive ? "A fresh perspective" : "Create a project";
            accessible-description-text: "Edit the project name and invite a collaborator.";
            x: root.dialog-skin == ShowcaseSkin.expressive ? parent.width - self.width : (parent.width - self.width) / 2;
            y: root.dialog-skin == ShowcaseSkin.expressive ? 20px : (parent.height - self.height) / 2;
            width: root.dialog-skin == ShowcaseSkin.expressive ? min(parent.width - 40px,root.enlarged ? 680px : 490px) : 540px;
            height: root.dialog-skin == ShowcaseSkin.expressive ? parent.height - 40px : min(parent.height - 40px, root.enlarged ? 760px : root.note-visible ? 640px : 570px);
            border-radius: root.dialog-skin == ShowcaseSkin.expressive ? 24px : 16px;
            background: root.theme.surface-raised;
            border-width: 1px;
            border-color: root.theme.border-subtle;
            dialog-scroll := ScrollView {
              private property <int> preview-request:root.dialog-preview-scroll-request;
              changed preview-request => {self.content-y = -max(0px,self.content-height - self.visible-height) * root.dialog-preview-scroll-position;}
              content-width: self.visible-width;
              content-height: max(self.visible-height,dialog-content.preferred-height);
              dialog-content := VerticalLayout {
                width: dialog-scroll.visible-width; height: dialog-scroll.content-height; alignment: start;
                padding: 28px; spacing: 24px;
                KitDialogHeader {
                    vertical-stretch: 0;
                    VerticalLayout {
                        width:dialog-scroll.visible-width - 56px;
                        spacing: 12px;
                        if root.dialog-skin == ShowcaseSkin.expressive: Avatar { theme: root.theme; initials: "↗"; }
                        Text { text: root.dialog-skin == ShowcaseSkin.expressive ? "A fresh perspective" : "Create a project"; color: root.theme.text-primary; font-size: 28px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
                        Text { text: "Real editing. Nested selection. Shared modal behavior."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                    }
                }
                KitDialogBody {
                    vertical-stretch: 0;
                    VerticalLayout {
                        spacing: 12px;
                        Label { theme: root.theme; text: "Project name"; font-weight: 650; }
                        KitFocusTarget {
                            token: 11; generation: root.focus-generations[11]; request: root.focus-request;
                            eligible: !root.dialog-state.busy;
                            focus-requested => { input.focus(); }
                            focus-observed(token, focused) => { root.focus-changed(token, focused); }
                            height: max(48px, input.preferred-height + 20px);
                            Rectangle {
                                background: root.theme.canvas;
                                border-width: 1px;
                                border-color: input.has-focus ? root.theme.focus-ring : root.theme.border-subtle;
                                border-radius: 8px;
                            }
                            input := TextInput {
                                x: 14px; y: 10px; width: parent.width - 28px; height: parent.height - 20px;
                                text <=> root.project-name;
                                color: root.theme.text-primary;
                                font-size: 15px * root.theme.text-scale;
                                single-line: true;
                                enabled: !root.dialog-state.busy;
                                accessible-label: "Project name";
                                changed has-focus => { root.focus-changed(11, self.has-focus); }
                            }
                        }
                        Label { theme: root.theme; text: "Invite a collaborator"; font-weight: 650; }
                        KitFocusTarget {
                            token: 12; generation: root.focus-generations[12]; request: root.focus-request;
                            eligible: !root.dialog-state.busy;
                            height: max(48px,nested-trigger.preferred-height);
                            focus-requested => { nested-trigger.take-focus(); }
                            focus-observed(token, focused) => { root.focus-changed(token, focused); }
                            nested-trigger := KitSelectTrigger {
                                theme: root.theme; state: root.select-state;
                                disabled: root.dialog-state.busy;
                                accessible-name: "Choose a collaborator inside dialog";
                                private property <PopupRect> anchor-geometry: {x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height};
                                changed anchor-geometry => { if (root.dialog-state.open) { root.popup-anchor = self.anchor-geometry; } }
                                focus-observed(focused) => { root.focus-changed(12, focused); }
                                open-requested => { root.popup-anchor = {x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height}; root.popup-skin = ShowcaseSkin.expressive; root.select-open(); }
                            navigate(step) => { root.select-navigate(step); }
                            activate(token, generation) => { root.select-activate(token, generation); }
                            dismiss(reason) => { root.select-dismiss(reason); }
                            typeahead(text) => { root.select-typeahead(text); }
                            tab-navigation(reverse) => { return root.select-tab(reverse) == TabDisposition.host-handled ? accept : reject; }
                                HorizontalLayout { spacing: 12px; Text { text: root.selected-label; color: root.theme.text-primary; font-size: 14px * root.theme.text-scale; vertical-alignment: center; overflow: elide; } KitIcon { kind: IconKind.chevron-down; ink: root.theme.text-secondary; } }
                            }
                        }
                        Text { text: "Try accents, emoji, selection, undo and paste. Escape closes one layer at a time."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                        RegisteredButton {
                            theme: root.theme; text: root.note-visible ? "Remove optional note" : "Add an optional note"; intent: ButtonIntent.quiet;
                            eligible: !root.dialog-state.busy;
                            token: 15; generation: root.focus-generations[15]; request: root.focus-request;
                            focus-observed(token, focused) => { root.focus-changed(token, focused); }
                            activated => { root.dialog-toggle-note(); }
                        }
                        if root.note-visible: KitFocusTarget {
                            token: 16; generation: root.focus-generations[16]; request: root.focus-request;
                            eligible: !root.dialog-state.busy;
                            height: max(48px,note.preferred-height + 20px);
                            focus-requested => { note.focus(); }
                            focus-observed(token, focused) => { root.focus-changed(token, focused); }
                            Rectangle { background: root.theme.canvas; border-radius: 8px; border-width: 1px; border-color: note.has-focus ? root.theme.focus-ring : root.theme.border-subtle; }
                            note := TextInput { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text <=> root.project-note; color: root.theme.text-primary; font-size:14px * root.theme.text-scale; single-line: true; accessible-label: "Optional project note"; changed has-focus => { root.focus-changed(16, self.has-focus); } }
                        }
                        if root.validation-message != "": Text {
                            text: root.validation-message;
                            color: root.validation-phase == ValidationPhase.failed ? root.theme.danger : root.theme.text-secondary;
                            font-size: 13px * root.theme.text-scale;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                KitDialogFooter {
                    vertical-stretch: 0;
                    VerticalLayout {
                        width:dialog-scroll.visible-width - 56px;
                        spacing: 14px;
                        if root.dialog-skin == ShowcaseSkin.expressive: Text { text: "Your content. Your composition."; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; }
                        FlexboxLayout {
                            spacing: 12px; alignment: start;
                            RegisteredButton { theme: root.theme; text: "Theme"; intent: ButtonIntent.quiet; eligible: !root.dialog-state.busy; token: 17; generation: root.focus-generations[17]; request: root.focus-request; focus-observed(token,focused) => { root.focus-changed(token,focused); } activated => { root.theme-mode = root.theme-mode == ThemeMode.dark ? ThemeMode.light : ThemeMode.dark; } }
                            RegisteredButton { theme: root.theme; text: "Cancel"; intent: ButtonIntent.secondary; eligible: !root.dialog-state.busy; token: 13; generation: root.focus-generations[13]; request: root.focus-request; focus-observed(token,focused) => { root.focus-changed(token,focused); } activated => { root.dialog-dismiss(CloseReason.programmatic); } }
                            RegisteredButton { theme: root.theme; text: root.dialog-state.busy ? "Creating…" : "Create project"; busy: root.dialog-state.busy; eligible: !root.dialog-state.busy; token: 14; generation: root.focus-generations[14]; request: root.focus-request; focus-observed(token,focused) => { root.focus-changed(token,focused); } activated => { root.dialog-submit(root.project-name); } }
                        }
                    }
                }
            }
        }
      }
    }

    // The expressive selector assembles public parts around the very same controller.
    if root.select-state.open && root.popup-skin == ShowcaseSkin.expressive: Rectangle {
        TouchArea { clicked => { root.select-dismiss(CloseReason.outside-press); } }
        surface := KitSelectSurface {
        x: root.popup-bounds.x;
        y: root.popup-bounds.y;
        width: root.popup-bounds.width;
        height: root.popup-bounds.height;
            theme: root.theme; state: root.select-state;
            empty: root.rows.length == 0;
            row-height: max(68px, 44px * root.theme.text-scale);
            viewport-height: custom-list.visible-height;
            scroll-y <=> custom-list.content-y;
            navigate(step) => { root.select-navigate(step); }
            activate(token, generation) => { root.select-activate(token, generation); }
            dismiss(reason) => { root.select-dismiss(reason); }
            query-edited(query) => { root.select-query(query); }
            typeahead(text) => { root.select-typeahead(text); }
                            tab-navigation(reverse) => { return root.select-tab(reverse) == TabDisposition.host-handled ? accept : reject; }
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    Text { text: "PEOPLE"; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; vertical-alignment: center; }
                    KitButton { theme: root.theme; text: "Switch theme"; intent: ButtonIntent.quiet; activated => { root.theme-mode = root.theme-mode == ThemeMode.dark ? ThemeMode.light : ThemeMode.dark; } }
                }
            custom-list := ListView {
                for row in root.rows: KitOption {
                    theme: root.theme; option-data: row;
                    active: root.select-state.active.present && root.select-state.active.token == row.token;
                    selected: root.select-state.selected.present && root.select-state.selected.token == row.token;
                    height: max(68px, 44px * root.theme.text-scale);
                    activate(token, generation) => { root.select-activate(token, generation); }
                    HorizontalLayout {
                        padding: 10px; spacing: 12px;
                        Avatar { theme: root.theme; initials: "P"; }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: row.label; color: row.disabled ? root.theme.disabled-text : root.theme.text-primary; font-size: 14px * root.theme.text-scale; font-weight: 650; }
                            Text { text: row.description; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; }
                        }
                        Text { text: row.disabled ? "Unavailable" : (root.select-state.selected.token == row.token && root.select-state.selected.present ? "✓" : ""); color: root.theme.accent; font-size: 12px * root.theme.text-scale; vertical-alignment: center; }
                    }
                }
            }
            }
        }
    }
    KitTooltipLayer {viewport-width:root.width;viewport-height:root.height;enabled:!root.dialog-state.open && root.page==ShowcasePage.display;}

}
