import { KitTheme, KitThemes, ControlSize, ButtonIntent, KitMetrics, TypographyRole } from "@kit/theme.slint";
import { PreviewAnchor, PreviewTarget, PreviewExamples } from "example-section.slint";
import { KitButton } from "@kit/button.slint";
import { KitBadge, KitAvatar, KitCard, KitCardHeader, KitCardBody, KitCardFooter, KitHero, KitFooter, KitDivider, KitStat, KitChatBubble, KitSkeleton, KitEmptyState, KitTimeline, KitSteps, StepState, Tone, ChatSide } from "@kit/display.slint";
import { KitAlert, KitSpinner, KitProgress, KitRadialProgress, KitTooltip, KitToastHost, AlertSeverity, ToastEntry, ToastInteraction } from "@kit/feedback.slint";
export { ToastEntry, AlertSeverity, ToastInteraction } from "@kit/feedback.slint";
export enum ToastExample { published, failed }
export enum ContentDemoState { empty, loading, loaded }
export enum ProgressDemoState { idle, running, completed, cancelled }
export global DisplayExamples {
    in-out property <ContentDemoState> content-state: ContentDemoState.empty;
    in-out property <bool> error-visible;
    in-out property <bool> alert-visible: true;
    in-out property <[ToastEntry]> toast-entries;
    in-out property <string> toast-status: "Notifications appear here.";
    in-out property <float> progress;
    in-out property <ProgressDemoState> progress-state: ProgressDemoState.idle;
    callback add-toast(ToastExample);
    callback toast-action(int);
    callback toast-dismiss(int);
    callback toast-interaction(int,ToastInteraction,bool);
    callback progress-start();
    callback progress-cancel();
}

// Each replacement is measured at the same finite width. Changing state never
// changes the surrounding page's scroll extent or moves the state controls.
component ContentStateCard inherits KitCard {
    private property <int> request: PreviewExamples.request;
    changed request => { if (PreviewExamples.target == PreviewTarget.content-states) { PreviewExamples.reveal(root.absolute-position.y,root.height); } }
}
component ContentStatePreview inherits Rectangle {
    in property <KitTheme> theme;
    in property <ControlSize> control-size;
    preferred-height: max(empty.preferred-height,loading.preferred-height,loaded.preferred-height);
    min-height: self.preferred-height;
    vertical-stretch: 0;
    background: root.theme.canvas;
    border-radius: root.theme.shape.radius-container;
    accessible-role: groupbox;
    accessible-label: "Content state preview";
    loading := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        padding: root.theme.spacing.unit * 6; spacing: root.theme.spacing.unit * 3; alignment: start;
        opacity: DisplayExamples.content-state == ContentDemoState.loading ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.fast; }
        KitSkeleton { theme: root.theme; running: DisplayExamples.content-state == ContentDemoState.loading; preferred-width: max(0px, min(parent.width - root.theme.spacing.unit * 12, root.theme.spacing.unit * 45)); max-width: self.preferred-width; }
        KitSkeleton { theme: root.theme; running: DisplayExamples.content-state == ContentDemoState.loading; }
        KitSkeleton { theme: root.theme; running: DisplayExamples.content-state == ContentDemoState.loading; preferred-width: max(0px, min(parent.width - root.theme.spacing.unit * 12, root.theme.spacing.unit * 60)); max-width: self.preferred-width; }
    }
    empty := KitEmptyState {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        theme: root.theme; title: "No collections yet"; description: "Create a demo collection to replace this empty state.";
        opacity: DisplayExamples.content-state == ContentDemoState.empty ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.fast; }
        KitButton { theme: root.theme; control-size: root.control-size; text: "Create Collection"; intent: ButtonIntent.primary; disabled: DisplayExamples.content-state != ContentDemoState.empty; activated => { DisplayExamples.content-state = ContentDemoState.loaded; } }
    }
    loaded := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        padding: root.theme.spacing.unit * 6; spacing: root.theme.spacing.unit * 2; alignment: start;
        opacity: DisplayExamples.content-state == ContentDemoState.loaded ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: root.theme.reduced-motion ? 0ms : root.theme.motion.fast; }
        Text { width: max(0px,root.width - root.theme.spacing.unit * 12); height: self.preferred-height; text: "Allsafe incident notes"; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; wrap: word-wrap; }
        Text { width: max(0px,root.width - root.theme.spacing.unit * 12); height: self.preferred-height; text: "Private collection · Elliot Alderson · Ready for its first note"; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
    }
}

export component DisplayGallery inherits VerticalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <ControlSize> control-size: ControlSize.medium;
    in property <length> viewport-width: 1180px;
    in property <length> viewport-height: 900px;
    spacing: root.theme.spacing.unit * 6; alignment: start; vertical-stretch: 0;
    KitCard { theme: root.theme;
        KitCardHeader { theme: root.theme; title: "Card, avatar & badges"; description: "KitCard · KitAvatar · KitBadge · Group content, metadata and actions."; }
        KitCardBody { theme: root.theme;
            HorizontalLayout { spacing: root.theme.spacing.unit * 3; alignment: start;
                KitAvatar { theme: root.theme; initials: "EA"; accessible-name: "Elliot Alderson"; }
                VerticalLayout { spacing: root.theme.spacing.unit;
                    Text { text: "Elliot Alderson"; wrap: word-wrap; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; }
                    Text { text: "Hello, friend."; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
                }
            }
            FlexboxLayout { spacing: root.theme.spacing.unit * 2; flex-wrap: wrap;
                KitBadge { theme: root.theme; text: "Published"; tone: Tone.success; }
                KitBadge { theme: root.theme; text: "Team workspace"; tone: Tone.accent; }
                KitBadge { theme: root.theme; text: "Draft"; }
            }
            KitDivider { theme: root.theme; label: "This month"; }
            FlexboxLayout { spacing: root.theme.spacing.unit * 6; flex-direction: root.theme.text-scale > 1 ? column : row; flex-wrap: no-wrap; cross-axis-alignment: start;
                KitStat { theme: root.theme; width: root.theme.text-scale > 1 ? root.width - root.theme.spacing.unit * 12 : (root.width - root.theme.spacing.unit * 18) / 2; height: self.preferred-height; label: "Readers"; value: "12,480"; description: "Across 18 published stories"; }
                KitStat { theme: root.theme; width: root.theme.text-scale > 1 ? root.width - root.theme.spacing.unit * 12 : (root.width - root.theme.spacing.unit * 18) / 2; height: self.preferred-height; label: "Contributors"; value: "24"; description: "People making things together"; }
            }
        }
        KitCardFooter { theme: root.theme;
            KitTooltip { theme: root.theme; text: "Publish this collection. You can undo from its notification."; target-focused: publish.has-focus; viewport-width: root.viewport-width; viewport-height: root.viewport-height;
                publish := KitButton { theme: root.theme; control-size: root.control-size; text: "Publish Update"; intent: ButtonIntent.primary; activated => { DisplayExamples.add-toast(ToastExample.published); } }
            }
        }
    }
    KitCard { theme: root.theme;
        KitCardHeader { theme: root.theme; title: "Alert"; description: "KitAlert · Show feedback next to the action that needs it."; }
        if DisplayExamples.alert-visible: KitAlert { theme: root.theme; severity: AlertSeverity.information; title: "Workspace ready"; message: "Invite a teammate to start sharing."; dismissible: true; dismissed => { DisplayExamples.alert-visible = false; } }
        if !DisplayExamples.alert-visible: KitButton { theme: root.theme; control-size: root.control-size; text: "Restore Alert"; intent: ButtonIntent.secondary; activated => { DisplayExamples.alert-visible = true; } }
        KitButton { theme: root.theme; control-size: root.control-size; text: "Show Error"; intent: ButtonIntent.secondary; activated => { DisplayExamples.error-visible = true; } }
        if DisplayExamples.error-visible: KitAlert { theme: root.theme; severity: AlertSeverity.error; title: "Update could not be saved"; message: "Your draft is preserved. Dismiss this message to try again."; dismissible: true; dismissed => { DisplayExamples.error-visible = false; } }
    }
    KitCard { theme: root.theme;
        PreviewAnchor { height: 0px; target: PreviewTarget.progress; }
        KitCardHeader { theme: root.theme; title: "Progress"; description: "KitProgress · KitRadialProgress · Start, cancel or restart an operation."; }
        KitProgress { theme: root.theme; value: DisplayExamples.progress; label: DisplayExamples.progress-state == ProgressDemoState.running ? "Importing collection" : DisplayExamples.progress-state == ProgressDemoState.completed ? "Import complete" : DisplayExamples.progress-state == ProgressDemoState.cancelled ? "Import cancelled" : "Ready to begin"; }
        HorizontalLayout { spacing: root.theme.spacing.unit * 4; alignment: start;
            KitRadialProgress { theme: root.theme; value: DisplayExamples.progress; label: "Import progress"; }
            if DisplayExamples.progress-state == ProgressDemoState.running: KitSpinner { theme: root.theme; label: "Importing collection"; }
        }
        KitCardFooter { theme: root.theme;
            KitButton { theme: root.theme; control-size: root.control-size; text: DisplayExamples.progress-state == ProgressDemoState.idle ? "Start Import" : "Restart"; intent: ButtonIntent.primary; activated => { DisplayExamples.progress-start(); } }
            KitButton { theme: root.theme; control-size: root.control-size; text: "Cancel"; intent: ButtonIntent.secondary; disabled: DisplayExamples.progress-state != ProgressDemoState.running; activated => { DisplayExamples.progress-cancel(); } }
        }
    }
    KitCard { theme: root.theme;
        PreviewAnchor { height: 0px; target: PreviewTarget.toast; }
        KitCardHeader { theme: root.theme; title: "Toast"; description: "KitToastHost · Window notifications stay in the bottom corner. Hover or focus pauses dismissal."; }
        KitCardFooter { theme: root.theme;
            KitButton { theme: root.theme; control-size: root.control-size; text: "Show Success"; intent: ButtonIntent.secondary; activated => { DisplayExamples.add-toast(ToastExample.published); } }
            KitButton { theme: root.theme; control-size: root.control-size; text: "Show Error"; intent: ButtonIntent.secondary; activated => { DisplayExamples.add-toast(ToastExample.failed); } }
        }
        Text { text: DisplayExamples.toast-status; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; accessible-live-region: polite; }
    }
    KitCard { theme: root.theme;
        KitCardHeader { theme: root.theme; title: "Chat bubbles"; description: "KitChatBubble · Keep author, message and delivery context together."; }
        KitChatBubble { theme: root.theme; author: "Darlene"; text: "The Allsafe audit is ready. Can you review the notes?"; metadata: "10:24 · Delivered"; }
        KitChatBubble { theme: root.theme; side: ChatSide.end; author: "You"; text: "I will review the network findings."; metadata: "10:25 · Read"; }
    }
    KitCard { theme: root.theme;
        KitCardHeader { theme: root.theme; title: "Timeline & steps"; description: "KitTimeline · KitSteps · Show past activity and the next step."; }
        KitSteps { theme: root.theme; entries: [{token:1,label:"Shape the idea",state:StepState.complete},{token:2,label:"Refine the details",state:StepState.current},{token:3,label:"Share it with the team",state:StepState.pending}]; }
        KitDivider { theme: root.theme; label: "Recent activity"; }
        KitTimeline { theme: root.theme; entries: [{title:"Collection created",description:"Allsafe incident notes are ready for review.",metadata:"Today · 09:10"},{title:"First review completed",description:"Darlene reviewed the network findings.",metadata:"Today · 10:05"}]; }
    }
    ContentStateCard { theme: root.theme;
        KitCardHeader { theme: root.theme; title: "Loading & empty states"; description: "KitSkeleton · KitEmptyState · Replace the placeholder when content is available."; }
        KitCardFooter { theme: root.theme;
            for state in [ContentDemoState.empty,ContentDemoState.loading,ContentDemoState.loaded]: KitButton { theme: root.theme; control-size: root.control-size; text: state == ContentDemoState.empty ? "Empty" : state == ContentDemoState.loading ? "Loading" : "Loaded"; intent: DisplayExamples.content-state == state ? ButtonIntent.primary : ButtonIntent.secondary; activated => { DisplayExamples.content-state = state; } }
        }
        ContentStatePreview { theme: root.theme; control-size: root.control-size; }
    }
    KitHero { theme: root.theme; title: "Make Room for Your Next Idea"; description: "KitHero · A quiet introduction that gives a page its purpose."; }
    KitFooter { theme: root.theme;
        Text { text: "Slint Kit"; color: root.theme.text-primary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle); font-weight: root.theme.typography.weight-semibold; }
        Text { text: "KitFooter · Persistent information at the end of a page."; color: root.theme.text-secondary; font-family: root.theme.typography.family; font-size: KitMetrics.font-size(root.theme, TypographyRole.control); wrap: word-wrap; }
    }
}
